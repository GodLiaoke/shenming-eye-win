  const continuityLabels = { proven: '正常', stale: '已过期', degraded: '恢复中', resyncing: '同步中' };
  const sessionLabels = {
    awaiting_session: '等待对局', live: '实时接收', replay: '回放中',
    degraded: '正在恢复', unrecoverable: '数据异常', ended: '对局已结束'
  };
  const operationLabels = {
    awaiting: '等待中', disabled: '已关闭', ready: '已就绪', active: '运行中',
    blocked: '已阻止', opaque: '不可解析', incomplete: '不完整', error: '异常'
  };
