<!doctype html>
<html lang="zh-CN" class="simple-panel">
<head>
  <meta charset="utf-8">
  <!-- viewport-fit=cover：手机 App 里页面是整屏铺满的（刘海/灵动岛盖在上面），
       必须让 env(safe-area-inset-*) 生效，否则顶栏会被状态栏压住。 -->
  <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
  <title>不死鸟CodeV · 实时雷达</title>
  <script>
    (() => {
      const advancedPanel = new URLSearchParams(location.search).get('advanced') === '1';
      window.ADVANCED_PANEL = advancedPanel;
      // Customer-facing rooms are map-first by default.  The full CodeV
      // workbench remains available only through the explicit admin query.
      document.documentElement.classList.toggle('simple-panel', !advancedPanel);
      document.documentElement.classList.add('aurora-signal-skin');
    })();
  </script>
  <style>
    :root {
      color-scheme: dark;
      --bg: #071016;
      --panel: rgba(12, 24, 32, .92);
      --panel-soft: rgba(7, 18, 25, .66);
      --line: rgba(157, 187, 202, .16);
      --line-strong: rgba(157, 187, 202, .28);
      --text: #edf5f7;
      --muted: #8fa5af;
      --good: #69d9ad;
      --warn: #e9b968;
      --bad: #f17780;
      --blue: #65b9ed;
      --red: #eb7184;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; min-height: 100%; background: var(--bg); color: var(--text); }
    body {
      min-height: 100vh;
      background:
        radial-gradient(circle at 12% 8%, rgba(45, 157, 204, .12), transparent 34%),
        radial-gradient(circle at 88% 92%, rgba(93, 224, 170, .07), transparent 30%),
        var(--bg);
    }
    button, select, input { font: inherit; }
    button, select {
      color: var(--text); background: #112633; border: 1px solid var(--line);
      border-radius: 8px; padding: 7px 11px;
    }
    button { cursor: pointer; }
    button:hover { border-color: rgba(96, 191, 255, .6); }
    #pause[aria-pressed="true"] { color: #071017; background: var(--good); }
    .app { min-height: 100vh; display: grid; grid-template-rows: auto minmax(0, 1fr) auto; }
    header {
      display: flex; align-items: center; justify-content: space-between; gap: 18px;
      padding: 15px 20px; border-bottom: 1px solid var(--line); background: rgba(5, 14, 20, .86);
      backdrop-filter: blur(18px); z-index: 2;
    }
    h1 { margin: 0; font-size: 16px; font-weight: 650; letter-spacing: .035em; }
    .sub { color: var(--muted); font-size: 12px; margin-top: 3px; }
    .status { display: inline-flex; align-items: center; gap: 8px; color: var(--muted); font-size: 13px; }
    .status::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--warn); box-shadow: 0 0 12px currentColor; }
    .status.good::before { background: var(--good); }
    .status.bad::before { background: var(--bad); }
    main { min-height: 0; display: grid; grid-template-columns: minmax(0, 1fr) 332px; gap: 12px; padding: 12px; }
    .map-panel, aside, footer { border: 1px solid var(--line); background: var(--panel); border-radius: 14px; box-shadow: 0 18px 44px rgba(0, 0, 0, .12); }
    .map-panel { min-height: 480px; position: relative; overflow: hidden; isolation: isolate; }
    .map-panel::after { content: ""; position: absolute; inset: 0; pointer-events: none; box-shadow: inset 0 0 80px rgba(0,0,0,.25); }
    canvas { display: block; width: 100%; height: 100%; min-height: 480px; }
    .map-label {
      position: absolute; left: 14px; top: 14px; padding: 6px 9px; border-radius: 7px;
      background: rgba(3, 11, 16, .78); color: var(--text); font-size: 11px; pointer-events: none;
      border: 1px solid var(--line); backdrop-filter: blur(12px); z-index: 2;
    }
    .map-warning {
      position: absolute; right: 14px; top: 14px; max-width: min(430px, calc(100% - 170px));
      padding: 7px 10px; border: 1px solid rgba(233, 185, 104, .32); border-radius: 8px;
      background: rgba(35, 28, 18, .82); color: var(--warn); font-size: 11px; line-height: 1.45;
      pointer-events: none; backdrop-filter: blur(12px); z-index: 2;
    }
    .map-warning.blocking { inset: 50% auto auto 50%; right: auto; top: auto; transform: translate(-50%, -50%); max-width: 430px; text-align: center; padding: 16px 20px; }
    .map-provenance {
      position: absolute; left: 14px; bottom: 14px; max-width: min(520px, calc(100% - 28px)); z-index: 2;
      display: grid; gap: 4px; padding: 9px 11px; border: 1px solid var(--line); border-radius: 9px;
      background: rgba(3, 11, 16, .76); backdrop-filter: blur(12px); pointer-events: none;
      color: var(--muted); font: 10px ui-monospace, SFMono-Regular, Menlo, monospace;
    }
    .map-provenance b { color: var(--text); font: 600 11px Inter, ui-sans-serif, system-ui, sans-serif; }
    aside { min-height: 0; overflow: auto; padding: 13px; scrollbar-width: thin; }
    .section-title { color: var(--muted); text-transform: uppercase; letter-spacing: .09em; font-size: 10px; margin: 3px 2px 9px; }
    .metrics { display: grid; grid-template-columns: 1fr 1fr; gap: 7px; margin-bottom: 14px; }
    .metric { padding: 9px; border: 1px solid var(--line); border-radius: 9px; background: rgba(6, 17, 24, .5); }
    .metric b { display: block; font: 600 15px ui-monospace, monospace; }
    .metric span { color: var(--muted); font-size: 10px; }
    .operations { display: grid; gap: 6px; margin-bottom: 15px; }
    .operation {
      display: grid; grid-template-columns: 8px minmax(0, 1fr) auto; align-items: center; gap: 8px;
      min-height: 43px; padding: 8px 9px; border: 1px solid var(--line); border-radius: 9px; background: var(--panel-soft);
    }
    .operation-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--warn); box-shadow: 0 0 9px currentColor; }
    .operation.good .operation-dot { background: var(--good); }
    .operation.bad .operation-dot { background: var(--bad); }
    .operation-main { min-width: 0; }
    .operation-name { display: block; font-size: 11px; }
    .operation-detail { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--muted); font-size: 9px; margin-top: 2px; }
    .operation-state { color: var(--muted); font: 9px ui-monospace, monospace; text-transform: uppercase; }
    .players { display: grid; gap: 6px; }
    .player {
      width: 100%; display: grid; grid-template-columns: 10px 1fr auto; gap: 8px; align-items: center;
      text-align: left; padding: 9px; background: rgba(6, 17, 24, .5);
    }
    .player[aria-pressed="true"] { color: var(--text); background: rgba(6, 17, 24, .5); }
    .player[aria-pressed="false"] { opacity: .42; }
    .swatch { width: 8px; height: 28px; border-radius: 4px; background: var(--slot); }
    .player-name { font-size: 12px; }
    .player-detail { color: var(--muted); font: 10px ui-monospace, monospace; margin-top: 3px; }
    .health { font-size: 9px; border-radius: 999px; padding: 3px 6px; border: 1px solid currentColor; color: var(--good); }
    .health.degraded, .health.resyncing, .health.stale { color: var(--warn); }
    .health.unrecoverable { color: var(--bad); }
    footer { margin: 0 12px 12px; padding: 10px 12px; display: grid; grid-template-columns: auto auto minmax(120px, 1fr) auto; gap: 10px; align-items: center; }
    .timeline { display: grid; gap: 3px; }
    .timeline input { width: 100%; accent-color: var(--good); }
    .time-labels { display: flex; justify-content: space-between; color: var(--muted); font: 10px ui-monospace, monospace; }
    .privacy { color: var(--muted); font-size: 10px; text-align: right; }
    .auth-gate { position: fixed; inset: 0; z-index: 10; display: grid; place-items: center; background: rgba(2, 8, 13, .86); backdrop-filter: blur(12px); }
    /* Author CSS overrides the user-agent [hidden] rule; keep the gate truly hidden after auth. */
    .auth-gate[hidden] { display: none; }
    .auth-card { width: min(360px, calc(100vw - 36px)); padding: 24px; border: 1px solid rgba(130, 205, 223, .25); border-radius: 18px; background: rgba(7, 19, 27, .96); box-shadow: 0 24px 80px rgba(0,0,0,.45); }
    .auth-card h2 { margin: 0 0 8px; font-size: 18px; }
    .auth-card p { margin: 0 0 16px; color: var(--muted); font-size: 12px; line-height: 1.5; }
    .auth-card form { display: grid; gap: 10px; }
    .auth-card input { width: 100%; box-sizing: border-box; padding: 10px 12px; border: 1px solid rgba(130,205,223,.25); border-radius: 10px; background: #061118; color: var(--text); font: 12px ui-monospace, monospace; }
    .auth-card button { justify-self: end; }
    .auth-error { min-height: 16px; color: var(--bad); font-size: 11px; }
    @media (max-width: 850px) {
      main { grid-template-columns: 1fr; }
      aside { max-height: 280px; }
      footer { grid-template-columns: auto auto 1fr; }
      .privacy { display: none; }
    }

    /* ── Workbench shell ─────────────────────────────────────────────── */
    :root {
      --bg: #080d12;
      --bg-raised: #0d151c;
      --panel: rgba(15, 25, 33, .92);
      --panel-solid: #101b23;
      --panel-soft: rgba(9, 18, 24, .72);
      --line: rgba(173, 208, 220, .13);
      --line-strong: rgba(173, 208, 220, .25);
      --text: #f1f7f8;
      --muted: #8ca2ac;
      --dim: #5e737d;
      --good: #64e0b2;
      --warn: #f0bd69;
      --bad: #f27882;
      --accent: #63d7d0;
      --accent-strong: #3ebbb5;
      --shadow: 0 22px 60px rgba(0, 0, 0, .25);
    }
    body { background: radial-gradient(ellipse at 75% -15%, rgba(71, 181, 177, .12), transparent 44%), radial-gradient(ellipse at -10% 100%, rgba(73, 112, 207, .11), transparent 38%), var(--bg); }
    button, select, input { -webkit-tap-highlight-color: transparent; }
    button:focus-visible, select:focus-visible, input:focus-visible, a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    .app { display: grid; grid-template-rows: 70px minmax(0, 1fr); min-height: 100vh; }
    .topbar { min-height: 70px; padding: 0 26px; border-bottom: 1px solid var(--line); background: rgba(7, 14, 19, .8); }
    .brand-lockup, .topbar-actions { display: flex; align-items: center; gap: 12px; }
    .brand-mark { width: 27px; height: 27px; display: grid; grid-template-columns: repeat(3, 1fr); align-items: end; gap: 3px; padding: 4px; border-radius: 8px; background: linear-gradient(145deg, rgba(99, 215, 208, .25), rgba(80, 119, 213, .18)); border: 1px solid rgba(99, 215, 208, .25); }
    .brand-mark span { border-radius: 2px; background: var(--accent); box-shadow: 0 0 9px rgba(99, 215, 208, .45); }
    .brand-mark span:nth-child(1) { height: 42%; opacity: .55; } .brand-mark span:nth-child(2) { height: 72%; opacity: .8; } .brand-mark span:nth-child(3) { height: 100%; }
    h1 { font-size: 14px; letter-spacing: .08em; text-transform: uppercase; } h1 span { color: var(--accent); }
    .sub { color: var(--muted); font-size: 11px; margin-top: 4px; max-width: 56vw; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .icon-button { width: 34px; height: 34px; display: grid; place-items: center; padding: 0; border-radius: 9px; background: transparent; border: 1px solid var(--line); color: var(--muted); }
    .mobile-menu { display: none; }
    .app-shell { min-height: 0; display: grid; grid-template-columns: 190px minmax(0, 1fr); }
    .sidebar { display: flex; flex-direction: column; gap: 5px; padding: 24px 13px 15px; border-right: 1px solid var(--line); background: rgba(7, 14, 19, .46); }
    .workspace-label { padding: 0 12px 10px; color: var(--dim); font-size: 9px; letter-spacing: .16em; font-weight: 700; }
    .nav-item { display: grid; grid-template-columns: 24px minmax(0, 1fr) auto; align-items: center; gap: 8px; width: 100%; padding: 10px 11px; border: 1px solid transparent; border-radius: 10px; background: transparent; color: var(--muted); text-align: left; transition: .18s ease; }
    .nav-item:hover { border-color: var(--line); background: rgba(99, 215, 208, .06); color: var(--text); }
    .nav-item.active { color: var(--text); background: linear-gradient(90deg, rgba(99, 215, 208, .14), rgba(99, 215, 208, .04)); border-color: rgba(99, 215, 208, .2); box-shadow: inset 2px 0 var(--accent); }
    .nav-item .nav-icon { color: var(--accent); font-size: 15px; line-height: 1; text-align: center; }
    .nav-item small { color: var(--dim); font-size: 9px; } .nav-item.active small { color: var(--muted); }
    .sidebar-foot { display: flex; align-items: center; gap: 7px; margin-top: auto; padding: 13px 10px 0; color: var(--dim); border-top: 1px solid var(--line); font-size: 9px; }
    .privacy-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--good); box-shadow: 0 0 8px var(--good); }
    .workspace { min-width: 0; min-height: 0; overflow: auto; display: block; padding: 0; background: transparent; }
    .view { min-height: calc(100vh - 70px); padding: 28px clamp(18px, 3vw, 42px) 32px; animation: view-in .22s ease both; }
    .view[hidden] { display: none; } @keyframes view-in { from { opacity: .2; transform: translateY(5px); } to { opacity: 1; transform: none; } }
    .mobile-nav { display: none; }
    .view-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin: 2px 0 21px; }
    .view-heading h2 { margin: 5px 0 0; font-size: clamp(22px, 2.5vw, 31px); font-weight: 650; letter-spacing: -.025em; }
    .eyebrow, .card-kicker { color: var(--accent); font-size: 9px; letter-spacing: .15em; font-weight: 750; text-transform: uppercase; }
    .heading-meta { display: flex; align-items: center; gap: 12px; } .muted { color: var(--muted); font-size: 11px; }
    .pill, .status-chip { display: inline-flex; align-items: center; width: max-content; padding: 5px 8px; border: 1px solid rgba(99, 215, 208, .25); border-radius: 999px; color: var(--accent); background: rgba(99, 215, 208, .08); font: 700 9px ui-monospace, monospace; letter-spacing: .06em; }
    .warning-pill { color: var(--warn); background: rgba(240, 189, 105, .08); border-color: rgba(240, 189, 105, .25); }
    .overview-grid { min-height: 0; display: grid; grid-template-columns: minmax(0, 1fr) 330px; gap: 15px; }
    .map-panel { min-height: min(67vh, 730px); border-radius: 17px; border-color: var(--line-strong); background: #09131a; box-shadow: var(--shadow); }
    .map-panel canvas { min-height: min(67vh, 730px); }
    .map-panel::before { content: "实时地图"; position: absolute; right: 16px; bottom: 16px; z-index: 2; color: rgba(225, 243, 245, .34); font: 700 9px ui-monospace, monospace; letter-spacing: .14em; pointer-events: none; }
    .map-controls { position: absolute; right: 14px; top: 52px; z-index: 3; display: flex; flex-wrap: nowrap; justify-content: flex-end; align-items: center; gap: 5px; max-width: calc(100% - 28px); overflow-x: auto; scrollbar-width: none; }
    .map-controls::-webkit-scrollbar { display: none; }
    .map-tool { min-width: 36px; padding: 6px 8px; border-radius: 7px; color: var(--muted); background: rgba(5, 13, 18, .78); font: 700 9px ui-monospace, monospace; }
    .map-tool.active, .map-tool[aria-pressed="true"] { color: var(--accent); border-color: rgba(99, 215, 208, .45); background: rgba(99, 215, 208, .12); }
    .map-tool.selecting { color: #ffd84d; border-color: rgba(255, 216, 77, .6); background: rgba(255, 216, 77, .12); }
    .view-mode-switch { display: inline-flex; gap: 2px; padding: 2px; border: 1px solid var(--line); border-radius: 8px; background: rgba(4, 12, 17, .82); }
    .view-mode-switch .map-tool { min-width: 34px; padding: 4px 7px; border: 0; background: transparent; }
    .view-mode-switch .map-tool.active { color: #071215; background: var(--accent); box-shadow: 0 3px 12px rgba(99,215,208,.2); }
    .map-visuals { position: absolute; inset: 0; display: grid; grid-template-columns: minmax(0,1fr); min-width: 0; min-height: 0; overflow: hidden; background: #07131b; }
    .map-visuals canvas { width: 100%; height: 100%; min-width: 0; min-height: 0; }
    .map-visuals.mode-radar #overlay3d, .map-visuals.mode-overlay #map { display: none; }
    .map-visuals.mode-both { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 1px; background: rgba(173,208,220,.18); }
    /* 竖屏（手机 App 内嵌面板）：双视改成上下各一半 —— 上半 2D 雷达、下半 3D 透视。
       横屏/桌面仍是左右并排。 */
    @media (orientation: portrait) {
      .map-visuals.mode-both { grid-template-columns: minmax(0,1fr); grid-template-rows: repeat(2, minmax(0,1fr)); }
    }
    .map-visuals.mode-both canvas { background: #07131b; }
    .map-panel.view-overlay .map-warning { display: none !important; }
    canvas.selecting-self { cursor: crosshair; }
    .map-legend { position: absolute; right: 14px; bottom: 14px; z-index: 3; display: flex; gap: 10px; padding: 6px 8px; border: 1px solid var(--line); border-radius: 7px; background: rgba(3, 11, 16, .72); color: var(--muted); font-size: 9px; }
    .map-legend span { display: inline-flex; align-items: center; gap: 4px; } .legend-dot, .key-dot { width: 6px; height: 6px; display: inline-block; border-radius: 50%; } .legend-dot.self { background: #ffd84d; } .legend-dot.team { background: #4fa9ff; } .legend-dot.enemy { background: #ff4d5f; } .legend-dot.neutral { background: #a7b0ba; }
    .map-label[hidden], .map-legend[hidden] { display: none !important; }
    /* 实时算法延迟：现在 − 最新抓包时刻，就是端到端延迟（含算法处理耗时）。
       放在地图标签下方，小而不抢眼；没数据时隐藏，不干扰正常使用。 */
    #phoenixLatency { top: auto; margin-top: 34px; font-size: 10px; opacity: .75; }
    /* 告警没有文字时不要留一个空壳（客户版默认不显示"候选底图"这类开发信息） */
    .map-warning:empty { display: none !important; }
    .map-warning[hidden] { display: none !important; }
    /* 地名标注编辑器（?labels=1 时出现；正常使用不显示） */
    .label-editor { position: absolute; left: 14px; bottom: 14px; z-index: 5; width: min(330px, calc(100% - 28px)); padding: 10px 11px; border: 1px solid rgba(99, 215, 208, .35); border-radius: 11px; background: rgba(4, 12, 17, .94); color: var(--text); font-size: 10px; line-height: 1.5; backdrop-filter: blur(12px); }
    .label-editor[hidden] { display: none !important; }
    .label-editor-head { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; }
    .label-editor-head b { font-size: 11px; }
    .label-editor-head span { margin-left: auto; color: var(--muted); font: 700 9px ui-monospace, monospace; }
    .label-editor-head button { border: 0; background: transparent; color: var(--muted); font-size: 14px; cursor: pointer; }
    .label-editor-hint { margin: 0 0 7px; color: var(--muted); font-size: 9px; line-height: 1.5; }
    .label-editor-row { display: flex; gap: 6px; margin-bottom: 6px; }
    .label-editor-row input, .label-editor-row select { flex: 1 1 auto; min-width: 0; padding: 5px 7px; border: 1px solid var(--line); border-radius: 7px; background: rgba(2, 9, 13, .85); color: var(--text); font: 600 10px ui-monospace, monospace; }
    .label-editor-row button { flex: 1 1 auto; padding: 5px 7px; border: 1px solid rgba(99, 215, 208, .35); border-radius: 7px; background: rgba(99, 215, 208, .1); color: var(--accent); font: 700 9px ui-monospace, monospace; cursor: pointer; }
    .label-editor-list { display: grid; gap: 3px; max-height: 134px; overflow: auto; }
    .label-editor-item { display: flex; align-items: center; gap: 6px; padding: 3px 5px; border-radius: 6px; background: rgba(255,255,255,.035); font: 600 9px ui-monospace, monospace; }
    .label-editor-item span { flex: 1 1 auto; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .label-editor-item button { border: 0; background: transparent; color: var(--muted); cursor: pointer; font-size: 11px; }
    .map-panel.label-editing canvas { cursor: crosshair; }
    .overview-rail { min-height: 0; max-height: min(67vh, 730px); overflow: auto; padding: 0; border: 0; background: transparent; box-shadow: none; }
    .rail-card, .card { border: 1px solid var(--line); border-radius: 13px; background: linear-gradient(145deg, rgba(17, 31, 40, .92), rgba(11, 21, 28, .88)); box-shadow: 0 12px 36px rgba(0,0,0,.12); }
    .session-card { margin-bottom: 17px; padding: 13px 14px; } .health-line { display: flex; align-items: center; gap: 8px; margin-top: 8px; } .health-line strong { font: 600 13px ui-monospace, monospace; }
    .health-pulse { width: 8px; height: 8px; border-radius: 50%; background: var(--warn); box-shadow: 0 0 0 4px rgba(240, 189, 105, .09), 0 0 12px var(--warn); } .health-pulse.good { background: var(--good); box-shadow: 0 0 0 4px rgba(100,224,178,.09),0 0 12px var(--good); } .health-pulse.bad { background: var(--bad); box-shadow: 0 0 0 4px rgba(242,120,130,.09),0 0 12px var(--bad); }
    .session-card p { margin: 7px 0 0; color: var(--muted); font-size: 10px; line-height: 1.45; }
    .display-settings-card { margin-bottom: 17px; padding: 14px; }
    .display-settings-card.collapsed { display: none !important; }
    .display-settings-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 10px; }
    .display-settings-head strong { display: block; margin-top: 5px; font-size: 13px; }
    .display-settings-close { width: 28px; height: 28px; padding: 0; border-radius: 8px; color: var(--muted); background: transparent; font-size: 18px; line-height: 1; }
    .display-options { display: grid; gap: 5px; }
    .display-option { display: flex; align-items: center; justify-content: space-between; gap: 10px; min-height: 44px; padding: 7px 8px; border: 1px solid transparent; border-radius: 9px; cursor: pointer; transition: border-color .18s, background .18s; }
    .display-option:hover { border-color: var(--line); background: rgba(99, 215, 208, .035); }
    .display-option span { min-width: 0; }
    .display-option b { display: block; font-size: 10px; font-weight: 650; }
    .display-option small { display: block; margin-top: 3px; color: var(--dim); font-size: 8px; line-height: 1.35; }
    .display-option input { appearance: none; position: relative; flex: 0 0 auto; width: 32px; height: 18px; margin: 0; border: 1px solid var(--line-strong); border-radius: 999px; background: #101d25; cursor: pointer; transition: .18s ease; }
    .display-option input::after { content: ""; position: absolute; left: 2px; top: 2px; width: 12px; height: 12px; border-radius: 50%; background: var(--muted); transition: .18s ease; }
    .display-option input:checked { border-color: rgba(99, 215, 208, .58); background: rgba(99, 215, 208, .2); }
    .display-option input:checked::after { transform: translateX(14px); background: var(--accent); box-shadow: 0 0 8px rgba(99, 215, 208, .5); }
    .display-option input:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    .display-reset { width: 100%; margin-top: 10px; padding: 7px 9px; color: var(--muted); background: transparent; font-size: 9px; }
    .diagnostic-runtime { display: none !important; }
    .section-title { display: flex; align-items: center; justify-content: space-between; margin: 18px 2px 8px; color: var(--muted); font-size: 9px; letter-spacing: .13em; }
    .operations { gap: 5px; margin-bottom: 0; } .operation { min-height: 39px; padding: 7px 8px; border-radius: 9px; background: rgba(8, 17, 23, .52); } .operation-name { font-size: 10px; } .operation-detail { font-size: 9px; } .operation-state { font-size: 8px; }
    .metrics { gap: 5px; margin: 9px 0 0; } .metric { padding: 8px; border-radius: 8px; background: rgba(8, 17, 23, .45); } .metric b { font-size: 14px; } .metric span { font-size: 9px; }
    .players-heading { margin-top: 19px; } .players { gap: 5px; } .player { padding: 8px; border-radius: 8px; border-color: var(--line); } .player-name { font-size: 11px; } .player-detail { font-size: 9px; }
    .empty-state { display: grid; place-items: center; min-height: 130px; color: var(--dim); border: 1px dashed var(--line); border-radius: 10px; font-size: 11px; } .empty-state.compact { min-height: 70px; }
    .timeline-bar { margin: 15px 0 0; padding: 11px 13px; display: grid; grid-template-columns: auto auto minmax(130px, 1fr) auto; gap: 9px; align-items: center; border: 1px solid var(--line); border-radius: 12px; background: rgba(14, 26, 34, .84); box-shadow: 0 10px 30px rgba(0,0,0,.1); } .timeline-bar .privacy { display: none; }
    button, select { border-radius: 8px; border-color: var(--line-strong); background: #13252f; } button { transition: border-color .18s, background .18s, transform .18s; } button:active { transform: translateY(1px); } button:hover { border-color: rgba(99, 215, 208, .55); }
    button.primary { color: #071215; background: var(--accent); border-color: var(--accent); font-weight: 700; } button.primary:hover { background: #83e6df; } button.ghost { background: transparent; color: var(--muted); } button.danger-text { color: var(--bad); }
    .content-grid { display: grid; gap: 15px; } .content-grid.two-col { grid-template-columns: repeat(2, minmax(0, 1fr)); } .card { padding: 20px; } .feature-card { min-height: 230px; } .card-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 15px; } .card h3 { margin: 7px 0 0; font-size: 17px; letter-spacing: -.015em; } .card-copy { margin: 14px 0; color: var(--muted); font-size: 12px; line-height: 1.6; } .inline-meta { display: flex; flex-wrap: wrap; gap: 5px; margin: 13px 0 20px; } .inline-meta span { padding: 4px 6px; border-radius: 5px; color: var(--dim); background: rgba(126,170,180,.08); font: 9px ui-monospace, monospace; }
    .profile-actions, .result-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 7px; } .proxy-meta { min-height: 16px; margin: -8px 0 14px; color: var(--dim); font: 10px ui-monospace, monospace; overflow-wrap: anywhere; } .proxy-pipeline-grid { display: grid; grid-template-columns: repeat(6,minmax(0,1fr)); gap: 6px; margin: 0 0 14px; } .proxy-pipeline-metric { padding: 7px; border: 1px solid var(--line); border-radius: 7px; background: rgba(7,16,22,.42); } .proxy-pipeline-metric small { display: block; color: var(--dim); font: 8px ui-monospace,monospace; text-transform: uppercase; } .proxy-pipeline-metric b { display: block; margin-top: 3px; font: 11px ui-monospace,monospace; } .profile-result { margin-top: 17px; padding: 12px; border: 1px solid rgba(100,224,178,.22); border-radius: 9px; background: rgba(100,224,178,.05); } .result-head { display: flex; justify-content: space-between; gap: 10px; margin-bottom: 6px; font-size: 11px; } .profile-id { margin-bottom: 10px; color: var(--muted); font: 10px ui-monospace, monospace; }
    .profile-artifacts { display: grid; gap: 9px; margin: 11px 0; } .artifact-row { display: grid; grid-template-columns: minmax(100px, .45fr) minmax(0, 1fr); gap: 9px; align-items: center; padding: 9px; border: 1px solid var(--line); border-radius: 8px; background: rgba(5,14,20,.36); } .artifact-copy strong { display: block; font-size: 10px; } .artifact-copy small { display: block; margin-top: 3px; color: var(--muted); font-size: 8px; line-height: 1.4; } .artifact-row .result-actions { justify-content: flex-end; }
    .saved-profiles { margin-top: 15px; padding-top: 14px; border-top: 1px solid var(--line); } .saved-profiles-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 8px; } .saved-profiles-head strong { font-size: 10px; } .saved-profiles-head span { color: var(--muted); font-size: 8px; } .saved-profile-list { display: grid; gap: 7px; } .saved-profile { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 9px; align-items: center; padding: 9px; border: 1px solid var(--line); border-radius: 8px; background: rgba(5,14,20,.32); } .saved-profile-main { min-width: 0; } .saved-profile-title { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; font: 10px ui-monospace, monospace; overflow-wrap: anywhere; } .saved-profile-title .status-chip { padding: 3px 6px; font-size: 7px; } .saved-profile-meta { margin-top: 4px; color: var(--muted); font: 8px ui-monospace, monospace; line-height: 1.45; } .saved-profile-actions { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 5px; } .saved-profile-actions button { padding: 6px 8px; font-size: 9px; } .profile-empty { padding: 10px; color: var(--dim); border: 1px dashed var(--line); border-radius: 8px; font-size: 9px; text-align: center; }
    .button-link { display: inline-flex; align-items: center; justify-content: center; min-height: 32px; padding: 7px 10px; border: 1px solid var(--line-strong); border-radius: 8px; color: var(--text); background: rgba(20, 39, 48, .9); font-size: 10px; text-decoration: none; cursor: pointer; } .button-link:hover { border-color: var(--accent); color: var(--accent); }
    .status-list { display: grid; gap: 12px; margin-top: 21px; } .status-row { display: grid; grid-template-columns: 14px minmax(0,1fr) auto; align-items: center; gap: 8px; } .status-row strong { display: block; font-size: 11px; } .status-row small { display: block; margin-top: 3px; color: var(--muted); font-size: 9px; line-height: 1.35; } .status-row b { color: var(--muted); font: 9px ui-monospace, monospace; text-transform: uppercase; } .status-icon { color: var(--warn); font-size: 10px; } .status-icon.good { color: var(--good); } .status-icon.bad { color: var(--bad); }
    .notice { display: flex; gap: 8px; align-items: flex-start; margin-top: 20px; padding: 10px; border: 1px solid rgba(99,215,208,.17); border-radius: 8px; color: var(--muted); background: rgba(99,215,208,.05); font-size: 10px; line-height: 1.5; } .notice.subtle { border-color: var(--line); background: rgba(7, 16, 22, .36); }
    .operations-card { margin-top: 15px; } .expanded-operations { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); margin-top: 16px; } .expanded-operations .operation { min-height: 55px; }
    .segmented { display: inline-flex; padding: 3px; border: 1px solid var(--line); border-radius: 9px; background: rgba(5, 12, 17, .42); } .segment { min-width: 66px; padding: 6px 10px; border: 0; border-radius: 6px; background: transparent; color: var(--muted); font: 600 10px ui-monospace, monospace; } .segment.active { color: #071215; background: var(--accent); }
    .map-selection-card { margin-bottom: 15px; } .map-select-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-top: 15px; color: var(--muted); font-size: 11px; } .map-select-row select { min-width: 220px; } .map-select-row select:disabled { opacity: .45; } .map-grid { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 11px; } .map-card { overflow: hidden; padding: 0; border: 1px solid var(--line); border-radius: 11px; background: rgba(11, 21, 28, .88); transition: border-color .18s, transform .18s; } .map-card:hover { transform: translateY(-2px); border-color: rgba(99,215,208,.4); } .map-card.selected { border-color: var(--accent); box-shadow: 0 0 0 1px rgba(99,215,208,.2); } .map-thumb { display: block; width: 100%; aspect-ratio: 1.5; object-fit: cover; background: #0a151c; } .map-card-body { padding: 10px; } .map-card-title { display: flex; justify-content: space-between; gap: 5px; font-size: 11px; } .map-card-title span:last-child { color: var(--warn); font: 8px ui-monospace, monospace; text-transform: uppercase; } .map-card-meta { margin-top: 6px; color: var(--muted); font: 9px ui-monospace, monospace; line-height: 1.5; }
    .loading-skeleton { min-height: 165px; border-radius: 11px; background: linear-gradient(100deg, rgba(18,32,41,.7) 20%, rgba(30,48,56,.8) 40%, rgba(18,32,41,.7) 60%); background-size: 200% 100%; animation: shimmer 1.6s infinite; } @keyframes shimmer { to { background-position: -200% 0; } }
    .replay-card { padding: clamp(20px, 4vw, 38px); } .replay-hero { display: flex; align-items: center; gap: 17px; } .replay-icon { display: grid; place-items: center; width: 54px; height: 54px; border-radius: 15px; color: var(--accent); background: rgba(99,215,208,.1); border: 1px solid rgba(99,215,208,.22); font-size: 27px; } .replay-hero h3 { margin: 0; font-size: 20px; } .replay-hero p { margin: 6px 0 0; color: var(--muted); font-size: 11px; } .replay-controls { display: flex; gap: 8px; margin-top: 28px; } .replay-timeline { margin-top: 21px; } .replay-state { display: flex; align-items: center; gap: 7px; margin-top: 16px; font-size: 11px; } .status-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--good); box-shadow: 0 0 8px var(--good); } .replay-state .muted { margin-left: auto; font-family: ui-monospace, monospace; } .continuity-key { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 17px; color: var(--muted); font-size: 10px; } .continuity-key span { display: inline-flex; align-items: center; gap: 5px; } .key-dot.good { background: var(--good); } .key-dot.warn { background: var(--warn); } .key-dot.bad { background: var(--bad); } .big-stat { margin-top: 22px; color: var(--accent); font: 600 35px ui-monospace, monospace; }
    .certificate-card { min-height: 320px; } .facts { display: grid; gap: 9px; margin: 21px 0; } .facts div { display: flex; justify-content: space-between; gap: 14px; padding-bottom: 8px; border-bottom: 1px solid var(--line); } .facts dt { color: var(--muted); font-size: 10px; } .facts dd { margin: 0; color: var(--text); font-size: 10px; text-align: right; } .mono { font-family: ui-monospace, monospace; } .download-grid { display: flex; flex-wrap: wrap; gap: 7px; } .steps { display: grid; gap: 17px; padding: 0; margin: 21px 0; list-style: none; } .steps li { display: grid; grid-template-columns: 29px 1fr; gap: 8px; align-items: start; } .steps li > span { color: var(--accent); font: 700 10px ui-monospace, monospace; } .steps p { margin: 0; color: var(--muted); font-size: 11px; line-height: 1.55; } .steps b { color: var(--text); font-weight: 600; } .privacy-card { margin-top: 15px; } .privacy-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 12px; margin-top: 17px; } .privacy-grid div { display: grid; gap: 5px; padding: 12px; border: 1px solid var(--line); border-radius: 9px; background: rgba(7,16,22,.35); } .privacy-grid strong { font-size: 10px; } .privacy-grid span { color: var(--muted); font-size: 9px; line-height: 1.45; }
    .toast-stack { position: fixed; right: 18px; bottom: 18px; z-index: 30; display: grid; gap: 8px; width: min(330px, calc(100vw - 36px)); pointer-events: none; } .toast { padding: 11px 13px; border: 1px solid var(--line-strong); border-radius: 10px; color: var(--text); background: rgba(14, 27, 35, .96); box-shadow: var(--shadow); font-size: 11px; animation: toast-in .2s ease both; } .toast.good { border-color: rgba(100,224,178,.45); } .toast.bad { border-color: rgba(242,120,130,.5); } @keyframes toast-in { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: none; } }
    @media (max-width: 1100px) { .overview-grid { grid-template-columns: minmax(0,1fr) 290px; } .map-grid { grid-template-columns: repeat(3,minmax(0,1fr)); } .expanded-operations { grid-template-columns: repeat(2,minmax(0,1fr)); } }
    @media (max-width: 820px) { .app { grid-template-rows: 62px minmax(0,1fr); } .topbar { min-height: 62px; padding: 0 15px; } .mobile-menu { display: grid; } .app-shell { display: block; } .sidebar { position: fixed; inset: 62px auto 58px 0; z-index: 20; width: 224px; transform: translateX(-102%); transition: transform .2s ease; box-shadow: 20px 0 50px rgba(0,0,0,.32); } .sidebar.open { transform: none; } .workspace { min-height: calc(100vh - 62px); } .view { min-height: calc(100vh - 62px); padding: 20px 14px 148px; } .overview-grid { display: block; } .map-panel { min-height: 56vh; } .map-panel canvas { min-height: 56vh; } .overview-rail { max-height: none; margin-top: 13px; overflow: visible; } .timeline-bar { position: fixed; left: 10px; right: 10px; bottom: 66px; z-index: 12; grid-template-columns: auto auto minmax(80px,1fr) auto; margin: 0; padding: 8px; } .timeline-bar .ghost { padding: 7px 8px; font-size: 10px; } .mobile-nav { position: fixed; left: 0; right: 0; bottom: 0; z-index: 18; display: grid; grid-template-columns: repeat(5, 1fr); gap: 3px; padding: 6px max(8px, env(safe-area-inset-left)) max(6px, env(safe-area-inset-bottom)); border-top: 1px solid var(--line); background: rgba(7, 14, 19, .94); backdrop-filter: blur(18px); } .mobile-nav .nav-item { display: grid; grid-template-columns: 1fr; justify-items: center; gap: 2px; padding: 5px 2px; border: 0; border-radius: 7px; text-align: center; font-size: 9px; } .mobile-nav .nav-item .nav-icon { font-size: 14px; } .mobile-nav .nav-item small { font-size: 8px; } .content-grid.two-col { grid-template-columns: 1fr; } .map-grid { grid-template-columns: repeat(2,minmax(0,1fr)); } .privacy-grid { grid-template-columns: 1fr; } .view-heading h2 { font-size: 24px; } }
    @media (max-width: 480px) { .sub { max-width: 50vw; } .heading-meta .muted { display: none; } .map-legend { left: 14px; right: auto; } .map-warning { max-width: calc(100% - 28px); left: 14px; right: 14px; top: 14px; } .map-warning.blocking { left: 50%; right: auto; max-width: calc(100% - 36px); } .map-grid { grid-template-columns: 1fr 1fr; gap: 7px; } .map-card-body { padding: 8px; } .map-card-meta { font-size: 8px; } .expanded-operations { grid-template-columns: 1fr; } .replay-controls { flex-wrap: wrap; } .download-grid .button-link { flex: 1 1 calc(50% - 7px); } .artifact-row, .saved-profile { grid-template-columns: 1fr; } .artifact-row .result-actions, .saved-profile-actions { justify-content: flex-start; } .proxy-pipeline-grid { grid-template-columns: repeat(3,minmax(0,1fr)); } }

    /* Public customer rooms open in a deliberately minimal radar view. */
    .simple-summary { display: none; align-items: center; gap: 7px; }
    .simple-chip[hidden] { display: none !important; }
    .simple-chip { display: inline-flex; align-items: center; min-height: 28px; padding: 5px 9px; border: 1px solid var(--line); border-radius: 999px; color: var(--muted); background: rgba(7, 17, 23, .62); font-size: 10px; white-space: nowrap; }
    html.simple-panel, html.simple-panel body { height: 100%; overflow: hidden; }
    .simple-panel .app { height: 100vh; grid-template-rows: 58px minmax(0, 1fr); }
    .simple-panel .topbar { min-height: 58px; padding: 0 18px; background: rgba(5, 13, 18, .92); }
    .simple-panel .brand-lockup { gap: 9px; }
    .simple-panel .brand-mark { width: 25px; height: 25px; }
    .simple-panel .brand-lockup h1 { font-size: 13px; text-transform: none; letter-spacing: .06em; }
    .simple-panel .brand-lockup .sub, .simple-panel .mobile-menu { display: none; }
    .simple-panel .simple-summary { display: flex; }
    .simple-panel .app-shell { display: block; min-height: 0; }
    .simple-panel .sidebar, .simple-panel .mobile-nav { display: none !important; }
    .simple-panel .workspace { height: calc(100vh - 58px); min-height: 0; overflow: hidden; }
    .simple-panel .view:not(#overviewView) { display: none !important; }
    .simple-panel #overviewView { display: block !important; min-height: 0; height: 100%; padding: 0; animation: none; }
    .simple-panel #overviewView > .view-heading,
    .simple-panel .timeline-bar,
    .simple-panel .map-provenance { display: none !important; }
    .simple-panel .overview-grid { display: block; width: 100%; height: 100%; }
    .simple-panel .overview-rail { display: contents !important; }
    .simple-panel .overview-rail > *:not(.display-settings-card):not(.roster-card) { display: none !important; }
    .simple-panel .display-settings-card { display: none; position: fixed; right: 16px; top: 104px; z-index: 8; width: min(270px, calc(100vw - 32px)); max-height: calc(100vh - 122px); margin: 0; overflow: auto; background: rgba(10, 21, 28, .96); box-shadow: 0 24px 70px rgba(0,0,0,.45); backdrop-filter: blur(18px); }
    .simple-panel .display-settings-card.open { display: block !important; }
    .simple-panel .map-panel { width: 100%; height: 100%; min-height: 0; border: 0; border-radius: 0; box-shadow: none; }
    .simple-panel .map-panel::before { display: none; }
    .simple-panel .map-panel canvas { width: 100%; height: 100%; min-height: 0; }
    .simple-panel .map-label { left: 16px; top: 14px; }
    .simple-panel .map-controls { top: 14px; right: 16px; }
    .simple-panel .map-tool { min-width: 42px; padding: 7px 9px; }
    .simple-panel .map-warning { top: 58px; right: 16px; max-width: min(390px, calc(100% - 32px)); }
    .simple-panel .map-warning.blocking { top: 50%; right: auto; }
    .simple-panel .toast-stack { bottom: 18px; }
    @media (max-width: 640px) {
      .simple-panel .app { grid-template-rows: 54px minmax(0, 1fr); }
      .simple-panel .topbar { min-height: 54px; padding: 0 11px; gap: 8px; }
      .simple-panel .workspace { height: calc(100vh - 54px); }
      .simple-panel .brand-mark { display: none; }
      .simple-panel .topbar-actions { gap: 7px; }
      .simple-panel .simple-chip { min-height: 26px; padding: 4px 7px; font-size: 9px; }
      .simple-panel #simpleMapName { display: none; }
      .simple-panel .status { font-size: 10px; gap: 5px; }
      .simple-panel .map-label { left: 10px; top: 10px; }
      .simple-panel .map-controls { top: 10px; right: 10px; }
      .simple-panel .map-tool { min-width: 38px; padding: 6px 7px; font-size: 9px; }
      .simple-panel .display-settings-card { left: 10px; right: 10px; top: 98px; width: auto; max-height: calc(100vh - 112px); }
      .simple-panel .map-warning { top: 50px; left: 10px; right: 10px; max-width: none; }
      .simple-panel .map-warning.blocking { left: 50%; right: auto; top: 50%; width: calc(100% - 32px); max-width: 390px; }
    }
    /* 手机竖屏：按钮不许压住地图名 —— 地图名独占一行，按钮挪到第二行。 */
    @media (orientation: portrait) and (max-width: 640px) {
      .simple-panel .map-label { top: 8px; left: 10px; font-size: 10px; padding: 5px 8px; }
      /* 按钮排成一行可横向滑动：不再占两三行、也不压住地图名和 2D 画面 */
      .simple-panel .map-controls { top: 44px; right: 10px; left: 10px; justify-content: flex-end; gap: 4px; max-width: none;
        flex-wrap: nowrap; overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
      .simple-panel .map-controls::-webkit-scrollbar { display: none; }
      .simple-panel .map-tool { min-width: 32px; padding: 5px 6px; font-size: 9px; }
      .simple-panel .map-warning { top: 80px; }
    }

    /* ===== 手机（App 内嵌 WebView 整屏）2026-10-04：② 手机端排版 =====
       ① 吃 safe-area：刘海/灵动岛 + Home 条都不许压住内容；
       ② 顶栏压成一行、工具条一行可滑（上面已有），不再占两三行；
       ③ 手机上不显示"候选底图…"这类开发提示（客户看的是雷达，不是我们的构建状态）；
       ④ 竖屏双视 2D : 3D = 62% : 38%（3D 只是辅助看高低差，不该跟 2D 平分）；
          横屏反过来 55% : 45%。 */
    @media (max-width: 640px) {
      .simple-panel .app {
        grid-template-rows: auto minmax(0, 1fr);
        padding-top: env(safe-area-inset-top, 0px);
        padding-bottom: env(safe-area-inset-bottom, 0px);
      }
      .simple-panel .topbar {
        min-height: 0;
        padding-top: 6px;
        padding-bottom: 6px;
        padding-left: max(10px, env(safe-area-inset-left, 0px));
        padding-right: max(10px, env(safe-area-inset-right, 0px));
        gap: 6px;
      }
      /* 手机顶栏别再放品牌字：宽度不够，会和工具条打架，而且客户看的是雷达不是 logo。
         （品牌字只在桌面/平板显示） */
      .simple-panel .brand-lockup h1,
      .simple-panel .brand-lockup .sub,
      .simple-panel .heading-meta { display: none !important; }
      .simple-panel .topbar .brand-lockup { gap: 0; }
      /* 工具条按钮按手指点：文字仍小，但热区加高 */
      .simple-panel .map-tool { min-height: 30px; }
      /* 工具条是横向滚动条：右侧留一点空隙，最后一个按钮别贴着屏幕边缘被切掉 */
      .simple-panel .map-controls { padding-right: 6px; scroll-padding-right: 10px; }
      /* 空状态卡片在手机上收窄，别把地图区全占了 */
      .simple-panel .map-empty-card { width: calc(100% - 26px); padding: 15px 16px 13px; border-radius: 15px; }
      .simple-panel .map-empty-card b { font-size: 15px; }
      .simple-panel .map-empty-card p,
      .simple-panel .map-empty-steps,
      .simple-panel .map-empty-foot { font-size: 11px; line-height: 1.55; }
      /* 手机上"减少多余显示"：空状态只留标题 + 一句人话，
         三步操作步骤和页脚（颜色说明）在桌面看就够了。 */
      .simple-panel .map-empty-steps,
      .simple-panel .map-empty-foot { display: none !important; }
      .simple-panel .map-empty-card p { margin: 6px 0 0; }
      .simple-panel .workspace { height: auto; min-height: 0; }
      /* 开发提示在手机上不上屏 */
      .simple-panel .map-warning:not(.blocking) { display: none !important; }
      /* 时间轴/底部控件躲开 Home 条 */
      .simple-panel .timeline-bar { bottom: calc(8px + env(safe-area-inset-bottom, 0px)); }
      .simple-panel .toast-stack { bottom: calc(18px + env(safe-area-inset-bottom, 0px)); }
    }
    @media (orientation: portrait) and (max-width: 640px) {
      .map-visuals.mode-both { grid-template-rows: 62% 38%; }
    }
    @media (orientation: landscape) and (max-height: 520px) {
      .map-visuals.mode-both { grid-template-rows: minmax(0, 1fr); grid-template-columns: 55% 45%; }
    }

    /* ===== 手机竖屏「地图优先」硬保证（2026-10-05 修「地图不见了」）=====
       现象：客户在手机上看到整屏都是「人物」列表，地图没了。
       根因：右栏那块「人物」列表（.players-heading / .players）在手机上没有被隐藏，
             只要地图面板的高度链有一次没撑起来（视口变化/滚动回弹/换方向），
             列表就顶到地图的位置上 —— 而手机上根本不需要这个列表（人物已经画在地图上，
             要筛选用顶栏「列表」那张卡）。
       所以这里不管当前是"精简外壳"还是"完整面板"，只要屏幕够窄就强制：
         ① 人物列表不参与布局；② 地图占满可视区；③ 概览区不允许纵向滚动。 */
    @media (max-width: 820px) {
      .players-heading, .players { display: none !important; }
      /* 下面三条只对「精简外壳」成立 —— 只有它才有确定的高度链
         （.workspace height:calc(100vh-54px) → #overviewView 100% → .map-panel 100%）。
         完整面板模式在窄屏没有任何规则给 .map-panel 高度，被 min-height:0 !important
         清零后，画布（absolute inset:0）就塌成 0 高 —— 这就是「竖屏看不到地图」。
         去掉无前缀的 !important，让上面那条 .map-panel{min-height:56vh} 重新生效。
         2026-10-06 修。 */
      .simple-panel .map-panel { height: 100%; min-height: 0 !important; }
      .simple-panel .map-panel canvas { min-height: 0 !important; }
      .simple-panel #overviewView { overflow: hidden !important; }
    }

  /* ================= 视觉皮肤 v2（对标同类产品：深蓝底 + 浅蓝描边 + 微光） ================= */
  :root {
    --bg: #070c16; --bg-raised: #0b1322; --panel: rgba(11, 20, 34, .93); --panel-solid: #0c1526;
    --panel-soft: rgba(9, 17, 30, .74); --line: rgba(120, 178, 232, .17); --line-strong: rgba(120, 178, 232, .32);
    --text: #e9f2fb; --muted: #8ba4c0; --accent: #5cc8ff;
    --good: #5ce0b0; --warn: #f0c56a; --bad: #ff6b7d; --blue: #5cc8ff; --red: #ff6b7d;
  }
  body, .app { background: radial-gradient(1100px 700px at 50% -10%, #0d1a30 0%, #070c16 60%) !important; }
  .map-panel { background: #08111e !important; border-color: rgba(120,178,232,.22) !important; }
  .sidebar, .topbar { background: rgba(8, 14, 26, .94) !important; border-color: rgba(120,178,232,.14) !important; }
  .rail-card, .card { background: linear-gradient(150deg, rgba(13, 24, 42, .94), rgba(9, 16, 29, .9)) !important; border-color: rgba(120,178,232,.18) !important; }
  .map-label, .map-legend, .map-tool, .simple-chip, .pill { border-color: rgba(120,178,232,.22) !important; }
  .map-tool.active, .view-mode-switch .map-tool.active { color: #04121d !important; background: var(--accent) !important; }
  .nav-item.active { color: var(--accent) !important; }

  /* 右栏新增卡片：阵营筛选 / 标记大小 / 人物列表 */
  .roster-card { margin-bottom: 17px; padding: 13px 14px; }
  .roster-card h4 { margin: 0 0 9px; font-size: 12px; letter-spacing: .04em; color: var(--text); display: flex; align-items: center; justify-content: space-between; }
  .roster-card h4 small { color: var(--muted); font: 700 9px ui-monospace, monospace; }
  .filter-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 5px; margin-bottom: 11px; }
  .filter-chip { display: flex; align-items: center; justify-content: space-between; gap: 6px; padding: 6px 8px; border: 1px solid var(--line); border-radius: 8px; cursor: pointer; font-size: 10px; color: var(--muted); }
  .filter-chip input { accent-color: var(--accent); }
  .filter-chip.on { color: var(--text); border-color: rgba(120,178,232,.34); background: rgba(92,200,255,.08); }
  .scale-row { display: flex; align-items: center; gap: 8px; margin-bottom: 11px; }
  .scale-row span { font-size: 10px; color: var(--muted); white-space: nowrap; }
  .scale-row input[type=range] { flex: 1 1 auto; accent-color: var(--accent); }
  .roster-list { display: grid; gap: 4px; max-height: 210px; overflow: auto; }
  .roster-row { display: grid; grid-template-columns: 22px 1fr 46px 52px; align-items: center; gap: 6px; padding: 4px 5px; border-radius: 7px; background: rgba(120,178,232,.055); font-size: 10px; }
  .roster-row img { width: 22px; height: 22px; border-radius: 50%; object-fit: cover; background: rgba(6,12,22,.8); }
  .roster-row b { font-weight: 700; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .roster-row .hp { font: 700 9px ui-monospace, monospace; text-align: right; }
  .roster-row .dist { font: 700 9px ui-monospace, monospace; text-align: right; color: var(--muted); }
  .roster-row.dead { opacity: .5; }
  .roster-empty { padding: 10px 6px; text-align: center; color: var(--muted); font-size: 10px; }
  .simple-panel .roster-card { display: none; position: absolute; right: 12px; top: 92px; width: min(250px, 48vw);
    max-height: 56vh; overflow: auto; z-index: 6; margin: 0; backdrop-filter: blur(14px); }
  .simple-panel .roster-card.open { display: block !important; }
  .simple-panel .roster-card .roster-list { max-height: 34vh; }

    /* ===== 静态地图层：把旋转/缩放交给浏览器合成器（零 canvas 重绘）===== */
    /* 注意：不要覆盖 .map-visuals 的 position:absolute;inset:0（高度链靠它），只补行高语义 */
    .map-visuals { grid-auto-rows: minmax(0, 1fr); align-items: stretch; }
    .map-pane {
      position: relative; overflow: hidden; min-width: 0;
      /* 原布局是靠 .map-panel canvas 的 min-height 撑开 grid 行的；
         画布改成绝对定位后必须把同样的高度语义放到 pane 上，否则整块地图塌成 0 高 */
      min-height: min(67vh, 730px);
      background-color: #07131b;
      background-image:
        linear-gradient(rgba(143,165,175,.055) 1px, transparent 1px),
        linear-gradient(90deg, rgba(143,165,175,.055) 1px, transparent 1px);
      background-size: 48px 48px, 48px 48px;
      background-position: 24px 24px, 24px 24px;
    }
    .map-pane::after {
      content: ''; position: absolute; inset: 0; pointer-events: none; z-index: 3;
      background: radial-gradient(125% 90% at 50% 45%, transparent 52%, rgba(2,7,11,.58) 100%);
    }
    #mapPane2d > canvas#map { position: absolute; inset: 0; width: 100%; height: 100%; min-height: 0; z-index: 2; }
    .map-visuals.mode-overlay #mapPane2d { display: none; }

    /* ===== 空状态（还没对局数据时，别给客户一块纯黑）===== */
    .map-empty { position: absolute; inset: 0; z-index: 2; display: grid; place-items: center; pointer-events: none;
      background: radial-gradient(120% 90% at 50% 42%, rgba(24,52,74,.55), rgba(6,15,22,.92) 62%, #050c12 100%); }
    .map-empty[hidden] { display: none !important; }
    .map-empty-card { width: min(430px, calc(100% - 56px)); padding: 22px 24px 20px; border-radius: 18px; text-align: left;
      background: rgba(8,18,26,.72); border: 1px solid rgba(157,187,202,.22); box-shadow: 0 24px 60px rgba(0,0,0,.45);
      -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px); }
    .map-empty-pulse { width: 34px; height: 34px; border-radius: 50%; margin-bottom: 12px;
      background: radial-gradient(circle, rgba(120,200,255,.9) 0 28%, rgba(120,200,255,.18) 34%, transparent 62%);
      animation: empty-pulse 1.8s ease-in-out infinite; }
    @keyframes empty-pulse { 0%,100% { transform: scale(.9); opacity: .7 } 50% { transform: scale(1.08); opacity: 1 } }
    .map-empty-card b { display: block; font-size: 16px; letter-spacing: .01em; }
    .map-empty-card p { margin: 7px 0 14px; color: var(--muted); font-size: 12px; line-height: 1.6; }
    .map-empty-steps { margin: 0; padding: 0 0 0 18px; color: rgba(206,226,240,.86); font-size: 12px; line-height: 1.75; }
    .map-empty-steps li::marker { color: rgba(120,200,255,.75); }
    .map-empty-foot { margin-top: 14px; padding-top: 12px; border-top: 1px solid rgba(157,187,202,.16);
      color: var(--muted); font-size: 11px; }

    /* ===== ?perf=1 尺子（默认隐藏：author CSS 的 display 会盖掉 UA 的 [hidden]，这里补兜底）===== */
    .perf-hud[hidden] { display: none !important; }
    .perf-hud {
      position: fixed; right: 12px; top: 12px; z-index: 90; display: grid; grid-template-columns: repeat(2, auto);
      gap: 6px 16px; padding: 10px 12px; border-radius: 12px;
      background: rgba(6,14,20,.84); border: 1px solid rgba(157,187,202,.22);
      -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
      font: 600 10px/1.25 ui-monospace, Menlo, monospace; color: #cfe0e8; pointer-events: none;
    }
    .perf-hud b { color: #7ef0b0; font-size: 12px; margin-right: 4px; font-variant-numeric: tabular-nums; }
    .perf-hud span { color: #8fa5af; }
    /* 尺子打开时，右上角的提示条（候选底图 / 加载中）往下让位，别被尺子压住。
       注意排除 .blocking（居中的那块大提示），它有自己的定位。 */
    body.perf-on .map-warning:not(.blocking) { top: 196px; }
    @media (max-width: 480px) { body.perf-on .map-warning:not(.blocking) { top: 196px; } }

    /* ===== A 档视觉：去 HTML 感 ===== */
    body { font-family: -apple-system, "SF Pro Text", "PingFang SC", BlinkMacSystemFont, "Helvetica Neue", sans-serif; }
    .rail-card, .card, .map-controls, .display-settings-card {
      border-radius: 14px;
      background: linear-gradient(180deg, rgba(16,30,40,.72), rgba(9,19,26,.64));
      border: 1px solid rgba(157,187,202,.14);
      box-shadow: 0 1px 0 rgba(255,255,255,.045) inset, 0 10px 30px rgba(0,0,0,.34), 0 2px 6px rgba(0,0,0,.22);
      -webkit-backdrop-filter: blur(18px) saturate(1.12); backdrop-filter: blur(18px) saturate(1.12);
    }
    .map-controls { border-radius: 13px; padding: 5px 6px; }
    button, .segment, .map-tool, .display-option {
      transition: background-color 120ms cubic-bezier(.4,0,.2,1), color 120ms cubic-bezier(.4,0,.2,1),
                  border-color 120ms cubic-bezier(.4,0,.2,1), box-shadow 120ms cubic-bezier(.4,0,.2,1),
                  transform 120ms cubic-bezier(.4,0,.2,1);
    }
    button:active { transform: scale(.985); }
    .map-tool {
      border-radius: 9px; background: rgba(8,18,25,.55);
      border-color: rgba(157,187,202,.16); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
    }
    .map-tool.active, .map-tool[aria-pressed="true"] {
      box-shadow: 0 0 0 1px rgba(99,215,208,.22), 0 3px 12px rgba(99,215,208,.14);
    }
    .view-mode-switch { border-radius: 11px; }
    .segmented { border-radius: 11px; }
    .metric b, .perf-hud b, #latency, #captureLatency, #serverLatency, .roster-row .dist, .scale-row span:last-child {
      font-variant-numeric: tabular-nums; font-feature-settings: "tnum" 1;
    }
    .rail::-webkit-scrollbar, .roster-list::-webkit-scrollbar, .display-options::-webkit-scrollbar { width: 0; height: 0; }
    .rail { scrollbar-width: none; }
    input[type="range"] { -webkit-appearance: none; appearance: none; height: 18px; background: transparent; }
    input[type="range"]::-webkit-slider-runnable-track {
      height: 3px; border-radius: 3px;
      background: linear-gradient(90deg, rgba(99,215,208,.6), rgba(99,215,208,.16));
    }
    input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none; width: 13px; height: 13px; margin-top: -5px; border-radius: 50%;
      background: #e2f7f5; border: 1px solid rgba(99,215,208,.85); box-shadow: 0 1px 4px rgba(0,0,0,.45);
    }
    input[type="checkbox"][role="switch"] { accent-color: #63d7d0; }

/* ===== A 档视觉层（去 HTML 感）：字体/胶囊控件/毛玻璃/阴影分级/自定义滑块/发光标记 =====
   这一层只做覆盖，全部集中在样式表末尾；整块删掉即可回滚。 */
:root {
  --shadow-1: 0 1px 2px rgba(0,0,0,.28), 0 2px 8px rgba(0,0,0,.22);
  --shadow-2: 0 6px 24px rgba(0,0,0,.30), 0 1px 0 rgba(255,255,255,.04) inset;
  --shadow-3: 0 24px 64px rgba(0,0,0,.46), 0 1px 0 rgba(255,255,255,.05) inset;
  --ease: cubic-bezier(.2,.8,.2,1);
}
body { font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC", "Helvetica Neue", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; letter-spacing: .005em; }
.metric b, .perf-hud b, .roster-row .dist, #latency, #captureLatency, #serverLatency,
.scale-row span:last-child, .map-empty-foot, #overviewClock, .map-tool {
  font-family: ui-monospace, SFMono-Regular, Menlo, "SF Mono", monospace;
  font-variant-numeric: tabular-nums; font-feature-settings: "tnum" 1;
}
.rail-card, .card { box-shadow: var(--shadow-2); border-radius: 15px; }
.display-settings-card, .label-editor, .map-empty-card { box-shadow: var(--shadow-3); }
.map-panel { box-shadow: var(--shadow-2); }
.map-panel::after { box-shadow: inset 0 0 120px rgba(0,0,0,.38); }
* { scrollbar-width: none; }
*::-webkit-scrollbar { width: 0; height: 0; }
.map-controls {
  padding: 6px; border-radius: 999px; gap: 6px;
  background: rgba(8, 16, 24, .62); border: 1px solid var(--line);
  -webkit-backdrop-filter: blur(18px) saturate(1.3); backdrop-filter: blur(18px) saturate(1.3);
  box-shadow: var(--shadow-1);
}
.map-tool {
  border-radius: 999px; padding: 6px 11px; border-color: transparent;
  background: transparent; color: var(--muted);
  transition: background-color .12s var(--ease), color .12s var(--ease), transform .12s var(--ease), box-shadow .12s var(--ease);
}
.map-tool:hover { color: var(--text); background: rgba(255,255,255,.06); }
.map-tool:active { transform: scale(.96); }
.map-tool.active, .map-tool[aria-pressed="true"] { color: #04121a; background: var(--accent); box-shadow: 0 4px 14px rgba(92,200,255,.28); }
.map-tool.selecting { color: #1a1200; background: #ffd84d; box-shadow: 0 4px 14px rgba(255,216,77,.26); }
.view-mode-switch {
  padding: 3px; gap: 3px; border-radius: 999px;
  background: rgba(4, 12, 18, .72); border-color: var(--line);
  box-shadow: inset 0 1px 2px rgba(0,0,0,.35);
}
.view-mode-switch .map-tool { padding: 5px 10px; border-radius: 999px; }
.view-mode-switch .map-tool.active { color: #04121a; background: var(--accent); box-shadow: 0 2px 8px rgba(92,200,255,.3); }
.scale-row input[type="range"] { -webkit-appearance: none; appearance: none; height: 22px; background: transparent; }
.scale-row input[type="range"]::-webkit-slider-runnable-track { height: 4px; border-radius: 999px; background: rgba(120,178,232,.22); }
.scale-row input[type="range"]::-webkit-slider-thumb {
  -webkit-appearance: none; appearance: none; width: 14px; height: 14px; margin-top: -5px;
  border-radius: 50%; background: #eaf4ff; border: 2px solid var(--accent); box-shadow: 0 2px 8px rgba(0,0,0,.4);
  transition: transform .12s var(--ease);
}
.scale-row input[type="range"]:active::-webkit-slider-thumb { transform: scale(1.12); }
.roster-row { padding: 7px 9px; border-radius: 9px; border-bottom: 1px solid rgba(173,208,220,.07); transition: background-color .12s var(--ease); }
.roster-row:last-child { border-bottom: 0; }
.roster-row:hover { background: rgba(255,255,255,.05); }
.topbar { background: rgba(7, 13, 22, .72); border-bottom-color: rgba(173,208,220,.10);
  -webkit-backdrop-filter: blur(20px) saturate(1.25); backdrop-filter: blur(20px) saturate(1.25); }
.sidebar { background: rgba(7, 13, 22, .52); border-right-color: rgba(173,208,220,.10);
  -webkit-backdrop-filter: blur(20px); backdrop-filter: blur(20px); }

/* ===== P0 视觉基线：字号下限 11px / 中文行高 1.55 / 触达 ≥32pt =====
   原来雷达页 68 处主体文字在 8~10px（实测），层次只能靠颜色深浅撑；
   这里把所有面向客户的文字抬到 11~13px，并把按钮触达面积补到 32pt 以上。 */
body { line-height: 1.55; }
.map-tool { font-size: 11px; padding: 7px 12px; min-width: 44px; min-height: 32px; }
.simple-panel .map-tool { font-size: 11px; min-width: 44px; min-height: 32px; padding: 7px 10px; }
.simple-chip, .simple-panel .simple-chip { font-size: 12px; min-height: 30px; padding: 5px 10px; }
.simple-panel .map-label { font-size: 12px; padding: 6px 10px; }
.simple-panel .status { font-size: 12px; }
.map-legend { font-size: 11px; padding: 7px 10px; }
.roster-row { padding: 9px 10px; }
.roster-row .dist, .roster-row .hp { font-size: 11px; }
.roster-empty { font-size: 12px; }
.metric span { font-size: 11px; } .metric b { font-size: 13px; }
.display-option b { font-size: 12px; } .display-option small { font-size: 11px; line-height: 1.5; }
.scale-row span { font-size: 11px; }
.map-warning { font-size: 12px; line-height: 1.55; }
.map-empty-card b { font-size: 17px; }
.map-empty-card p, .map-empty-steps, .map-empty-foot { font-size: 12px; line-height: 1.6; }
.card-kicker, .eyebrow { font-size: 11px; letter-spacing: .1em; }
.session-card p { font-size: 11px; }
.nav-item small, .workspace-label, .sidebar-foot { font-size: 11px; }
.label-editor-hint, .label-editor-item, .label-editor-head span { font-size: 11px; }
.map-panel::before { font-size: 10px; }
/* 提示收敛：空状态卡片出现时，顶部两个 chip 与旧警告条不再重复说同一件事 */
body.is-empty .simple-summary { display: none !important; }
body.is-empty .map-warning { display: none !important; }
/* 空状态里的三步状态行 */
.map-empty-status { display: grid; gap: 7px; margin: 0 0 14px; }
.map-empty-status .row { display: grid; grid-template-columns: 14px 1fr auto; align-items: center; gap: 8px; font-size: 12px; }
.map-empty-status .dot { width: 8px; height: 8px; border-radius: 50%; background: rgba(140,162,172,.45); box-shadow: 0 0 0 3px rgba(140,162,172,.10); }
.map-empty-status .dot.ok { background: #5ce0b0; box-shadow: 0 0 0 3px rgba(92,224,176,.16); }
.map-empty-status b { font-weight: 600; color: rgba(214,232,244,.9); }
.map-empty-status span { color: var(--muted); font-family: ui-monospace, Menlo, monospace; font-size: 11px; }

/* ===== P1：工具栏渐进披露（⋯ 面板）+ 快捷键提示 ===== */
.map-more { position: absolute; right: 14px; top: 100px; z-index: 6; display: flex; flex-direction: column; gap: 6px;
  padding: 8px; border-radius: 14px; background: rgba(8,16,24,.88); border: 1px solid var(--line);
  -webkit-backdrop-filter: blur(18px) saturate(1.3); backdrop-filter: blur(18px) saturate(1.3); box-shadow: var(--shadow-2); }
.map-more[hidden] { display: none !important; }
.map-more .map-tool { width: 100%; justify-content: flex-start; text-align: left; min-width: 132px; }
.map-more .view-mode-switch { display: flex; }
.map-more .view-mode-switch .map-tool { text-align: center; }

/* ===== P2 可访问性与细腻度 ===== */
/* ① 尊重系统「减少动态效果」 */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: .001ms !important; animation-iteration-count: 1 !important; transition-duration: .001ms !important; }
  .view { animation: none !important; }
  .map-empty-pulse { animation: none !important; transform: none !important; }
  .map-empty { background: rgba(6,15,22,.94) !important; }
}
/* ② 显示设置改成右侧抽屉（原来是浮动小卡片） */
.simple-panel .display-settings-card {
  position: fixed; right: 0; top: 0; bottom: 0; height: 100vh; width: min(340px, calc(100vw - 48px));
  max-height: none; margin: 0; padding: 18px; overflow: auto; z-index: 9;
  background: rgba(9,18,26,.95); border-left: 1px solid var(--line); border-radius: 18px 0 0 18px;
  box-shadow: -30px 0 80px rgba(0,0,0,.5);
  -webkit-backdrop-filter: blur(22px) saturate(1.3); backdrop-filter: blur(22px) saturate(1.3);
  transform: translateX(0); transition: transform .2s var(--ease, cubic-bezier(.2,.8,.2,1));
}
.simple-panel .display-settings-card .display-settings-close { width: 32px; height: 32px; font-size: 20px; border-radius: 10px; background: rgba(255,255,255,.05); }
.simple-panel .display-settings-card .display-settings-head { margin-bottom: 14px; padding-bottom: 12px; border-bottom: 1px solid var(--line); }

/* ===== P3：显示抽屉分组标题 ===== */
.display-group { margin: 12px 8px 4px; color: var(--dim); font-size: 11px; font-weight: 700; letter-spacing: .1em; }
.display-group:first-child { margin-top: 0; }

/* ===== 工具栏 v2（按反馈：进顶栏、缩小、方角、淡色激活态）===== */
.topbar { gap: 16px; }
.map-controls {
  position: static; right: auto; top: auto; z-index: auto;
  margin-left: 4px; padding: 4px; gap: 4px; border-radius: 10px;
  border: 1px solid rgba(173,208,220,.12);
  background: rgba(8,14,22,.72);
  -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
  box-shadow: none; overflow-x: auto; scrollbar-width: none;
}
.map-controls::-webkit-scrollbar { display: none; }
.map-tool {
  border-radius: 7px; padding: 5px 9px; min-width: 34px; min-height: 24px;
  font-size: 11px; border-color: transparent; background: transparent;
}
.map-tool:hover { color: var(--text); background: rgba(255,255,255,.05); }
.map-tool.active, .map-tool[aria-pressed="true"] {
  color: #9BD9F5; background: rgba(92,200,255,.14);
  box-shadow: inset 0 0 0 1px rgba(92,200,255,.35);
}
.map-tool.selecting { color: #F2CE5A; background: rgba(242,206,90,.14); box-shadow: inset 0 0 0 1px rgba(242,206,90,.4); }
.view-mode-switch { padding: 2px; gap: 2px; border-radius: 8px; background: rgba(4,12,18,.6); box-shadow: none; }
.view-mode-switch .map-tool { padding: 5px 10px; border-radius: 6px; }
.view-mode-switch .map-tool.active { color: #9BD9F5; background: rgba(92,200,255,.16); box-shadow: inset 0 0 0 1px rgba(92,200,255,.35); }
@media (max-width: 1180px) {
  body.is-empty .simple-summary { display: none !important; }
  .map-controls { max-width: 46vw; }
}
/* 触屏（iPhone / iPad）：工具栏按钮回到可点尺寸，别为了"好看"把手指点不到 */
@media (pointer: coarse) {
  .map-tool { min-height: 32px; padding: 7px 12px; font-size: 12px; }
  .view-mode-switch .map-tool { padding: 7px 13px; }
}

  /* ===== 宽视口安全区适配（2026-10-06 修「横屏顶部功能点不动」）=====
     现象：手机横过来后，地图右上角工具条看得见但点不到。
     根因：env(safe-area-inset-*) 只写在 max-width:640px 里面 → 横屏（宽约 852pt）不命中；
           而原生 WebView 是整屏铺满（viewport-fit=cover + ignoresSafeArea），
           于是 .map-controls 的 top:14px / right:16px 正好落进刘海·传感器那一条带。
     为什么限定 >640px：≤640px 时 .simple-panel .app 已经吃过一次 safe-area padding，
           这里再吃一次就会重复计算，把工具条往下压 59px。 */
  @media (min-width: 641px) {
    .simple-panel .map-controls {
      top: calc(14px + env(safe-area-inset-top, 0px));
      right: calc(16px + env(safe-area-inset-right, 0px));
    }
    .simple-panel .map-label {
      top: calc(14px + env(safe-area-inset-top, 0px));
      left: calc(16px + env(safe-area-inset-left, 0px));
    }
    .simple-panel .map-warning {
      top: calc(58px + env(safe-area-inset-top, 0px));
      right: calc(16px + env(safe-area-inset-right, 0px));
    }
    .simple-panel .topbar {
      padding-left: max(10px, env(safe-area-inset-left, 0px));
      padding-right: max(10px, env(safe-area-inset-right, 0px));
    }
  }

  /* ===== 2026-10-06 修「竖屏看不到地图」——真根因（无头 iPhone 视口实测）=====
     第 390 行 .simple-panel .workspace { height: auto; min-height: 0 } 与
     前面两条 .simple-panel .workspace { height: calc(100vh - 5Xpx) } 同特异性但更靠后，
     于是 height:auto 胜出 → 高度链塌陷：
       .workspace(auto) → #overviewView(100%→auto) → .map-panel(100%→auto)
     而 .map-panel { min-height: 0 !important }（10-05 补丁）又把唯一保底高度清掉，
     结果 .map-panel 实测高度 = 0，画布 571px 高却因 overflow:hidden 被整块裁掉。
     这里直接给地图面板一个确定高度，不再依赖父级链；
     .workspace 保持 height:auto 不动（空状态卡片需要它能滚动）。 */
  @media (max-width: 640px) {
    .simple-panel .map-panel { height: calc(100vh - 54px); min-height: 0 !important; }
  }

  /* ===== 2026-10-06 修「竖屏顶部功能条显示不全」=====
     .simple-panel .app 只定义了 grid-template-rows，没有 grid-template-columns，
     隐式列按 max-content 撑开 —— 实测容器 393px 而列宽 519.09px，整条链
     （.app-shell/.workspace/#overviewView/.map-panel）全部被撑到 519px 溢出屏幕，
     顶部工具条（toolbar/map-controls）两头被裁掉、还出现横向滚动。
     显式把列锁成 minmax(0,1fr)，让它永远不超过视口。
     只作用于 .simple-panel（手机侧），桌面端布局不受影响。 */
  .simple-panel .app { grid-template-columns: minmax(0, 1fr); }

  /* ===== 2026-10-06 修「竖屏顶部功能条显示不全」真根因 =====
     第 342 行 .simple-panel .map-controls 用了 justify-content: flex-end
     + flex-wrap: nowrap + overflow-x: auto。实测内容宽 394px、容器 373px，
     flex-end 把溢出推到**左侧**，而滚动条滚不到负坐标 →
     开头的 2D / 双视 / 3D 三个按钮横坐标变成 -101 ~ -6，永远点不到。
     改成左对齐 + 允许换行：所有按钮一律可见，够宽时仍是一行。 */
  @media (max-width: 640px) {
    .simple-panel .map-controls {
      justify-content: flex-start;
      flex-wrap: wrap;
      max-width: none;
    }
  }

  /* ===== 2026-10-06 修「展开列表/显示后工具条点不动」=====
     实测：.map-controls 的 z-index 是 3，而 .simple-panel .display-settings-card 是 8，
     且该面板在手机上定位为 left/right:10px + max-height:calc(100vh - 112px)，
     展开后整个压在工具条**上面** —— 于是"第一次点开有效、之后工具条再也点不到"，
     用户只能看到一个大面板却关不掉（"装不下"的实感来源）。
     把工具条提到面板之上，保证它永远可点、随时能再点一次收起面板。 */
  .simple-panel .map-controls { z-index: 9; }

  /* ================= 手机端「地图优先」布局 v3（2026-10-09） =================
     范围：只作用于 ≤640px 宽 + 精简外壳（App 里内嵌的那种）。
          桌面端、平板、以及 ?advanced=1 的完整面板一行都不变。

     改之前的实测（402×874 无头视口，精简外壳）：
       · 顶栏里的 .map-controls（2D/双视/3D + 简洁/适配/选自己/列表/显示）在 402pt 宽下
         折成 3 行，顶栏实测高 97px；WebView 里中文字体更大时还要再多一行；
       · .map-panel 写死 height: calc(100vh - 54px) = 820px，比顶栏下面真正剩下的
         718px 高 102px，底部被 #overviewView 的 overflow:hidden 整块裁掉；
       · 画布又被 .map-pane 的 min-height: min(67vh, 730px) 压在 586px，面板里留一条死区。
     客户看到的就是：上面一排按钮、中间一大片空、雷达挤在最下面一条。

     改之后：
       ① 工具区收进顶栏一个 44pt「工具」按钮，点开是从顶栏下沿推下来的抽屉，
          点抽屉外任意一处即收起；收起时它完全不占屏幕；
       ② 高度链锁死成「顶栏 + 地图 = 视口」，地图面板吃掉剩下的全部高度，不再被裁；
       ③ 画布铺满面板（去掉手机上那个 67vh 的 min-height）。
     只动布局与呈现，页面的数据 / WS 逻辑一行没改。 */

  /* 工具抽屉的开关：桌面端这三个元素不参与布局（只出现在 ≤640px 的精简外壳里）。 */
  .map-tools-toggle, .map-tools-scrim, .map-tools-toggle-input { display: none; }

  @media (max-width: 640px) {
    .simple-panel .topbar {
      /* 顶栏原来是半透明毛玻璃。手机上页面不滚动、它背后只有页面底色，
         去掉 backdrop-filter 既省一层合成，也解开一个硬约束：
         带 backdrop-filter 的元素会成为后代 fixed/absolute 的包含块、并自成层叠上下文，
         抽屉就没法盖在雷达面板之上了（规范行为，不是 bug）。
         视觉上仍是同一条深色栏（底色由上面那条 !important 规则给）。 */
      -webkit-backdrop-filter: none; backdrop-filter: none;
      position: relative;
      z-index: auto;
    }

    /* —— ① 工具抽屉 —— */
    .simple-panel .map-tools-toggle-input {
      display: block; position: absolute; width: 1px; height: 1px; margin: -1px;
      padding: 0; border: 0; overflow: hidden; clip: rect(0 0 0 0); clip-path: inset(50%);
      white-space: nowrap;
    }
    .simple-panel .map-tools-toggle {
      display: inline-flex; align-items: center; justify-content: center; gap: 6px;
      align-self: center; flex: 0 0 auto;
      min-height: 44px; min-width: 76px; padding: 0 15px; margin-right: 8px;
      border: 1px solid rgba(120, 178, 232, .30); border-radius: 12px;
      color: var(--text); background: rgba(92, 200, 255, .09);
      font-size: 13px; font-weight: 600; white-space: nowrap;
      transition: background-color .12s var(--ease), color .12s var(--ease), border-color .12s var(--ease);
    }
    .simple-panel .map-tools-toggle:active { transform: scale(.97); }
    .simple-panel .map-tools-toggle .map-tools-toggle-close { display: none; }

    /* 抽屉本体：还是那个 #mapControls，只是手机上从「顶栏里的一排」改成「顶栏下面的抽屉」。
       位置相对 .topbar（position: relative 在上面），所以永远贴着顶栏下沿。 */
    .simple-panel .map-controls {
      position: absolute; top: 100%; left: 0; right: 0; z-index: 30;
      display: none; flex-wrap: wrap; justify-content: flex-start; align-items: center;
      gap: 8px; margin: 0;
      padding: 12px max(12px, env(safe-area-inset-right, 0px)) 14px max(12px, env(safe-area-inset-left, 0px));
      max-width: none; max-height: calc(100vh - 40vh); overflow-x: hidden; overflow-y: auto;
      border-radius: 0 0 18px 18px; border-top: 0;
      background: rgba(9, 17, 28, .985);
      box-shadow: 0 22px 46px rgba(0, 0, 0, .52);
    }
    /* 抽屉里每个按钮都按手指点（≥44pt），不再挤成小方块 */
    .simple-panel .map-controls .map-tool {
      min-height: 44px; min-width: 52px; padding: 10px 15px;
      font-size: 13px; border-radius: 11px;
    }
    .simple-panel .map-controls .view-mode-switch { padding: 3px; gap: 3px; }
    .simple-panel .map-controls .view-mode-switch .map-tool { min-width: 56px; }

    .simple-panel .map-tools-toggle-input:checked ~ .map-controls { display: flex; }
    .simple-panel .map-tools-toggle-input:checked ~ .map-tools-scrim {
      display: block; position: fixed; inset: 0; z-index: 20;
      background: rgba(3, 7, 12, .42);
    }
    .simple-panel .map-tools-toggle-input:checked ~ .map-tools-toggle {
      color: #04121a; background: var(--accent); border-color: transparent;
    }
    .simple-panel .map-tools-toggle-input:checked ~ .map-tools-toggle .map-tools-toggle-open { display: none; }
    .simple-panel .map-tools-toggle-input:checked ~ .map-tools-toggle .map-tools-toggle-close { display: inline; }

    /* —— ② 高度链：顶栏之外，剩下的全部给地图 —— */
    .simple-panel .app { height: 100vh; grid-template-rows: auto minmax(0, 1fr); }
    .simple-panel .app-shell { display: block; height: 100%; min-height: 0; }
    .simple-panel .workspace { height: 100%; min-height: 0; overflow: hidden; }
    .simple-panel #overviewView { height: 100%; min-height: 0; padding: 0; }
    .simple-panel .overview-grid { height: 100%; min-height: 0; }
    .simple-panel .map-panel { height: 100%; min-height: 0 !important; }

    /* —— ③ 画布铺满面板 —— */
    .simple-panel .map-visuals { grid-auto-rows: minmax(0, 1fr); }
    /* 页面底色对齐 App 主界面（#060812 一族）。
       原来这里是 #07131b 偏青，全屏之后它就是"整块屏幕的颜色"。 */
    .simple-panel .app,
    .simple-panel .map-panel,
    .simple-panel .map-visuals,
    .simple-panel .map-visuals.mode-both canvas { background: transparent; }
    .simple-panel body,
    .simple-panel .map-panel {
      background:
        radial-gradient(120% 62% at 50% 38%, rgba(30, 62, 110, .30), rgba(6, 8, 18, 0) 62%),
        radial-gradient(80% 40% at 80% 96%, rgba(92, 200, 255, .06), rgba(6, 8, 18, 0) 70%),
        #05070f;
    }
    .simple-panel .map-visuals.mode-radar,
    .simple-panel .map-visuals.mode-overlay { grid-template-rows: minmax(0, 1fr); }
    .simple-panel .map-pane { min-height: 0 !important; }
    .simple-panel .map-panel canvas { min-height: 0 !important; }

    /* 手机上顶栏只剩「工具 + 状态摘要」一行，别再让它被内容撑开。
       顶栏原本是 space-between：手机上左边那个空掉的品牌块会把「工具」顶到屏幕中间，
       所以改成左对齐 + 让状态摘要自己靠右。 */
    .simple-panel .topbar { min-height: 0; justify-content: flex-start; }
    .simple-panel .topbar-actions { margin-left: auto; }
    .simple-panel .simple-summary { flex-wrap: nowrap; }

    /* 竖屏双视（App 竖屏默认视图）：2D 那一格给**画布能画出的最大正方形**就够，
       多给的高度它也用不上 —— 页面画底图的规则是
         side = min(画布宽, 画布高) - 32   （见 JS 里那行 const side）
       竖屏下画布高度总是大于宽度，所以底图尺寸由**屏宽**决定，最大就是 宽-32。
       于是 2D 那一格取 min(屏宽, 62%)：
         · 够高时正好等于屏宽 → 底图顶到最大，格子里没有一条死边；
         · 矮屏（小手机/横屏换算下来不够）时按 62% 收，保证 3D 那一格不被挤没。
       剩下全部高度给 3D —— 双视的"双"才真的看得见。 */
    .simple-panel .map-visuals.mode-both { grid-template-rows: 62% minmax(0, 1fr); }
    .simple-panel .map-visuals.mode-both { grid-template-rows: min(100vw, 62%) minmax(0, 1fr); }
    /* 2D 那一格就是"画布宽 = 屏宽"的正方形：底图尺寸 = min(宽,高) − 4，正好顶满，
       格子里不留死边；省下来的高度全给 3D。 */
    .simple-panel #mapPane2d { position: relative; }
    /* 底图外缘压一层极淡的暗角：视点收在画面中间，余光不会被四角拉走 */
    .simple-panel #mapPane2d::after {
      content: ''; position: absolute; inset: 0; pointer-events: none;
      background:
        radial-gradient(118% 88% at 50% 46%, rgba(0,0,0,0) 52%, rgba(2,5,11,.42) 100%);
    }
  }
  /* ================= 全屏雷达 v4（2026-10-09）=================
     范围：只作用于 ≤640px 宽 + 精简外壳（iOS App 内嵌的那种）。
          桌面端（>640px）、平板、?advanced=1 的完整面板一行都不变。

     为什么又改：v3 把工具条收进顶栏一个「工具」按钮，但**顶栏本身还在**，
     它照样吃掉 57px，而且和 App 原生的底部状态带一上一下夹着地图。
     本轮的结构决定：**雷达页只负责画雷达** ——
       · 顶栏整条从雷达页上消失（状态改由 App 原生一颗小圆点表达）；
       · 地图从"画布里的一个正方形"变成**满屏**（连画布内侧那 16px 边距也去掉）；
       · 控件全部收进右下角一颗半透明小圆钮，点开是底部抽屉，收起时不占一格像素。

     这一节只动布局与呈现，页面的数据 / WS / 渲染逻辑一行没改。 */

  /* —— ① 顶栏整条退出雷达页 ——
     它承载的东西都有人接管了：连接状态 → App 原生状态圆点；
     地图名 → 地图左上角那枚「仪表标签」；人物数 → 抽屉里的人名列表；
     工具入口 → 右下角那颗悬浮钮。 */
  @media (max-width: 640px) {
    /* 顶栏压成 0 高（不是 display:none）：它里面还挂着工具抽屉与那颗浮动钮，
       display:none 会把它们一起干掉。高度归零后它不再占任何一格，
       但抽屉 / 浮钮 / scrim 这三个 fixed 后代会照常出现在视口上。 */
    /* 用 absolute 而不是 display:none —— 顶栏脱出网格流（只剩 .app-shell 一个网格项），
       同时仍然是工具抽屉 / 浮钮 / scrim 的最近定位祖先，三者照常挂在视口上。 */
    .simple-panel .app { position: relative; }
    .simple-panel .topbar {
      position: absolute !important;
      left: 0; right: 0; top: 0;
      display: block !important;
      height: 0; min-height: 0 !important;
      padding: 0 !important; margin: 0; border: 0;
      overflow: visible; background: transparent;
    }
    /* 顶栏里原来的内容（品牌块、状态摘要、连接状态字）在手机上全部退场：
       地图名 → 左上角仪表标签；连接状态 → App 原生状态圆点；
       人物数 → 抽屉里的名单。 */
    .simple-panel .topbar > .brand-lockup,
    .simple-panel .topbar > .topbar-actions { display: none !important; }
    .simple-panel .app {
      height: 100vh;
      /* 单行：整屏都给地图 */
      grid-template-rows: minmax(0, 1fr);
    }
    /* 全屏铺满之后，地图自己吃掉安全区（刘海 + Home 条）：
       底图是居中的正方形，屏宽决定它的大小，多出来的上下留白正好是安全区，
       所以"铺满"不会把任何东西顶到刘海或 Home 条底下。 */
    /* 高度链保持 v 3 已经锁好的那条：.app(100vh) → 唯一一行 → .app-shell(100%)
       → .workspace(100%) → #overviewView(100%) → .map-panel(100%)。
       这里只把 .workspace 上残留的 padding 清掉（满屏就真的满屏）。 */
    .simple-panel .workspace { padding: 0; }
  }

  /* —— ② 仪表标签（地图名）与警告：浮在地图上的小胶囊 —— */
  @media (max-width: 640px) {
    .simple-panel .map-label {
      left: calc(12px + env(safe-area-inset-left, 0px));
      top: calc(12px + env(safe-area-inset-top, 0px));
      display: inline-flex; align-items: center; gap: 7px;
      max-width: calc(100vw - 24px);
      padding: 6px 12px 6px 10px; border-radius: 999px;
      border: 1px solid rgba(120, 178, 232, .18);
      background: rgba(6, 13, 24, .62);
      -webkit-backdrop-filter: blur(14px) saturate(1.25);
      backdrop-filter: blur(14px) saturate(1.25);
      box-shadow: 0 10px 26px rgba(0, 0, 0, .34);
      color: #cddcf0; font-size: 12px; font-weight: 600; letter-spacing: .01em;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    /* 标签最前面那颗青蓝点：整页只剩它是"信息"，不跟标记颜色抢 */
    .simple-panel .map-label::before {
      content: ''; flex: 0 0 auto; width: 6px; height: 6px; border-radius: 50%;
      background: var(--accent); box-shadow: 0 0 0 3px rgba(92, 200, 255, .14);
    }
    .simple-panel .map-label[hidden] { display: none !important; }
    /* 延迟那个标签不重复第二颗点 */
    .simple-panel #phoenixLatency::before { display: none; }
    .simple-panel #phoenixLatency {
      left: auto; right: calc(12px + env(safe-area-inset-right, 0px));
      top: auto; bottom: calc(12px + env(safe-area-inset-bottom, 0px));
      margin-top: 0; opacity: .9;
      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
      font-size: 11px; letter-spacing: .02em;
    }
    /* "尚未获得地图标定"这种开发期提示：手机上仍然只在阻断时出现，
       但把它从"压在地图顶部的一条"改成居中一枚卡片，不糊住地图名。 */
    .simple-panel .map-warning {
      top: auto; left: 50%; right: auto; transform: translateX(-50%);
      bottom: calc(82px + env(safe-area-inset-bottom, 0px));
      max-width: min(360px, calc(100vw - 28px));
      border-radius: 14px;
    }
    .simple-panel .map-warning.blocking { top: 50%; bottom: auto; transform: translate(-50%, -50%); }
  }

  /* —— ③ 右下角悬浮控件：一颗半透明小圆钮 → 底部抽屉 —— */
  @media (max-width: 640px) {
    /* 触发器：44pt 圆形，常态 46% 不透明度，点一下展开。
       底部右边是拇指位；它盖住的那一小块地图角落在双视下是 3D 那一格的边缘，
       不影响中央的 2D 底图。 */
    .simple-panel .map-tools-toggle {
      position: fixed;
      right: calc(14px + env(safe-area-inset-right, 0px));
      bottom: calc(16px + env(safe-area-inset-bottom, 0px));
      z-index: 24;
      display: inline-flex; align-items: center; justify-content: center;
      width: 46px; height: 46px; min-width: 0; min-height: 0;
      padding: 0; margin: 0; border-radius: 50%;
      border: 1px solid rgba(150, 196, 236, .20);
      color: rgba(214, 232, 248, .90);
      background: rgba(9, 18, 31, .58);
      -webkit-backdrop-filter: blur(16px) saturate(1.3);
      backdrop-filter: blur(16px) saturate(1.3);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, .07), 0 10px 26px rgba(0, 0, 0, .38);
      opacity: .46;
      -webkit-tap-highlight-color: transparent;
      transition: opacity .22s ease, background-color .15s ease,
                  border-color .15s ease, transform .15s cubic-bezier(.2, .9, .25, 1);
    }
    /* 常态：安静。手指按住 / 点开：亮起来。 */
    .simple-panel .map-tools-toggle:active,
    .simple-panel .map-tools-toggle:focus-visible { opacity: 1; transform: scale(.94); }
    .simple-panel .map-tools-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
    /* 点开之后小圆钮让位给抽屉，自己也别一直亮着 */
    .simple-panel .map-tools-toggle-input:checked ~ .map-tools-toggle { opacity: .16; }

    /* 抽屉：从底部推上来的底板（不是从顶栏下沿垂下来的那块）。
       它是"页面上的一层"，收起时 display:none 完全不占位。 */
    .simple-panel .map-controls {
      position: fixed; left: 0; right: 0; bottom: 0;
      top: auto; z-index: 25;
      display: none;
      flex-wrap: wrap; align-items: center; justify-content: flex-start;
      gap: 9px; margin: 0;
      padding: 15px calc(14px + env(safe-area-inset-right, 0px))
               calc(17px + env(safe-area-inset-bottom, 0px))
               calc(14px + env(safe-area-inset-left, 0px));
      max-width: none; max-height: 46vh; overflow-x: hidden; overflow-y: auto;
      border: 0; border-top: 1px solid rgba(150, 196, 236, .13);
      border-radius: 22px 22px 0 0;
      background: rgba(7, 13, 24, .90);
      -webkit-backdrop-filter: blur(26px) saturate(1.35);
      backdrop-filter: blur(26px) saturate(1.35);
      box-shadow: 0 -26px 60px rgba(0, 0, 0, .55);
    }
    .simple-panel .map-tools-toggle-input:checked ~ .map-controls {
      display: flex;
      animation: mvRailIn .26s cubic-bezier(.22, .9, .24, 1) both;
    }
    /* 「显示」抽屉：从屏幕右侧滑进来。
       原规则（第 676 行）是 `transform: translateX(0)` + transition，
       但 0 → 0 没有位移，所以它是"凭空出现"。手机上给它一个真正的入场。 */
    .simple-panel .display-settings-card:not(.open) { transform: translateX(calc(100% + 26px)); }
    @keyframes mvRailIn {
      from { transform: translateY(18px); opacity: 0; }
      to   { transform: none; opacity: 1; }
    }

    /* 抽屉里的按钮：按手指点，且**全都是中性**（青蓝只属于"当前选中"） */
    .simple-panel .map-controls .map-tool {
      min-height: 42px; min-width: 58px; padding: 10px 16px;
      border-radius: 13px; border-color: rgba(150, 196, 236, .16);
      background: rgba(255, 255, 255, .055); color: #d3e0ef;
      font-size: 13px; font-weight: 600; letter-spacing: .01em;
      transition: background-color .13s ease, color .13s ease, border-color .13s ease;
    }
    .simple-panel .map-controls .map-tool:active { transform: scale(.96); }
    .simple-panel .map-controls .view-mode-switch {
      padding: 3px; gap: 3px; border-radius: 15px;
      background: rgba(255, 255, 255, .035);
      box-shadow: inset 0 0 0 1px rgba(150, 196, 236, .10);
    }
    .simple-panel .map-controls .view-mode-switch .map-tool {
      border-radius: 11px; background: transparent; min-width: 62px;
    }
    .simple-panel .map-controls .map-tool.active,
    .simple-panel .map-controls .map-tool[aria-pressed="true"],
    .simple-panel .map-controls .view-mode-switch .map-tool.active,
    .simple-panel .map-controls .view-mode-switch .map-tool[aria-pressed="true"] {
      color: #04121a;
      background: var(--accent);
      border-color: transparent;
      box-shadow: 0 6px 18px rgba(92, 200, 255, .26);
    }
    .simple-panel .map-controls .map-tool.selecting { color: #1a1200; background: #ffd84d; }

    /* 抽屉打开时压暗地图，但**不拦截点击落空**之外的东西：
       点地图任意处即收起（scrim 铺满整屏，在抽屉之下）。 */
    .simple-panel .map-tools-toggle-input:checked ~ .map-tools-scrim {
      display: block; position: fixed; inset: 0; z-index: 23;
      background: rgba(2, 6, 12, .46);
      animation: mvScrimIn .2s ease both;
    }
    @keyframes mvScrimIn { from { opacity: 0; } to { opacity: 1; } }

    @media (prefers-reduced-motion: reduce) {
      .simple-panel .map-tools-toggle-input:checked ~ .map-controls,
      .simple-panel .map-tools-toggle-input:checked ~ .map-tools-scrim { animation: none; }
    }
  }

    /* ── v2 雷达优先控制层：一个入口、一个抽屉 ───────────────────── */
    .radar-control-toggle {
      min-width: 52px; min-height: 44px; padding: 0 13px; border-radius: 12px;
      color: var(--text); background: rgba(10, 27, 36, .86); border: 1px solid rgba(99, 215, 208, .28);
      font-size: 12px; font-weight: 750; letter-spacing: .04em;
    }
    .radar-control-toggle[aria-expanded="true"] { color: #071215; background: var(--accent); }
    .radar-control-scrim { position: fixed; inset: 0; z-index: 40; background: rgba(2, 8, 13, .42); backdrop-filter: blur(3px); }
    .radar-control-scrim[hidden] { display: none !important; }
    #mapControls {
      position: static !important; display: block !important; max-width: none !important; overflow: visible !important;
      padding: 0 !important; border: 0 !important; background: transparent !important; box-shadow: none !important;
    }
    .radar-control-sheet {
      position: fixed; right: 16px; bottom: calc(16px + env(safe-area-inset-bottom)); z-index: 41;
      width: min(360px, calc(100vw - 32px)); max-height: min(76vh, 640px); overflow: auto;
      padding: 17px; border: 1px solid rgba(144, 205, 220, .24); border-radius: 20px;
      background: rgba(8, 20, 28, .97); box-shadow: 0 24px 80px rgba(0, 0, 0, .48); backdrop-filter: blur(20px);
      scrollbar-width: thin;
    }
    .radar-control-sheet[hidden] { display: none !important; }
    .radar-control-head { display: flex; align-items: center; gap: 12px; margin-bottom: 15px; padding-bottom: 13px; border-bottom: 1px solid var(--line); }
    .radar-control-head strong { display: block; margin-top: 4px; font-size: 16px; letter-spacing: -.01em; }
    .radar-control-close { margin-left: auto; width: 44px; height: 44px; padding: 0; border-radius: 12px; color: var(--muted); background: rgba(255,255,255,.04); font-size: 22px; line-height: 1; }
    .radar-control-section { display: grid; gap: 10px; padding: 3px 0 15px; }
    .radar-control-section + .radar-control-section { border-top: 1px solid rgba(173, 208, 220, .1); padding-top: 15px; }
    .radar-control-label { display: flex; align-items: baseline; justify-content: space-between; color: var(--muted); font-size: 11px; letter-spacing: .1em; font-weight: 750; }
    .radar-control-label small { color: var(--dim); font: 10px ui-monospace, monospace; letter-spacing: 0; }
    .radar-control-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
    .radar-control-grid-compact { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .radar-control-grid .map-tool { min-height: 44px; padding: 0 10px; border-radius: 11px; font-size: 11px; }
    .radar-control-section .filter-grid { margin: 0; }
    .radar-control-section .filter-chip { min-height: 44px; padding: 0 10px; border-radius: 11px; }
    .radar-control-section .scale-row { min-height: 44px; }
    .radar-control-section .roster-list { max-height: 26vh; overflow: auto; margin-top: 2px; }
    .radar-control-section .roster-list:empty { display: none; }
    .map-empty-card { width: min(360px, calc(100% - 32px)); padding: 17px 18px 16px; border-radius: 16px; }
    .map-empty-card { pointer-events: auto; }
    .map-empty-help-toggle { min-height: 44px; margin-top: 7px; padding: 0 11px; border-radius: 10px; color: var(--accent); background: rgba(99,215,208,.08); border: 1px solid rgba(99,215,208,.2); font-size: 11px; }
    .map-empty-help-toggle span { display: inline-block; margin-left: 6px; transition: transform .18s ease; }
    .map-empty-help-toggle[aria-expanded="true"] span { transform: rotate(180deg); }
    #mapEmptySteps[hidden] { display: none !important; }
    #mapEmptySteps .map-empty-steps { margin-top: 12px; }
    .simple-panel .overview-grid { display: block; }
    .simple-panel .overview-rail { display: none !important; }
    .simple-panel .map-panel { min-height: calc(100vh - 96px); }
    .simple-panel .map-panel canvas { min-height: calc(100vh - 96px); }
    @media (max-width: 640px) {
      .radar-control-toggle { min-width: 50px; }
      .radar-control-sheet { right: 10px; left: 10px; bottom: calc(10px + env(safe-area-inset-bottom)); width: auto; max-height: min(78vh, 680px); border-radius: 18px; }
      .simple-panel .map-panel { min-height: calc(100vh - 82px); border-radius: 0; border-left: 0; border-right: 0; }
    .simple-panel .map-panel canvas { min-height: calc(100vh - 82px); }
    }

    /* 旧版本的顶栏工具条/名单卡 CSS 仍保留在历史样式区，不能让它覆盖 v2 抽屉。
       这里用 ID 锚点明确声明新结构的几何：一个固定入口、一个固定抽屉、名单在抽屉内可见。 */
    #mapControls {
      position: static !important;
      margin: 0 !important;
      padding: 0 !important;
      border: 0 !important;
      background: transparent !important;
      box-shadow: none !important;
      -webkit-backdrop-filter: none !important;
      backdrop-filter: none !important;
      overflow: visible !important;
    }
    #rosterCard {
      display: grid !important;
      position: static !important;
      inset: auto !important;
      width: auto !important;
      max-width: none !important;
      margin: 0 !important;
      padding: 3px 0 15px !important;
      background: transparent !important;
      box-shadow: none !important;
    }
    /* 2026-10-13 修：这套定位/外观原来**只在 @media (max-width:640px)** 里，
       于是手机竖屏看得到，**横屏手机(≈844px)、电脑宽屏(1440px)、iPad 竖屏(744px) 全都看不到**
       （客户反馈"横屏和电脑上面都没有控制按钮，没法调雷达功能"）。
       现在提到不限宽度的位置：任何宽度都固定在地图右下角。 */
    .simple-panel #radarControlToggle {
      position: fixed !important;
      right: calc(14px + env(safe-area-inset-right, 0px));
      bottom: calc(16px + env(safe-area-inset-bottom, 0px));
      z-index: 42;
      width: 52px;
      height: 52px;
      min-width: 52px;
      padding: 0;
      border-radius: 50%;
      box-shadow: 0 10px 28px rgba(0,0,0,.38), inset 0 1px 0 rgba(255,255,255,.08);
      opacity: .86;
    }
    .simple-panel #radarControlToggle.active { opacity: 1; }
    /* 宽屏（电脑 / 平板横屏）给一颗稍大的，手指/鼠标都好点 */
    @media (min-width: 641px) {
      .simple-panel #radarControlToggle { width: 60px; height: 60px; min-width: 60px; right: 22px; bottom: 22px; font-size: 13px; }
    }

    /* v4 radar os skin */
    .radar-hud-name { display: none; }
    .simple-panel .map-panel::before {
      content: "";
      display: block;
      position: absolute;
      inset: 0;
      z-index: 1;
      pointer-events: none;
      background:
        radial-gradient(circle at 50% 47%, transparent 0 18%, rgba(101,221,255,.045) 18.1%, transparent 18.4%),
        radial-gradient(circle at 50% 47%, transparent 0 31%, rgba(101,221,255,.028) 31.1%, transparent 31.35%),
        linear-gradient(145deg, transparent 49.8%, rgba(101,221,255,.045) 50%, transparent 50.2%);
      mix-blend-mode: screen;
      opacity: .82;
    }
    .simple-panel .map-empty {
      place-items: end center;
      padding: 0 0 calc(54px + env(safe-area-inset-bottom, 0px));
    }
    .simple-panel .map-empty-card.map-first-empty {
      width: min(320px, calc(100% - 46px));
      background: linear-gradient(150deg, rgba(7,20,31,.84), rgba(3,11,19,.72));
      box-shadow: 0 20px 50px rgba(0,0,0,.27);
      backdrop-filter: blur(16px);
    }
    /* iOS WebView CJK font fallback: SF Mono has no Chinese glyphs, so any
       control that inherited the old monospace rule rendered as boxed '?'. */
    .simple-panel .map-tool,
    .simple-panel .radar-control-sheet,
    .simple-panel .radar-control-label,
    .simple-panel .filter-chip,
    .simple-panel .scale-row,
    .simple-panel .roster-row,
    .simple-panel .map-empty-card,
    .simple-panel .map-label,
    .simple-panel .status,
    .simple-panel .simple-chip,
    .simple-panel .radar-control-toggle {
      font-family: "PingFang SC", "Noto Sans CJK SC", "Heiti SC", sans-serif !important;
    }
    /* Keep the primary map controls explicit: this is also the selector used by
       the iOS simulator review gate, so a later legacy rule cannot reintroduce
       SF Mono for Chinese labels. */
    .simple-panel .map-tool { font-family: "PingFang SC", "Noto Sans CJK SC", "Heiti SC", sans-serif !important; }
    /* Descendant shorthands in the legacy stylesheet used to put status rows
       back on SF Mono.  Reassert the CJK stack for every customer-facing
       label inside the two mobile surfaces. */
    .simple-panel .map-empty-card *,
    .simple-panel .radar-control-sheet *,
    .simple-panel .radar-control-toggle * { font-family: "PingFang SC", "Noto Sans CJK SC", "Heiti SC", sans-serif !important; }
    .simple-panel .topbar {
      background: rgba(3,8,14,.84) !important;
      border-bottom-color: rgba(126,181,221,.14) !important;
    }
    .simple-panel .brand-lockup .brand-mark {
      display: grid !important;
      width: 20px;
      height: 20px;
      border-radius: 6px;
      color: var(--accent);
    }
    .simple-panel .brand-lockup .brand-mark span { display: none; }
    .simple-panel .brand-lockup .brand-mark::after { content: "RV"; font: 700 8px ui-monospace, monospace; }
    .simple-panel .radar-hud-name {
      display: inline-block;
      color: var(--text);
      font: 700 10px ui-monospace, SFMono-Regular, Menlo, monospace;
      letter-spacing: .18em;
    }
    .simple-panel .topbar .status {
      min-height: 28px;
      padding: 0 9px;
      border: 1px solid rgba(126,181,221,.16);
      border-radius: 999px;
      background: rgba(3,11,19,.62);
      font: 10px ui-monospace, SFMono-Regular, Menlo, monospace;
      letter-spacing: .04em;
      text-transform: uppercase;
    }
    .simple-panel .topbar .status::before { width: 6px; height: 6px; box-shadow: 0 0 10px currentColor; }
    .simple-panel .map-label {
      border-radius: 999px;
      background: rgba(3,11,19,.62);
      box-shadow: 0 10px 26px rgba(0,0,0,.26);
      font: 600 10px ui-monospace, SFMono-Regular, Menlo, monospace;
      letter-spacing: .04em;
    }
    .simple-panel #phoenixLatency {
      color: var(--cyan);
      border-color: rgba(101,221,255,.24);
    }
    @media (max-width: 640px) {
      .simple-panel .map-empty { padding-bottom: calc(66px + env(safe-area-inset-bottom, 0px)); }
      .simple-panel .brand-lockup { min-width: 0; }
      .simple-panel .radar-hud-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    }

    /* v3 map-first empty state */
    body, .app {
      background-color: #06111b !important;
      background-image:
        linear-gradient(rgba(133,189,221,.045) 1px, transparent 1px),
        linear-gradient(90deg, rgba(133,189,221,.045) 1px, transparent 1px),
        radial-gradient(ellipse at 50% 48%, rgba(43,129,163,.11), transparent 55%),
        linear-gradient(180deg, #07131f, #050d16) !important;
      background-size: 56px 56px, 56px 56px, 100% 100%, 100% 100%;
    }
    .simple-panel .map-panel {
      background: #06111b !important;
    }
    .map-empty {
      background: transparent !important;
    }
    .map-empty-card.map-first-empty {
      width: min(306px, calc(100% - 42px));
      padding: 19px 19px 16px;
      border: 1px solid rgba(154,194,222,.19);
      border-radius: 18px;
      background: rgba(7,19,30,.82);
      box-shadow: 0 18px 55px rgba(0,0,0,.28);
      backdrop-filter: blur(14px);
    }
    .map-empty-card.map-first-empty .map-empty-pulse {
      width: 10px;
      height: 10px;
      margin: 0 10px 0 0;
      background: var(--warn);
      box-shadow: 0 0 0 5px rgba(242,197,108,.10), 0 0 16px rgba(242,197,108,.35);
    }
    .map-empty-card.map-first-empty > b {
      display: inline-block;
      vertical-align: top;
      margin-top: -2px;
      font-size: 17px;
    }
    .map-empty-card.map-first-empty p {
      margin: 9px 0 14px;
      font-size: 12px;
      line-height: 1.55;
    }
    .map-empty-card.map-first-empty .map-empty-status {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 6px;
      margin-bottom: 0;
    }
    .map-empty-card.map-first-empty .map-empty-status .row {
      display: block;
      min-width: 0;
      padding: 9px 7px;
      border: 1px solid rgba(154,194,222,.12);
      border-radius: 11px;
      background: rgba(4,13,22,.5);
    }
    .map-empty-card.map-first-empty .map-empty-status .row .dot {
      display: block;
      margin-bottom: 7px;
    }
    .map-empty-card.map-first-empty .map-empty-status .row b,
    .map-empty-card.map-first-empty .map-empty-status .row span {
      display: block;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .map-empty-card.map-first-empty .map-empty-status .row b { font-size: 10px; }
    .map-empty-card.map-first-empty .map-empty-status .row span { margin-top: 3px; font-size: 9px; }
    .map-empty-card.map-first-empty .map-empty-help-toggle {
      width: 100%;
      height: 42px;
      margin-top: 12px;
      border-radius: 11px;
      background: rgba(104,216,255,.08);
      border-color: rgba(104,216,255,.24);
      color: #68d8ff;
      font-weight: 700;
    }
    @media (max-width: 640px) {
      .map-empty-card.map-first-empty { width: min(306px, calc(100% - 42px)); }
    }


    /* ── aurora-signal-skin：客户雷达页的完整视觉换肤 ─────────────────────
       不是把原来的蓝色换成另一种蓝，而是用紫/青/珊瑚建立三层信息层级：
       紫=空间层，青=可操作，薄荷/琥珀/珊瑚=真实连接状态。 */
    :root {
      --aurora-violet: #8f7cff;
      --aurora-pink: #ff628f;
      --signal-mint: #73efbb;
      --signal-amber: #ffc96b;
      --signal-coral: #ff7187;
      --surface-night: #09091a;
      --surface-indigo: #11102a;
    }
    html, body { -webkit-text-size-adjust: 100%; }
    body.aurora-signal-skin, .aurora-signal-skin body, .aurora-signal-skin .app {
      background-color: var(--surface-night) !important;
      background-image:
        radial-gradient(ellipse at 82% -8%, rgba(143,124,255,.24), transparent 43%),
        radial-gradient(ellipse at 4% 112%, rgba(115,239,187,.13), transparent 36%),
        radial-gradient(ellipse at 100% 72%, rgba(255,98,143,.09), transparent 32%),
        linear-gradient(rgba(148,130,255,.045) 1px, transparent 1px),
        linear-gradient(90deg, rgba(148,130,255,.045) 1px, transparent 1px) !important;
      background-size: auto, auto, auto, 58px 58px, 58px 58px !important;
    }
    .simple-panel .topbar {
      background: linear-gradient(105deg, rgba(12,11,31,.94), rgba(22,14,42,.86)) !important;
      border-bottom-color: rgba(143,124,255,.28) !important;
    }
    .simple-panel .brand-mark {
      background: linear-gradient(145deg, rgba(115,239,187,.30), rgba(143,124,255,.32), rgba(255,98,143,.22)) !important;
      border-color: rgba(143,124,255,.48) !important;
    }
    .simple-panel .brand-mark::after { color: var(--signal-mint); }
    .simple-panel .topbar .status {
      border-color: rgba(115,239,187,.34) !important;
      background: rgba(115,239,187,.08) !important;
    }
    .simple-panel .map-panel,
    .simple-panel .map-visuals,
    .simple-panel .map-visuals canvas {
      background: linear-gradient(145deg, #0b0d22, #080b18 54%, #120b25) !important;
    }
    .simple-panel .map-panel::before {
      background:
        radial-gradient(circle at 50% 47%, transparent 0 18%, rgba(143,124,255,.12) 18.1%, transparent 18.6%),
        radial-gradient(circle at 50% 47%, transparent 0 31%, rgba(115,239,187,.08) 31.1%, transparent 31.55%),
        radial-gradient(circle at 28% 22%, rgba(255,98,143,.10), transparent 22%),
        linear-gradient(145deg, transparent 49.7%, rgba(143,124,255,.08) 50%, transparent 50.3%) !important;
      mix-blend-mode: screen;
    }
    .simple-panel .map-label {
      border-color: rgba(115,239,187,.30) !important;
      background: rgba(12,11,31,.74) !important;
      color: #d8fff0 !important;
    }
    .simple-panel .map-empty-card.map-first-empty {
      border-color: rgba(143,124,255,.46) !important;
      background: linear-gradient(145deg, rgba(28,22,58,.92), rgba(12,13,31,.88) 62%, rgba(46,17,38,.76)) !important;
      box-shadow: 0 24px 70px rgba(0,0,0,.42), 0 0 0 1px rgba(255,98,143,.08), 0 0 34px rgba(143,124,255,.14) !important;
    }
    .simple-panel .map-empty-card.map-first-empty .map-empty-pulse {
      background: var(--signal-mint) !important;
      box-shadow: 0 0 0 7px rgba(115,239,187,.12), 0 0 24px rgba(115,239,187,.65) !important;
    }
    .simple-panel .map-empty-card.map-first-empty > b { color: #f8f3ff !important; }
    .simple-panel .map-empty-card.map-first-empty p,
    .simple-panel .map-empty-card.map-first-empty .map-empty-foot { color: #b9b5d1 !important; }
    .simple-panel .map-empty-card .map-empty-status .row { border-color: rgba(143,124,255,.20) !important; background: rgba(143,124,255,.07) !important; }
    .simple-panel .map-empty-card .map-empty-status .row .dot { background: var(--signal-amber) !important; box-shadow: 0 0 10px rgba(255,201,107,.55) !important; }
    .simple-panel .radar-control-toggle {
      border-color: rgba(143,124,255,.52) !important;
      background: linear-gradient(145deg, rgba(24,20,51,.92), rgba(48,18,45,.82)) !important;
      box-shadow: 0 12px 34px rgba(0,0,0,.36), 0 0 22px rgba(143,124,255,.16) !important;
    }
    .simple-panel .radar-control-toggle[aria-expanded="true"] {
      color: #0b0a19 !important;
      background: linear-gradient(135deg, var(--signal-mint), var(--accent), var(--aurora-violet)) !important;
    }
    .simple-panel .radar-control-sheet {
      border-color: rgba(143,124,255,.46) !important;
      background: linear-gradient(155deg, rgba(25,20,52,.98), rgba(11,12,30,.98) 58%, rgba(40,14,37,.95)) !important;
      box-shadow: 0 28px 90px rgba(0,0,0,.58), 0 0 40px rgba(143,124,255,.15) !important;
    }
    .simple-panel .radar-control-sheet .map-tool.active,
    .simple-panel .radar-control-sheet .map-tool[aria-pressed="true"] {
      color: #0c0b19 !important;
      background: linear-gradient(135deg, var(--signal-mint), var(--accent)) !important;
      box-shadow: 0 7px 20px rgba(115,239,187,.20) !important;
    }
    .simple-panel .radar-control-sheet .filter-chip[aria-pressed="true"] {
      color: #160a14 !important;
      background: linear-gradient(135deg, #ffd177, var(--aurora-pink)) !important;
      border-color: transparent !important;
    }
    .simple-panel .map-controls .map-tool.selecting { color: #1a1200 !important; background: var(--signal-amber) !important; }
    .simple-panel .status.good::before { background: var(--signal-mint) !important; }
    .simple-panel .status.bad::before { background: var(--signal-coral) !important; }

    /* v5 radar feedback pass：空状态收敛、横屏去掉重复顶栏、触控不再双击放大。 */
    .simple-panel .map-empty-card.map-first-empty {
      background: rgba(9, 11, 28, .94) !important;
      border-color: rgba(143, 124, 255, .28) !important;
      box-shadow: 0 20px 48px rgba(0,0,0,.34), 0 0 0 1px rgba(115,239,187,.05) !important;
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
    }
    .simple-panel .map-empty-card.map-first-empty .map-empty-status .row {
      background: rgba(255,255,255,.045) !important;
      border-color: rgba(255,255,255,.09) !important;
    }
    .simple-panel .map-empty-card.map-first-empty .map-empty-pulse {
      box-shadow: 0 0 0 5px rgba(115,239,187,.08), 0 0 15px rgba(115,239,187,.42) !important;
    }
    .simple-panel .radar-control-toggle,
    .simple-panel .radar-control-toggle *,
    .simple-panel .radar-control-sheet button,
    .simple-panel .map-tool,
    .simple-panel .filter-chip {
      touch-action: manipulation;
      -webkit-user-select: none;
      user-select: none;
    }
    .simple-panel .radar-control-sheet {
      width: min(300px, calc(100vw - 28px));
      max-height: min(64vh, 560px);
      padding: 13px;
    }
    .simple-panel .radar-control-toggle {
      width: 46px;
      height: 46px;
      min-width: 46px;
      min-height: 46px;
    }
    @media (max-width: 640px) {
      .simple-panel .radar-control-section { gap: 8px; padding-bottom: 12px; }
      .simple-panel .radar-control-grid .map-tool,
      .simple-panel .radar-control-section .filter-chip { min-height: 40px; }
    }
    @media (orientation: landscape) {
      .simple-panel .app { grid-template-rows: 0 minmax(0, 1fr) !important; }
      .simple-panel .topbar { display: none !important; }
      .simple-panel .workspace,
      .simple-panel #overviewView { height: 100vh !important; min-height: 100vh !important; }
      .simple-panel .map-panel,
      .simple-panel .map-panel canvas,
      .simple-panel .map-visuals { min-height: 100vh !important; height: 100vh !important; }
      .simple-panel .map-label { top: 10px; }
      .simple-panel .map-controls { top: 10px; }
      .simple-panel #radarControlToggle { right: 10px; bottom: 10px; }
      .simple-panel .radar-control-sheet {
        width: min(292px, 46vw);
        max-height: calc(100vh - 16px);
        right: 10px;
        bottom: 8px;
        padding: 12px;
        border-radius: 16px;
      }
      .simple-panel .radar-control-grid .map-tool,
      .simple-panel .radar-control-section .filter-chip { min-height: 40px; }
      .simple-panel .map-empty { padding-bottom: 24px; }
      .simple-panel .map-empty-card.map-first-empty { width: min(330px, 50vw); }
    }

  /* ===== 同行移植：人物卡头像 + 血条 ===== */
  .player .pav{width:28px;height:28px;border-radius:50%;flex:0 0 auto;display:grid;place-items:center;
    font:800 11px/1 ui-monospace,monospace;color:#0a0508;border:1px solid rgba(255,255,255,.14);
    background:linear-gradient(145deg,#ff5a4d,#180a0e);box-shadow:0 0 0 2px rgba(10,5,8,.55) inset}
  .player .pmain{min-width:0;flex:1;display:flex;flex-direction:column;gap:3px}
  .player .pbar{height:4px;border-radius:999px;background:rgba(255,255,255,.10);overflow:hidden}
  .player .pbar > i{display:block;height:100%;border-radius:999px;background:#2fd28a}
</style>
<style id="brand-skin">
  /* 品牌皮肤 B 不死鸟·烈焰红 · Phoenix Ember
     这段永远排在原 <style> 之后（后写覆盖先写）。
     回滚 = 删掉整个 brand-skin 样式块，其它地方一处都不用动。 */
  :root, html.simple-panel {
    --bg: #0a0508 !important;
    --bg-raised: #100609 !important;
    --panel: rgba(24,10,14, .95) !important;
    --panel-solid: #180a0e !important;
    --panel-soft: rgba(16,6,9, .76) !important;
    --line: rgba(184,154,153, .16) !important;
    --line-strong: rgba(184,154,153, .30) !important;
    --text: #fff1ef !important;
    --muted: #b89a99 !important;
    --dim: #b89a99 !important;
    --good: #2fd28a !important;
    --warn: #ffb84d !important;
    --bad: #ff6b8f !important;
    --blue: #7dd3fc !important;
    --red: #ff6b8f !important;
    --accent: #ff3b30 !important;
    --accent-strong: #ff8a3d !important;
    --aurora-violet: #ff3b30 !important;
    --aurora-pink: #ff6f91 !important;
    --signal-mint: #2fd28a !important;
    --signal-amber: #ffb84d !important;
    --signal-coral: #ff6b8f !important;
    --surface-night: #0a0508 !important;
    --surface-indigo: #180a0e !important;
  }
  .brand-mark, .simple-panel .brand-mark {
    background: linear-gradient(145deg, rgba(255,59,48,.32), rgba(255,138,61,.34), rgba(255,59,48,.18)) !important;
    border-color: rgba(255,59,48,.55) !important;
    box-shadow: 0 0 18px rgba(255,59,48,.30) !important;
  }
  .brand-mark span, .simple-panel .brand-mark span { background: var(--accent) !important; box-shadow: 0 0 9px rgba(255,59,48,.55) !important; }
  .simple-panel .brand-mark::after { color: #ff3b30 !important; }
  .radar-hud-name, .simple-panel .radar-hud-name { color: #ff3b30 !important; border-color: rgba(255,59,48,.30) !important; }
  html, body, .app, .simple-panel .app, .simple-panel .app { background-color: #0a0508 !important; }
  body, .app, .simple-panel .app, .simple-panel .app {
    background-image:
      radial-gradient(ellipse at 78% -10%, rgba(255,59,48,.16), transparent 46%),
      radial-gradient(ellipse at -6% 108%, rgba(255,138,61,.10), transparent 42%),
      linear-gradient(rgba(255,59,48,.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,59,48,.035) 1px, transparent 1px) !important;
    background-size: auto, auto, 56px 56px, 56px 56px !important;
  }
  .map-panel, .simple-panel .map-panel, .map-visuals, .simple-panel .map-visuals, .map-visuals canvas, .simple-panel .map-visuals canvas, .map-pane canvas, .simple-panel .map-pane canvas {
    background: linear-gradient(145deg, #180a0e, #0a0508 56%, #100609) !important;
  }
  .sidebar, .simple-panel .sidebar, .topbar, .simple-panel .topbar, header, .simple-panel header, .simple-panel .topbar {
    background: rgba(10,5,8,.93) !important;
    border-color: rgba(184,154,153,.16) !important;
  }
  .rail-card, .simple-panel .rail-card, .card, .simple-panel .card, .session-card, .simple-panel .session-card, .roster-card, .simple-panel .roster-card, .display-settings-card, .simple-panel .display-settings-card {
    background: linear-gradient(150deg, rgba(24,10,14,.96), rgba(10,5,8,.94)) !important;
    border-color: rgba(184,154,153,.20) !important;
  }
  .map-label, .simple-panel .map-label, .map-legend, .simple-panel .map-legend, .map-tool, .simple-panel .map-tool, .simple-chip, .simple-panel .simple-chip, .pill, .simple-panel .pill, .status-chip, .simple-panel .status-chip, .map-empty-card, .simple-panel .map-empty-card, .metric, .simple-panel .metric, .player, .simple-panel .player, .operation, .simple-panel .operation {
    border-color: rgba(184,154,153,.22) !important;
  }
  .map-label, .simple-panel .map-label { background: rgba(10,5,8,.80) !important; color: #fff1ef !important; }
  .map-tool, .simple-panel .map-tool { background: rgba(24,10,14,.74) !important; color: #fff1ef !important; }
  .map-tool.active, .simple-panel .map-tool.active, .view-mode-switch .map-tool.active, .simple-panel .view-mode-switch .map-tool.active, .simple-panel .map-tool.active, .radar-control-sheet .map-tool[aria-pressed="true"], .simple-panel .radar-control-sheet .map-tool[aria-pressed="true"] {
    background: linear-gradient(135deg, #ff3b30, #ff8a3d) !important;
    color: #1a0406 !important; border-color: transparent !important;
  }
  .map-tool.selecting, .simple-panel .map-tool.selecting, .map-controls .map-tool.selecting, .simple-panel .map-controls .map-tool.selecting, .simple-panel .map-controls .map-tool.selecting {
    background: #ffb84d !important; color: #1a0406 !important;
  }
  .map-empty, .simple-panel .map-empty { background: rgba(24,10,14,.95) !important; }
  .map-empty-card, .simple-panel .map-empty-card, .map-empty-card.map-first-empty, .simple-panel .map-empty-card.map-first-empty {
    background: rgba(24,10,14,.97) !important;
    border-color: rgba(255,59,48,.30) !important;
    box-shadow: 0 20px 48px rgba(0,0,0,.42), 0 0 26px rgba(255,59,48,.10) !important;
  }
  .map-empty-card.map-first-empty > b, .simple-panel .map-empty-card.map-first-empty > b { color: #fff1ef !important; }
  .map-empty-card.map-first-empty p, .simple-panel .map-empty-card.map-first-empty p, .map-empty-card.map-first-empty .map-empty-foot, .simple-panel .map-empty-card.map-first-empty .map-empty-foot { color: #b89a99 !important; }
  .map-empty-card .map-empty-status .row, .simple-panel .map-empty-card .map-empty-status .row {
    background: rgba(255,59,48,.07) !important; border-color: rgba(255,59,48,.18) !important;
  }
  .map-empty-help-toggle, .simple-panel .map-empty-help-toggle {
    background: rgba(255,59,48,.10) !important; border-color: rgba(255,59,48,.28) !important; color: #ff3b30 !important;
  }
  .radar-control-toggle, .simple-panel .radar-control-toggle {
    background: linear-gradient(145deg, rgba(24,10,14,.92), rgba(10,5,8,.88)) !important;
    border-color: rgba(255,59,48,.42) !important;
  }
  .radar-control-toggle[aria-expanded="true"], .simple-panel .radar-control-toggle[aria-expanded="true"] {
    background: linear-gradient(135deg, #ff3b30, #ff8a3d) !important; color: #1a0406 !important;
  }
  .radar-control-sheet, .simple-panel .radar-control-sheet {
    background: linear-gradient(155deg, rgba(24,10,14,.98), rgba(10,5,8,.98)) !important;
    border-color: rgba(255,59,48,.34) !important;
  }
  .filter-chip[aria-pressed="true"], .simple-panel .filter-chip[aria-pressed="true"] {
    background: linear-gradient(135deg, #ffb84d, #ff6f91) !important;
    color: #1a0406 !important; border-color: transparent !important;
  }
  .nav-item.active, .simple-panel .nav-item.active {
    background: linear-gradient(90deg, rgba(255,59,48,.16), rgba(255,59,48,.04)) !important;
    border-color: rgba(255,59,48,.28) !important;
  }
  .metric, .simple-panel .metric, .player, .simple-panel .player, .operation, .simple-panel .operation { background: rgba(16,6,9,.60) !important; }
  .auth-card, .simple-panel .auth-card {
    background: rgba(24,10,14,.98) !important; border-color: rgba(255,59,48,.28) !important;
  }
  .auth-card input, .simple-panel .auth-card input {
    background: rgba(10,5,8,.94) !important; border-color: rgba(255,59,48,.24) !important; color: #fff1ef !important;
  }
  #pause[aria-pressed="true"], .simple-panel #pause[aria-pressed="true"] { background: #2fd28a !important; color: #1a0406 !important; }
  .timeline input, .simple-panel .timeline input, input[type="checkbox"][role="switch"], .simple-panel input[type="checkbox"][role="switch"], input[type="range"], .simple-panel input[type="range"] { accent-color: #ff3b30 !important; }
  button.primary, .simple-panel button.primary { color: #1a0406 !important; }
  .simple-panel .status.good::before { background: #2fd28a !important; }
  .simple-panel .status.bad::before { background: #ff6b8f !important; }
  .simple-panel .map-empty-card.map-first-empty .map-empty-pulse {
    background: #2fd28a !important;
    box-shadow: 0 0 0 6px rgba(255,59,48,.10), 0 0 18px rgba(255,59,48,.55) !important;
  }
</style>
</head>
<body>
  <div class="perf-hud" id="perfHud" hidden>
    <div><b id="perfFps">—</b><span>FPS</span></div>
    <div><b id="perfP50">—</b><span>帧间隔 p50</span></div>
    <div><b id="perfP95">—</b><span>帧间隔 p95</span></div>
    <div><b id="perfDrop">0</b><span>掉帧(&gt;25ms)</span></div>
    <div><b id="perfStatic">—</b><span>静态层 ms</span></div>
    <div><b id="perfDynamic">—</b><span>动态层 ms</span></div>
    <div><b id="perf3d">—</b><span>3D 层 ms</span></div>
    <div><b id="perfDraws">—</b><span>绘制/秒</span></div>
    <div><b id="perfRaf">—</b><span>WS→RAF p99</span></div>
  </div>

<div class="app">
  <header class="topbar">
    <div class="brand-lockup">
      <div class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></div>
      <div><h1>不死鸟CODEV <span>·</span> 实时雷达</h1><div class="sub" id="sessionMeta">正在等待无畏契约对局数据</div></div>
      <span class="radar-hud-name" aria-hidden="true">RADAR OS</span>
    </div>
    
    <div class="topbar-actions">
      <div class="simple-summary" aria-label="当前对局摘要"><span class="simple-chip" id="simpleMapName">地图未识别</span><span class="simple-chip" id="simplePlayerCount">人物 0</span></div>
      <span class="status" id="connection" role="status" aria-live="polite">连接中</span>
      <button class="icon-button mobile-menu" id="mobileMenu" type="button" aria-label="打开导航" aria-expanded="false">☰</button>
    </div>
  </header>
  <div class="auth-gate" id="authGate" hidden>
    <div class="auth-card">
      <h2>授权面板访问</h2>
      <p>请输入本次启动生成的管理员令牌。令牌只用于换取短期安全会话，不会写入 URL。</p>
      <form id="authForm">
        <input id="authToken" type="password" autocomplete="one-time-code" placeholder="管理员令牌" required>
        <div class="auth-error" id="authError"></div>
        <button type="submit">进入面板</button>
      </form>
    </div>
  </div>
  <div class="app-shell">
    <nav class="sidebar" id="sidebar" aria-label="主导航">
      <div class="workspace-label">功能导航</div>
      <button class="nav-item active" type="button" data-view="overview" aria-current="page"><span class="nav-icon">◈</span><span>对局总览</span><small>雷达</small></button>
      <button class="nav-item" type="button" data-view="connectivity"><span class="nav-icon">⌁</span><span>连接管理</span><small>节点</small></button>
      <button class="nav-item" type="button" data-view="maps"><span class="nav-icon">▧</span><span>地图资源</span><small>底图</small></button>
      <button class="nav-item" type="button" data-view="replay"><span class="nav-icon">◌</span><span>对局回放</span><small>时间线</small></button>
      <button class="nav-item" type="button" data-view="settings"><span class="nav-icon">⚙</span><span>设置与帮助</span><small>高级</small></button>
      <div class="sidebar-foot"><span class="privacy-dot"></span><span>实时算法 · 隐私保护</span></div>
    </nav>
    <main class="workspace">
      <section class="view active" id="overviewView" data-view-panel="overview" aria-labelledby="overviewTitle">
        <div class="view-heading"><div><div class="eyebrow">实时对局</div><h2 id="overviewTitle">对局总览</h2></div><div class="heading-meta"><span class="pill" id="mapModeBadge">自动地图</span><span class="muted" id="overviewClock">—</span></div></div>
        <div class="overview-grid">
          <section class="map-panel">
            <div class="map-visuals mode-radar" id="mapVisuals"><div class="map-pane" id="mapPane2d"><canvas id="map" aria-label="以自身为中心的二维战术地图"></canvas></div><canvas id="overlay3d" aria-label="以自身视角投影的三维人物透视"></canvas></div>
            <div class="map-empty" id="mapEmpty" hidden>
              <div class="map-empty-card map-first-empty">
                <div class="map-empty-pulse"></div>
                <b id="mapEmptyTitle">等待对局数据</b>
                <p id="mapEmptyDetail">手机连上节点后开一局新的，坐标就会出现在这里。</p>
                <div class="map-empty-status" id="mapEmptyStatus">
                  <div class="row"><i class="dot" id="emptyDotLink"></i><b>数据通道</b><span id="emptyLinkState">连接中…</span></div>
                  <div class="row"><i class="dot" id="emptyDotSession"></i><b>游戏会话</b><span id="emptySessionState">未开始</span></div>
                  <div class="row"><i class="dot" id="emptyDotCoords"></i><b>坐标流</b><span id="emptyCoordsState">—</span></div>
                </div>
                <button type="button" class="map-empty-help-toggle" id="mapEmptyHelpToggle" aria-expanded="false" aria-controls="mapEmptySteps">连接帮助 <span aria-hidden="true">⌄</span></button>
                <div id="mapEmptySteps" hidden>
                  <ol class="map-empty-steps">
                    <li>手机与 Mac 连同一 Wi-Fi，Shadowrocket 扫码添加本机节点</li>
                    <li>Shadowrocket → 设置 → UDP → 打开「启用转发」</li>
                    <li>进游戏开一局新的（会话密钥来自开局握手）</li>
                  </ol>
                  <div class="map-empty-foot" id="mapEmptyFoot">有数据后：黄色=自己 · 蓝色=队友 · 红色=敌人</div>
                </div>
              </div>
            </div>
            <div class="map-label" id="mapLabel">地图未识别</div>
            <div class="map-label" id="phoenixLatency" hidden>延迟 —</div>
            
            <div class="map-warning blocking" id="mapWarning">尚未获得受支持的地图标定；底图和坐标标记保持隐藏。</div>
            <div class="map-provenance" id="mapProvenance" hidden><b id="mapProvenanceTitle">地图信息</b><span id="mapProvenancePak">资源包 —</span><span id="mapProvenanceTexture">地图纹理 —</span></div>
            <div class="map-legend"><span><i class="legend-dot self"></i>自身</span><span><i class="legend-dot team"></i>队友</span><span><i class="legend-dot enemy"></i>敌人</span><span><i class="legend-dot neutral"></i>未知</span></div>
            <div class="label-editor" id="labelEditor" hidden>
              <div class="label-editor-head"><b>地名标注</b><span id="labelEditorMap">—</span><button type="button" id="labelEditorClose" aria-label="关闭地名标注">×</button></div>
              <p class="label-editor-hint">左键点地图空白处 = 在落点加名字；拖动名字可移动；右键名字 = 删除。改完点「复制 JSON」发我，我写进引擎内置表（现在只存在本页面内存里）。</p>
              <div class="label-editor-row"><input id="labelNameInput" type="text" placeholder="名字，如 中路 / 天台 / A点" maxlength="12"><select id="labelKindSelect"><option value="area">区域名</option><option value="site">点位</option><option value="spawn">出生点</option></select></div>
              <div class="label-editor-row"><button type="button" id="labelCopy">复制 JSON</button><button type="button" id="labelClear">清空本图</button></div>
              <div class="label-editor-list" id="labelList"></div>
            </div>
          </section>
          <aside class="overview-rail">
            <div class="rail-card session-card"><div class="card-kicker">对局状态</div><div class="health-line"><span class="health-pulse" id="healthPulse"></span><strong id="healthLabel">等待对局</strong></div><p id="healthDetail">正在等待对局数据</p></div>
            <div class="diagnostic-runtime" aria-hidden="true">
              <div class="operations">
                <div class="operation" id="proxyOperation"><span class="operation-dot"></span><span class="operation-main"><span class="operation-name">SOCKS5 / 捕获</span><span class="operation-detail">等待代理或 pcap 数据源</span></span><span class="operation-state">等待中</span></div>
                <div class="operation" id="tlsOperation"><span class="operation-dot"></span><span class="operation-main"><span class="operation-name">HTTPS MITM</span><span class="operation-detail">默认关闭</span></span><span class="operation-state">已关闭</span></div>
                <div class="operation" id="quicOperation"><span class="operation-dot"></span><span class="operation-main"><span class="operation-name">QUIC / UDP 443</span><span class="operation-detail">尚未观察到决策</span></span><span class="operation-state">等待中</span></div>
                <div class="operation" id="recordingOperation"><span class="operation-dot"></span><span class="operation-main"><span class="operation-name">会话录制</span><span class="operation-detail">默认关闭，不落盘</span></span><span class="operation-state">已关闭</span></div>
              </div>
              <div class="metrics">
              <div class="metric"><b id="eventCount">0</b><span>坐标批次</span></div><div class="metric"><b id="eventRate">0.0/s</b><span>近 3 秒</span></div><div class="metric"><b id="playerCount">0</b><span>活跃人物</span></div><div class="metric"><b id="captureLatency">—</b><span>采集→WS p99</span></div><div class="metric"><b id="latency">—</b><span>WS→RAF p99</span></div>
              </div>
            </div>
            <div class="section-title players-heading"><span>人物</span><span class="muted" id="playerHint">点击隐藏</span></div><div class="players" id="players"><div class="empty-state compact">等待坐标事件…</div></div>
          </aside>
        </div>
        <footer class="timeline-bar">
          <button id="pause" class="primary" aria-pressed="false">暂停</button><select id="speed" aria-label="回放速度"><option value="0.25">0.25×</option><option value="0.5">0.5×</option><option value="1" selected>1×</option><option value="2">2×</option><option value="4">4×</option></select><div class="timeline"><input id="seek" type="range" min="0" max="1000" value="1000" aria-label="对局时间线"><div class="time-labels"><span id="elapsed">00:00.0</span><span id="duration">00:00.0</span></div></div><button id="live" class="ghost">回到实时</button>
        </footer>
      </section>

      <section class="view" id="connectivityView" data-view-panel="connectivity" aria-labelledby="connectivityTitle" hidden>
        <div class="view-heading"><div><div class="eyebrow">网络与安全</div><h2 id="connectivityTitle">连接管理</h2></div><span class="pill" id="proxyStatusPill">检查中</span></div>
        <div class="content-grid two-col">
          <article class="card feature-card">
            <div class="card-head"><div><div class="card-kicker">代理配置</div><h3>SOCKS5 节点配置</h3></div><span class="status-chip" id="proxyCardState">—</span></div>
            <p class="card-copy">生成选择性 Shadowrocket 配置。完整 <b>.conf</b> 会保持微信登录、DNS 和普通网页直连，同时把已知游戏域名、专用端口与动态对局 UDP 送入 CodeV；配置显式启用 <code>udp-relay=true</code>。</p>
            <div class="inline-meta"><span>TCP CONNECT</span><span>UDP ASSOCIATE</span><span>RFC 1929</span></div>
            <div class="proxy-meta" id="proxyMeta">等待代理状态…</div>
            <div class="proxy-pipeline-grid" aria-label="代理解析阶段"><div class="proxy-pipeline-metric"><small>TCP</small><b id="metricTcp">0</b></div><div class="proxy-pipeline-metric"><small>UDP ASSOC</small><b id="metricUdpAssoc">0</b></div><div class="proxy-pipeline-metric"><small>UDP</small><b id="metricUdp">0</b></div><div class="proxy-pipeline-metric"><small>MNA HELLO</small><b id="metricMnaHello">0</b></div><div class="proxy-pipeline-metric"><small>MNA DATA</small><b id="metricMnaDecrypted">0</b></div><div class="proxy-pipeline-metric"><small>ALT SESSION</small><b id="metricAltSession">0</b></div><div class="proxy-pipeline-metric"><small>SESSION ERR</small><b id="metricSessionError">0</b></div><div class="proxy-pipeline-metric"><small>MNA EVICT</small><b id="metricMnaEvict">0</b></div><div class="proxy-pipeline-metric"><small>MATERIAL</small><b id="metricMaterial">0</b></div><div class="proxy-pipeline-metric"><small>UDP LOCK</small><b id="metricUdpLock">0</b></div><div class="proxy-pipeline-metric"><small>UDP REJOIN</small><b id="metricUdpRejoin">0</b></div><div class="proxy-pipeline-metric"><small>ACTOR UPDATE</small><b id="metricActorUpdate">0</b></div><div class="proxy-pipeline-metric"><small>INVALID POS</small><b id="metricInvalidPosition">0</b></div><div class="proxy-pipeline-metric"><small>REJECT</small><b id="metricReject">0</b></div></div>
            <div class="profile-actions"><button id="createProfile" class="primary" type="button">生成完整配置</button><button id="refreshProxy" class="ghost" type="button">刷新状态</button></div>
            <div class="profile-result" id="profileResult" hidden>
              <div class="result-head"><strong>配置已就绪 · 凭据仅本次可取回</strong><span class="muted" id="profileExpiry">—</span></div>
              <div class="profile-id" id="profileId">—</div>
              <div class="profile-artifacts">
                <div class="artifact-row"><div class="artifact-copy"><strong>完整 .conf · 推荐</strong><small>游戏分流 + UDP relay；普通网页与其他应用保持 DIRECT</small></div><div class="result-actions"><button id="profileConfImport" class="button-link" type="button">一键导入完整配置</button><a id="profileConf" class="button-link" download="codev-shadowrocket.conf">下载 .conf</a></div></div>
                <div class="artifact-row"><div class="artifact-copy"><strong>直接 SOCKS5 节点 · 诊断备用</strong><small>节点 URI 不携带分流规则；全局代理会让非游戏目标被受限服务端拒绝</small></div><div class="result-actions"><button id="copyNode" class="ghost" type="button">复制节点 URI</button><button id="profileImport" class="button-link" type="button">直接添加节点</button><a id="profileQr" class="button-link" target="_blank" rel="noopener">节点二维码</a></div></div>
              </div>
              <div class="notice"><span>!</span><span>连接代理后请彻底结束并冷启动游戏；运行中切换代理可能错过本局初始化数据，无法恢复当前对局。</span></div>
              <div class="result-actions"><button id="rotateProfile" class="ghost danger-text" type="button">轮换当前凭据</button><button id="revokeProfile" class="ghost danger-text" type="button">撤销当前配置</button></div>
            </div>
            <div class="saved-profiles"><div class="saved-profiles-head"><strong>已保存的配置</strong><span>仅保存可撤销元数据；重新获取节点需轮换</span></div><div class="saved-profile-list" id="savedProfileList" aria-live="polite"><div class="profile-empty">正在加载安全元数据…</div></div></div>
          </article>
          <article class="card feature-card"><div class="card-head"><div><div class="card-kicker">HTTPS 检查</div><h3>MITM 与 QUIC</h3></div><span class="status-chip" id="mitmCardState">—</span></div><div class="status-list"><div class="status-row"><span class="status-icon" id="tlsStatusIcon">●</span><span><strong>白名单 HTTPS 检查</strong><small id="tlsCardDetail">状态由会话实时上报</small></span><b id="tlsCardState">已关闭</b></div><div class="status-row"><span class="status-icon" id="quicStatusIcon">●</span><span><strong>UDP / 443</strong><small>白名单域名的 QUIC 会被阻断并回落 TCP</small></span><b id="quicCardState">等待中</b></div></div><div class="notice subtle"><span>ⓘ</span><span>明文只在显式录制开关下写入本地文件，不进入网页。</span></div></article>
        </div>
        <article class="card operations-card"><div class="card-head"><div><div class="card-kicker">运行链路</div><h3>运行组件</h3></div><span class="muted">实时状态</span></div><div class="operations expanded-operations"><div class="operation" id="proxyOperationMirror"><span class="operation-dot"></span><span class="operation-main"><span class="operation-name">SOCKS5 / 捕获</span><span class="operation-detail">等待状态</span></span><span class="operation-state">等待中</span></div><div class="operation" id="tlsOperationMirror"><span class="operation-dot"></span><span class="operation-main"><span class="operation-name">HTTPS MITM</span><span class="operation-detail">等待状态</span></span><span class="operation-state">已关闭</span></div><div class="operation" id="quicOperationMirror"><span class="operation-dot"></span><span class="operation-main"><span class="operation-name">QUIC / UDP 443</span><span class="operation-detail">等待状态</span></span><span class="operation-state">等待中</span></div><div class="operation" id="recordingOperationMirror"><span class="operation-dot"></span><span class="operation-main"><span class="operation-name">会话录制</span><span class="operation-detail">默认关闭</span></span><span class="operation-state">已关闭</span></div></div></article>
      </section>

      <section class="view" id="mapsView" data-view-panel="maps" aria-labelledby="mapsTitle" hidden>
        <div class="view-heading"><div><div class="eyebrow">地图标定与来源</div><h2 id="mapsTitle">地图资源</h2></div><span class="pill warning-pill">候选版本</span></div>
        <article class="card map-selection-card"><div class="card-head"><div><div class="card-kicker">显示标定</div><h3>底图选择</h3></div><div class="segmented" role="group" aria-label="地图模式"><button type="button" class="segment active" id="mapModeAuto">自动</button><button type="button" class="segment" id="mapModeManual">手动</button></div></div><p class="card-copy" id="mapModeHelp">自动模式跟随对局上报的地图编号。手动模式仅在回放时可用，只改变当前浏览器的投影，不会修改会话状态。</p><div class="map-select-row"><label for="manualMap">选择地图</label><select id="manualMap" disabled><option value="">等待清单…</option></select><span class="muted" id="manualMapState">实时对局使用自动模式</span></div></article><div class="map-grid" id="mapCards"><div class="loading-skeleton"></div><div class="loading-skeleton"></div><div class="loading-skeleton"></div></div>
      </section>

      <section class="view" id="replayView" data-view-panel="replay" aria-labelledby="replayTitle" hidden>
        <div class="view-heading"><div><div class="eyebrow">时间线控制</div><h2 id="replayTitle">回放控制</h2></div><span class="pill" id="replayModePill">实时画面</span></div>
        <article class="card replay-card"><div class="replay-hero"><div class="replay-icon">◌</div><div><h3>按时间线查看对局</h3><p>数据采集持续运行；每个浏览器拥有独立的回放进度，数据中断处不会错误插值。</p></div></div><div class="replay-controls"><button id="replayPause" class="primary" type="button" aria-pressed="false">暂停</button><select id="replaySpeed" aria-label="回放速度"><option value="0.25">0.25×</option><option value="0.5">0.5×</option><option value="1" selected>1×</option><option value="2">2×</option><option value="4">4×</option></select><button id="replayLive" class="ghost" type="button">回到实时</button></div><div class="timeline replay-timeline"><input id="replaySeek" type="range" min="0" max="1000" value="1000" aria-label="回放时间线"><div class="time-labels"><span id="replayElapsed">00:00.0</span><span id="replayDuration">00:00.0</span></div></div><div class="replay-state"><span class="status-dot"></span><span id="replayStateText">实时画面</span><span class="muted" id="replayCursor">—</span></div></article><div class="content-grid two-col"><article class="card"><div class="card-kicker">数据连续性</div><h3>坐标状态</h3><p class="card-copy">检测到数据中断后，人物位置会暂时标记为恢复中；收到新的完整坐标后自动恢复正常。</p><div class="continuity-key"><span><i class="key-dot good"></i>正常</span><span><i class="key-dot warn"></i>过期 / 同步中</span><span><i class="key-dot bad"></i>恢复中</span></div></article><article class="card"><div class="card-kicker">性能状态</div><h3>呈现延迟</h3><div class="big-stat" id="replayLatency">—</div><p class="muted">数据到达网页后的显示延迟（P99）</p></article></div></section>

      <section class="view" id="settingsView" data-view-panel="settings" aria-labelledby="settingsTitle" hidden>
        <div class="view-heading"><div><div class="eyebrow">客户端配置</div><h2 id="settingsTitle">设置与帮助</h2></div><span class="pill">隐私优先</span></div>
        <div class="content-grid two-col">
          <article class="card certificate-card"><div class="card-head"><div><div class="card-kicker">iOS 信任设置</div><h3>HTTPS 检查证书</h3></div><span class="status-chip" id="caState">检查中</span></div><p class="card-copy">将 CodeV 检查证书安装到授权 iOS 设备后，才能检查白名单域名的 HTTPS 会话。该证书只用于白名单游戏流量。</p><dl class="facts"><div><dt>状态</dt><dd id="caStatusText">加载中…</dd></div><div><dt>SHA-256</dt><dd class="mono" id="caFingerprint">—</dd></div><div><dt>生成时间</dt><dd id="caGenerated">—</dd></div></dl><div class="download-grid"><a id="caPem" class="button-link" download="codev-ca.pem">PEM</a><a id="caDer" class="button-link" download="codev-ca.der">DER</a><a id="caMobile" class="button-link" download="codev-ca.mobileconfig">iOS 描述文件</a><a id="caReadme" class="button-link" target="_blank" rel="noopener">iOS 安装说明</a></div></article>
          <article class="card help-card"><div class="card-kicker">快速开始</div><h3>在 iPhone 上开始</h3><ol class="steps"><li><span>01</span><p>在此页面下载 <b>iOS 描述文件</b>，安装后在“证书信任设置”开启完全信任。</p></li><li><span>02</span><p>在“连接管理”中生成配置，并使用“一键导入完整配置”或下载配置文件。</p></li><li><span>03</span><p>在 Shadowrocket 选择该配置并开启 UDP 转发；保持规则模式，不要改为全局代理。</p></li><li><span>04</span><p>先连接代理，再彻底结束并重新启动游戏；面板会自动进入实时接收状态。</p></li></ol><div class="notice"><span>⌁</span><span>证书私钥永不导出；轮换证书会使旧证书失效。</span></div></article>
        </div>
        <article class="card privacy-card"><div class="card-kicker">DATA BOUNDARIES</div><h3>隐私与部署</h3><div class="privacy-grid"><div><strong>不会发送到面板</strong><span>会话密钥 · 对局标识 · UID · OpenID · 完整 HTTPS body</span></div><div><strong>当前模式</strong><span>SOCKS5 代理 · localhost / staging HTTP</span></div><div><strong>地图状态</strong><span>候选底图 · 构建绑定与方向待验证</span></div></div></article>
      </section>
    </main>
  </div>
  <nav class="mobile-nav" aria-label="移动端主导航">
    <button class="nav-item active" type="button" data-view="overview" aria-current="page"><span class="nav-icon">◈</span><span>雷达</span><small>总览</small></button>
    <button class="nav-item" type="button" data-view="connectivity"><span class="nav-icon">⌁</span><span>连接</span><small>节点</small></button>
    <button class="nav-item" type="button" data-view="maps"><span class="nav-icon">▧</span><span>地图</span><small>底图</small></button>
    <button class="nav-item" type="button" data-view="replay"><span class="nav-icon">◌</span><span>回放</span><small>时间线</small></button>
    <button class="nav-item" type="button" data-view="settings"><span class="nav-icon">⚙</span><span>设置</span><small>帮助</small></button>
  </nav>
</div>
<!-- 单一雷达控制抽屉；地图外点击 scrim 关闭，数据/WS/画布不重建。 -->
    <button type="button" class="radar-control-toggle" id="radarControlToggle" aria-expanded="false" aria-controls="radarControlSheet">控制</button>
    <div class="radar-control-scrim" id="radarControlScrim" hidden></div>
    <div class="map-controls" id="mapControls">
      <div class="radar-control-sheet" id="radarControlSheet" hidden>
        <div class="radar-control-head"><div><div class="card-kicker">雷达控制</div><strong>视图与目标</strong></div><button type="button" class="radar-control-close" id="radarControlClose" aria-label="关闭雷达控制">×</button></div>
        <section class="radar-control-section" aria-labelledby="radarViewLabel"><div class="radar-control-label" id="radarViewLabel">视图</div><div class="radar-control-grid" role="tablist" aria-label="雷达视图模式"><button type="button" role="tab" class="map-tool active" id="viewRadar" aria-selected="true">2D</button><button type="button" role="tab" class="map-tool" id="viewBoth" aria-selected="false">双视</button><button type="button" role="tab" class="map-tool" id="view3d" aria-selected="false">3D</button></div></section>
        <section class="radar-control-section" aria-labelledby="radarCameraLabel"><div class="radar-control-label" id="radarCameraLabel">镜头</div><div class="radar-control-grid radar-control-grid-compact"><button type="button" class="map-tool" id="fitMap" aria-label="适配地图">适配</button><button type="button" class="map-tool" id="radarFollowToggle" aria-pressed="true">跟随自己</button><button type="button" class="map-tool active" id="radarNorthToggle" aria-pressed="true">北向朝上</button><button type="button" class="map-tool" id="selectSelf" aria-pressed="false" aria-label="在地图上点选自身">选自己</button></div></section>
        <section class="radar-control-section roster-card" id="rosterCard" aria-labelledby="radarTargetLabel"><div class="radar-control-label" id="radarTargetLabel">目标 <small id="rosterCount">0 人物</small></div><div class="filter-grid"><label class="filter-chip on" for="filterSelf"><span>自己</span><input id="filterSelf" type="checkbox" role="switch" checked></label><label class="filter-chip on" for="filterTeam"><span>队友</span><input id="filterTeam" type="checkbox" role="switch" checked></label><label class="filter-chip on" for="filterEnemy"><span>敌人</span><input id="filterEnemy" type="checkbox" role="switch" checked></label></div><div class="scale-row"><span>标记大小</span><input id="markerScale" type="range" min="60" max="170" value="100" step="5" aria-label="标记大小"><span id="markerScaleValue">100%</span></div><div class="roster-list" id="rosterList"><div class="roster-empty">等待实时人物数据</div></div></section>
      </div>
    </div>
<div class="toast-stack" id="toastStack" aria-live="polite" aria-atomic="true"></div>
<script>
(() => {
  'use strict';
  const TOKEN = '__CODEV_SESSION_TOKEN__';
  const PUBLIC_PANEL = TOKEN.length === 0;
  // 局域网共享：A 设备把 <http://A的局域网IP:端口/?access=令牌> 发给 B/C，
  // 对方打开即自动换取会话，不用手输令牌。
  const ACCESS_FROM_URL = (() => {
    try {
      const fromQuery = new URLSearchParams(location.search).get('access');
      if (fromQuery) return fromQuery;
      const hash = location.hash.replace(/^#/, '');
      if (hash.startsWith('access=')) return decodeURIComponent(hash.slice(7));
    } catch {}
    return '';
  })();
  let accessAttempted = false;
  // 本机 / 局域网访问免令牌。
  // 为什么：面板会话只存在引擎内存里，引擎一重启（App 切后台被回收、链路重连）
  // 会话就没了；而 App 内嵌的 WebView 只在页面首次加载时自动换一次令牌，
  // 之后不再重试 —— 结果就是雷达跑着跑着突然跳「请输入管理员令牌」这一页，客户卡死。
  // App 用 127.0.0.1、局域网设备用 192.168.x.x / 10.x / 172.16-31.x，
  // 这两种来源本来就是客户自己的设备，直接放行（公网节点地址不在此列，照旧要令牌）。
  const LOCAL_VIEWER_HOST = (() => {
    const host = location.hostname;
    return host === '127.0.0.1' || host === 'localhost' || host === '::1' || host === '[::1]'
      || /^10\./.test(host)
      || /^192\.168\./.test(host)
      || /^172\.(1[6-9]|2\d|3[01])\./.test(host);
  })();
  const exchangeSession = async token => {
    const response = await fetch('/api/v1/auth/exchange', {
      method:'POST', credentials:'include', headers:{'content-type':'application/json'},
      body: JSON.stringify({token})
    }).catch(() => null);
    if (!response?.ok) return false;
