      if (![baseX,baseY,topX,topY].every(Number.isFinite)) return null;
      const boxHeight=Math.max(3,Math.abs(baseY-topY)*2), boxWidth=Math.max(2,boxHeight/2.5);
      const x=topX-boxWidth/2;
      const y=Math.min(topY,baseY-boxHeight/2)-boxHeight*THREE_D_VERTICAL_LIFT_BODY_HEIGHTS;
