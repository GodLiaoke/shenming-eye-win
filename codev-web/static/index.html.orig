      const projectZ = z => {
        const localZ=z-camera.z;
        const projectedDepth=dx*forward[0]+dy*forward[1]+localZ*forward[2];
        if (!(projectedDepth>1)) return [NaN,NaN];
        const horizontal=dx*right[0]+dy*right[1]+localZ*right[2];
        const vertical=dx*up[0]+dy*up[1]+localZ*up[2];
