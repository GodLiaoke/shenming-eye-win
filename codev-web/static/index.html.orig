    const now = performance.now();
    if (key !== null) selfResolvedSeenMs = now;
    if (key === selfResolvedKey) { selfResolvedPoint = candidate; return candidate; }
    if (selfResolvedKey !== null && now - selfResolvedSince < SELF_SWITCH_DEBOUNCE_MS) {
      return selfResolvedPoint;      // 抖动窗口内沿用上一个"自己"，不让视点跟着甩
