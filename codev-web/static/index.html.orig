  const selfCampRejected = point => {
    if (selfCampId === null || !Number.isInteger(point.camp_id)) { selfCampMismatchSince = 0; return false; }
    if (point.camp_id === selfCampId) { selfCampMismatchSince = 0; return false; }
    const now = performance.now();
    if (!selfCampMismatchSince) selfCampMismatchSince = now;
