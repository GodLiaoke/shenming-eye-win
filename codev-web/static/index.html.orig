  const EMPTY_CARD_DELAY_MS = 1500;
  let emptyCardTimer = null;
  const setEmptyCardVisible = visible => {
    const card = document.getElementById('mapEmpty');
    if (card) card.hidden = !visible;
    document.body.classList.toggle('is-empty', visible);
  };
