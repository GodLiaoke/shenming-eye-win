    // 罗盘刻度：沿地平线每 15° 一格，中间那格是正前方 —— 3D 是"以自己为视点"，
    // 没有这排刻度就完全看不出自己在朝哪边看。
    overlayCtx.save();
    overlayCtx.font = `600 10px ${LABEL_FONT_STACK}`;
    overlayCtx.textAlign = 'center'; overlayCtx.textBaseline = 'bottom';
    for (let deg = 0; deg < 360; deg += 15) {
      const x = (lockNorthUp ? deg : deg) / 360 * width;
      if (x < 6 || x > width - 6) continue;
      const major = deg % 45 === 0;
      overlayCtx.strokeStyle = major ? 'rgba(150,196,236,.34)' : 'rgba(150,196,236,.16)';
      overlayCtx.beginPath();
      overlayCtx.moveTo(x + .5, horizon - (major ? 9 : 5));
      overlayCtx.lineTo(x + .5, horizon);
      overlayCtx.stroke();
      if (major) {
        overlayCtx.fillStyle = 'rgba(160,190,218,.46)';
        overlayCtx.fillText(String(deg), x, horizon - 11);
      }
    }
    overlayCtx.restore();
    // 取景框（四角）只收住下半部分：上半留给世界，不再是个"围起来的盒子"
    const frameTop = horizon + 10;
    const frameInset = 10, frameLen = Math.min(30, Math.max(16, width * .07));
    overlayCtx.strokeStyle='rgba(92,200,255,.30)'; overlayCtx.lineWidth=1.5;
    overlayCtx.beginPath();
    // 左右两条从地平线一路拉到下沿
    overlayCtx.moveTo(frameInset + .5, frameTop + frameLen); overlayCtx.lineTo(frameInset + .5, height - frameInset);
    overlayCtx.moveTo(width - frameInset - .5, frameTop + frameLen); overlayCtx.lineTo(width - frameInset - .5, height - frameInset);
    // 下沿两角
    overlayCtx.moveTo(width - frameInset, height - frameInset - frameLen); overlayCtx.lineTo(width - frameInset, height - frameInset); overlayCtx.lineTo(width - frameInset - frameLen, height - frameInset);
    overlayCtx.moveTo(frameInset + frameLen, height - frameInset); overlayCtx.lineTo(frameInset, height - frameInset); overlayCtx.lineTo(frameInset, height - frameInset - frameLen);
    overlayCtx.stroke();
    // 视点准星：3D 的投影中心就是"你自己"，给一个小十字，画面才有锚
    const cx0b = width / 2, cy0b = height / 2;
    overlayCtx.strokeStyle = 'rgba(92,200,255,.34)';
    overlayCtx.lineWidth = 1.2;
    overlayCtx.beginPath();
    overlayCtx.moveTo(cx0b, cy0b - 17); overlayCtx.lineTo(cx0b, cy0b - 6);
    overlayCtx.moveTo(cx0b, cy0b + 6); overlayCtx.lineTo(cx0b, cy0b + 17);
    overlayCtx.moveTo(cx0b - 17, cy0b); overlayCtx.lineTo(cx0b - 6, cy0b);
    overlayCtx.moveTo(cx0b + 6, cy0b); overlayCtx.lineTo(cx0b + 17, cy0b);
    overlayCtx.stroke();
    // 视线读数：正前方（你自己朝向）与"这就是你自己"两句话，替代原来一行干巴巴的字
    overlayCtx.save();
    overlayCtx.font = '700 12px ui-monospace, SFMono-Regular, Menlo, monospace';
    overlayCtx.textAlign = 'center'; overlayCtx.textBaseline = 'middle';
    overlayCtx.fillStyle = 'rgba(255,216,77,.88)';
    overlayCtx.fillText(String(Math.round(((stableYaw(selfSlot, selfPoint.yaw, selfPoint.updated_ns) % 360) + 360) % 360)) + '°', cx0b, cy0b + 30);
    overlayCtx.restore();
    const selectedSelfPoint=selfSlot===null?null:current.get(selfSlot);
    const selfPoint=isActiveRadarPoint(selectedSelfPoint)?selectedSelfPoint:null;
    if (!selfPoint) {
      // 空状态只占一小块，地图（上面那一格）该看什么还看得见。
      // 措辞也说清"3D 为什么是空的" —— 认不出自己时雷达本身是正常的。
      const cw = Math.min(300, width - 44), ch = 74;
      const cx0 = width / 2 - cw / 2, cy0 = height / 2 - ch / 2;
      overlayCtx.save();
      overlayCtx.beginPath();
      if (overlayCtx.roundRect) overlayCtx.roundRect(cx0, cy0, cw, ch, 15); else overlayCtx.rect(cx0, cy0, cw, ch);
      overlayCtx.fillStyle='rgba(6,13,24,.72)'; overlayCtx.fill();
      overlayCtx.strokeStyle='rgba(150,196,236,.16)'; overlayCtx.lineWidth=1; overlayCtx.stroke();
      overlayCtx.textAlign='center'; overlayCtx.textBaseline='middle';
      overlayCtx.fillStyle='rgba(233,242,251,.94)';
      overlayCtx.font='650 15px -apple-system,BlinkMacSystemFont,sans-serif';
      overlayCtx.fillText('3D 视角待定位', width/2, cy0 + 26);
      overlayCtx.fillStyle='rgba(150,172,196,.88)';
      overlayCtx.font='12.5px -apple-system,BlinkMacSystemFont,sans-serif';
      overlayCtx.fillText('还没认出你（自己）在场上哪一个点', width/2, cy0 + 48);
      overlayCtx.restore();
      return;
    }
    // 3D 相机和 2D 跟随必须共用同一条稳定朝向链，不能绕过 stableYaw 直读原始值。
    const cameraYaw=stableYaw(selfPoint.slot,selfPoint.yaw,selfPoint.updated_ns);
    const camera={x:selfPoint.world.x,y:selfPoint.world.y,z:selfPoint.world.z+160,pitch:selfPoint.pitch,yaw:cameraYaw};
    const project=createWorldProjector(camera,width,height);
    const projectedTargets=drawablePoints()
      .filter(point=>point.slot!==selfSlot&&visible.get(point.slot)!==false)
      .filter(point=>!(hideTeam3d&&roleForPoint(point)==='team'))
      .map(point=>({point,rect:project(point.world),role:roleForPoint(point),metrics:threatMetricsFor(point,selfPoint)}));
    const targets=projectedTargets
      .filter(entry=>entry.rect?.onScreen)
      .sort((a,b)=>b.rect.depth-a.rect.depth);
    const nearestEnemy=projectedTargets.filter(entry=>entry.role==='enemy'&&entry.metrics)
      .reduce((nearest,entry)=>!nearest||entry.metrics.distanceMeters<nearest.metrics.distanceMeters?entry:nearest,null);
    if (showThreats) {
      for (const entry of projectedTargets) {
        const centerX=entry.rect?.x+entry.rect?.width/2, centerY=entry.rect?.y+entry.rect?.height/2;
        if (entry.role==='enemy'&&!entry.rect?.onScreen&&Number.isFinite(centerX)&&Number.isFinite(centerY)) {
          drawOffscreenThreat(overlayCtx,width,height,centerX,centerY,entry.metrics);
        }
      }
    }
    for (const {point,rect,role,metrics} of targets) {
      const color=markerColors[role];
      const boxHeight=Math.max(10,Math.min(height*1.2,rect.height));
      const boxWidth=Math.max(5,Math.min(width*.5,rect.width));
      const x=rect.x+(rect.width-boxWidth)/2, y=rect.y+(rect.height-boxHeight)/2;
      const style=continuityStyle(point.continuity);
      overlayCtx.globalAlpha=style.alpha * (pointAgeMs(point) > STALE_DIM_AFTER_MS ? 0.5 : 1);
      if (showThreats&&role==='enemy'&&metrics&&(metrics.critical||metrics.approaching)) {
        overlayCtx.fillStyle=metrics.approaching?'rgba(255,77,95,.13)':'rgba(255,77,95,.07)';
        overlayCtx.fillRect(x-4,y-4,boxWidth+8,boxHeight+8);
      }
      overlayCtx.strokeStyle=`${color}66`;overlayCtx.lineWidth=1;overlayCtx.beginPath();overlayCtx.moveTo(width/2,4);overlayCtx.lineTo(x+boxWidth/2,y);overlayCtx.stroke();
      drawCornerBox(overlayCtx,x,y,boxWidth,boxHeight,color);
      if (showThreats&&nearestEnemy?.point.slot===point.slot) {
        overlayCtx.strokeStyle='rgba(255,211,114,.9)';overlayCtx.lineWidth=1.5;overlayCtx.strokeRect(x-3,y-3,boxWidth+6,boxHeight+6);
      }
      const distance=metrics?.distanceMeters??Math.hypot(point.world.x-selfPoint.world.x,point.world.y-selfPoint.world.y,point.world.z-selfPoint.world.z)/100;
      const distanceLabel=`${Math.round(distance)}m${showThreats&&metrics?` · ${heightLabelFor(metrics.heightMeters)}`:''}`;
      overlayCtx.font=`700 10px ${LABEL_FONT_STACK}`;overlayCtx.textAlign='center';overlayCtx.textBaseline='top';
      overlayCtx.lineWidth=3;overlayCtx.strokeStyle='rgba(2,8,12,.92)';overlayCtx.strokeText(distanceLabel,x+boxWidth/2,y+boxHeight+4);
      overlayCtx.fillStyle=color;overlayCtx.fillText(distanceLabel,x+boxWidth/2,y+boxHeight+4);
      if (showThreats&&role==='enemy'&&metrics&&(metrics.approaching||nearestEnemy?.point.slot===point.slot)) {
        const threatLabel=metrics.approaching?`接近 ${metrics.approachSpeed.toFixed(1)}m/s`:
          (metrics.receding?`远离 ${Math.abs(metrics.approachSpeed).toFixed(1)}m/s`:'最近敌人');
        overlayCtx.textBaseline='bottom';overlayCtx.lineWidth=3;overlayCtx.strokeStyle='rgba(2,8,12,.94)';overlayCtx.strokeText(threatLabel,x+boxWidth/2,y-5);
        overlayCtx.fillStyle=metrics.approaching?'#ff7180':'#ffd372';overlayCtx.fillText(threatLabel,x+boxWidth/2,y-5);
      }
      overlayCtx.globalAlpha=1;
    }
    const heading=((selfPoint.yaw%360)+360)%360;
    overlayCtx.fillStyle='rgba(3,11,16,.72)';overlayCtx.fillRect(width/2-64,12,128,25);
    overlayCtx.fillStyle='#63d7d0';overlayCtx.font=`700 10px ${LABEL_FONT_STACK}`;overlayCtx.textAlign='center';overlayCtx.textBaseline='middle';
    overlayCtx.fillText(`3D · ${Math.round(heading)}° · ${targets.length} 可见`,width/2,24.5);
    const cx=width/2,cy=height/2,size=10;
    overlayCtx.strokeStyle='#69d9ad';overlayCtx.lineWidth=1.5;overlayCtx.beginPath();
    overlayCtx.moveTo(cx-size,cy);overlayCtx.lineTo(cx-3,cy);overlayCtx.moveTo(cx+3,cy);overlayCtx.lineTo(cx+size,cy);
    overlayCtx.moveTo(cx,cy-size);overlayCtx.lineTo(cx,cy-3);overlayCtx.moveTo(cx,cy+3);overlayCtx.lineTo(cx,cy+size);overlayCtx.stroke();
    if (showThreats&&nearestEnemy) drawThreatHud(overlayCtx,width,height,nearestEnemy.metrics);
  };
  // 自适应降载：双视模式下两块画布每帧都要重绘；上一帧一旦超过预算，这一帧就把 3D
  // （次要视图）跳过去（等效 30Hz），先保住 2D 不掉帧。3D 单独显示时仍然是全帧率。
  let lastFrameCostMs = 0, overlaySkipToggle = false;
  const draw = () => {
    const t0 = performance.now();
    if (viewMode !== 'overlay') {
      const t = performance.now(); drawRadar(); perfDynamicMs = performance.now() - t - perfStaticMs;
      perfDrawCount++;
    }
    if (viewMode !== 'radar') {
      const underPressure = viewMode === 'both' && lastFrameCostMs > 11;
      overlaySkipToggle = underPressure ? !overlaySkipToggle : false;
      if (!overlaySkipToggle) {
        const t = performance.now(); drawOverlay(); perf3dMs = performance.now() - t;
      }
    }
    lastFrameCostMs = performance.now() - t0;
  };

  const handleMessage = data => {
    if (!data || data.schema_version !== 1) return;
    if (typeof data.session_id === 'string' && wireSessionId !== null && data.session_id !== wireSessionId) {
      clearTracks(); startNs = null; latestNs = null; cursorNs = null; lastDeltaSeq = 0;
    }
    if (typeof data.session_id === 'string') wireSessionId = data.session_id;
    if (data.kind === 'hello') {
      const configuredSpeed = Number(data.payload?.initial_playback_speed);
      speed = [0.25,0.5,1,2,4].includes(configuredSpeed) ? configuredSpeed : 1;
      document.getElementById('speed').value = String(speed);
      live = data.payload?.starts_at_live_edge !== false;
      setConnection('已连接','good');
    }
    if (data.kind === 'session_status') { wsSessionSeen = true; updateSession(data.payload); }
    if (data.kind === 'map_roster') {
      wsSessionSeen = true;   // WS 是权威：一旦给过会话，REST 兜底就不再插手
      manifest=data.payload?.maps||manifest;
      updateOperations(data.payload);
      updateSession(data.payload?.session);
      updateRoster(data.payload?.roster);
      applyEngineBinding(data.payload?.binding);
    }
    if (data.kind === 'position_delta' && Number(data.seq) > lastDeltaSeq) {
      lastDeltaSeq = Number(data.seq);
      pendingRafReceipts.set(lastDeltaSeq, performance.now());
      ingestPositions(data.payload?.positions, data.capture_ns);
    }
    if (data.kind === 'snapshot') {
      pendingRafReceipts.set(Number(data.seq) || 0, performance.now());
      replaceSnapshot(data.payload?.positions, data.capture_ns, data.payload?.reason || 'initial');
    }
    if (data.kind === 'gap') {
      if (live && !paused) {
        for (const point of current.values()) point.continuity = 'degraded';
      }
      setConnection(`数据缺口 ${data.payload.first_missing}–${data.payload.last_missing}`,'bad');
      rebuildPlayers(); needsDraw = true;
    }
    if (data.kind === 'metrics') {
      syncEmptyState();   // 顺带刷新空状态卡片里的三步状态
      updateOperations(data.payload);
      updateProxyPipelineMetrics(data.payload);
      const coordinateUpdates = Number(data.payload?.coordinate_updates);
      if (Number.isSafeInteger(coordinateUpdates) && coordinateUpdates >= 0) eventCount = coordinateUpdates;
      const formatLatency = value => Number.isFinite(Number(value)) ? `${Number(value).toFixed(1)} ms` : '—';
      // 云端→WS 这一段计时随「云端解析」一起下线；元素已删，这里必须一起删，
      // 否则 getElementById 返回 null，整条统计回调会抛异常（渲染循环不能被打死）。
      document.getElementById('captureLatency').textContent = formatLatency(data.payload.capture_to_ws_p99_ms);
    }
    if (data.kind === 'end') setConnection(data.payload?.complete ? '对局结束' : '对局不完整','bad');
    document.getElementById('eventCount').textContent = eventCount.toLocaleString();
  };

  const sendControl = message => {
    if (ws?.readyState === WebSocket.OPEN) ws.send(JSON.stringify(message));
  };
  const requestSeek = (captureNs, immediate=false) => {
    pendingSeekNs = Math.max(0, Math.round(captureNs));
    const transmit = () => {
      pendingSeekTimer = null;
      if (pendingSeekNs == null) return;
      sendControl({action: 'seek', capture_ns: pendingSeekNs});
      pendingSeekNs = null;
      lastSeekSentAt = performance.now();
    };
    if (immediate || performance.now() - lastSeekSentAt >= 50) {
      if (pendingSeekTimer !== null) clearTimeout(pendingSeekTimer);
      transmit();
    } else if (pendingSeekTimer === null) {
      pendingSeekTimer = setTimeout(transmit, 50 - (performance.now() - lastSeekSentAt));
    }
  };

  const ensureAuth = async ({force = false} = {}) => {
    if (!PUBLIC_PANEL) return true;
    // 本机/局域网面板由引擎的 allow_lan_hosts 直接放行 HTTP/WS，
    // 不需要再走公网 Cookie 交换。App 的 WKWebView 若先对 127.0.0.1
    // 发起 exchange，WebKit 可能把请求挂起，结果页面停在“连接中”而根本没有创建 WS。
    // 外网/房间页仍必须走 access 交换。
    if (LOCAL_VIEWER_HOST) {
      document.getElementById('authGate').hidden = true;
      // 本机面板（App 里的 127.0.0.1:18080）的 WS 由引擎白名单放行，所以"连接"从来没问题；
      // 但页面**启动时从不主动取会话** —— 唯一取会话的地方在下面"非本机"那条分支里。
      // 于是页面只靠 WS 的 session_status / map_roster **变更广播**学会话：只要它连上得
      // 晚于最后一次广播，就永远停在初始态 —— 表现就是 App 里那句
      // "等待对局数据"+ "地图未识别"，什么都不画（而画中画不依赖这个，所以它一直正常）。
      // 这里补两步：启动取一次；仍未开局就每 2 秒轮询，一旦 live/replay 立即停。
      const seedSession = () => fetch('/api/v1/session', {credentials:'include'})
        .then(response => (response.ok ? response.json() : null))
        .then(body => {
          // WS 已经给过会话（或已经 live/replay）→ 不覆盖，避免状态来回跳造成闪烁
          if (!body || wsSessionSeen) return;
          if (session.status === 'live' || session.status === 'replay') return;
          updateSession(body);
        })
        .catch(() => {});
      void seedSession();
      if (sessionSeedTimer === null) {
        sessionSeedTimer = setInterval(() => {
          if (wsSessionSeen || session.status === 'live' || session.status === 'replay') {
            clearInterval(sessionSeedTimer);
            sessionSeedTimer = null;
            return;
          }
          void seedSession();
        }, 2000);
      }
      return true;
    }
    if (!force) {
      const existing = await fetch('/api/v1/session', {credentials:'include'}).catch(() => null);
      if (existing?.ok) {
        document.getElementById('authGate').hidden = true;
        return true;
      }
      if (ACCESS_FROM_URL && !accessAttempted) {
        accessAttempted = true;
        if (await exchangeSession(ACCESS_FROM_URL)) {
          document.getElementById('authGate').hidden = true;
          return true;
        }
      }
    }
    if (authPromise) return authPromise;
    const gate = document.getElementById('authGate');
    const form = document.getElementById('authForm');
    const input = document.getElementById('authToken');
    const error = document.getElementById('authError');
    gate.hidden = false;
    authPromise = new Promise(resolve => {
      form.onsubmit = async event => {
        event.preventDefault();
        error.textContent = '';
        if (!(await exchangeSession(input.value.trim()))) {
          error.textContent = '令牌无效或已过期';
          input.select();
          return;
        }
        input.value = '';
        gate.hidden = true;
        resolve(true);
      };
    });
    const pending = authPromise;
    void pending.finally(() => { if (authPromise === pending) authPromise = null; });
    return pending;
  };

  const connect = async () => {
    if (!(await ensureAuth())) return;
    const protocol = location.protocol === 'https:' ? 'wss' : 'ws';
    const query = PUBLIC_PANEL ? '' : `?token=${encodeURIComponent(TOKEN)}`;
    const socket = new WebSocket(`${protocol}://${location.host}/api/v1/ws${query}`);
    ws = socket;
    socket.onopen = () => {
      reconnectDelayMs = 1000;
      if (reconnectTimer !== null) { clearTimeout(reconnectTimer); reconnectTimer = null; }
      setConnection('实时连接','good');
    };
    socket.onmessage = event => { try { handleMessage(JSON.parse(event.data)); } catch(error) { console.warn(error); } };
    socket.onerror = () => setConnection('连接错误','bad');
    socket.onclose = () => {
      if (ws !== socket) return;
      if (reconnectTimer !== null) clearTimeout(reconnectTimer);
      const delay = reconnectDelayMs;
      reconnectDelayMs = Math.min(30000, Math.round(reconnectDelayMs * 1.8));
      // 重连只在"断了一小会儿"之后才提示，避免开着面板时状态条一直在跳
      if (delay >= 3000) setConnection(`重连中 · ${Math.ceil(delay / 1000)}s`);
      else setConnection('已连接','good');
      reconnectTimer = setTimeout(() => { reconnectTimer = null; connect(); }, delay);
    };
  };

  const switchView = name => {
    document.querySelectorAll('[data-view-panel]').forEach(view => { const active = view.dataset.viewPanel === name; view.hidden = !active; view.classList.toggle('active', active); });
    document.querySelectorAll('.nav-item').forEach(item => { const active = item.dataset.view === name; item.classList.toggle('active', active); if (active) item.setAttribute('aria-current', 'page'); else item.removeAttribute('aria-current'); });
    const sidebar = document.getElementById('sidebar'); if (sidebar) sidebar.classList.remove('open'); const menu = document.getElementById('mobileMenu'); if (menu) menu.setAttribute('aria-expanded', 'false');
    if (name === 'connectivity') Promise.allSettled([loadProxyStatus(), loadProfiles()]);
    needsDraw = true;
  };
  const radarControlSheet = document.getElementById('radarControlSheet');
  const radarControlToggle = document.getElementById('radarControlToggle');
  const radarControlClose = document.getElementById('radarControlClose');
  const radarControlScrim = document.getElementById('radarControlScrim');
  const selectSelfButton = document.getElementById('selectSelf');
  let radarControlOpen = false;
  const setRadarControlOpen = open => {
    radarControlOpen = Boolean(open);
    if (radarControlSheet) radarControlSheet.hidden = !radarControlOpen;
    if (radarControlScrim) radarControlScrim.hidden = !radarControlOpen;
    if (radarControlToggle) {
      radarControlToggle.setAttribute('aria-expanded', String(radarControlOpen));
      radarControlToggle.classList.toggle('active', radarControlOpen);
    }
  };
  // 保留引擎绑定调用点；手动入口现在就是控制抽屉里的「选自己」，不再动态注入诊断行。
  const removeSelfDiagnostic = () => {};
  const setSelectingSelf = value => {
    selectingSelf = Boolean(value);
    canvas.classList.toggle('selecting-self', selectingSelf);
    if (selectSelfButton) {
      selectSelfButton.classList.toggle('selecting', selectingSelf);
      selectSelfButton.setAttribute('aria-pressed', String(selectingSelf));
      selectSelfButton.textContent = selectingSelf ? '点图标' : '选自己';
    }
    if (selectingSelf) toast('点地图上的人物；再点一次「选自己」取消', 'info');
  };
  radarControlToggle?.addEventListener('click', () => setRadarControlOpen(!radarControlOpen));
  // WKWebView 会把连续两次点击当作页面缩放手势；控制按钮只负责开关抽屉。
  radarControlToggle?.addEventListener('dblclick', event => {
    event.preventDefault();
    event.stopPropagation();
  }, { passive: false });
  radarControlClose?.addEventListener('click', () => setRadarControlOpen(false));
  radarControlScrim?.addEventListener('click', () => setRadarControlOpen(false));
  // 横竖屏切换时 WebView 的 visual viewport 会先变、布局再变；关掉抽屉并让下一帧重算画布，
  // 避免旧方向的控制层位置/画布尺寸残留在新方向。
  const syncRadarViewport = () => {
    setRadarControlOpen(false);
    needsDraw = true;
    requestAnimationFrame(() => { needsDraw = true; });
  };
  window.addEventListener('resize', syncRadarViewport, { passive: true });
  window.addEventListener('orientationchange', () => setTimeout(syncRadarViewport, 80), { passive: true });
  window.visualViewport?.addEventListener('resize', syncRadarViewport, { passive: true });
  document.getElementById('radarFollowToggle')?.addEventListener('click', () => {
    showFollow = !showFollow;
    try { localStorage.setItem('codev.display.follow', showFollow ? '1' : '0'); } catch {}
    syncDisplayPreferences(true);
    toast(showFollow ? '已开启跟随自己' : '已切换为自由视图', 'good');
  });
  document.getElementById('radarNorthToggle')?.addEventListener('click', () => {
    lockNorthUp = !lockNorthUp;
    try { localStorage.setItem(RADAR_NORTH_KEY, lockNorthUp ? '1' : '0'); } catch {}
    smoothView = null; resetViewSamples();
    syncDisplayPreferences(true, true);
    toast(lockNorthUp ? '已锁定正北朝上' : '已跟随自身朝向', 'good');
  });
  document.getElementById('mapEmptyHelpToggle')?.addEventListener('click', event => {
    const button = event.currentTarget;
    const steps = document.getElementById('mapEmptySteps');
    const open = Boolean(steps && steps.hidden);
    if (steps) steps.hidden = !open;
    button.setAttribute('aria-expanded', String(open));
  });
  document.querySelectorAll('.nav-item').forEach(item => item.addEventListener('click', () => switchView(item.dataset.view)));
  document.getElementById('mobileMenu')?.addEventListener('click', () => { const sidebar = document.getElementById('sidebar'); const open = sidebar?.classList.toggle('open') || false; document.getElementById('mobileMenu')?.setAttribute('aria-expanded', String(open)); });
  for (const [id,mode,label] of [['viewRadar','radar','二维雷达'],['viewBoth','both','2D / 3D 双视'],['view3d','overlay','三维透视']]) {
    document.getElementById(id)?.addEventListener('click', () => {
      viewMode=mode; syncViewMode(true); setRadarControlOpen(false); toast(`已切换到${label}`, 'good');
    });
  }
  const resetViewToFit = (message) => {
    panOffsetX = 0; panOffsetY = 0; viewZoom = 1; panMode = false;
    smoothView = null; resetViewSamples(); followHold = null;
    needsDraw = true;
    if (message) toast(message, 'good');
  };
  document.getElementById('fitMap')?.addEventListener('click', () => { resetViewToFit('已适配：整张地图进画布'); setRadarControlOpen(false); });
  // 双击人物标记 → 现场校准英雄头像（只存本机）
  canvas.addEventListener('dblclick', event => {
    event.preventDefault();
    resetViewToFit('已回到自己（重置缩放与平移）');
    return;
  });
  selectSelfButton?.addEventListener('click', () => {
    if (viewMode === 'overlay') { viewMode='radar'; syncViewMode(true); }
    setSelectingSelf(!selectingSelf);
    if (selectingSelf) {
      // 选点必须把遮罩一起收起，否则 scrim 会先吃掉地图点击，用户永远点不中人物。
      setRadarControlOpen(false);
      toast('请在地图上点击代表你自己的方向图标', 'info');
    }
  });
  canvas.addEventListener('click', event => {
    if (!selectingSelf) return;
    const rect = canvas.getBoundingClientRect();
    const x = event.clientX - rect.left, y = event.clientY - rect.top;
    const nearest = markerHits.map(hit => ({...hit, distance: Math.hypot(hit.x-x, hit.y-y)})).sort((a,b) => a.distance-b.distance)[0];
    if (!nearest || nearest.distance > 28) {
      toast('没有点中人物图标，请再试一次', 'info');
      return;
    }
    setSelfSlot(nearest.slot, true);
    selfSlotManual = true;
    selfManualGen = channelGeneration;
    try { localStorage.setItem('codev.display.selfManual', '1'); } catch {}
    const chosen = current.get(nearest.slot);
    if (chosen && chosen.track_id) {
      selfTrackId = chosen.track_id;
      try { localStorage.setItem('codev.display.selfTrack', selfTrackId); } catch {}
    }
    if (chosen && Number.isInteger(chosen.camp_id)) {
      selfCampId = chosen.camp_id;
      try { localStorage.setItem('codev.display.selfCamp', String(selfCampId)); } catch {}
    }
    resetViewToFit(null);
    setSelectingSelf(false);
    toast('已将黄色图标设为自身（按身份跟踪，换局不会跑偏）', 'good');
  });
  // 拦截页面级缩放：双指捏合（Safari 的 gesture*）和 Ctrl+滚轮都只在 2D 上生效，
  // 避免整页缩放把右侧 3D 视角一起放大/缩小（3D 尺寸锁死，不受 2D 缩放影响）。
  for (const name of ['gesturestart', 'gesturechange', 'gestureend']) {
    mapVisuals.addEventListener(name, event => event.preventDefault(), { passive: false });
  }
  mapVisuals.addEventListener('wheel', event => { if (event.ctrlKey) event.preventDefault(); }, { passive: false });

  // 按住拖动平移（拖动时自动暂停"跟随自己"，松手后可用双击/适配复位）
  let dragState = null;
  canvas.addEventListener('pointerdown', event => {
    if (selectingSelf) return;
    dragState = { x: event.clientX, y: event.clientY, panX: panOffsetX, panY: panOffsetY, moved: false };
    canvas.setPointerCapture?.(event.pointerId);
  });
  canvas.addEventListener('pointermove', event => {
    if (!dragState) return;
    const dx = event.clientX - dragState.x, dy = event.clientY - dragState.y;
    if (!dragState.moved && Math.abs(dx) + Math.abs(dy) < 4) return;
    dragState.moved = true;
    panMode = true;
    panOffsetX = dragState.panX + dx;
    panOffsetY = dragState.panY + dy;
    needsDraw = true;
  });
  canvas.addEventListener('pointerup', event => {
    if (dragState && dragState.moved) toast('已暂停跟随；双击或点「适配」回到自己', 'info');
    dragState = null;
    canvas.releasePointerCapture?.(event.pointerId);
  });
  canvas.addEventListener('pointercancel', () => { dragState = null; });
  // 滚轮缩放（以光标为中心）
  canvas.addEventListener('wheel', event => {
    event.preventDefault();
    const rect = canvas.getBoundingClientRect();
    const cx = rect.width / 2, cy = rect.height / 2;
    const factor = event.deltaY < 0 ? 1.08 : 1 / 1.08;
    const nextZoom = Math.min(VIEW_MAX_ZOOM, Math.max(VIEW_MIN_ZOOM, viewZoom * factor));
    const px = event.clientX - rect.left, py = event.clientY - rect.top;
    panOffsetX = px - cx - (px - cx - panOffsetX) * (nextZoom / viewZoom);
    panOffsetY = py - cy - (py - cy - panOffsetY) * (nextZoom / viewZoom);
    viewZoom = nextZoom;
    panMode = true;
    needsDraw = true;
  }, { passive: false });
  // ---- 阵营筛选 / 标记大小 的控件接线 ----
  const syncCampFilterControls = () => {
    for (const [id, key] of [['filterSelf','self'],['filterTeam','team'],['filterEnemy','enemy'],['filterDead','dead']]) {
      const input = document.getElementById(id);
      if (!input) continue;
      input.checked = Boolean(campFilter[key]);
      input.closest('.filter-chip')?.classList.toggle('on', Boolean(campFilter[key]));
    }
    const slider = document.getElementById('markerScale');
    if (slider) slider.value = String(Math.round(markerScale * 100));
    const label = document.getElementById('markerScaleValue');
    if (label) label.textContent = `${Math.round(markerScale * 100)}%`;
    needsDraw = true;
  };
  for (const [id, key] of [['filterSelf','self'],['filterTeam','team'],['filterEnemy','enemy'],['filterDead','dead']]) {
    document.getElementById(id)?.addEventListener('change', event => {
      campFilter[key] = Boolean(event.target.checked);
      persistCampFilter();
      syncCampFilterControls();
    });
  }
  // 目标筛选和标记大小属于同一个「目标」分组；不再有独立列表/显示面板。
  document.getElementById('markerScale')?.addEventListener('input', event => {
    const value = Number(event.target.value);
    if (!Number.isFinite(value)) return;
    markerScale = Math.max(0.6, Math.min(1.7, value / 100));
    try { localStorage.setItem('codev.display.markerScale', String(Math.round(markerScale * 100))); } catch {}
    syncCampFilterControls();
  });
  syncCampFilterControls();
  // ---- 地名标注编辑器（只有 ?labels=1 时启用，正常使用完全不受影响）----
  const labelEditorPanel = document.getElementById('labelEditor');
  const labelEditorMapLabel = document.getElementById('labelEditorMap');
  const labelNameInput = document.getElementById('labelNameInput');
  const labelKindSelect = document.getElementById('labelKindSelect');
  const labelList = document.getElementById('labelList');
  const labelRowsForCurrentMap = () => {
    const mapId = Number(calibration?.map_id);
    if (!Number.isInteger(mapId)) return null;
    if (!Array.isArray(MAP_LABELS[mapId])) MAP_LABELS[mapId] = [];
    return MAP_LABELS[mapId];
  };
  const renderLabelEditor = () => {
    if (!labelEditorPanel || labelEditorPanel.hidden) return;
    const rows = labelRowsForCurrentMap();
    if (labelEditorMapLabel) {
      labelEditorMapLabel.textContent = calibration
        ? `${calibration.name || `地图 ${calibration.map_id}`} · ${rows ? rows.length : 0} 个`
        : '等待地图标定';
    }
    if (labelList) {
      labelList.replaceChildren();
      for (const [index, row] of (rows || []).entries()) {
        const item = document.createElement('div'); item.className = 'label-editor-item';
        const name = document.createElement('span');
        name.textContent = `${row.kind === 'site' ? '◆' : (row.kind === 'spawn' ? '◇' : '·')} ${row.text}  u${Number(row.u).toFixed(3)} v${Number(row.v).toFixed(3)}`;
        name.title = '点击填入下面的编辑框';
        name.style.cursor = 'pointer';
        name.addEventListener('click', () => {
          if (labelNameInput) labelNameInput.value = row.text;
          if (labelKindSelect) labelKindSelect.value = row.kind || 'area';
        });
        const remove = document.createElement('button'); remove.type = 'button'; remove.textContent = '×';
        remove.setAttribute('aria-label', `删除 ${row.text}`);
        remove.addEventListener('click', () => { rows.splice(index, 1); renderLabelEditor(); needsDraw = true; });
        item.append(name, remove);
        labelList.appendChild(item);
      }
    }
    needsDraw = true;
  };
  const labelExportJson = () => {
    const out = {};
    for (const [key, rows] of Object.entries(MAP_LABELS)) {
      if (!Array.isArray(rows) || !rows.length) continue;
      out[key] = rows.map(row => ({
        u: Number(Number(row.u).toFixed(4)),
        v: Number(Number(row.v).toFixed(4)),
        text: row.text,
        kind: row.kind || 'area'
      }));
    }
    return JSON.stringify(out);
  };
  if (labelEditorEnabled && labelEditorPanel) {
    labelEditorPanel.hidden = false;
    document.querySelector('.map-panel')?.classList.add('label-editing');
    renderLabelEditor();
    document.getElementById('labelEditorClose')?.addEventListener('click', () => { labelEditorPanel.hidden = true; });
    document.getElementById('labelCopy')?.addEventListener('click', async () => {
      const text = labelExportJson();
      try { await copyText(text); toast('地名 JSON 已复制，发我写进引擎内置表', 'good'); }
      catch { window.prompt('复制失败，手动复制这段 JSON：', text); }
      console.log('map-labels', text);
    });
    document.getElementById('labelClear')?.addEventListener('click', () => {
      const rows = labelRowsForCurrentMap();
      if (!rows) { toast('还没识别到地图', 'info'); return; }
      rows.length = 0;
      renderLabelEditor();
      toast('已清空本图地名（刷新页面即恢复内置数据）', 'info');
    });
    // 事件挂在 mapVisuals 的捕获阶段：一定先于画布上的平移/缩放处理器执行，
    // 拖地名时用 stopPropagation 拦住平移，避免"拖字变成拖地图"。
    const editorPoint = event => {
      const rect = canvas.getBoundingClientRect();
      return { x: event.clientX - rect.left, y: event.clientY - rect.top };
    };
    const editorHit = (x, y) => labelHits
      .map(hit => ({ ...hit, distance: Math.hypot(hit.x - x, hit.y - y) }))
      .filter(hit => hit.distance <= 18)
      .sort((a, b) => a.distance - b.distance)[0];
    const editorPickUv = (x, y) => {
      if (!labelProjection) return null;
      const { u, v } = labelProjection.unproject(x, y);
      if (!Number.isFinite(u) || !Number.isFinite(v)) return null;
      return { u: Math.min(1.05, Math.max(-0.05, u)), v: Math.min(1.05, Math.max(-0.05, v)) };
    };
    mapVisuals.addEventListener('pointerdown', event => {
      if (event.target !== canvas || !calibration) return;
      const { x, y } = editorPoint(event);
      const hit = editorHit(x, y);
      if (!hit) return;
      labelEditorDrag = { index: hit.index };
      labelEditorMoved = false;
      canvas.setPointerCapture?.(event.pointerId);
      event.stopPropagation();
      needsDraw = true;
    }, { capture: true });
    mapVisuals.addEventListener('pointermove', event => {
      if (!labelEditorDrag || event.target !== canvas) return;
      const rows = labelRowsForCurrentMap();
      const { x, y } = editorPoint(event);
      const uv = editorPickUv(x, y);
      const row = rows && rows[labelEditorDrag.index];
      if (!row || !uv) return;
      labelEditorMoved = true;
      row.u = uv.u;
      row.v = uv.v;
      event.stopPropagation();
      needsDraw = true;
    }, { capture: true });
    mapVisuals.addEventListener('pointerup', event => {
      if (!labelEditorDrag) return;
      labelEditorDrag = null;
      canvas.releasePointerCapture?.(event.pointerId);
      renderLabelEditor();
      event.stopPropagation();
    }, { capture: true });
    mapVisuals.addEventListener('contextmenu', event => {
      if (event.target !== canvas) return;
      const { x, y } = editorPoint(event);
      const hit = editorHit(x, y);
      if (!hit) return;
      const rows = labelRowsForCurrentMap();
      if (!rows) return;
      event.preventDefault();
      event.stopPropagation();
      rows.splice(hit.index, 1);
      renderLabelEditor();
      toast('已删除该地名', 'info');
    }, { capture: true });
    canvas.addEventListener('click', event => {
      if (labelEditorMoved) { labelEditorMoved = false; return; }
      const rows = labelRowsForCurrentMap();
      const { x, y } = editorPoint(event);
      const uv = editorPickUv(x, y);
      if (!rows || !uv) { toast('底图还没加载好，稍后再点', 'info'); return; }
      if (editorHit(x, y)) return;    // 点在已有地名上 → 交给拖动
      const text = (labelNameInput?.value || '').trim() || '新地名';
      rows.push({ u: uv.u, v: uv.v, text, kind: labelKindSelect?.value || 'area' });
      renderLabelEditor();
      toast(`已加「${text}」（拖动能微调，右键删除）`, 'good');
    });
    document.addEventListener('keydown', event => { if (event.key === 'Escape') labelEditorPanel.hidden = true; });
    // 换地图/换局时同步列表与地图名（面板只在 ?labels=1 下存在）
    setInterval(() => { if (!labelEditorPanel.hidden) renderLabelEditor(); }, 1500);
  }
  // P1：快捷键 —— 1/2/3 切换视图、F 适配、T 跟随（输入框里不拦）
  document.addEventListener('keydown', event => {
    if (event.metaKey || event.ctrlKey || event.altKey) return;
    const target = event.target;
    const tag = (target && target.tagName ? target.tagName : '').toLowerCase();
    if (tag === 'input' || tag === 'textarea' || tag === 'select' || (target && target.isContentEditable)) return;
    switch (String(event.key).toLowerCase()) {
      case '1': document.getElementById('viewRadar')?.click(); break;
      case '2': document.getElementById('viewBoth')?.click(); break;
      case '3': document.getElementById('view3d')?.click(); break;
      case 'f': document.getElementById('fitMap')?.click(); break;
      case 't': document.getElementById('radarFollowToggle')?.click(); break;
      default: return;
    }
  });

  document.addEventListener('keydown', event => { if (event.key === 'Escape') { setRadarControlOpen(false); if (selectingSelf) setSelectingSelf(false); } });
  document.getElementById('mapModeAuto')?.addEventListener('click', () => { mapMode = 'auto'; sessionStorage.setItem('codev.map.mode', 'auto'); syncMapControls(); selectCalibration(); });
  document.getElementById('mapModeManual')?.addEventListener('click', () => { if (session.status !== 'replay') { toast('实时会话固定使用服务器地图', 'info'); return; } mapMode = 'manual'; sessionStorage.setItem('codev.map.mode', 'manual'); if (!manualMapId && session.map_id != null) manualMapId = String(session.map_id); sessionStorage.setItem('codev.map.manual', manualMapId); syncMapControls(); selectCalibration(); });
  document.getElementById('manualMap')?.addEventListener('change', event => { if (session.status !== 'replay') return; manualMapId = event.target.value; mapMode = 'manual'; sessionStorage.setItem('codev.map.mode', mapMode); sessionStorage.setItem('codev.map.manual', manualMapId); selectCalibration(); });
  document.getElementById('createProfile')?.addEventListener('click', createProfile);
  document.getElementById('refreshProxy')?.addEventListener('click', () => { Promise.allSettled([loadProxyStatus(), loadProfiles()]); toast('正在刷新代理与配置状态…', 'info'); });
  document.getElementById('rotateProfile')?.addEventListener('click', () => mutateProfile('rotate'));
  document.getElementById('revokeProfile')?.addEventListener('click', () => mutateProfile('revoke'));
  document.getElementById('copyNode')?.addEventListener('click', async () => { if (!profileState?.nodeUrl) { toast('节点 URI 尚未返回', 'info'); return; } try { await copyText(profileState.nodeUrl); toast('节点 URI 已复制', 'good'); } catch { toast('复制失败，请使用节点二维码或 .conf', 'bad'); } });
  document.getElementById('profileConfImport')?.addEventListener('click', () => { const importUrl = shadowrocketConfigImportUrl(profileState?.conf); if (!importUrl) { toast('完整配置下载地址尚未返回', 'info'); return; } window.location.assign(importUrl); });
  document.getElementById('profileImport')?.addEventListener('click', () => { if (!profileState?.importUrl) { toast('直接节点尚未返回', 'info'); return; } window.location.assign(profileState.importUrl); });
  document.getElementById('replayPause')?.addEventListener('click', () => document.getElementById('pause')?.click());
  document.getElementById('replaySpeed')?.addEventListener('change', event => { const speedNode = document.getElementById('speed'); if (speedNode) { speedNode.value = event.target.value; speedNode.dispatchEvent(new Event('change')); } });
  document.getElementById('replaySeek')?.addEventListener('input', event => { seek.value = event.target.value; seek.dispatchEvent(new Event('input')); });
  document.getElementById('replayLive')?.addEventListener('click', () => document.getElementById('live')?.click());

  document.getElementById('pause').onclick = () => {
    setPaused(!paused);
    sendControl({action: paused ? 'pause' : 'play'});
    if (!paused) {
      if (live) sendControl({action: 'live'});
    }
  };
  document.getElementById('speed').onchange = event => {
    const next = Number(event.target.value);
    speed = [0.25,0.5,1,2,4].includes(next) ? next : 1;
    sendControl({action:'speed', value:speed});
  };
  seek.oninput = event => {
    if (startNs == null || latestNs == null) return;
    live = false;
    setPaused(true);
    cursorNs = startNs + (latestNs - startNs) * Number(event.target.value) / 1000;
    sendControl({action: 'pause'});
    requestSeek(cursorNs);
    updateTimeline();
  };
  document.getElementById('live').onclick = () => {
    live = true;
    setPaused(false);
    cursorNs = latestNs;
    sendControl({action:'live'});
    updateTimeline();
  };
  new ResizeObserver(()=>{needsDraw=true;}).observe(mapVisuals);
  setInterval(()=>{ const now=performance.now(); rateWindow=rateWindow.filter(t=>t>=now-3000); document.getElementById('eventRate').textContent=`${(rateWindow.length/3).toFixed(1)}/s`; },250);
  const updatePerfHud = () => {
    if (!PERF) return;
    const now = performance.now();
    if (now - perfLastPaint < 250) return;
    perfLastPaint = now;
    const set = (id, value) => { const el = document.getElementById(id); if (el) el.textContent = value; };
    const sorted = perfFrames.slice().sort((a, b) => a - b);
    const q = p => sorted.length ? sorted[Math.min(sorted.length - 1, Math.floor(sorted.length * p))] : NaN;
    const mean = sorted.length ? sorted.reduce((a, b) => a + b, 0) / sorted.length : NaN;
    set('perfFps', isFinite(mean) ? (1000 / mean).toFixed(0) : '—');
    set('perfP50', isFinite(q(.5)) ? q(.5).toFixed(1) + ' ms' : '—');
    set('perfP95', isFinite(q(.95)) ? q(.95).toFixed(1) + ' ms' : '—');
    set('perfDrop', String(perfDrop));
    set('perfStatic', perfStaticMs.toFixed(2));
    set('perfDynamic', Math.max(0, perfDynamicMs).toFixed(2));
    set('perf3d', perf3dMs.toFixed(2));
    // 1 秒窗口才算「绘制/秒」
    if (now - perfDrawRateAt >= 1000) {
      perfDrawRate = Math.round(perfDrawCount * 1000 / (now - perfDrawRateAt));
      perfDrawCount = 0;
      perfDrawRateAt = now;
    }
    set('perfDraws', String(perfDrawRate));
    const rafEl = document.getElementById('latency');
    set('perfRaf', rafEl && rafEl.textContent ? rafEl.textContent : '—');
    perfFrames = []; perfDrop = 0;
  };
  // 现场排查用：连打 d-e-b-u-g 打开/关闭左上角探针（显示自己是谁、视点、跟随状态）。
  // 出问题让对方截图这一小块就能定位，不用连电脑。
  // 探针用的节奏统计（只在探针打开时采集，避免平时多开销）
  let probeDataAt = [], probeFrameMs = [];
  const probeStats = () => {
    const iv = probeDataAt.slice(1).map((v, i) => v - probeDataAt[i]).sort((a, b) => a - b);
    const fr = probeFrameMs.slice().sort((a, b) => a - b);
    const q = (arr, p) => arr.length ? arr[Math.min(arr.length - 1, Math.floor(arr.length * p))] : NaN;
    const f = v => Number.isFinite(v) ? v.toFixed(1) : '—';
    return [
      `数据间隔 p50 ${f(q(iv, .5))}ms  p95 ${f(q(iv, .95))}ms  最大 ${f(iv.length ? iv[iv.length - 1] : NaN)}ms`,
      `帧 p95 ${f(q(fr, .95))}ms  掉帧(>25ms) ${probeFrameMs.filter(v => v > 25).length}`,
    ];
  };
  const lurchProbe = (() => {
    const el = document.createElement('div');
    el.id = 'lurchProbe';
    el.style.cssText = 'position:fixed;left:10px;top:52px;z-index:99;display:none;padding:8px 10px;border-radius:8px;'
      + 'background:rgba(6,12,18,.9);border:1px solid rgba(92,200,255,.35);color:#cfe9f7;'
      + 'font:11px/1.55 ui-monospace,SFMono-Regular,Menlo,monospace;pointer-events:none;white-space:pre';
    document.body.appendChild(el);
    let buffer = '';
    window.addEventListener('keydown', event => {
      if (event.key && event.key.length === 1) {
        buffer = (buffer + event.key.toLowerCase()).slice(-5);
        if (buffer === 'debug') {
          el.style.display = el.style.display === 'none' ? 'block' : 'none';
          buffer = '';
        }
      }
    });
    return el;
  })();
  const updateLurchProbe = () => {
    if (lurchProbe.style.display === 'none') return;
    // 注意：这里的"自己"必须用模块级的 resolveBoundSelf()。
    // 以前这里写的是 selfPoint —— 那个变量只存在于 drawRadar()/drawOverlay() 内部，
    // 模块作用域里根本没有 → 打开探针的第一帧就 ReferenceError，
    // 而 updateLurchProbe() 当时在 try/catch 之外 → rAF 链断掉 → 整个雷达定格。
    const probeSelf = resolveBoundSelf();
    lurchProbe.textContent = [
      `selfSlot ${selfSlot}  manual ${selfSlotManual ? 'Y' : 'N'}  engine ${engineBinding.self_slot}`,
      `track ${selfTrackId ? selfTrackId.slice(-8) : '—'}  resolved ${selfResolvedKey || '—'}`,
      `follow ${showFollow ? 'on' : 'off'}  hold ${followHold ? 'Y' : 'N'}  pan ${panMode ? 'Y' : 'N'}`,
      `view u ${smoothView ? smoothView.u.toFixed(3) : '—'}  v ${smoothView ? smoothView.v.toFixed(3) : '—'}`,
      `yaw ${smoothView ? smoothView.yaw.toFixed(1) : '—'}  raw ${probeSelf ? Number(probeSelf.yaw).toFixed(1) : '—'}  stable ${probeSelf ? stableYaw(probeSelf.slot, probeSelf.yaw, probeSelf.updated_ns).toFixed(1) : '—'}  cacheAge ${viewCache ? Math.round(performance.now() - viewCache.at) + 'ms' : '—'}`,
      ...probeStats(),
    ].join('\n');
    if (probeDataAt.length > 200) probeDataAt = probeDataAt.slice(-120);
    if (probeFrameMs.length > 240) probeFrameMs = probeFrameMs.slice(-120);
  };

  const loop = () => {
    // 整帧兜底：以前只有 draw() 被 try/catch 包住，而 updatePerfHud()/updateLurchProbe()
    // 在它外面 —— 探针里一个未定义变量就能把 rAF 链打断，雷达直接定格（2026-10-04 实锤）。
    // 现在整帧 try + finally 里排下一帧：任何异常最多丢一帧，循环永远活着。
    try {
    const frameNow = performance.now();
    if (PERF && perfLastFrameMs) {
      const interval = frameNow - perfLastFrameMs;
      perfFrames.push(interval);
      if (perfFrames.length > 480) perfFrames.shift();
      if (interval > 25) perfDrop++;
    }
    // 探针打开时也收一份帧间隔（PERF 关着也能看）
    if (lurchProbe.style.display !== 'none' && perfLastFrameMs) {
      probeFrameMs.push(frameNow - perfLastFrameMs);
    }
    perfLastFrameMs = frameNow;
    if (PERF) updatePerfHud();
    updateLurchProbe();
    if(needsDraw){
      // 【关键】先把标志清掉再画。以前是"画完再清"，而 draw() 内部的跟随逻辑
      // （drawRadar 末尾那句 `if (followActive) needsDraw = true;`）是在画的过程中把标志
      // 重新点亮的 —— 画完立刻被这里清掉，于是"跟随时每帧重绘"从来没生效过：
      // 画面只在收到数据的那一下才重画 = 数据节奏 30 次/秒（录屏实测 25~29 次/秒，
      // 尺子 250ms 口径显示 7~8 也正好是 30/秒）。现在改成先清后画，draw() 里点亮的状态
      // 能留到下一帧，跟随才是真正的 60Hz。
      needsDraw=false;
      // 任何一处绘制抛异常，以前会顺着 rAF 回调冒出去 —— 而 requestAnimationFrame(loop)
      // 在函数末尾，于是整个雷达就此定格（2D/3D 一起死，只能刷新页面）。
      // 现在兜住异常：本帧放弃、下一帧照常排，并把第一次的错误打到控制台（只打一次，不刷屏）。
      try {
        draw();
      } catch (error) {
        if (!window.__codevDrawError) {
          window.__codevDrawError = String((error && error.stack) || error);
          console.error('绘制异常（已捕获，雷达不会卡死）:', error);
        }
      }
      const renderedAt = performance.now();
      for (const receivedAt of pendingRafReceipts.values()) {
        rafLatencies.push(renderedAt - receivedAt);
      }
      pendingRafReceipts.clear();
      if (rafLatencies.length > 2048) rafLatencies = rafLatencies.slice(-2048);
      // 原来这里每帧都要排序 2000 个样本 + 写一次 DOM（写 DOM 会触发样式/布局计算），
      // 纯属白给的开销；降到 4 次/秒，而且只在真的变了才写。
      if (rafLatencies.length && renderedAt - lastLatencyPaint > 250) {
        lastLatencyPaint = renderedAt;
        const ordered = [...rafLatencies].sort((a,b)=>a-b);
        const p99 = ordered[Math.ceil(ordered.length * .99) - 1];
        const el = document.getElementById('latency');
        const text = `${p99.toFixed(1)} ms`;
        if (el && el.textContent !== text) el.textContent = text;
      }
    }
    } catch (error) {
      if (!window.__codevLoopError) {
        window.__codevLoopError = String((error && error.stack) || error);
        console.error('渲染循环异常（已捕获，雷达不会卡死）:', error);
      }
    } finally {
      requestAnimationFrame(loop);
    }
  };
  syncPerfHud();
  ensureAuth().then(async () => {
    syncDisplayPreferences(false);
    syncViewMode(false);
    syncDrawMode(false);
    syncEmptyState();   // 页面一打开还没数据 → 直接显示空状态卡片（不留纯黑）
    setRadarControlOpen(false);
    syncMapControls();
    // 先把数据通道接上：以前要先等 4 个面板接口（地图清单/代理状态/配置/CA）回来才 connect，
    // 首帧数据被这几个请求拖住 —— 这就是"刚进对局要等一会儿才有人物"的一半原因。
    void connect();
    await Promise.allSettled([loadMapManifest(), loadProxyStatus(), loadProfiles(), loadCaStatus()]);
    // 「选自己」按钮已在工具栏恢复，这里的诊断入口不再自动出现（代码留着备用）。
  });

  // App 用的是 WKWebView：窗口不在最前面/被挡住时，系统的 App Nap 会把渲染与计时器降频甚至暂停，
  // 表现就是"切回 App 才补画一帧"（雷达要等一会儿才有人物，浏览器却一进游戏就有）。
  // 这里在回到可见/拿到焦点时主动补一帧，并把重连退避清零立刻重连。
  const recoverAfterWake = () => {
    try { needsDraw = true; draw(); } catch (error) { /* loop 里同样有兜底 */ }
    if (!ws || ws.readyState === WebSocket.CLOSED) {
      reconnectDelayMs = 1000;
      if (reconnectTimer !== null) { clearTimeout(reconnectTimer); reconnectTimer = null; }
      void connect();
    }
  };
  document.addEventListener('visibilitychange', () => { if (!document.hidden) recoverAfterWake(); });
  window.addEventListener('focus', recoverAfterWake);
  window.addEventListener('pageshow', recoverAfterWake);
  // 自检模式：加 ?selftest=1 打开面板会注入 4 个假坐标点，用来验证
  // 英雄头像 / 3D 投影 / 滞后绘制是否正常（不影响正常使用）
  if (location.search.includes('selftest')) {
    setTimeout(() => {
      try {
        session.map_id = 1010;      // Lotus
        session.status = 'live';
        syncEmptyState();           // 自检模式也要同步空状态（真实对局走 updateSession）
        if (location.search.includes('full')) { drawMode = 'full'; syncDrawMode(false); }   // 自检时强制全面模式
        selectCalibration();
        const base = Date.now() * 1e6;
        const mk = (slot, agentId, camp, u, v, health, maxHealth, weapon) => ({
          slot, track_id: `selftest-${slot}`, agent_id: agentId, camp_id: camp,
          // 故意给 unresolved：回归测试要点 —— 阵营不能被"身份置信度"吃掉
          identity_confidence: slot === 0 ? 'proven' : 'unresolved',
          // 给不同的世界坐标，3D 视图才有东西画（自检要覆盖 3D 路径）：
          // 自己放原点、其余放在 +x 前方（yaw=0 视为朝 +x），保证进相机视锥
          world: { x: slot * 320, y: (slot % 2 ? 180 : -180) * (1 + slot * .3), z: 100 }, map: { u, v },
          pitch: 0, yaw: slot * 45,
          fresh: true, continuity: 'live', updated_ns: base,
          // 自检专用：血量/武器（真实对局里由解码层给，没有就不显示）
          health, max_health: maxHealth, weapon_name: weapon,
        });
        ingestPositions([mk(0, 3009, 1, 0.50, 0.50, 100, 100, '暴徒'),
                         mk(1, 3002, 1, 0.44, 0.42, 62, 100, '幻影'),
                         mk(2, 3005, 2, 0.58, 0.56, 18, 100, ''),
                         mk(3, 3077, 2, 0.62, 0.38, null, null, '冥驹')], base);
        setSelfSlot(0, false);
        document.getElementById('mapWarning')?.setAttribute('hidden', '');
        setInterval(() => {
          const t = Date.now() * 1e6;
          for (const point of current.values()) { point.updated_ns = t; point.capture_ns = t; }
          needsDraw = true;
        }, 300);
        console.log('selftest: 已注入假坐标点', current.size);
      } catch (error) { console.warn('selftest failed', error); }
    }, 2000);
  }
  requestAnimationFrame(loop);
})();
</script>
</body>
</html>