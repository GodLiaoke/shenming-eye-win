    const pitch = Math.max(-75,Math.min(75,signedAngle(camera.pitch)))*Math.PI/180;
    const yaw = signedAngle(camera.yaw)*Math.PI/180;
    const sp=Math.sin(pitch), cp=Math.cos(pitch), sy=Math.sin(yaw), cy=Math.cos(yaw);
    const forward=[cp*cy,cp*sy,sp], right=[-sy,cy,0], up=[-sp*cy,-sp*sy,cp];
    const focal=width/2/Math.tan(90*Math.PI/360), centerX=width/2, centerY=height/2;
    return world => {
      const dx=world.x-camera.x, dy=world.y-camera.y, dz=world.z-camera.z;
