    if (!hasLiveData) syncEmptyRows();
    const title = document.getElementById('mapEmptyTitle');
    const detail = document.getElementById('mapEmptyDetail');
    if (title && status === 'degraded') title.textContent = '数据正在恢复';
    else if (title) title.textContent = '等待对局数据';
    if (detail && status === 'degraded') detail.textContent = '检测到采集缺口，正在等待下一批坐标。';
