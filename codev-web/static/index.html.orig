  let selfTrackGen = (() => { try { return localStorage.getItem('codev.display.selfGen') || null; } catch { return null; } })();
  const selfTrackUsable = () => !selfTrackGen || channelGeneration === null || selfTrackGen === channelGeneration;
  const selfCandidate = () => {
    if (selfTrackId && selfTrackUsable()) {
