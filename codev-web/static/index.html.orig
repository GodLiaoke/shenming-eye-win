  const syncEmptyRows = () => {
    const readText = id => { const el = document.getElementById(id); return el ? (el.textContent || '').trim() : ''; };
    const connText = readText('connection') || '连接中…';
    const sessText = readText('healthLabel') || '未开始';
    const rateText = readText('eventRate') || '—';
    const rate = parseFloat(rateText);
    const hasRate = Number.isFinite(rate) && rate > 0;
    const set = (id, text) => { const el = document.getElementById(id); if (el) el.textContent = text; };
    set('emptyLinkState', connText);
    set('emptySessionState', sessText);
    set('emptyCoordsState', hasRate ? rateText : '—');
    const mark = (id, ok) => { const el = document.getElementById(id); if (el) el.className = ok ? 'dot ok' : 'dot'; };
    mark('emptyDotLink', /已连接|实时|正常/.test(connText));
    mark('emptyDotSession', /实时接收|回放中/.test(sessText));
    mark('emptyDotCoords', hasRate);
  };
