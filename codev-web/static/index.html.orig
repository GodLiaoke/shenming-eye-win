        ctx.save();ctx.font=`800 9px ${LABEL_FONT_STACK}`;ctx.textAlign='center';ctx.textBaseline='top';
        ctx.lineWidth=3;ctx.strokeStyle='rgba(2,8,12,.96)';ctx.strokeText(threatLabel,x,y+size+7);
        ctx.fillStyle=metrics.approaching?'#ff7180':'#ffd372';ctx.fillText(threatLabel,x,y+size+7);ctx.restore();
