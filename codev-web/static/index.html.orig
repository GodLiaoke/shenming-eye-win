  const MAP_LABELS = {
    1: [{ u: 0.152, v: 0.690, text: 'A点', kind: 'site' }, { u: 0.799, v: 0.731, text: 'B点', kind: 'site' }],
    2: [{ u: 0.287, v: 0.739, text: 'A点', kind: 'site' }, { u: 0.341, v: 0.303, text: 'B点', kind: 'site' }],
    1003: [{ u: 0.240, v: 0.418, text: 'A点', kind: 'site' }, { u: 0.812, v: 0.321, text: 'B点', kind: 'site' }],
    1004: [{ u: 0.128, v: 0.629, text: 'A点', kind: 'site' }, { u: 0.497, v: 0.609, text: 'B点', kind: 'site' }, { u: 0.846, v: 0.647, text: 'C点', kind: 'site' }],
    1009: [{ u: 0.320, v: 0.165, text: 'A点', kind: 'site' }, { u: 0.399, v: 0.806, text: 'B点', kind: 'site' }],
