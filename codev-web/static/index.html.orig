  let hideTeam3d = readDisplayPreference('hideTeam3d');
  // [已移除] 英雄目录/映射/头像缓存 (JS)

  let showPlayers = readDisplayPreference('players');
  let showFollow = readDisplayPreference('follow');
  let showThreats = readDisplayPreference('threats');
  let showMapName = readDisplayPreference('mapName');
  let showLegend = readDisplayPreference('legend');
  let showLabels = readDisplayPreference('labels');
  let labelsRotateWithMap = readDisplayPreference('labelsRotate');
  // 墙/通路高亮（默认开）：贴图里 alpha=0 的"被地面包围"部分是建筑/墙体，
  // 把它描出来、地面提亮 + 边界亮线，一眼分清能不能走。
  let showMapStructure = readDisplayPreference('mapStructure');
  let styledStructured = null;      // 处理好的"结构版"底图（切图时离线算一次）
  // 锁定朝向：默认开启（正北朝上）——地图不再随视角旋转，抖动随之消失
  const RADAR_NORTH_KEY = 'codev.radar.lockNorth';
  let lockNorthUp = (() => {
    // 新版首次进入固定正北朝上；不读取旧显示面板的同名键，避免历史设置把地图带回跟随朝向。
    try { const value = localStorage.getItem(RADAR_NORTH_KEY); return value === null ? true : value === '1'; }
    catch { return true; }
  })();
  let selfSlot = (() => {
    try {
      const value = localStorage.getItem('codev.display.selfSlot');
      return value !== null && Number.isInteger(Number(value)) ? Number(value) : null;
    } catch { return null; }
  })();
  // Ephemeral by design: credentials and token-bearing URLs are never written to browser storage.
  let profileState = null;
  let savedProfiles = [];
  let profilesLoadPromise = null;
  let reconnectTimer = null;
  let sessionSeedTimer = null;

  // WS 给过会话没有。**REST 只会用它做"页面启动时的一次性兜底"**：
  // 之前没有这个判断，轮询每 2 秒把 REST 的会话覆盖上去，只要它和 WS 不一致，
  // 空态卡就每 2 秒亮一次灭一次（客户反馈"等待对局数据的弹窗频繁闪"）。
  let wsSessionSeen = false;
  let reconnectDelayMs = 1000;

  const operationNodes = {
    proxy: document.getElementById('proxyOperation'),
    tls_mitm: document.getElementById('tlsOperation'),
    quic: document.getElementById('quicOperation'),
    recording: document.getElementById('recordingOperation')
  };
  const operationMirrors = {
    proxy: document.getElementById('proxyOperationMirror'),
    tls_mitm: document.getElementById('tlsOperationMirror'),
    quic: document.getElementById('quicOperationMirror'),
    recording: document.getElementById('recordingOperationMirror')
  };
  const operationDefaults = {
    proxy: {state:'awaiting', detail:'等待代理或 pcap 数据源'},
    tls_mitm: {state:'disabled', detail:'HTTPS MITM 默认关闭'},
    quic: {state:'awaiting', detail:'尚未观察到 QUIC 决策'},
    recording: {state:'disabled', detail:'录制默认关闭，不落盘'}
  };

  // v2：普通用户只控制视图、镜头和目标。其余渲染参数固定为稳定默认值，
  // 支持排障仍可通过 ?perf=1 / ?full=1 进入，不再把工程参数塞进显示面板。
  const displayControls = {};
  const syncRadarButton = (id, active, labelOn, labelOff = labelOn) => {
    const button = document.getElementById(id);
    if (!button) return;
    button.setAttribute('aria-pressed', String(Boolean(active)));
    button.classList.toggle('active', Boolean(active));
    button.textContent = active ? labelOn : labelOff;
  };
  const syncDisplayPreferences = (persist = false, force = false) => {
    // 低延迟与稳定北向是本代产品的默认值，不跟随旧 localStorage 降级。
    lowLatencyMode = true;
    showPlayers = true;
    showThreats = true;
    showMapName = true;
    showLegend = false;
    showLabels = true;
    labelsRotateWithMap = false;
    showMapStructure = true;
    if (persist) {
      for (const [key, value] of Object.entries({ players: showPlayers, threats: showThreats, mapName: showMapName, legend: showLegend, labels: showLabels, labelsRotate: labelsRotateWithMap, lowLatency: lowLatencyMode, mapStructure: showMapStructure })) {
        try { localStorage.setItem(`codev.display.${key}`, value ? '1' : '0'); } catch {}
      }
    }
    syncRadarButton('radarFollowToggle', showFollow, '跟随自己', '自由视图');
    syncRadarButton('radarNorthToggle', lockNorthUp, '北向朝上', '跟随朝向');
    applyLatencyProfile(force);
    const mapLabel = document.getElementById('mapLabel'); if (mapLabel) mapLabel.hidden = !showMapName;
    const mapLegend = document.querySelector('.map-legend'); if (mapLegend) mapLegend.hidden = !showLegend;
    needsDraw = true;
  };
  const resetDisplayPreferences = () => {
    showFollow = displayDefaults.follow;
    lockNorthUp = true;
    viewMode = 'radar';
    drawMode = 'simple';
    syncDisplayPreferences(true, true);
    syncViewMode(true);
    syncDrawMode(true);
  };
  // 绘制详略：简洁模式保持原有渲染；全面模式叠加槽位/阵营/速度等读数。
  // 英雄头像与血量、持械需要解码层提供数据，未接入前保持占位而不是伪造数值。
  let drawMode = (() => {
    try {
      // 全面绘制保留为 URL 调试入口：普通控制抽屉不会暴露工程参数。
      const query = new URLSearchParams(location.search);
      if (query.get('full') === '1' || query.get('full') === 'true') return 'full';
      const value = localStorage.getItem('codev.display.drawMode');
      return value === 'full' ? 'full' : 'simple';
    } catch { return 'simple'; }
  })();
  const fullDraw = () => drawMode === 'full';
  const syncDrawMode = (persist = false) => {
    // 全面绘制保留给 ?full=1 的排障入口；普通面板不再暴露切换按钮。
    const note = document.getElementById('fullModeNote');
    if (note) note.hidden = !fullDraw();
    if (persist) try { localStorage.setItem('codev.display.drawMode', drawMode); } catch {}
    needsDraw = true;
  };
  const syncViewMode = (persist = false) => {
    mapVisuals.className = `map-visuals mode-${viewMode}`;
    mapPanel?.classList.toggle('view-overlay', viewMode === 'overlay');
    for (const [id, mode] of [['viewRadar','radar'],['viewBoth','both'],['view3d','overlay']]) {
      const button = document.getElementById(id);
      if (!button) continue;
      const active = viewMode === mode;
      button.classList.toggle('active', active);
      button.setAttribute('aria-selected', String(active));
    }
    if (persist) try { localStorage.setItem('codev.display.viewMode', viewMode); } catch {}
    needsDraw = true;
  };

  const updateOperations = payload => {
    const nested = payload?.operations && typeof payload.operations === 'object' ? payload.operations : {};
    for (const [key, node] of Object.entries(operationNodes)) {
      const direct = payload?.[`${key}_status`] ?? payload?.[key];
      const value = nested[key] && typeof nested[key] === 'object'
        ? nested[key] : (direct && typeof direct === 'object' ? direct : operationDefaults[key]);
      const state = typeof value.state === 'string' ? value.state.slice(0, 32) : operationDefaults[key].state;
      const detail = typeof value.detail === 'string' ? value.detail.slice(0, 256) : operationDefaults[key].detail;
      const good = ['ready','active'].includes(state);
      const bad = ['error','incomplete','opaque'].includes(state);
      for (const target of [node, operationMirrors[key]]) {
        if (!target) continue;
        target.querySelector('.operation-state').textContent = statusLabel(state);
        target.querySelector('.operation-detail').textContent = detail;
        target.className = `operation ${good ? 'good' : (bad ? 'bad' : '')}`;
      }
      const stateMap = { tls_mitm: ['tlsCardState', 'tlsCardDetail', 'tlsStatusIcon'], quic: ['quicCardState', null, 'quicStatusIcon'] };
      const card = stateMap[key];
      if (card) {
        const stateNode = document.getElementById(card[0]); if (stateNode) stateNode.textContent = statusLabel(state);
        const detailNode = card[1] && document.getElementById(card[1]); if (detailNode) detailNode.textContent = detail;
        const iconNode = card[2] && document.getElementById(card[2]); if (iconNode) iconNode.className = `status-icon ${good ? 'good' : (bad ? 'bad' : '')}`;
      }
      if (key === 'tls_mitm') {
        const mitm = document.getElementById('mitmCardState');
        if (mitm) mitm.textContent = statusLabel(state);
      }
    }
    const proxyState = nested.proxy?.state || payload?.proxy_status?.state || payload?.proxy?.state || 'awaiting';
    const proxyText = document.getElementById('proxyCardState'); if (proxyText) proxyText.textContent = statusLabel(proxyState);
    const proxyPill = document.getElementById('proxyStatusPill'); if (proxyPill) proxyPill.textContent = statusLabel(proxyState);
  };

  const setConnection = (text, kind='') => { connection.textContent = text; connection.className = `status ${kind}`; };
  const fmtTime = ns => {
    const seconds = Math.max(0, Number(ns || 0) / 1e9);
    const minutes = Math.floor(seconds / 60);
    return `${String(minutes).padStart(2,'0')}:${(seconds % 60).toFixed(1).padStart(4,'0')}`;
  };
  const setPaused = value => {
    paused = value;
    const button = document.getElementById('pause');
    button.setAttribute('aria-pressed', String(paused));
    button.textContent = paused ? '继续' : '暂停';
    const replayButton = document.getElementById('replayPause');
    if (replayButton) { replayButton.setAttribute('aria-pressed', String(paused)); replayButton.textContent = paused ? '继续' : '暂停'; }
  };
  const clearTracks = () => {
    current = new Map();
    motionBySlot = new Map();
    markerHits = [];
    rebuildPlayers();
    needsDraw = true;
  };

  const updateSession = next => {
    if (!next || typeof next !== 'object') return;
    if (next.operations) updateOperations(next);
    if (channelGeneration !== null && next.channel_generation !== channelGeneration) {
      clearTracks();
      rosterBySlot = new Map();
      setSelfSlot(null, true);
      followHold = null;
      viewCache = null;
      selfCampMismatchSince = 0;
      // 换局了：上一局的 track 记忆作废（否则可能把别人当成自己）
      selfTrackId = null; selfTrackGen = null;
      // 手选也要作废：槽位重排后，同一个槽号已经是别人了（"下一回合直接在别人身上"就是这个）
      selfSlotManual = false;
      selfManualGen = null;
      pendingEngineSelfSlot = null; pendingEngineSelfSlotHits = 0;
      engineBinding = { self_slot: null, local_slots: [] };
      // 保持窗口也要清：别把上一局那个人继续当成自己
      selfResolvedKey = null; selfResolvedPoint = null; selfResolvedSeenMs = 0;
      yawFilters.clear();
      try { localStorage.removeItem('codev.display.selfTrack'); localStorage.removeItem('codev.display.selfGen'); } catch {}
    }
    channelGeneration = next.channel_generation;
    // 2026-10-13：引擎（代理模式）看不到这一局时，会周期性把会话重新发成
    // awaiting/degraded；而镜像上传已经把会话立成 live。两边来回覆盖 →
    // 地图/卡片闪烁（客户："等待对局数据的弹窗频繁闪"）。
    // 规则：**只要坐标还在流（5 秒内）就不接受 live/replay → 未开局的降级**，
    // 只把 detail/operations 等无关字段更新进来，status 与 map_id 保持不变。
    const currentStatus = (session && typeof session === 'object') ? session.status : null;
    const liveNow = currentStatus === 'live' || currentStatus === 'replay';
    const incomingLive = next.status === 'live' || next.status === 'replay';
    if (liveNow && !incomingLive && performance.now() - lastIngestMs < 5000) {
      session = Object.assign({}, next, {
        status: currentStatus,
        map_id: session.map_id != null ? session.map_id : next.map_id,
        capture_start_ns: session.capture_start_ns != null ? session.capture_start_ns : next.capture_start_ns,
      });
    } else {
      session = next;
    }
    syncEmptyState();
    const first = Number(session.capture_start_ns);
    const latest = Number(session.latest_capture_ns);
    if (Number.isFinite(first) && first > 0) startNs = first;
    if (Number.isFinite(latest) && latest > 0) latestNs = Math.max(latestNs ?? latest, latest);
    if (cursorNs == null && latestNs != null) cursorNs = latestNs;
    const bad = session.status === 'unrecoverable';
    const good = session.status === 'live' || session.status === 'replay';
    setConnection(statusLabel(session.status || 'awaiting_session'), bad ? 'bad' : (good ? 'good' : ''));
    document.getElementById('sessionMeta').textContent = `${session.build_id || '未知版本'} · ${statusLabel(session.status)} · ${session.status_detail || ''}`;
    const healthLabel = document.getElementById('healthLabel'); if (healthLabel) healthLabel.textContent = statusLabel(session.status || 'awaiting_session');
    const healthDetail = document.getElementById('healthDetail'); if (healthDetail) healthDetail.textContent = session.status_detail || '等待会话元数据';
    const pulse = document.getElementById('healthPulse'); if (pulse) pulse.className = `health-pulse ${bad ? 'bad' : (good ? 'good' : '')}`;
    const replayPill = document.getElementById('replayModePill'); if (replayPill) replayPill.textContent = session.status === 'replay' ? '回放中' : (live ? '实时画面' : '时间线');
    syncMapControls();
    selectCalibration();
    updateTimeline();
  };

  const worldToMap = world => {
    if (!calibration || !world) return null;
    return {
      u: 0.5 - (world.x - calibration.level_center.x) / calibration.level_size.x,
      v: 0.5 - (world.y - calibration.level_center.y) / calibration.level_size.y
    };
  };

  const reprojectTracks = () => {
    if (!calibration) return;
    for (const point of current.values()) point.map = worldToMap(point.world);
  };

  const selectCalibration = () => {
    const rawMapId = mapMode === 'manual' && session.status === 'replay' && manualMapId !== ''
      ? manualMapId : session.map_id;
    const requestedMapId = rawMapId === '' || rawMapId == null ? NaN : Number(rawMapId);
    const maps = Array.isArray(manifest.maps) ? manifest.maps : [];
    const valid = m => m && ['proven','candidate'].includes(m.status) &&
      Number.isFinite(m.default_rotation_degrees) && Number.isFinite(m.image_rotation_degrees) &&
      Number.isFinite(m.level_center?.x) && Number.isFinite(m.level_center?.y) &&
      Number.isFinite(m.level_size?.x) && m.level_size.x > 0 &&
      Number.isFinite(m.level_size?.y) && m.level_size.y > 0 && Number.isInteger(Number(m.texture_width)) && Number(m.texture_width) > 0 &&
      Number.isInteger(Number(m.texture_height)) && Number(m.texture_height) > 0 && typeof m.texture_path === 'string' &&
      !m.texture_path.startsWith('/') && !m.texture_path.includes('\\') &&
      m.texture_path.split('/').every(part => part && part !== '.' && part !== '..') &&
      (m.status === 'candidate' || (
        m.orientation_verified === true && m.build_binding === 'verified' &&
        Number.isFinite(m.background_rotation_degrees) &&
        Math.abs((((m.background_rotation_degrees-m.image_rotation_degrees)%360)+360)%360) < 1e-9
      ))
    ;
    const selected = Number.isFinite(requestedMapId)
      ? maps.find(m => valid(m) && m.build_id === session.build_id && Number(m.map_id) === requestedMapId)
        || maps.find(m => valid(m) && Number(m.map_id) === requestedMapId)
        || null
      : null;
    const sameTexture = selected && calibration
      && selected.texture_path === calibration.texture_path
      && Number(selected.map_id) === Number(calibration.map_id)
      && selected.build_id === calibration.build_id
      && Number(selected.texture_width) === Number(calibration.texture_width)
      && Number(selected.texture_height) === Number(calibration.texture_height);
    calibration = selected;
    provenance.hidden = !calibration;
    if (calibration) {
      const perMapRotation = Number.isFinite(calibration.background_rotation_degrees)
        ? calibration.background_rotation_degrees : calibration.image_rotation_degrees;
      calibration.asset_rotation_degrees = perMapRotation;
      const candidate = calibration.status === 'candidate';
      document.getElementById('mapProvenanceTitle').textContent = `${calibration.name || `地图 ${calibration.map_id}`} · ${candidate ? '候选底图' : '已验证'}`;
      const binding = calibration.build_binding_evidence?.status || calibration.build_binding || 'unknown';
      const pakHash = typeof calibration.pak_sha256 === 'string' ? calibration.pak_sha256.slice(0,12) : 'unknown';
      const textureHash = typeof calibration.texture_sha256 === 'string' ? calibration.texture_sha256.slice(0,12) : 'unknown';
      document.getElementById('mapProvenancePak').textContent = `资源包 ${calibration.source_pak || '未知'} · ${pakHash}… · 绑定 ${binding}`;
      document.getElementById('mapProvenanceTexture').textContent = `地图纹理 ${calibration.texture_path} · ${textureHash}… · 方向 ${calibration.orientation_verified ? '已验证' : '未验证'}`;
      warning.classList.toggle('blocking', !background);
      warning.hidden = !candidate && Boolean(background);
      warning.textContent = !background ? '正在加载地图纹理…' : (candidate ? '候选底图 · 构建绑定未闭合 · 方向/地标证据未验证' : '');
      if (!sameTexture || !background) {
        background = null;
        styledStructured = null;
        const image = new Image();
        image.onload = () => {
          if (calibration !== selected) return;
          if (image.naturalWidth !== Number(calibration.texture_width) || image.naturalHeight !== Number(calibration.texture_height)) {
            background = null;
            warning.hidden = false;
            warning.classList.add('blocking');
            warning.textContent = '地图纹理尺寸与清单不一致；底图和坐标保持隐藏。';
            return;
          }
          background = image;
          styledBackground = buildStyledMap(image);
          if (showMapStructure) scheduleStructuredMap(styledBackground);
          warning.hidden = calibration.status === 'proven';
          warning.classList.toggle('blocking', false);
          warning.textContent = (calibration.status === 'candidate' && ADVANCED_PANEL) ? '候选底图 · 构建绑定未闭合 · 方向/地标证据未验证' : '';
          needsDraw = true;
        };
        image.onerror = () => {
          if (calibration !== selected) return;
          warning.hidden = false;
          warning.classList.add('blocking');
          warning.textContent = '地图纹理加载失败；底图和坐标保持隐藏。';
        };
        image.src = `/api/v1/maps/${calibration.texture_path.split('/').map(encodeURIComponent).join('/')}`;
      }
      reprojectTracks();
    } else {
      background = null;
      styledStructured = null;
      const waitingForMatch = !Number.isFinite(requestedMapId);
      warning.hidden = waitingForMatch;              // 没进对局时什么都不显示，别一开面板就报警
      warning.classList.toggle('blocking', !waitingForMatch);
      warning.textContent = waitingForMatch ? '' : '这张地图暂无标定；底图和坐标标记保持隐藏。';
    }
    const mapName = Number.isFinite(requestedMapId) ? (calibration?.name || `地图 ${requestedMapId}`) : '地图未识别';
    const mapState = calibration?.status === 'proven' ? '已验证' : (calibration?.status === 'candidate' ? '候选底图' : '暂不支持');
    document.getElementById('mapLabel').textContent = Number.isFinite(requestedMapId) ? `${mapName} · ${mapState}` : mapName;
    const simpleMapName = document.getElementById('simpleMapName'); if (simpleMapName) simpleMapName.textContent = mapName;
    const badge = document.getElementById('mapModeBadge'); if (badge) badge.textContent = mapMode === 'manual' && session.status === 'replay' ? '手动地图' : '自动地图';
    renderMapCatalog();
  };

  const toast = (message, kind = 'info') => {
    const stack = document.getElementById('toastStack');
    if (!stack) return;
    // P1：还没数据时不弹"已暂停跟随"这类提示（空状态下它没有意义，只会干扰）
    if (kind === 'info' && document.body.classList.contains('is-empty')) return;
    const nodes = Array.from(stack.children);
    if (nodes.some(existing => existing.textContent === message)) return;   // 同文案不重复
    while (nodes.length >= 2) { nodes.shift().remove(); }                    // 最多两条
    const node = document.createElement('div'); node.className = `toast ${kind}`; node.textContent = message;
    stack.appendChild(node); setTimeout(() => node.remove(), 3200);
  };

  const safeMapPath = map => {
    if (!map || typeof map.texture_path !== 'string' || map.texture_path.startsWith('/') || map.texture_path.includes('\\')) return null;
    const parts = map.texture_path.split('/');
    if (!parts.length || parts.some(part => !part || part === '.' || part === '..')) return null;
    return `/api/v1/maps/${parts.map(encodeURIComponent).join('/')}`;
  };

  const syncMapControls = () => {
    const replay = session.status === 'replay';
    if (!replay && mapMode === 'manual') { mapMode = 'auto'; sessionStorage.setItem('codev.map.mode', 'auto'); }
    const auto = document.getElementById('mapModeAuto'); const manual = document.getElementById('mapModeManual');
    if (auto) auto.classList.toggle('active', mapMode !== 'manual');
    if (manual) { manual.classList.toggle('active', mapMode === 'manual'); manual.disabled = !replay; manual.title = replay ? '回放中选择投影地图' : '实时会话只能跟随服务器地图'; }
    const select = document.getElementById('manualMap'); if (select) { select.disabled = !replay || mapMode !== 'manual'; if (manualMapId) select.value = manualMapId; }
    const state = document.getElementById('manualMapState'); if (state) state.textContent = replay ? (mapMode === 'manual' ? '仅改变本浏览器投影' : '回放时可以切换到手动模式') : '实时对局使用自动模式';
    const help = document.getElementById('mapModeHelp'); if (help) help.textContent = replay ? '自动模式跟随对局上报的地图编号；手动模式只改变当前浏览器的投影，不会修改会话状态。' : '实时对局自动跟随服务器识别的地图；仅在回放时可以手动切换。';
    const badge = document.getElementById('mapModeBadge'); if (badge) badge.textContent = mapMode === 'manual' && replay ? '手动地图' : '自动地图';
  };

  const renderMapCatalog = () => {
    const maps = Array.isArray(manifest.maps) ? manifest.maps : [];
    const select = document.getElementById('manualMap'); const grid = document.getElementById('mapCards');
    if (select) {
      const previous = manualMapId;
      select.replaceChildren();
      if (!maps.length) { const option = document.createElement('option'); option.textContent = '暂无地图清单'; option.value = ''; select.appendChild(option); }
      maps.forEach(map => { const option = document.createElement('option'); option.value = String(map.map_id ?? ''); option.textContent = map.name || `Map ${map.map_id}`; select.appendChild(option); });
      if (previous && maps.some(map => String(map.map_id) === previous)) select.value = previous;
    }
    if (!grid) return;
    grid.replaceChildren();
    if (!maps.length) { const empty = document.createElement('div'); empty.className = 'empty-state'; empty.textContent = '地图清单暂不可用'; grid.appendChild(empty); syncMapControls(); return; }
    const selectedId = mapMode === 'manual' && session.status === 'replay' && manualMapId ? String(manualMapId) : String(session.map_id ?? '');
    maps.forEach(map => {
      const card = document.createElement('article'); card.className = `map-card ${String(map.map_id) === selectedId ? 'selected' : ''}`;
      card.setAttribute('tabindex', '0'); card.setAttribute('role', 'button'); card.setAttribute('aria-label', `选择地图 ${map.name || map.map_id}`);
      const image = document.createElement('img'); image.className = 'map-thumb'; image.alt = `${map.name || '地图'} 预览`; const path = safeMapPath(map); if (path) image.src = path; image.onerror = () => { image.removeAttribute('src'); };
      const body = document.createElement('div'); body.className = 'map-card-body';
      const title = document.createElement('div'); title.className = 'map-card-title'; const name = document.createElement('strong'); name.textContent = map.name || `地图 ${map.map_id}`; const status = document.createElement('span'); status.textContent = map.status === 'proven' ? '已验证' : '候选'; title.append(name, status);
      const meta = document.createElement('div'); meta.className = 'map-card-meta'; meta.textContent = `${map.texture_width || '—'}×${map.texture_height || '—'} · ${map.build_binding || '未验证'} · ${map.orientation_verified ? '方向已验证' : '方向待验证'}`;
      body.append(title, meta); card.append(image, body);
      const choose = () => {
        if (session.status !== 'replay') { toast('实时会话固定使用服务器地图', 'info'); return; }
        mapMode = 'manual'; manualMapId = String(map.map_id); sessionStorage.setItem('codev.map.mode', mapMode); sessionStorage.setItem('codev.map.manual', manualMapId); syncMapControls(); selectCalibration(); toast(`已切换 ${map.name || `Map ${map.map_id}`} 投影`, 'good');
      };
      card.addEventListener('click', choose); card.addEventListener('keydown', event => { if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); choose(); } }); grid.appendChild(card);
    });
    syncMapControls();
  };

  const panelFetch = async (path, options = {}, retryAuth = true) => {
    const request = () => fetch(path, {credentials: 'include', ...options, headers: {'accept': 'application/json', ...(options.headers || {})}});
    let response = await request();
    if (PUBLIC_PANEL && response.status === 401 && retryAuth) {
      await ensureAuth({force: true});
      response = await request();
    }
    return response;
  };
  const apiJson = async (path, options = {}) => {
    const response = await panelFetch(path, options);
    if (!response.ok) {
      const error = new Error(`${response.status} ${response.statusText || 'request failed'}`);
      error.status = response.status;
      throw error;
    }
    const type = response.headers.get('content-type') || '';
    if (!type.includes('json')) throw new Error('response is not JSON');
    return response.json();
  };

  const loadMapManifest = async () => {
    try {
      const data = await apiJson('/api/v1/maps/manifest');
      if (!data || !Array.isArray(data.maps)) throw new Error('map manifest schema invalid');
      manifest = data;
      renderMapCatalog();
      selectCalibration();
    } catch (error) {
      renderMapCatalog();
      if (error?.status === 401) toast('登录已失效，请重新认证', 'info');
      else toast(`地图清单加载失败：${error.message || '未知错误'}`, 'bad');
    }
  };

  const setDownload = (id, href, fallback) => { const node = document.getElementById(id); if (!node) return; const target = typeof href === 'string' && href ? href : (typeof fallback === 'string' && fallback ? fallback : ''); if (target) { node.href = target; node.setAttribute('aria-disabled', 'false'); } else { node.removeAttribute('href'); node.setAttribute('aria-disabled', 'true'); } };
  const updateProxyPipelineMetrics = payload => {
    const metrics = payload?.proxy_pipeline;
    if (!metrics || typeof metrics !== 'object') return;
    const value = key => {
      const number = Number(metrics[key]);
      return Number.isSafeInteger(number) && number >= 0 ? number : 0;
    };
    const set = (id, number) => { const node = document.getElementById(id); if (node) node.textContent = number.toLocaleString(); };
    set('metricTcp', value('tcp_frames'));
    set('metricUdpAssoc', value('udp_associations'));
    set('metricUdp', value('udp_frames'));
    set('metricMnaHello', value('mna_server_hello_observed'));
    set('metricMnaDecrypted', value('mna_data_decrypted'));
    set('metricAltSession', value('mna_authenticated_layout_sessions'));
    set('metricSessionError', value('mna_session_parse_failures'));
    set('metricMnaEvict', value('mna_control_flows_evicted'));
    set('metricMaterial', value('materials_installed'));
    set('metricUdpLock', value('udp_flows_locked'));
    set('metricUdpRejoin', value('udp_association_migrations'));
    set('metricActorUpdate', value('actor_updates_decoded'));
    set('metricInvalidPosition', value('actor_updates_invalid'));
    set('metricReject', value('rejected_authentication') + value('rejected_targets') + value('udp_candidates_rejected'));
  };
  const loadProxyStatus = async () => {
    try {
      const data = await apiJson('/api/v1/proxy/status');
      const state = data?.state || data?.status || data?.proxy?.state || 'ready';
      const pill = document.getElementById('proxyStatusPill'); if (pill) pill.textContent = statusLabel(state);
      const card = document.getElementById('proxyCardState'); if (card) card.textContent = statusLabel(state);
      const meta = document.getElementById('proxyMeta');
      if (meta) {
        const host = typeof data?.advertised_host === 'string' && data.advertised_host ? data.advertised_host : (data?.listen_host || '—');
        const port = Number(data?.advertised_port || data?.listen_port);
        const hosts = Array.isArray(data?.allow_hosts) ? data.allow_hosts.length : 0;
        const ports = Array.isArray(data?.allow_ports) ? data.allow_ports.length : 0;
        const ttl = Number(data?.profile_ttl_secs);
        meta.textContent = `${host}:${Number.isFinite(port) ? port : '—'} · 白名单 ${hosts} 个域名 / ${ports} 个端口 · 配置有效期 ${ttl > 0 ? Math.round(ttl / 86400) + ' 天' : '—'}`;
      }
    } catch (error) {
      if (error?.status === 401) {
        const pill = document.getElementById('proxyStatusPill'); if (pill) pill.textContent = '需要登录';
        const card = document.getElementById('proxyCardState'); if (card) card.textContent = 'auth_required';
        const meta = document.getElementById('proxyMeta'); if (meta) meta.textContent = '登录已失效，请重新认证';
        return;
      }
      const pill = document.getElementById('proxyStatusPill'); if (pill) pill.textContent = '暂不可用';
      const card = document.getElementById('proxyCardState'); if (card) card.textContent = 'unavailable';
      const meta = document.getElementById('proxyMeta'); if (meta) meta.textContent = '代理状态暂不可用';
      if (error?.message && !String(error.message).startsWith('404')) toast('代理状态接口暂不可用，仍可使用实时面板', 'info');
    }
  };
  const profileDate = value => {
    if (value == null || value === '') return '—';
    const numeric = Number(value);
    const milliseconds = Number.isFinite(numeric) ? numeric * (numeric < 1e12 ? 1000 : 1) : Date.parse(value);
    return Number.isFinite(milliseconds) ? new Date(milliseconds).toLocaleDateString() : '—';
  };
  const strictURIComponent = value => encodeURIComponent(value).replace(/[!'()*]/g, character => `%${character.charCodeAt(0).toString(16).toUpperCase()}`);
  const shadowrocketNodeImportUrl = nodeUrl => typeof nodeUrl === 'string' && nodeUrl ? `shadowrocket://add/${strictURIComponent(nodeUrl)}` : '';
  const shadowrocketConfigImportUrl = confPath => {
    if (typeof confPath !== 'string' || !confPath) return '';
    try { return `shadowrocket://config/add/${strictURIComponent(new URL(confPath, window.location.href).href)}`; }
    catch { return ''; }
  };
  const copyText = async value => {
    if (navigator.clipboard?.writeText) {
      await navigator.clipboard.writeText(value);
      return;
    }
    const field = document.createElement('textarea');
    field.value = value;
    field.setAttribute('readonly', '');
    field.style.position = 'fixed';
    field.style.left = '-9999px';
    document.body.appendChild(field);
    field.select();
    const copied = document.execCommand('copy');
    field.remove();
    if (!copied) throw new Error('copy unavailable');
  };
  const renderSavedProfiles = () => {
    const list = document.getElementById('savedProfileList');
    if (!list) return;
    if (!savedProfiles.length) {
      const empty = document.createElement('div');
      empty.className = 'profile-empty';
      empty.textContent = '尚无已保存配置';
      list.replaceChildren(empty);
      return;
    }
    const rows = savedProfiles.map(profile => {
      const row = document.createElement('div');
      row.className = 'saved-profile';
      const main = document.createElement('div');
      main.className = 'saved-profile-main';
      const title = document.createElement('div');
      title.className = 'saved-profile-title';
      const name = document.createElement('span');
      name.textContent = profile.label ? `${profile.label} · ${profile.profile_id}` : profile.profile_id;
      const state = document.createElement('span');
      const inactive = profile.revoked === true || profile.expired === true;
      state.className = `status-chip${inactive ? ' warning-pill' : ''}`;
      state.textContent = profile.revoked === true ? 'REVOKED' : (profile.expired === true ? 'EXPIRED' : 'SAVED');
      title.append(name, state);
      const meta = document.createElement('div');
      meta.className = 'saved-profile-meta';
      const generation = Number.isInteger(Number(profile.generation)) ? `generation ${Number(profile.generation)}` : 'generation —';
      meta.textContent = `${generation} · 创建 ${profileDate(profile.created_at ?? profile.created_at_unix)} · 到期 ${profileDate(profile.expires_at)}`;
      main.append(title, meta);
      const actions = document.createElement('div');
      actions.className = 'saved-profile-actions';
      const rotate = document.createElement('button');
      rotate.type = 'button'; rotate.className = 'ghost'; rotate.textContent = '轮换并重新下载';
      rotate.disabled = profile.revoked === true;
      rotate.addEventListener('click', () => mutateProfile('rotate', profile.profile_id));
      const revoke = document.createElement('button');
      revoke.type = 'button'; revoke.className = 'ghost danger-text'; revoke.textContent = '撤销';
      revoke.disabled = profile.revoked === true;
      revoke.addEventListener('click', () => mutateProfile('revoke', profile.profile_id));
      actions.append(rotate, revoke);
      row.append(main, actions);
      return row;
    });
    list.replaceChildren(...rows);
  };
  const loadProfiles = async () => {
    if (profilesLoadPromise) return profilesLoadPromise;
    profilesLoadPromise = (async () => {
      const list = document.getElementById('savedProfileList');
      try {
        const data = await apiJson('/api/v1/proxy/profiles');
        const profiles = Array.isArray(data) ? data : data?.profiles;
        if (!Array.isArray(profiles)) throw new Error('profile list schema invalid');
        savedProfiles = profiles.filter(profile => profile && typeof profile.profile_id === 'string').map(profile => ({
          profile_id: profile.profile_id,
          label: typeof profile.label === 'string' ? profile.label : '',
          created_at: profile.created_at,
          created_at_unix: profile.created_at_unix,
          expires_at: profile.expires_at,
          generation: profile.generation,
          revoked: profile.revoked === true,
          expired: profile.expired === true || (Number(profile.expires_at) > 0 && Number(profile.expires_at) <= Date.now() / 1000)
        })).sort((a, b) => Number(b.created_at ?? b.created_at_unix ?? 0) - Number(a.created_at ?? a.created_at_unix ?? 0));
        renderSavedProfiles();
      } catch (error) {
        if (list) {
          const failure = document.createElement('div');
          failure.className = 'profile-empty';
          failure.textContent = error?.status === 404 ? '服务器尚未启用已保存配置列表' : '已保存配置加载失败，请刷新重试';
          list.replaceChildren(failure);
        }
        if (error?.status !== 404) toast(`配置列表加载失败：${error.message || '未知错误'}`, 'bad');
      } finally {
        profilesLoadPromise = null;
      }
    })();
    return profilesLoadPromise;
  };
  const applyProfile = data => {
    if (!data || typeof data !== 'object' || typeof data.profile_id !== 'string') throw new Error('profile response invalid');
    const nodeUrl = typeof data.node_url === 'string' ? data.node_url : '';
    if (!nodeUrl.startsWith('socks5://')) throw new Error('direct node is missing');
    profileState = {
      id: data.profile_id,
      nodeUrl,
      importUrl: typeof data.shadowrocket_node_import_url === 'string' && data.shadowrocket_node_import_url
        ? data.shadowrocket_node_import_url
        : shadowrocketNodeImportUrl(nodeUrl),
      conf: typeof data.conf_download === 'string' ? data.conf_download : '',
      qr: typeof data.qr_download === 'string' ? data.qr_download : '',
      expires: data.expires_at
    };
    const result = document.getElementById('profileResult'); if (result) result.hidden = false;
    const id = document.getElementById('profileId'); if (id) id.textContent = profileState.id;
    const expiry = document.getElementById('profileExpiry'); if (expiry) expiry.textContent = profileState.expires ? `expires ${profileDate(profileState.expires)}` : '长期配置 · 可撤销';
    setDownload('profileConf', profileState.conf, '');
    setDownload('profileQr', profileState.qr, '');
    const confImport = document.getElementById('profileConfImport'); if (confImport) confImport.disabled = !shadowrocketConfigImportUrl(profileState.conf);
    const copy = document.getElementById('copyNode'); if (copy) copy.disabled = !profileState.nodeUrl;
    const direct = document.getElementById('profileImport'); if (direct) direct.disabled = !profileState.importUrl;
  };
  const clearProfileState = () => {
    profileState = null;
    const result = document.getElementById('profileResult'); if (result) result.hidden = true;
    const id = document.getElementById('profileId'); if (id) id.textContent = '—';
    const expiry = document.getElementById('profileExpiry'); if (expiry) expiry.textContent = '—';
    const confImport = document.getElementById('profileConfImport'); if (confImport) confImport.disabled = true;
    const copy = document.getElementById('copyNode'); if (copy) copy.disabled = true;
    const direct = document.getElementById('profileImport'); if (direct) direct.disabled = true;
    setDownload('profileConf', '', '');
    setDownload('profileQr', '', '');
  };
  const createProfile = async () => {
    const button = document.getElementById('createProfile'); if (button) { button.disabled = true; button.textContent = '生成中…'; }
    try { const data = await apiJson('/api/v1/proxy/profiles', {method: 'POST', headers: {'content-type': 'application/json'}, body: '{}'}); applyProfile(data); await loadProfiles(); toast('选择性配置已生成；请一键导入完整配置并开启 UDP 转发', 'good'); }
    catch (error) { toast(`配置生成失败：${error.message}`, 'bad'); }
    finally { if (button) { button.disabled = false; button.textContent = '生成配置'; } }
  };
  const mutateProfile = async (action, requestedId) => {
    const profileId = requestedId || profileState?.id;
    if (!profileId) { toast('请先生成或选择一个配置', 'info'); return; }
    try { const data = await apiJson(`/api/v1/proxy/profiles/${encodeURIComponent(profileId)}/${action}`, {method: 'POST', headers: {'content-type': 'application/json'}, body: '{}'}); if (action === 'revoke') { if (profileState?.id === profileId) clearProfileState(); toast('配置已撤销', 'good'); } else { applyProfile(data); toast('配置凭据已轮换，请立即重新添加；旧节点已失效', 'good'); } await loadProfiles(); }
    catch (error) { toast(`${action === 'revoke' ? '撤销' : '轮换'}失败：${error.message}`, 'bad'); }
  };
  const loadCaStatus = async () => {
    try {
      const data = await apiJson('/api/v1/ca/status');
      const enabled = data?.enabled !== false; const state = document.getElementById('caState'); if (state) { state.textContent = enabled ? '已就绪' : '未启用'; state.className = `status-chip ${enabled ? '' : 'warning-pill'}`; }
      const status = document.getElementById('caStatusText'); if (status) status.textContent = enabled ? '已生成 · 私钥受限保存' : '未启用';
      const fingerprint = document.getElementById('caFingerprint'); if (fingerprint) fingerprint.textContent = typeof data?.fingerprint_sha256 === 'string' ? data.fingerprint_sha256 : '—';
      const generated = document.getElementById('caGenerated');
      if (generated) {
        const unix = Number(data?.generated_at_unix);
        generated.textContent = Number.isFinite(unix) && unix > 0
          ? new Date(unix * 1000).toLocaleString()
          : '—';
      }
    } catch (error) { const status = document.getElementById('caStatusText'); if (status) status.textContent = '状态接口暂不可用'; const state = document.getElementById('caState'); if (state) state.textContent = '暂不可用'; }
    setDownload('caPem', null, '/api/v1/ca/download/pem'); setDownload('caDer', null, '/api/v1/ca/download/der'); setDownload('caMobile', null, '/api/v1/ca/download/mobileconfig'); setDownload('caReadme', null, '/api/v1/ca/download/readme');
  };

  const normalizePosition = (raw, captureNs) => {
    if (!raw || !Number.isInteger(raw.slot) || raw.slot < 0 || raw.slot > 63 || !raw.world ||
        ![raw.world.x,raw.world.y,raw.world.z,raw.yaw].every(Number.isFinite)) return null;
    const continuity = Object.hasOwn(continuityClasses, raw.continuity) ? raw.continuity : 'degraded';
    const confidence = raw.identity_confidence === 'proven' ? 'proven' : 'unresolved';
    const map = mapMode === 'manual'
      ? worldToMap(raw.world)
      : (raw.map && Number.isFinite(raw.map.u) && Number.isFinite(raw.map.v)
        ? {u: raw.map.u, v: raw.map.v} : worldToMap(raw.world));
    return {
      slot: raw.slot,
      track_id: confidence === 'proven' && typeof raw.track_id === 'string'
        ? raw.track_id.slice(0, 128) : `batch_slot_${raw.slot}`,
      actor_guid: Number.isInteger(raw.actor_guid) ? raw.actor_guid : null,
      player_state_guid: Number.isInteger(raw.player_state_guid) ? raw.player_state_guid : null,
      display_name: confidence === 'proven' && typeof raw.display_name === 'string' ? raw.display_name.slice(0, 128) : null,
      agent_id: confidence === 'proven' && Number.isInteger(raw.agent_id) ? raw.agent_id : null,
      // 阵营（我方/敌方）由引擎的 state_index 判定，是"证明过的"信息，
      // 不受"身份置信度"影响 —— 之前两者绑在一起，导致队友/敌人全变灰"未知"。
      camp_id: Number.isInteger(raw.camp_id) ? raw.camp_id : null,
      world: {x: raw.world.x, y: raw.world.y, z: raw.world.z}, map,
      pitch: Number.isFinite(raw.pitch) ? raw.pitch : 0, yaw: raw.yaw,
      fresh: raw.fresh !== false, continuity, identity_confidence: confidence,
      updated_ns: Number(raw.updated_ns) || Number(captureNs), capture_ns: Number(captureNs)
    };
  };

  const ingestPositions = (positions, captureNs) => {
    lastIngestMs = performance.now();
    if (typeof lurchProbe !== 'undefined' && lurchProbe && lurchProbe.style.display !== 'none') {
      probeDataAt.push(performance.now());
    }
    const timestamp = Number(captureNs || 0);
    if (!Number.isFinite(timestamp)) return;
    startNs = startNs == null ? timestamp : Math.min(startNs, timestamp);
    latestNs = latestNs == null ? timestamp : Math.max(latestNs, timestamp);
    if (live && !paused) cursorNs = latestNs;
    for (const raw of positions || []) {
      const point = normalizePosition(raw, timestamp);
      if (!point) continue;
      if (!visible.has(point.slot)) visible.set(point.slot, true);
      if (live && !paused) applyPoint(point);
    }
    eventCount++;
    rateWindow.push(performance.now());
    updateTimeline();
    rebuildPlayers();
    needsDraw = true;
  };

  const applyPoint = point => {
    updateLifeState(point);   // 生死判定只依赖"这一条是不是零变化慢投递"，与绘制无关
    // A stale coordinate is no longer active in the current actor stream.
    // Keep it in the timeline for replay/recovery, but never let its old
    // motion vector drive live threat cues while it is hidden.
    if (!isActiveRadarPoint(point)) {
      motionBySlot.delete(point.slot);
      current.set(point.slot, point);
      return;
    }
    const previous = current.get(point.slot);
    if (previous) {
      const previousNs = Number(previous.updated_ns || previous.capture_ns);
      const pointNs = Number(point.updated_ns || point.capture_ns);
      const elapsedSeconds = (pointNs-previousNs)/1e9;
      if (Number.isFinite(elapsedSeconds) && elapsedSeconds >= .005 && elapsedSeconds <= 2) {
        const velocity = {
          x: (point.world.x-previous.world.x)/100/elapsedSeconds,
          y: (point.world.y-previous.world.y)/100/elapsedSeconds,
          z: (point.world.z-previous.world.z)/100/elapsedSeconds
        };
        const speed = Math.hypot(velocity.x,velocity.y,velocity.z);
        if (Number.isFinite(speed) && speed <= 50) {
          const prior = motionBySlot.get(point.slot);
          const blend = prior ? Math.max(.25,Math.min(.7,elapsedSeconds*4)) : 1;
          motionBySlot.set(point.slot, {
            x: prior ? prior.x+(velocity.x-prior.x)*blend : velocity.x,
            y: prior ? prior.y+(velocity.y-prior.y)*blend : velocity.y,
            z: prior ? prior.z+(velocity.z-prior.z)*blend : velocity.z,
            updated_ns: pointNs
          });
        } else {
          motionBySlot.delete(point.slot);
        }
      } else if (elapsedSeconds > 2) {
        motionBySlot.delete(point.slot);
      }
    }
    current.set(point.slot, point);
  };

  const replaceSnapshot = (positions, captureNs, reason) => {
    lastIngestMs = performance.now();
    const timestamp = Number(captureNs || 0);
    if (!Number.isFinite(timestamp)) return;
    latestNs = latestNs == null ? timestamp : Math.max(latestNs, timestamp);
    if (reason === 'lag_resync' && (paused || !live)) {
      updateTimeline();
      return;
    }
    current = new Map();
    motionBySlot = new Map();
    for (const raw of positions || []) {
      const point = normalizePosition(raw, timestamp);
      if (!point) continue;
      if (!visible.has(point.slot)) visible.set(point.slot, true);
      applyPoint(point);
    }
    if (reason === 'live') { live = true; setPaused(false); }
    if (reason !== 'seek' || paused) cursorNs = timestamp;
    rebuildPlayers();
    updateTimeline();
    needsDraw = true;
  };

  const updateTimeline = () => {
    const span = Math.max(1, (latestNs || 0) - (startNs || 0));
    const fraction = ((cursorNs ?? latestNs ?? 0) - (startNs || 0)) / span;
    seek.value = String(Math.max(0, Math.min(1000, Math.round(fraction * 1000))));
    document.getElementById('elapsed').textContent = fmtTime((cursorNs ?? latestNs ?? 0) - (startNs || 0));
    document.getElementById('duration').textContent = fmtTime(span);
    const replaySeek = document.getElementById('replaySeek');
    if (replaySeek) replaySeek.value = seek.value;
    const replayElapsed = document.getElementById('replayElapsed'); if (replayElapsed) replayElapsed.textContent = document.getElementById('elapsed').textContent;
    const replayDuration = document.getElementById('replayDuration'); if (replayDuration) replayDuration.textContent = document.getElementById('duration').textContent;
    const replayCursor = document.getElementById('replayCursor'); if (replayCursor) replayCursor.textContent = cursorNs == null ? '—' : `采集时间 ${Math.round(cursorNs)}`;
  };

  const setSelfSlot = (slot, persist = true) => {
    selfSlot = Number.isInteger(slot) && slot >= 0 && slot <= 63 ? slot : null;
    if (persist) try {
      if (selfSlot === null) localStorage.removeItem('codev.display.selfSlot');
      else localStorage.setItem('codev.display.selfSlot', String(selfSlot));
    } catch {}
    rebuildPlayers();
    needsDraw = true;
  };

  // 引擎给的贴槽结果：自己落在哪个槽 + 本机五人槽位。
  // 自己这个槽位是引擎用"本机角色出生点"锚出来的（不是猜的），所以它是权威。
  // ⚠ 这里原来把"手选过自己"永久写进 localStorage，而旧的多房间模式里**所有房间共用
  //   同一份本地存储**，于是手选一次之后引擎判定永远被忽略；换局/换房间后
  //   槽位重新分配，页面就停在旧槽位 → 没有黄色自己、整队被画成敌人、3D 一直要求"选自己"，
  //   看起来就是"客户端没雷达效果"（浏览器那边只是恰好存了正确的自选值）。
  // 现在：手选只在**本次页面会话内**有效，并在引擎判定时校验"手选槽位是否仍属于本局本机阵营"。
  let selfSlotManual = false;
  // 手选发生在哪一代（channel_generation）：换局后槽位重排，手选必须失效交还引擎；
  // 但**同一局内**手选不再交给引擎（见 applyEngineBinding 的 manualStillValid）。
  let selfManualGen = null;
  // 引擎 self_slot 的"两连一致"计数（见 applyEngineBinding）
  let pendingEngineSelfSlot = null, pendingEngineSelfSlotHits = 0;
  try { localStorage.removeItem('codev.display.selfManual'); } catch {}
  let engineBinding = { self_slot: null, local_slots: [] };
  const applyEngineBinding = binding => {
    if (!binding || typeof binding !== 'object') return;
    engineBinding = {
      self_slot: Number.isInteger(binding.self_slot) ? binding.self_slot : null,
      local_slots: Array.isArray(binding.local_slots) ? binding.local_slots.filter(Number.isInteger) : []
    };
    // 手选仍有效的前提（2026-10-05 改）：
    //   ① 它是**本局**选的（换局 = channel_generation 变 → 槽位重排，必须交还引擎判定）；
    //   ② 手选那个人没有被阵营证据否定（持续显示为敌方，见 selfCampRejected）。
    // 以前这里用的是"槽位还在不在本机阵营五人名单里"。观战/换局时引擎那份名单会重排，
    // 于是手选被误杀 → 交还引擎 → 而引擎此刻恰好指到被观战的人 → 用户看到"选中的自己跳到别人身上"。
    const manualStillValid = selfSlotManual && selfSlot !== null
      && (selfManualGen === null || channelGeneration === null || selfManualGen === channelGeneration)
      && !selfCampRejected(current.get(selfSlot) || {});
    if (!manualStillValid) selfSlotManual = false;   // 手选残留直接失效，交还给引擎判定
    if (engineBinding.self_slot !== null) removeSelfDiagnostic();   // 引擎已认出 → 诊断入口自动消失
    // 观战/阵亡窗口里不急着认引擎的新判定：人一死，游戏会把"本机视角"切到被观战的人身上，
    // 引擎按出生点的判定在这个窗口里最容易指到别人。判据 = 自己那条超过 3 秒没更新。
    const selfQuietMs = (() => {
      if (selfSlot === null) return 0;
      const point = current.get(selfSlot);
      const ns = point ? Number(point.updated_ns || point.capture_ns || 0) : 0;
      const latest = Number(latestNs || 0);
      if (!ns || !latest || latest <= ns) return 0;
      return (latest - ns) / 1e6;
    })();
    const selfSpectating = lifeState.get(selfSlot)?.state === 'dead' || selfQuietMs > 3000;
    // 引擎的 self_slot 要"连续一致"才采纳：单条消息抖一下不改绑定；
    // 观战窗口里要求更长的连续一致（5 条），避免那几秒的误判把手选/已认出的自己顶掉。
    // 还没有"自己"时一条就采纳：引擎通常只发一条 roster，而以前要求"两条一致"，
    // 于是新开的网页/观众页永远认不出自己 → 所有人都被画成敌人（客户报的"我们是红方"）。
    // 已经有绑定之后仍然保持原来的抗抖策略（2 条；观战窗口 5 条）。
    const requiredEngineHits = selfSlot === null ? 1 : (selfSpectating ? 5 : 2);
    if (engineBinding.self_slot !== null && engineBinding.self_slot !== selfSlot) {
      if (engineBinding.self_slot === pendingEngineSelfSlot) pendingEngineSelfSlotHits += 1;
      else { pendingEngineSelfSlot = engineBinding.self_slot; pendingEngineSelfSlotHits = 1; }
      if (pendingEngineSelfSlotHits < requiredEngineHits) return;
    } else {
      pendingEngineSelfSlot = null; pendingEngineSelfSlotHits = 0;
    }
    if (!manualStillValid && engineBinding.self_slot !== null && engineBinding.self_slot !== selfSlot) {
      setSelfSlot(engineBinding.self_slot, true);
      selfSlotManual = false;
      selfManualGen = null;
      const point = current.get(engineBinding.self_slot);
      if (point && point.track_id) {
        selfTrackId = point.track_id;
        selfTrackGen = channelGeneration;
        try {
          localStorage.setItem('codev.display.selfTrack', selfTrackId);
          if (channelGeneration !== null) localStorage.setItem('codev.display.selfGen', channelGeneration);
        } catch {}
      }
      toast(`引擎已认出你 = 槽 ${engineBinding.self_slot}（按出生点判定，可随时手动改）`, 'good');
    }
  };

  const updateRoster = entries => {
    const next = new Map();
    for (const entry of Array.isArray(entries) ? entries : []) {
      if (!entry || !Number.isInteger(entry.slot) || entry.slot < 0 || entry.slot > 63) continue;
      next.set(entry.slot, {
        slot: entry.slot,
        camp_id: Number.isInteger(entry.camp_id) ? entry.camp_id : null
      });
    }
    rosterBySlot = next;
    rebuildPlayers();
    needsDraw = true;
  };

  // 朝向（弧度）。原来它定义在 drawRadar 内部，3D 的 drawOverlay 看不见 →
  // 一开 3D 就抛 ReferenceError，而 rAF 循环末尾才排下一帧，异常直接把整个雷达画死。
  // 提到模块级共用，并用可选链保证 calibration 还没加载时也不会 NaN。
  // 朝向"单帧尖峰"过滤（2026-10-03 实测定位）：
  // 用你 9/30 的抓包统计，站着不动时游戏会**间歇性上报 yaw = 0**（一帧），下一帧又跳回真实值 ——
  // 该槽位静止帧里 0 度出现 3046 次、相邻帧跳变>20° 121 次。跟随视角时地图就跟着来回晃。
  // 真实转身是连续变化，所以取"最近 5 个数据采样（按 updated_ns 去重）的中位数"即可滤掉尖峰：
  // 同一份抓包上滤波后 → 0 度只剩 2 次、跳变 0 次；真实转身只滞后约 2 个采样（≈60ms）。
  const YAW_FILTER_WINDOW = 5;
  const yawFilters = new Map();
  const stableYaw = (slot, rawYaw, ns) => {
    const key = Number.isInteger(slot) ? slot : -1;
    let entry = yawFilters.get(key);
    if (!entry) { entry = { ns: null, raw: null, win: [], stable: 0 }; yawFilters.set(key, entry); }
    const raw = Number(rawYaw);
    if (!Number.isFinite(raw)) return entry.stable;
    const yaw = ((raw % 360) + 360) % 360;
    const stamp = Number(ns);
    const hasNs = ns !== undefined && ns !== null && Number.isFinite(stamp) && stamp > 0;
    // 网络乱序时不能拿旧帧清空滑动窗口。旧实现遇到时间戳回退会
    // 先把 5 帧中位数丢掉，再把过期的 yaw 当成新基线，单帧尖峰就又进来了。
    // 换局由 channel_generation 分支统一 yawFilters.clear()；单纯乱序帧只忽略。
    if (hasNs && entry.ns !== null && stamp < entry.ns) return entry.stable;
    if (hasNs ? entry.ns !== stamp : entry.raw !== yaw) {
      entry.ns = hasNs ? stamp : null;
      entry.raw = yaw;
      const base = entry.win.length ? entry.win[entry.win.length - 1] : yaw;
      // O(1) angular unwrap: even a very large but finite yaw cannot spin an unbounded while loop.
      const delta = ((yaw - base + 180) % 360 + 360) % 360 - 180;
      const value = base + delta;
      entry.win.push(value);
      if (entry.win.length > YAW_FILTER_WINDOW) entry.win.shift();
    }
    const sorted = [...entry.win].sort((a, b) => a - b);
    const median = sorted[Math.floor(sorted.length / 2)];
    entry.stable = ((median % 360) + 360) % 360;
    return entry.stable;
  };
  const headingFor = point => (stableYaw(point.slot, point.yaw, point.updated_ns) - (calibration?.default_rotation_degrees ?? 0)) * Math.PI / 180;

  const roleForPoint = point => {
    if (selfSlot !== null && point.slot === selfSlot) return 'self';
    // 本机房间必须优先使用本机解码出的五人槽位；云端已不再参与，
    // 仅凭 camp_id 无法知道哪一组是手机端我方（我方可能是 camp 2）。
    const boundLocalSlots = new Set(engineBinding.local_slots);
    if (boundLocalSlots.has(point.slot)) return 'team';
    const localCampVotes = [...boundLocalSlots]
      .map(slot => current.get(slot)?.camp_id)
      .filter(Number.isInteger);
    const localCampCounts = new Map();
    for (const camp of localCampVotes) localCampCounts.set(camp, (localCampCounts.get(camp) || 0) + 1);
    const boundCamp = [...localCampCounts.entries()]
      .sort((a, b) => b[1] - a[1])[0]?.[0] ?? null;
    // 自己所在阵营：优先本机槽位多数，其次当前自身点，再回退到手选阵营，最后才是旧默认1。
    const liveCamp = selfSlot === null ? null : current.get(selfSlot)?.camp_id;
    const ownCamp = Number.isInteger(liveCamp) ? liveCamp
      : (Number.isInteger(selfCampId) ? selfCampId : 1);
    const finalOwnCamp = Number.isInteger(boundCamp) ? boundCamp : ownCamp;
    const pointCamp = point.camp_id;
    if (Number.isInteger(finalOwnCamp) && Number.isInteger(pointCamp)) return finalOwnCamp === pointCamp ? 'team' : 'enemy';
    return 'unknown';
  };
  const roleLabels = { self: '自身', team: '队友', enemy: '敌人', unknown: '未知' };
  // ---- 标记大小 / 阵营筛选（存本机，和同行面板一个思路）----
  let markerScale = (() => {
    try {
      const value = Number(localStorage.getItem('codev.display.markerScale'));
      return Number.isFinite(value) && value >= 60 && value <= 170 ? value / 100 : 1;
    } catch { return 1; }
  })();
  const campFilter = (() => {
    const base = { self: true, team: true, enemy: true, dead: true };
    try {
      const raw = localStorage.getItem('codev.display.campFilter');
      return raw ? Object.assign(base, JSON.parse(raw)) : base;
    } catch { return base; }
  })();
  const persistCampFilter = () => {
    try { localStorage.setItem('codev.display.campFilter', JSON.stringify(campFilter)); } catch {}
  };
  // 血量：解码层提供了 health/max_health（或 hp/max_hp）就显示，没有就不画 —— 不造假数据。
  const healthRatioFor = point => {
    const cur = Number(point?.health ?? point?.hp);
    const max = Number(point?.max_health ?? point?.max_hp);
    if (!Number.isFinite(cur) || !Number.isFinite(max) || max <= 0) return null;
    return Math.max(0, Math.min(1, cur / max));
  };
  const isDeadPoint = point => point?.alive === false
    || (healthRatioFor(point) === 0)
    || point?.life_state === 'dead';
  // 阵亡的人不必再报威胁
  const campAllowed = (role, point) => {
    if (isDeadPoint(point)) return campFilter.dead;
    if (role === 'self') return campFilter.self;
    if (role === 'team') return campFilter.team;
    if (role === 'enemy') return campFilter.enemy;
    return true;
  };
  // The server applies a grace period before declaring a sparse actor slot
  // stale. Do not add a second client-side age cutoff: game delta batches may
  // legitimately omit an otherwise active stationary actor for a while.
  const isActiveRadarPoint = point => {
    return Boolean(point) && point.continuity !== 'stale';
  };
  const activeRadarPoints = () => [...current.values()].filter(isActiveRadarPoint);
  // 画不画，只看"这条通道多久没有新数据了"：
  //   我方(含自己)：整段静默就立刻不画 —— 包里没有"死亡"字段（实测过：状态位/句柄/静止
  //     三种判据都对不上），只能拿"客户端不再推这个 actor"当死亡/消失的近似。
  //   敌方：静默只代表"进雾了"，保留最后位置(半透明+"最后位置")，TTL 拉长，避免一闪一黑。
  let teamLingerMs = (() => {
    try { const v = Number(localStorage.getItem('codev.display.teamLinger')); return Number.isFinite(v) && v >= 800 && v <= 6000 ? v : 2500; }
    catch { return 2500; }
  })();
  const ENEMY_LINGER_MS = 25000;
  const STALE_DIM_AFTER_MS = 2000;
  const lastLiveAt = new Map();
  const lastSeenNs = new Map();
  // ===== 生死三级状态（活 / 失联 / 阵亡）=====
  // 背景：包里**没有**死亡字段。1.24.0.2911 的字段字典（codev-cli/assets/fields-*.json）
  // 只逆出了传输层（WaterMark/ChaCha/Oodle/PacketNotify）和大厅 protobuf（agent_list/camp_info…），
  // 没有任何血量/伤害/击杀字段；坐标通道里也只有 位置/朝向/state_index/extra_state 四项。
  // 实测两条事实（工具/死亡判定器-final.py，样本 Bind 228s + Icebox 334s）：
  //   ① 活人（含站着不动、架枪）是 8~30Hz 连发；但**活人也可能静默 6~14 秒**（走远/离开复制集）
  //      → 所以「静默」绝不能判死，只能降级显示；
  //   ② 真死之后，客户端会**重复投递同一份冻结状态**（x/y/z/yaw 全同）≥2 次，直到回合结束；
  //      两局里这条只落在真死者身上（局1 我方 3 人、局2 4 敌 1 友）。
  const LIFE_SLOW_TICK_MS = 1500;    // 超过这个间隔才算"慢投递"
  const LIFE_DEAD_TICKS = 2;         // 连续 2 次零变化慢投递 → 阵亡
  const LIFE_FADE_ENEMY_MS = 8000;   // 敌方静默多久转"失联幽灵"
  const LIFE_DEAD_LINGER_MS = 3000;  // 判定阵亡后仍绘制多久（你要的残留 3 秒）
  const LIFE_TEAM_GHOST_TTL_MS = 12000; // 我方幽灵最多留多久，之后不再画
  const lifeState = new Map();       // slot -> {ns, sig, ticks, state, deadAtMs}
  const LIFE_DEBUG = (() => { try { return location.search.includes('lifedebug'); } catch { return false; } })();
  // 每次收到该槽位的新数据时更新（高频→活；零变化慢投递→累计；静默后又有位移→活）
  const updateLifeState = point => {
    const ns = Number(point.updated_ns || point.capture_ns || 0);
    const sig = `${point.world.x}|${point.world.y}|${point.world.z}|${point.yaw}`;
    const prev = lifeState.get(point.slot);
    if (!prev) {
      lifeState.set(point.slot, {ns, sig, ticks: 0, state: 'live', deadAtMs: 0});
      return;
    }
    const gapMs = (ns - prev.ns) / 1e6;
    let ticks = prev.ticks, state = prev.state, deadAtMs = prev.deadAtMs;
    if (!(gapMs > 0) || gapMs < 500) {
      ticks = 0; state = 'live'; deadAtMs = 0;                 // 高频 → 活（复活/被救也走这条）
    } else if (gapMs >= LIFE_SLOW_TICK_MS) {
      if (sig === prev.sig) {
        ticks += 1;
        if (ticks >= LIFE_DEAD_TICKS && state !== 'dead') { state = 'dead'; deadAtMs = performance.now(); }
      } else {
        ticks = 0; state = 'live'; deadAtMs = 0;                // 静默之后又动了 → 活着
      }
    }
    lifeState.set(point.slot, {ns, sig, ticks, state, deadAtMs});
  };
  // 用于渲染的当前状态：live / fade(失联幽灵) / dying(阵亡残留) / dead(不再画)
  const lifeOf = point => {
    const st = lifeState.get(point && point.slot);
    if (!st) return 'live';
    if (st.state === 'dead') {
      return (performance.now() - st.deadAtMs < LIFE_DEAD_LINGER_MS) ? 'dying' : 'dead';
    }
    const role = roleForPoint(point);
    const fadeMs = (role === 'self' || role === 'team') ? teamLingerMs : LIFE_FADE_ENEMY_MS;
    return pointAgeMs(point) > fadeMs ? 'fade' : 'live';
  };
  const drawablePoints = () => {
    const now = performance.now();
    const points = [];
    for (const point of current.values()) {
      const updatedNs = Number(point.updated_ns || point.capture_ns || 0);
      if (lastSeenNs.get(point.slot) !== updatedNs) {
        lastSeenNs.set(point.slot, updatedNs);
        lastLiveAt.set(point.slot, now);
      }
      if (lastLiveAt.get(point.slot) === undefined) lastLiveAt.set(point.slot, now);
      const seen = lastLiveAt.get(point.slot);
      const role = roleForPoint(point);
      const life = lifeOf(point);
      // 唯一会"删除"的路径：判定阵亡（依据=重复投递的冻结状态）且残留时间已过
      if (life === 'dead') continue;
      // 其余都画：活人用实心+针；失联/阵亡残留画成幽灵，位置仍给最后已知
      const ttl = (role === 'enemy' || role === 'unknown')
        ? ENEMY_LINGER_MS
        : Math.max(teamLingerMs * 4, LIFE_TEAM_GHOST_TTL_MS);
      if (point.map && now - seen < ttl) points.push(point);
    }
    return points;
  };
  const pointAgeMs = point => performance.now() - (lastLiveAt.get(point?.slot) ?? 0);

  const recentMotionFor = point => {
    if (!point) return null;
    const motion = motionBySlot.get(point.slot);
    if (!motion) return null;
    const referenceNs = Number(latestNs || point.updated_ns || point.capture_ns);
    const ageNs = referenceNs-Number(motion.updated_ns);
    return Number.isFinite(ageNs) && ageNs >= 0 && ageNs <= THREAT_MOTION_MAX_AGE_NS ? motion : null;
  };
  const threatMetricsFor = (point,selfPoint) => {
    if (!isActiveRadarPoint(point) || !isActiveRadarPoint(selfPoint) || !point.world || !selfPoint.world || point.slot === selfPoint.slot) return null;
    const dx=(point.world.x-selfPoint.world.x)/100;
    const dy=(point.world.y-selfPoint.world.y)/100;
    const dz=(point.world.z-selfPoint.world.z)/100;
    const distanceMeters=Math.hypot(dx,dy,dz);
    const targetMotion=recentMotionFor(point), selfMotion=recentMotionFor(selfPoint);
    let approachSpeed=null;
    if (distanceMeters > .01 && (targetMotion || selfMotion)) {
      const relativeVelocity={
        x:(targetMotion?.x||0)-(selfMotion?.x||0),
        y:(targetMotion?.y||0)-(selfMotion?.y||0),
        z:(targetMotion?.z||0)-(selfMotion?.z||0)
      };
      approachSpeed=-(dx*relativeVelocity.x+dy*relativeVelocity.y+dz*relativeVelocity.z)/distanceMeters;
      if (!Number.isFinite(approachSpeed)) approachSpeed=null;
    }
    return {
      distanceMeters,
      heightMeters:dz,
      approachSpeed,
      approaching:approachSpeed !== null && approachSpeed >= THREAT_APPROACH_SPEED_MPS,
      receding:approachSpeed !== null && approachSpeed <= -THREAT_APPROACH_SPEED_MPS,
      critical:distanceMeters <= THREAT_CRITICAL_DISTANCE_METERS
    };
  };
  const heightLabelFor = heightMeters => {
    if (!Number.isFinite(heightMeters) || Math.abs(heightMeters) < 1.5) return '同层';
    return `${heightMeters > 0 ? '↑' : '↓'}${Math.round(Math.abs(heightMeters))}m`;
  };
  const insideScreen = (x,y,width,height,margin=12) =>
    Number.isFinite(x) && Number.isFinite(y) && x >= margin && x <= width-margin && y >= margin && y <= height-margin;
  const screenEdgePoint = (x,y,width,height,margin=28) => {
    const centerX=width/2, centerY=height/2, dx=x-centerX, dy=y-centerY;
    if (!Number.isFinite(dx) || !Number.isFinite(dy) || Math.hypot(dx,dy) < 1e-6) return null;
    const candidates=[];
    if (dx > 0) candidates.push((width-margin-centerX)/dx);
    else if (dx < 0) candidates.push((margin-centerX)/dx);
    if (dy > 0) candidates.push((height-margin-centerY)/dy);
    else if (dy < 0) candidates.push((margin-centerY)/dy);
    const scale=Math.min(...candidates.filter(value=>Number.isFinite(value)&&value>=0));
    if (!Number.isFinite(scale)) return null;
    return {x:centerX+dx*scale,y:centerY+dy*scale,angle:Math.atan2(dy,dx)};
  };
  const drawOffscreenThreat = (context,width,height,targetX,targetY,metrics) => {
    const edge=screenEdgePoint(targetX,targetY,width,height);
    if (!edge || !metrics) return;
    const pulse=.5+.5*Math.sin(performance.now()/145);
    context.save();
    context.translate(edge.x,edge.y);context.rotate(edge.angle);
    context.fillStyle=metrics.approaching ? `rgba(255,77,95,${.72+.22*pulse})` : 'rgba(255,77,95,.82)';
    context.strokeStyle='rgba(3,10,15,.95)';context.lineWidth=2;
    context.beginPath();context.moveTo(13,0);context.lineTo(-8,-8);context.lineTo(-4,0);context.lineTo(-8,8);context.closePath();context.fill();context.stroke();
    context.restore();
    const labelX=edge.x-Math.cos(edge.angle)*28, labelY=edge.y-Math.sin(edge.angle)*28;
    const label=`${Math.round(metrics.distanceMeters)}m ${heightLabelFor(metrics.heightMeters)}`;
    context.save();context.font=`800 9px ${LABEL_FONT_STACK}`;context.textAlign='center';context.textBaseline='middle';
    context.lineWidth=3;context.strokeStyle='rgba(2,8,12,.96)';context.strokeText(label,labelX,labelY);
    context.fillStyle='#ff6a78';context.fillText(label,labelX,labelY);context.restore();
  };
  const drawEnemyFacingCone = (context,x,y,angle,distanceMeters) => {
    const radius=Math.max(30,Math.min(58,60-distanceMeters*.35));
    const halfAngle=THREAT_FOV_HALF_ANGLE_DEGREES*Math.PI/180;
    context.save();context.globalAlpha=.06;context.fillStyle='#ff4d5f';context.strokeStyle='rgba(255,77,95,.22)';context.lineWidth=1;
    context.beginPath();context.moveTo(x,y);context.arc(x,y,radius,angle-halfAngle,angle+halfAngle);context.closePath();context.fill();context.stroke();context.restore();
  };
  const drawThreatHud = (context,width,height,metrics) => {
    if (!metrics) return;
    // 手机是全屏雷达：原来那条"最近敌人 19m · 同层 · 近距离 · 距离稳定"横条
    // 几乎铺满屏宽、还压在 2D 底图下缘（读数本身在地图上已经有了）。
    // 手机上改成左下角一个小小的仪表：数字大、单位小、底子几乎没有。
    if (width <= 640) {
      const label = Math.round(metrics.distanceMeters) + 'm';
      context.save();
      context.textAlign = 'center';
      context.textBaseline = 'middle';
      context.font = `800 27px ${LABEL_FONT_STACK}`;
      const w = context.measureText(label).width;
      const boxW = w + 22, boxH = 46, bx = 12, by = height - boxH - 12;
      context.beginPath();
      if (context.roundRect) context.roundRect(bx, by, boxW, boxH, 12); else context.rect(bx, by, boxW, boxH);
      context.fillStyle = 'rgba(6, 12, 21, .54)';
      context.fill();
      context.strokeStyle = metrics.approaching ? 'rgba(255, 107, 125, .52)' : 'rgba(150, 196, 236, .18)';
      context.lineWidth = 1;
      context.stroke();
      context.fillStyle = metrics.approaching ? '#ff8490' : 'rgba(233, 242, 251, .90)';
      context.fillText(label, bx + boxW / 2, by + boxH / 2 + 1);
      context.font = '650 10px -apple-system, BlinkMacSystemFont, sans-serif';
      context.fillStyle = 'rgba(160, 190, 218, .78)';
      context.fillText('最近敌人', bx + boxW / 2, by - 8);
      context.restore();
      return;
    }
    const states=[];
    if (metrics.critical) states.push('近距离');
    if (metrics.approaching) states.push(`接近 ${metrics.approachSpeed.toFixed(1)}m/s`);
    else if (metrics.receding) states.push(`远离 ${Math.abs(metrics.approachSpeed).toFixed(1)}m/s`);
    else if (metrics.approachSpeed !== null) states.push('距离稳定');
    const state=states.length?` · ${states.join(' · ')}`:'';
    const text=`最近敌人 ${Math.round(metrics.distanceMeters)}m · ${heightLabelFor(metrics.heightMeters)}${state}`;
    context.save();context.font=`600 10px ${LABEL_FONT_STACK}`;
    const boxWidth=Math.min(width-28,context.measureText(text).width+18), x=14, y=height-46;
    context.fillStyle='rgba(28,8,13,.86)';context.strokeStyle=metrics.approaching?'rgba(255,77,95,.82)':'rgba(255,77,95,.42)';context.lineWidth=1;
    context.beginPath();context.roundRect(x,y,boxWidth,30,8);context.fill();context.stroke();
    context.fillStyle='#ff8490';context.textAlign='left';context.textBaseline='middle';context.fillText(text,x+11,y+15);context.restore();
  };

  const rebuildPlayers = () => {
    const list = document.getElementById('players');
    const points = activeRadarPoints().sort((a,b) => a.slot-b.slot);
    const rows = points.map(point => {
      const button = document.createElement('button');
      const role = roleForPoint(point);
      button.className = 'player'; button.style.setProperty('--slot', markerColors[role]);
      button.setAttribute('aria-pressed', String(visible.get(point.slot) !== false));
      button.innerHTML = `<span class="swatch"></span><span class="pav"></span><span class="pmain"><span class="player-name"></span><span class="player-detail"></span><span class="pbar"><i></i></span></span><span class="health"></span>`;
      const meta = agentMetaFor(point.agent_id);
      const pav = button.querySelector('.pav');
      if (meta) {
        pav.textContent = meta.name.slice(0, 1);
        pav.style.background = `linear-gradient(145deg,${meta.color},rgba(24,10,14,.92))`;
      } else {
        pav.textContent = String(point.slot + 1);
      }
      const agentName = meta ? `${meta.name} · ` : '';
      button.querySelector('.player-name').textContent = `${agentName}${roleLabels[role]} · 图标 ${point.slot + 1}`;
      const hpRatio = healthRatioFor(point);
      const hpText = hpRatio === null ? `朝向 ${Math.round(((point.yaw % 360) + 360) % 360)}°`
        : `${Math.ceil(Number(point.health ?? point.hp))}/${Math.ceil(Number(point.max_health ?? point.max_hp))} · 朝向 ${Math.round(((point.yaw % 360) + 360) % 360)}°`;
      button.querySelector('.player-detail').textContent = hpText;
      const pbar = button.querySelector('.pbar > i');
      if (pbar) {
        pbar.style.width = `${hpRatio === null ? 0 : hpRatio * 100}%`;
        pbar.style.background = hpRatio === null ? 'transparent' : (hpRatio > .6 ? '#2fd28a' : (hpRatio > .3 ? '#ffb84d' : '#ff6b8f'));
      }
      const health = button.querySelector('.health'); health.textContent = continuityLabels[point.continuity]; health.className = `health ${continuityClasses[point.continuity]}`;
      button.onclick = () => { visible.set(point.slot, visible.get(point.slot) === false); rebuildPlayers(); needsDraw = true; };
      return button;
    });
    list.replaceChildren(...(rows.length ? rows : [Object.assign(document.createElement('div'), {className:'empty-state compact', textContent:'等待坐标事件…'})]));
    document.getElementById('playerCount').textContent = String(points.length);
    const simplePlayerCount = document.getElementById('simplePlayerCount');
  if (simplePlayerCount) simplePlayerCount.hidden = true;   // 和人物列表重复，不常驻显示
    if (simplePlayerCount) { simplePlayerCount.textContent = `人物 ${points.length}`; simplePlayerCount.hidden = true; }
  };

  // 画布像素上限：丝滑 vs 清晰 的总开关
  // 背景：Retina(DPR2) 下 1360x715 的画布 = 2720x1430 约 390 万像素/帧，每帧都要合成上屏；
  // 系统稍有别的负担（浏览器标签/微信/Xcode…）就抢不到时机：
  // 实测空闲 p95 36ms，加一份 GPU 负载后 p95 43~79ms、FPS 60 掉到 47；而绘制本身只要 1ms。
  // 上限 1.5 把每帧合成像素砍 44%（1.0 砍 75%），Retina 上肉眼几乎无差。
  let canvasPixelScale = (() => {
    try { const v = Number(localStorage.getItem('codev.display.pixelScale')); return Number.isFinite(v) && v >= 1 && v <= 2 ? v : 1.5; }
    catch { return 1.5; }
  })();
  const resizeCanvas = (target, context) => {
    const rect = target.getBoundingClientRect();
    const dpr = Math.max(1, Math.min(canvasPixelScale, window.devicePixelRatio || 1));
    const width = Math.max(1, Math.round(rect.width)), height = Math.max(1, Math.round(rect.height));
    if (target.width !== Math.round(width*dpr) || target.height !== Math.round(height*dpr)) {
      target.width = Math.round(width*dpr); target.height = Math.round(height*dpr);
    }
    context.setTransform(dpr,0,0,dpr,0,0);
    context.clearRect(0,0,width,height);
    return {width,height};
  };
  const drawGrid = (context, width, height) => {
    context.fillStyle = '#07131b'; context.fillRect(0,0,width,height);
    context.strokeStyle='rgba(143,165,175,.055)'; context.lineWidth=1;
    for(let x=24;x<width;x+=48){context.beginPath();context.moveTo(x,0);context.lineTo(x,height);context.stroke();}
    for(let y=24;y<height;y+=48){context.beginPath();context.moveTo(0,y);context.lineTo(width,y);context.stroke();}
  };
  const continuityStyle = continuity => {
    switch (continuity) {
      case 'proven': return { alpha: 1, ring: false };
      case 'stale': return { alpha: .68, ring: true };
      case 'resyncing': return { alpha: .52, ring: true };
      default: return { alpha: .42, ring: true };
    }
  };
  // 把官方底图烘焙成"深蓝底图"：先带外发光画一遍，再用 source-atop 只染有像素的部分。
  // 观感对齐同类产品（深蓝 + 浅蓝描边 + 微光），帧率不受影响（换图时才做一次）。
  const buildStyledMap = image => {
    try {
      const w = image.naturalWidth, h = image.naturalHeight;
      if (!w || !h) return null;
      const canvas = document.createElement('canvas');
      canvas.width = w; canvas.height = h;
      const c = canvas.getContext('2d');
      if (!c) return null;
      c.save();
      // 去视觉疲劳：外发光从"荧光圈"降成一层很弱的边（原来 shadowBlur ≈ w/90 太抢眼）
      c.shadowColor = 'rgba(92, 200, 255, .18)';
      c.shadowBlur = Math.max(2, w / 240);
      c.drawImage(image, 0, 0);
      c.restore();
      // 降饱和：蓝色叠加变淡，长时间看眼睛不酸（原图偏青，看久了刺眼）
      c.globalCompositeOperation = 'source-atop';
      c.fillStyle = 'rgba(28, 68, 132, .40)';
      c.fillRect(0, 0, w, h);
      c.fillStyle = 'rgba(120, 176, 232, .05)';
      c.fillRect(0, 0, w, h);
      // 压暗一层并加一点对比：底图从"一块灰蓝"变成"暗地面 + 亮墙线"，
      // 人物标记与距离读数才压得住它（这是全屏雷达上面积最大的一块颜色）。
      c.fillStyle = 'rgba(4, 9, 20, .30)';
      c.fillRect(0, 0, w, h);
      c.globalCompositeOperation = 'source-over';
      return canvas;
    } catch { return null; }
  };
  // ---- 地图"墙 / 通路"结构渲染（2026-10-03）----
  // 贴图里 alpha=0 表示"不可走"，但里面混着两种东西：**外部虚空** 和 **建筑/墙体**。
  // 判据：从图片四条边做 flood fill，能连到边的 alpha=0 = 外部；**剩下的 alpha=0 = 墙/建筑**。
  // 输出：外部→透明（退到背景色）、墙→石板色填充 + 亮描边、可走地面→提亮 + 边界亮线。
  // 只在切图时离线算一次并缓存成 canvas，逐帧渲染成本不变。
  const buildStructuredMap = source => {
    try {
      const w = source.width, h = source.height;
      if (!w || !h || w * h > 6_000_000) return null;
      const read = document.createElement('canvas');
      read.width = w; read.height = h;
      const rc = read.getContext('2d', { willReadFrequently: true });
      if (!rc) return null;
      rc.drawImage(source, 0, 0);
      const image = rc.getImageData(0, 0, w, h);
      const data = image.data;
      const total = w * h;
      const floor = new Uint8Array(total);
      for (let i = 0; i < total; i++) floor[i] = data[i * 4 + 3] > 0 ? 1 : 0;
      const outside = new Uint8Array(total);
      const stack = [];
      const seed = (x, y) => {
        const i = y * w + x;
        if (!outside[i] && !floor[i]) { outside[i] = 1; stack.push(i); }
      };
      for (let x = 0; x < w; x++) { seed(x, 0); seed(x, h - 1); }
      for (let y = 0; y < h; y++) { seed(0, y); seed(w - 1, y); }
      while (stack.length) {
        const i = stack.pop();
        const x = i % w, y = (i - x) / w;
        if (x > 0) seed(x - 1, y);
        if (x < w - 1) seed(x + 1, y);
        if (y > 0) seed(x, y - 1);
        if (y < h - 1) seed(x, y + 1);
      }
      for (let y = 0; y < h; y++) {
        for (let x = 0; x < w; x++) {
          const i = y * w + x, p = i * 4;
          if (outside[i]) { data[p] = 0; data[p + 1] = 0; data[p + 2] = 0; data[p + 3] = 0; continue; }
          const isFloor = floor[i] === 1;
          // 四邻是否"不同类"（外部 / 墙 / 地面 三类）→ 边界
          let edge = false;
          if (x === 0 || y === 0 || x === w - 1 || y === h - 1) edge = true;
          if (!edge) {
            const l = i - 1, r = i + 1, u = i - w, d = i + w;
            edge = outside[l] || outside[r] || outside[u] || outside[d]
                || (floor[l] === 1) !== isFloor || (floor[r] === 1) !== isFloor
                || (floor[u] === 1) !== isFloor || (floor[d] === 1) !== isFloor;
          }
          if (!isFloor) {
            // 墙/建筑：比地面更暗的一层，读起来才像"实体"
            if (edge) { data[p] = 96; data[p + 1] = 138; data[p + 2] = 178; }       // 墙的轮廓
            else { data[p] = 30; data[p + 1] = 45; data[p + 2] = 60; }              // 墙/建筑：石板色
          } else if (edge) {
            data[p] = 104; data[p + 1] = 186; data[p + 2] = 232;                    // 可走边界：青蓝细线
          } else {
            // 地面（可走区域）：青蓝石板。
            // 原来这里把地面提亮到接近白色，整张图就是"一大块亮灰蓝" ——
            // 人物标记和距离读数全是高饱和小点，压不住它。压暗一档后
            // 地面是"底"、标记是"上"，层次才成立。
            data[p] = Math.min(255, data[p] * 0.34 + 42);
            data[p + 1] = Math.min(255, data[p + 1] * 0.36 + 58);
            data[p + 2] = Math.min(255, data[p + 2] * 0.38 + 76);
          }
          data[p + 3] = 255;
        }
      }
      const out = document.createElement('canvas');
      out.width = w; out.height = h;
      out.getContext('2d').putImageData(image, 0, 0);
      return out;
    } catch { return null; }
  };
  // 异步算（避免阻塞首帧）：算完换上去并请求重画
  const scheduleStructuredMap = source => {
    styledStructured = null;
    if (!source) return;
    window.setTimeout(() => {
      const built = buildStructuredMap(source);
      if (built) { styledStructured = built; needsDraw = true; }
    }, 0);
  };

  // 方向标（方案 B）：小圆点(身体) + 细长指针(朝向)。
  //   去掉"屁股"那截尾焰 —— 朝向已经由针表达，尾焰在贴脸交战时只会糊成一团；
  //   身体收到 0.82×，两三个人贴在一起时不再连成一坨；
  //   针长按**原尺寸**算（不跟着身体缩）：自己 3.4×、别人 1.25× —— 自己和别人一眼分得清。
  const markerBodyRadius = size => size * 0.82;
  // 朝向针长度（按"标记尺寸"的倍数）：
  //   以前别人只有 1.25×，短到看不出朝向；现在统一加长到 2.6×，
  //   自己 3.1×（只比别人长一点点，一眼找到"我朝哪"）。
  const NEEDLE_LENGTH_OTHERS = 2.6;
  const NEEDLE_LENGTH_SELF = 3.1;
  // ---- 标记读数（距离 / 槽位）的呈现参数 ----
  // 手机是全屏雷达：手指之外只能靠眼睛，读数要够大；
  // 但**不能人人一样大**，否则 8 个人的读数糊成一片（上一版就是这个观感）。
  // 规则：最近的那个敌人 = 焦点（更大 + 暖色 + 深色胶囊底），其余人只给距离，且更淡。
  const READOUT_MOBILE = Math.min(640, Math.max(320, window.innerWidth || 402));
  const READOUT_SCALE = READOUT_MOBILE <= 640 ? 1.25 : 1;
  // 同屏读数防重叠：距离读数是一枚有底的胶囊，两枚叠在一起就会互相糊掉
  // （实测：8 个人挤在一个点位上时最严重）。每帧按"先到先得 + 最小间距"剔掉重叠的，
  // 只影响这一帧画不画那枚读数，不动任何坐标或数据。
  const READOUT_BOXES = [];
  // 最近的那个敌人是"焦点"，它周围多留一圈，别让别人的读数贴着它。
  const READOUT_FOCUS_PAD = 9;
  // 画面里最多同时存在几枚距离读数（按"离自己最近"排，选中的进 lane 0）。
  const READOUT_NEAR_LIMIT = 5;
  // "接近 x m/s"这种威胁文字手机上也只给最近的 3 个，否则一样会糊。
  let READOUT_TEXT_LIMIT = Infinity;
  const readoutFits = (cx, cy, w, h) => {
    for (let i = 0; i < READOUT_BOXES.length; i++) {
      const b = READOUT_BOXES[i];
      const pad = b.focus ? READOUT_FOCUS_PAD : 0;
      if (Math.abs(cx - b.cx) < (w + b.w) / 2 + 3 + pad
          && Math.abs(cy - b.cy) < (h + b.h) / 2 + 2 + pad) return false;
    }
    return true;
  };
  const readoutPill = (context, x, y, text, font, fill, bg, alpha) => {
    context.save();
    context.globalAlpha = alpha;
    context.font = font;
    context.textAlign = 'center';
    context.textBaseline = 'middle';
    const w = context.measureText(text).width;
    const h = Math.round(READOUT_SCALE * 13);
    const padX = Math.round(READOUT_SCALE * 3.5);
    const bx = x - w / 2 - padX, by = y - h / 2;
    context.beginPath();
    if (context.roundRect) context.roundRect(bx, by, w + padX * 2, h, h * 0.42);
    else context.rect(bx, by, w + padX * 2, h);
    context.fillStyle = bg;
    context.fill();
    context.fillStyle = fill;
    context.fillText(text, x, y);
    context.restore();
  };
  // ===== 同行移植：英雄头像目录 =====
  // agent_id 来自引擎（已有字段）。图标按 /agents/<id>.png 取；没有就退"首字 + 主色"，
  // 绝不整块留白（同行那套的核心观感就是这个头像环）。
  const AGENT_META = {
    1:{name:'捷风',color:'#7ee7f5'}, 2:{name:'不死鸟',color:'#ff8a3d'}, 3:{name:'贤者',color:'#5ef2c0'},
    4:{name:'猎枭',color:'#8fb7ff'}, 5:{name:'夜露',color:'#c9a7ff'}, 6:{name:'零',color:'#9aa7b8'},
    7:{name:'雷兹',color:'#ffb84d'}, 8:{name:'蝰蛇',color:'#7ee787'}, 9:{name:'斯凯',color:'#f2a3c7'},
    10:{name:'幽影',color:'#b0a8ff'}, 11:{name:'洛特',color:'#ffd372'}, 12:{name:'凯瑠',color:'#ff9d6b'},
    13:{name:'布史东',color:'#9fd8ff'}, 14:{name:'铁壁',color:'#ffc46b'}, 15:{name:'亚星卓',color:'#c9b6ff'},
    16:{name:'欧门',color:'#a6b4ff'}, 17:{name:'妮虹',color:'#7ce0ff'}, 18:{name:'菲德',color:'#b6a2ff'},
    19:{name:'哈勃',color:'#8ee8d2'}, 20:{name:'盖可',color:'#ffd08a'}, 21:{name:'死锁',color:'#c2c9d6'},
    22:{name:'离火',color:'#ff8f6b'}, 23:{name:'克莱夫',color:'#9be6a8'}, 24:{name:'维丝',color:'#d6a8ff'},
    25:{name:'黑梦',color:'#8fa8ff'}, 26:{name:'提奥',color:'#ffcf8a'}, 27:{name:'威龙',color:'#ffa3a3'},
  };
  // 引擎里的 agent_id 是游戏内部编号（实测出现 3002/3005/3009/3077 这类），
  // 和上表的 1..27 不是同一套。没收录的 id 用稳定哈希色兜底，并保留编号，
  // 这样现场一看就知道"这个 id 是谁"，回头补进 AGENT_META 即可。
  const hashColor = id => {
    let hash = 0;
    for (const ch of String(id)) hash = (hash * 31 + ch.charCodeAt(0)) % 360;
    return `hsl(${hash}, 72%, 62%)`;
  };
  const agentMetaFor = id => {
    if (id === null || id === undefined) return null;
    const entry = AGENT_META[String(id)];
    if (entry) return entry;
    const tail = String(id).slice(-2);
    return { name: `特工${id}`, short: tail, color: hashColor(id), raw: true };
  };
  // 引擎里的 agent_id（3001..30xx）↔ 头像文件名的映射放在 agents.json 的 ids 字段，
  // 运行期拉取 —— 补映射不用重打包（文件本身 no-store）。
  let agentCatalog = [];
  const agentKeyById = new Map();
  const agentIconCache = new Map();
  const loadAgentCatalog = async () => {
    try {
      const response = await fetch('/api/v1/agents/agents.json', { cache: 'no-store' });
      if (!response.ok) return;
      const catalog = await response.json();
      agentCatalog = Array.isArray(catalog?.heroes) ? catalog.heroes : [];
      const ids = catalog && typeof catalog === 'object' ? catalog.ids : null;
      if (ids && typeof ids === 'object') {
        for (const [id, key] of Object.entries(ids)) {
          if (typeof key === 'string' && key) agentKeyById.set(String(id), key);
        }
      }
      // 本地标定优先（现场按一局对照后保存，重装/换包前一直在）
      try {
        const local = JSON.parse(localStorage.getItem('codev.agent.map') || '{}');
        for (const [id, key] of Object.entries(local)) {
          if (typeof key === 'string' && key) agentKeyById.set(String(id), key);
        }
      } catch {}
      refreshAgentPanel();
    } catch { /* 目录缺失就退回"色块 + 编号" */ }
  };

  // ===== 现场标定：引擎的 agent_id → 英雄头像 =====
  // 地址加 ?mapagents=1 打开。打一局，按槽位选英雄，点「保存」即可；
  // 映射存 localStorage（codev.agent.map），并支持导出 JSON 交回内置。
  const saveAgentMap = () => {
    const obj = {};
    for (const [id, key] of agentKeyById) obj[id] = key;
    try { localStorage.setItem('codev.agent.map', JSON.stringify(obj)); } catch {}
    if (agentIconCache) agentIconCache.clear();
  };
  const refreshAgentPanel = () => {
    const host = document.getElementById('agentMapBody');
    if (!host) return;
    const slots = [...current.values()].sort((a, b) => a.slot - b.slot);
    if (!slots.length) { host.textContent = '等待一局开始（拿到槽位后再来标定）'; return; }
    host.replaceChildren();
    for (const point of slots) {
      const row = document.createElement('div');
      row.style.cssText = 'display:flex;align-items:center;gap:8px;padding:4px 0';
      const label = document.createElement('span');
      label.textContent = `槽 ${point.slot} · id ${point.agent_id ?? '—'}`;
      label.style.cssText = 'flex:1;font:600 11px ui-monospace,monospace;color:#b89a99';
      const select = document.createElement('select');
      select.style.cssText = 'background:#180a0e;color:#fff1ef;border:1px solid rgba(255,241,239,.14);border-radius:8px;padding:3px 6px;font-size:11px';
      const blank = document.createElement('option'); blank.value = ''; blank.textContent = '未标定';
      select.appendChild(blank);
      for (const hero of agentCatalog) {
        const option = document.createElement('option');
        option.value = hero.key; option.textContent = hero.name || hero.key;
        select.appendChild(option);
      }
      select.value = point.agent_id != null ? (agentKeyById.get(String(point.agent_id)) || '') : '';
      select.onchange = () => {
        if (point.agent_id == null) return;
        if (select.value) agentKeyById.set(String(point.agent_id), select.value);
        else agentKeyById.delete(String(point.agent_id));
        saveAgentMap();
        needsDraw = true;
      };
      row.append(label, select);
      host.appendChild(row);
    }
  };
  const mountAgentPanel = () => {
    if (!location.search.includes('mapagents')) return;
    const panel = document.createElement('div');
    panel.style.cssText = 'position:fixed;right:12px;bottom:12px;z-index:60;max-height:52vh;overflow:auto;' +
      'background:rgba(12,6,9,.96);border:1px solid rgba(255,241,239,.14);border-radius:14px;padding:12px;min-width:260px';
    panel.innerHTML = '<div style="font:700 12px system-ui;color:#fff1ef;margin-bottom:6px">英雄标定（agent_id → 头像）</div>' +
      '<div id="agentMapBody" style="color:#b89a99;font-size:11px">加载中…</div>' +
      '<div style="display:flex;gap:8px;margin-top:8px">' +
      '<button id="agentMapSave" style="flex:1;background:linear-gradient(90deg,#ff3b30,#ff8a3d);border:0;color:#fff;border-radius:10px;padding:6px;font:700 11px system-ui">保存并刷新</button>' +
      '<button id="agentMapCopy" style="flex:1;background:transparent;border:1px solid rgba(255,241,239,.2);color:#fff1ef;border-radius:10px;padding:6px;font:700 11px system-ui">复制 JSON</button>' +
      '</div>';
    document.body.appendChild(panel);
    document.getElementById('agentMapSave').onclick = () => { saveAgentMap(); refreshAgentPanel(); needsDraw = true; };
    document.getElementById('agentMapCopy').onclick = async () => {
      const obj = {}; for (const [id, key] of agentKeyById) obj[id] = key;
      const text = JSON.stringify({ ids: obj }, null, 2);
      try { await navigator.clipboard.writeText(text); } catch { window.prompt('复制这段：', text); }
    };
    setInterval(refreshAgentPanel, 3000);
  };
  mountAgentPanel();

  const agentIcon = id => {
    const key = agentKeyById.get(String(id));
    if (!key) return null;
    if (!agentIconCache.has(key)) {
      const img = new Image();
      img.decoding = 'async';
      img.src = `/api/v1/agents/${key}.png`;
      agentIconCache.set(key, img);
    }
    const img = agentIconCache.get(key);
    return img && img.complete && img.naturalWidth > 0 ? img : null;
  };
  loadAgentCatalog();
  // 圆心头像：有图贴图，没图用英雄主色 + 首字；两层都带深色底衬，保证亮底图上也看得清
  const drawAgentAvatar = (context, radius, agentId, fallbackColor) => {
    const meta = agentMetaFor(agentId);
    const img = agentIcon(agentId);
    context.save();
    context.beginPath(); context.arc(0, 0, radius, 0, Math.PI * 2); context.clip();
    if (img) {
      context.drawImage(img, -radius, -radius, radius * 2, radius * 2);
    } else if (meta) {
      const gradient = context.createLinearGradient(-radius, -radius, radius, radius);
      gradient.addColorStop(0, meta.color);
      gradient.addColorStop(1, 'rgba(10,5,8,.92)');
      context.fillStyle = gradient;
      context.fillRect(-radius, -radius, radius * 2, radius * 2);
      context.fillStyle = '#0a0508';
      context.font = `800 ${Math.round(radius * 0.95)}px ${LABEL_FONT_STACK}`;
      context.textAlign = 'center'; context.textBaseline = 'middle';
      context.fillText(meta.short || meta.name.slice(0, 1), 0, radius * 0.06);
    } else {
      context.fillStyle = fallbackColor;
      context.fillRect(-radius, -radius, radius * 2, radius * 2);
    }
    context.restore();
  };

  const drawBallArrowMarker = (context,x,y,angle,radius,color,needleLength = NEEDLE_LENGTH_OTHERS, ghost = false, agentId = null) => {
    const r = markerBodyRadius(radius);
    const needle = radius * needleLength;
    context.save();context.translate(x,y);context.rotate(angle);
    // 深色底衬：保证在亮底图上也看得见
    context.fillStyle='rgba(3,10,15,.94)';context.beginPath();context.arc(0,0,r+2.2,0,Math.PI*2);context.fill();
    // 朝向针：**失联/阵亡的人不画针** —— 针代表"这个人正在移动、可以预判"，没数据的别给假信息
    if (!ghost) {
      context.lineCap='round';
      context.strokeStyle='rgba(3,10,15,.96)';context.lineWidth=Math.max(2.8,r*0.46);
      context.beginPath();context.moveTo(0,0);context.lineTo(needle,0);context.stroke();
      context.strokeStyle=color;context.lineWidth=Math.max(1.5,r*0.26);
      context.beginPath();context.moveTo(0,0);context.lineTo(needle,0);context.stroke();
      context.fillStyle='rgba(3,10,15,.96)';context.beginPath();context.arc(needle,0,Math.max(2.2,r*0.30),0,Math.PI*2);context.fill();
      context.fillStyle=color;context.beginPath();context.arc(needle,0,Math.max(1.5,r*0.20),0,Math.PI*2);context.fill();
    }
    // 身体圆点（活人=实心；幽灵=虚线外圈，一眼能区分）
    context.fillStyle=color;context.strokeStyle='rgba(238,248,250,.55)';context.lineWidth=0.9;
    if (ghost) { context.setLineDash([3,2]); context.globalAlpha *= .75; }
    // A 档：活人标记加一层柔和同色外发光（幽灵不加，保持"没数据"的观感）
    if (!ghost) { context.shadowColor = color; context.shadowBlur = Math.max(4, r * 1.15); }
    context.beginPath();context.arc(0,0,r,0,Math.PI*2);context.fill();context.stroke();
    context.shadowBlur = 0; context.shadowColor = 'transparent';
    // 同行做法：圆心换成英雄头像（没图标就用首字+主色），阵营色仍由圆环承担
    if (!ghost && agentMetaFor(agentId)) {
      context.save();
      // 头像比底盘略小，留一圈阵营色描边
      drawAgentAvatar(context, Math.max(3, r - 1.2), agentId, color);
      context.restore();
    }
    context.setLineDash([]);
    context.restore();
  };
  const pruneVisibleSlots = () => {
    for (const slot of [...visible.keys()]) {
      const point = current.get(slot);
      if (!point || !isActiveRadarPoint(point)) visible.delete(slot);
    }
  };
  // ---- 地名标注渲染 ----
  // 画在底图之上、人物标记之下；文字反向旋转保持水平（「地名随地图旋转」打开后跟随底图）。
  // 位置全部用 project() 求屏幕坐标 → 与人物点共用同一条变换链，缩放/旋转/平移天然对齐。
  const LABEL_FONT_STACK = '"PingFang SC", "Noto Sans CJK SC", "Heiti SC", sans-serif';
  const labelRoundRect = (context, x, y, w, h, radius) => {
    const r = Math.min(radius, w / 2, h / 2);
    context.beginPath();
    context.moveTo(x + r, y);
    context.arcTo(x + w, y, x + w, y + h, r);
    context.arcTo(x + w, y + h, x, y + h, r);
    context.arcTo(x, y + h, x, y, r);
    context.arcTo(x, y, x + w, y, r);
    context.closePath();
  };
  const drawMapLabels = (context, project, width, height, totalRotation) => {
    labelHits = [];
    if (!calibration) return;
    const editing = labelEditorEnabled;
    if (!showLabels && !editing) return;
    const rows = MAP_LABELS[Number(calibration.map_id)];
    if (!Array.isArray(rows) || !rows.length) return;
    if (viewZoom < 0.7 && !editing) return;      // 缩得太小就整层隐藏，避免糊成一团
    const sitePx = Math.max(9, Math.min(17, 12 * (0.75 + 0.25 * viewZoom)));
    const textPx = Math.max(9, Math.min(19, 11.5 * (0.75 + 0.25 * viewZoom)));
    // 标注是画在屏幕坐标系里的（底图绘制后已 restore），所以：
    //   默认（不勾选）= 0 → 文字永远水平，任何视角下都好读；
    //   勾选「随地图旋转」= 底图内容的总旋转量 → 文字像印在底图上，跟着地图转。
    const counterRotation = labelsRotateWithMap ? totalRotation : 0;
    for (let index = 0; index < rows.length; index += 1) {
      const row = rows[index];
      if (!row || !Number.isFinite(row.u) || !Number.isFinite(row.v)) continue;
      const [x, y] = project({ map: { u: row.u, v: row.v } });
      if (!Number.isFinite(x) || !Number.isFinite(y)) continue;
      const visibleNow = insideScreen(x, y, width, height, 4);
      if (visibleNow) labelHits.push({ index, x, y });
      if (!visibleNow && !editing) continue;
      const text = String(row.text || '');
      context.save();
      context.translate(x, y);
      context.rotate(counterRotation);
      context.textAlign = 'center';
      context.textBaseline = 'middle';
      context.lineJoin = 'round';
      if (row.kind === 'site') {
        // 半透明浅色：看得见但不抢人（原来是不透明暖黄圆点 + 粗黑边，很吸眼）
        const letter = (text.match(/[A-Za-z]/) || [text.slice(0, 1) || '?'])[0].toUpperCase();
        context.beginPath();
        context.arc(0, 0, sitePx * 1.28, 0, Math.PI * 2);
        context.fillStyle = 'rgba(226,236,246,.20)';
        context.fill();
        context.strokeStyle = 'rgba(226,236,246,.34)';
        context.lineWidth = 1.1;
        context.stroke();
        context.fillStyle = 'rgba(226,236,246,.62)';
        context.font = `600 ${Math.round(sitePx * 1.34)}px ${LABEL_FONT_STACK}`;
        context.fillText(letter, 0, 0.5);
        const nameY = sitePx * 1.34 + textPx * 0.95;
        context.font = `700 ${Math.round(textPx)}px ${LABEL_FONT_STACK}`;
        context.lineWidth = 3.4;
        context.strokeStyle = 'rgba(5,10,14,.94)';
        context.strokeText(text, 0, nameY);
        context.fillStyle = 'rgba(242,246,248,.97)';
        context.fillText(text, 0, nameY);
      } else {
        context.font = `600 ${Math.round(textPx)}px ${LABEL_FONT_STACK}`;
        const pillWidth = context.measureText(text).width + 15;
        const pillHeight = textPx + 9;
        labelRoundRect(context, -pillWidth / 2, -pillHeight / 2, pillWidth, pillHeight, 6);
        context.fillStyle = row.kind === 'spawn' ? 'rgba(24,54,74,.88)' : 'rgba(8,15,20,.84)';
        context.fill();
        context.strokeStyle = 'rgba(232,217,160,.42)';
        context.lineWidth = 1.2;
        context.stroke();
        context.fillStyle = 'rgba(238,243,245,.97)';
        context.fillText(text, 0, 0.5);
      }
      if (editing) {   // 标注模式下给出可拖动提示圈
        context.beginPath();
        context.arc(0, 0, Math.max(sitePx * 2.05, 15), 0, Math.PI * 2);
        context.setLineDash([4, 4]);
        context.lineWidth = 1.5;
        context.strokeStyle = labelEditorDrag && labelEditorDrag.index === index ? 'rgba(99,215,208,.95)' : 'rgba(99,215,208,.32)';
        context.stroke();
        context.setLineDash([]);
      }
      context.restore();
    }
  };
  // ---- 人物列表（右栏）：英雄头像 / 英雄名 / 血量 / 距离，按距离排序 ----
  let rosterLastRender = 0;
  const renderRoster = plots => {
    const list = document.getElementById('rosterList');
    if (!list) return;
    const now = performance.now();
    if (now - rosterLastRender < 250) return;   // 4 次/秒足够，避免每帧重排 DOM
    rosterLastRender = now;
    const count = document.getElementById('rosterCount');
    const rows = (plots || []).slice().sort((a, b) => {
      const da = Number.isFinite(a.metrics?.distanceMeters) ? a.metrics.distanceMeters : 1e9;
      const db = Number.isFinite(b.metrics?.distanceMeters) ? b.metrics.distanceMeters : 1e9;
      return da - db;
    });
    if (count) count.textContent = `${rows.length} 人物`;
    if (!rows.length) { list.innerHTML = '<div class="roster-empty">等待实时人物数据</div>'; return; }
    list.innerHTML = rows.map(plot => {
      const point = plot.point;
      const role = roleForPoint(point);
      const name = `槽${point.slot}·${roleLabels[role] || '未知'}`;
      const distance = Number.isFinite(plot.metrics?.distanceMeters) ? `${Math.round(plot.metrics.distanceMeters)}m` : '—';
      const dotColor = markerColors[role] || markerColors.unknown;
      const avatar = `<i style="display:inline-block;width:9px;height:9px;border-radius:50%;background:${dotColor}"></i>`;
      return `<div class="roster-row">${avatar}<b>${name}</b>`
        + `<span class="dist">${distance}</span></div>`;
    }).join('');
  };

  // ===== 静态地图层：底图的「缩放/旋转/平移」交给 CSS 变换，由浏览器合成器完成 =====
  // 动机：原来每帧用 ctx.rotate + drawImage 把整张底图重采样一遍（2400×1600 画布），
  // 旋转时既吃 CPU 又和 30Hz 的数据台阶叠在一起，观感就是"不够丝滑"。
  // 现在：底图只在「尺寸/底图变化」时烘焙一次；每帧只更新一次 CSS 矩阵（合成器线程处理）。
  // 人物/威胁/文字仍在动态画布上，且人物投影本来就是数学旋转（baseProjectRaw），无需改动。
  const matMul = (m, n) => ({
    a: m.a*n.a + m.c*n.b, b: m.b*n.a + m.d*n.b,
    c: m.a*n.c + m.c*n.d, d: m.b*n.c + m.d*n.d,
    e: m.a*n.e + m.c*n.f + m.e, f: m.b*n.e + m.d*n.f + m.f,
  });
  const matT = (x, y) => ({ a: 1, b: 0, c: 0, d: 1, e: x, f: y });
  const matS = s => ({ a: s, b: 0, c: 0, d: s, e: 0, f: 0 });
  const matR = rad => ({ a: Math.cos(rad), b: Math.sin(rad), c: -Math.sin(rad), d: Math.cos(rad), e: 0, f: 0 });
  // 逐条对应原 canvas 变换链，顺序不能改：
  //   translate(center+pan) → scale(zoom) → translate(-center) → translate(pivot) → rotate(sel)
  //   → translate(-pivot) → translate(center) → rotate(base) → translate(-origin)
  //   → translate(center) → rotate(asset) → translate(-center) → drawImage(bg, left, top, side, side)
  const drawRadar = () => {
    pruneVisibleSlots();
    const {width,height} = resizeCanvas(canvas, ctx);
    // 网格底色已改为 .map-pane 的 CSS 背景（零 canvas 成本），画布保持透明
    markerHits = [];
    labelHits = [];
    READOUT_BOXES.length = 0;
    READOUT_TEXT_LIMIT = READOUT_SCALE === 1 ? Infinity : 3;   // 手机上只有最近的 3 个挂文字
    // 没标定 → 真的什么都画不了；但**底图缺失不再连坐标点一起藏**。
    // 客户现场：底图加载失败 → 面板看上去"没雷达效果"，其实坐标数据是好的。
    if (!calibration) return;
    // 手机是全屏雷达：画布内侧原来留的 16px 边距在手机上白占 32pt 宽度
    // （竖屏底图尺寸由**屏宽**封顶），去掉就直接大一圈。桌面端保持 16px 不变。
    const edgeInset = width <= 640 ? 4 : 32;
    const side = Math.min(width,height) - edgeInset, left=(width-side)/2, top=(height-side)/2;
    const centerX = width / 2, centerY = height / 2;
    // Restore the empirically correct v1.1.13 separation: MapImageRotation is
    // an asset-space correction for the bitmap only.  Player UVs and headings
    // stay in native map space, then the composed radar receives one shared
    // viewport rotation to match the in-game map orientation.
    // The live game yaw increases on the opposite axis from the old native-map
    // helper.  Keep the world/map projection untouched and invert only the yaw
    // delta so follow mode turns in the same direction as the player's view.
    const assetRotation = calibration.asset_rotation_degrees*Math.PI/180;
    const globalViewRotation = GLOBAL_VIEW_ROTATION_DEGREES*Math.PI/180;
    // 自己：优先按 track_id 绑定（槽位重排不影响），并用缓存 + 平滑保持视点稳定
    const boundSelf = resolveBoundSelf();
    const selfPoint = (boundSelf && boundSelf.map) ? boundSelf : null;
    const selfFresh = Boolean(selfPoint && isActiveRadarPoint(selfPoint));
    const nowViewMs = performance.now();
    if (selfFresh) { viewCache = { u: selfPoint.map.u, v: selfPoint.map.v, yaw: stableYaw(selfPoint.slot, selfPoint.yaw, selfPoint.updated_ns), at: nowViewMs }; lastViewDataMs = nowViewMs; }
    const cacheUsable = Boolean(viewCache && nowViewMs - viewCache.at < VIEW_CACHE_TTL_MS);
    const followAvailable = Boolean(showFollow && !panMode && (selfFresh || cacheUsable));
    // 跟随中且数据还很新 → 逐帧渲染（每帧 ~3ms，60fps 常驻无压力），避免画面走走停停
    if (followAvailable && nowViewMs - lastViewDataMs < VIEW_RENDER_HOLD_MS) needsDraw = true;
    if (followAvailable) {
      const targetU = selfFresh ? selfPoint.map.u : viewCache.u;
      const targetV = selfFresh ? selfPoint.map.v : viewCache.v;
      const targetYaw = selfFresh ? stableYaw(selfPoint.slot, selfPoint.yaw, selfPoint.updated_ns) : viewCache.yaw;
      const nowMs = performance.now();
      const dtMs = smoothViewLastMs ? Math.min(150, Math.max(1, nowMs - smoothViewLastMs)) : 16.7;
      smoothViewLastMs = nowMs;
      // 时间基系数：30/60/120Hz 下时间常数一致（原来按帧 0.22 → 随帧率漂移）
      const tauMs = lowLatencyMode ? VIEW_TAU_FAST_MS : VIEW_TAU_MS;
      const alpha = 1 - Math.exp(-dtMs / tauMs);
      // 用最近两次真实采样估角速度/位移速度，把 30Hz 两点之间"外推"补出来
      if (selfFresh) pushViewSample(Number(selfPoint.updated_ns || selfPoint.capture_ns || 0), selfPoint.map.u, selfPoint.map.v, targetYaw);
      let exU = targetU, exV = targetV, exYaw = targetYaw, extrapolating = false;
      if (selfFresh && viewPrevSample && viewCurSample && viewCurSample.ns > viewPrevSample.ns) {
        const dSec = (viewCurSample.ns - viewPrevSample.ns) / 1e9;
        // 用"页面收到该采样后过了多久"当外推时长（同一种时钟，稳）
        // 数据空档（实测最长 117~333ms）过去会让外推"到点就硬停"，看起来就是一顿一停。
        // 现在超过上限后按时间常数衰减速度（滑行到停），空档期间画面是连续的。
        const rawAgeMs = Math.max(0, nowMs - (viewCurSample.at ?? nowMs));
        const ageMs = Math.min(VIEW_EXTRAPOLATE_MAX_MS, rawAgeMs);
        const coastDecay = rawAgeMs > VIEW_EXTRAPOLATE_MAX_MS
          ? Math.exp(-(rawAgeMs - VIEW_EXTRAPOLATE_MAX_MS) / 180)
          : 1;
        if (dSec > 0.008 && dSec < 0.6 && ageMs > 1) {
          const ageSec = ageMs / 1000;
          const vu = (viewCurSample.u - viewPrevSample.u) / dSec;
          const vv = (viewCurSample.v - viewPrevSample.v) / dSec;
          const vyaw = (((viewCurSample.yaw - viewPrevSample.yaw + 540) % 360) - 180) / dSec;
          if (Math.abs(vyaw) <= VIEW_MAX_YAW_RATE_DPS && Math.abs(vu) < 2 && Math.abs(vv) < 2) {
            exU = viewCurSample.u + vu * ageSec * coastDecay;
            exV = viewCurSample.v + vv * ageSec * coastDecay;
            exYaw = viewCurSample.yaw + vyaw * ageSec * coastDecay;
            // 原来门槛是 3°/s：慢转（瞄准微调）时外推直接关掉 → 画面退化成 30Hz 台阶。
            // 调到 0.5°/s，慢转也连续。
            extrapolating = Math.abs(vyaw) > 0.5 || Math.abs(vu) > 0.0005 || Math.abs(vv) > 0.0005;
          }
        }
      }
      if (!smoothView) {
        // 重新进入跟随时从"冻住的视点"起步，平滑滑过去；直接对到新目标就是一次跳。
        smoothView = followHold
          ? { u: (followHold.selfRaw[0] - left) / side, v: (followHold.selfRaw[1] - top) / side, yaw: followHold.yaw }
          : { u: exU, v: exV, yaw: exYaw };
        smoothViewLastMs = 0;
      } else {
        smoothView.u += (exU - smoothView.u) * alpha;
        smoothView.v += (exV - smoothView.v) * alpha;
        const delta = ((exYaw - smoothView.yaw + 540) % 360) - 180;
        if (Math.abs(delta) > VIEW_YAW_DEAD_ZONE_DEGREES) smoothView.yaw += delta * alpha;
        if (Math.abs(exU - smoothView.u) > 5e-5 || Math.abs(exV - smoothView.v) > 5e-5
            || Math.abs(delta) > 0.02 || extrapolating) needsDraw = true;
      }
    } else {
      smoothView = null; resetViewSamples();
    }
    const followActive = Boolean(followAvailable && smoothView);
    // 【录屏实测】跟随旋转时画面只有 ~20 次/秒（间隔中位 33ms = 数据节奏），还夹着 0.1~0.3s 空档；
    // 而录屏本身 41fps → 说明是"没到阈值就不重绘"。跟随是连续动作，直接每帧都画，
    // 让旋转跑满显示器刷新率（60/120Hz）。像素已经在上一步砍过 44%，这里再加也划算。
    if (followActive) needsDraw = true;
    // 自己短暂消失（丢包/换局瞬间/账号还没绑上）时，把上一次的跟随视点**冻住**，
    // 不要立刻切回 globalViewRotation + 画布中心 —— 那一下也是"晃"。
    const holdView = Boolean(showFollow && !panMode && !followActive && followHold);
    const selfRaw = followActive
      ? [left + smoothView.u*side, top + smoothView.v*side]
      : (holdView ? followHold.selfRaw : [centerX,centerY]);
    const viewYaw = followActive ? smoothView.yaw : (holdView ? followHold.yaw : 0);
    const baseViewRotation = (followActive || holdView)
      ? (lockNorthUp ? 0 : -Math.PI/2 - (viewYaw - calibration.default_rotation_degrees)*Math.PI/180)
      : globalViewRotation;
    const baseTransformOrigin = (followActive || holdView) ? selfRaw : [centerX,centerY];
    if (followActive) followHold = { selfRaw: [left + smoothView.u*side, top + smoothView.v*side], yaw: smoothView.yaw };
    // 平移/缩放（外层变换）：拖动或滚轮后从这里生效
    const applyViewTransform = (x, y) => [
      centerX + panOffsetX + (x - centerX) * viewZoom,
      centerY + panOffsetY + (y - centerY) * viewZoom,
    ];
    const baseProjectRaw = (rawX,rawY) => {
      const dx = rawX-baseTransformOrigin[0], dy = rawY-baseTransformOrigin[1];
