fn embedded_map_file(path: &str) -> Option<&'static include_dir::File<'static>> {
    MAP_FILES.get_file(path).or_else(|| {
        let name = path.rsplit('/').next().unwrap_or(path);
        MAP_FILES.files().find(|file| {
            file.path()
                .file_name()
                .and_then(|file_name| file_name.to_str())
                == Some(name)
        })
    })
}

async fn map_file(State(hub): State<EventHub>, Path(path): Path<String>) -> HttpResponse<Body> {
    let safe_path = !path.is_empty()
        && !path.starts_with('/')
        && !path.contains('\\')
        && path
            .split('/')
            .all(|component| !matches!(component, "" | "." | ".."));
    let is_published_texture = hub
        .inner
        .map_catalog
        .manifest()
        .maps
        .iter()
        .any(|map| map.status.is_usable() && map.texture_path == path);
    if !safe_path || !is_published_texture {
        return StatusCode::NOT_FOUND.into_response();
    }
    let Some(file) = embedded_map_file(&path) else {
        return StatusCode::NOT_FOUND.into_response();
    };
    let mime = mime_guess::from_path(&path).first_or_octet_stream();
    // agents.json 是"可变清单"（英雄编号映射会更新），必须禁用长缓存：
    // 之前和图片一样给了 immutable，WebView 会永久缓存旧清单，导致新增映射不生效。
    let cache = if path.ends_with(".json") {
        "no-store"
    } else {
        "public, max-age=31536000, immutable"
    };
    HttpResponse::builder()
        .status(StatusCode::OK)
        .header(header::CONTENT_TYPE, mime.as_ref())
        .header(header::CACHE_CONTROL, cache)
        .body(Body::from(file.contents()))
        .unwrap()
}

async fn ability_file(Path(path): Path<String>) -> HttpResponse<Body> {
    let safe_path = !path.is_empty()
        && !path.starts_with('/')
        && !path.contains('\\')
        && path
            .split('/')
            .all(|component| !matches!(component, "" | "." | ".."));
    if !safe_path {
        return StatusCode::NOT_FOUND.into_response();
    }
    let file = ABILITY_FILES.get_file(&path).or_else(|| {
        let name = path.rsplit('/').next().unwrap_or(path.as_str());
        ABILITY_FILES.files().find(|file| {
            file.path()
                .file_name()
                .and_then(|file_name| file_name.to_str())
                == Some(name)
        })
    });
    let Some(file) = file else {
        return StatusCode::NOT_FOUND.into_response();
    };
    let mime = mime_guess::from_path(&path).first_or_octet_stream();
    let cache = if path.ends_with(".json") {
        "no-store"
    } else {
        "public, max-age=31536000, immutable"
    };
    HttpResponse::builder()
        .status(StatusCode::OK)
        .header(header::CONTENT_TYPE, mime.as_ref())
        .header(header::CACHE_CONTROL, cache)
        .body(Body::from(file.contents()))
        .unwrap()
}

