    #[test]
    fn dashboard_rotates_map_and_markers_clockwise_around_selected_player() {
        assert!(INDEX_HTML.contains(
            "const selectedPlayerRotation = hasBoundSelfThisSession\n      ? SELECTED_PLAYER_ROTATION_DEGREES*Math.PI/180\n      : 0;"
        ));
        assert!(INDEX_HTML.contains(
            "const rotationPivot = selfPoint?.map\n      ? baseProjectRaw(selfRaw[0],selfRaw[1])\n      : (followHold ? baseProjectRaw(followHold.selfRaw[0],followHold.selfRaw[1]) : [centerX,centerY]);"
        ));
        // 底图与人物画在**同一张画布、同一次变换**里（分层那套已按反馈撤掉）
        assert!(INDEX_HTML.contains(
        "const mapBitmap = (showMapStructure && styledStructured) || styledBackground || background;"
    ));
    assert!(INDEX_HTML.contains("if (mapBitmap) ctx.drawImage(mapBitmap, left, top, side, side);"));
        assert!(!INDEX_HTML.contains("applyStaticMatrix("));
        assert!(!INDEX_HTML.contains("mapStaticCanvas"));
        assert!(INDEX_HTML.contains("ctx.rotate(selectedPlayerRotation);"));
        assert!(INDEX_HTML.contains("const [baseX,baseY] = baseProjectRaw(rawX,rawY)"));

        let angle = std::f64::consts::FRAC_PI_2;
        let (cosine, sine) = (angle.cos(), angle.sin());
        let pivot = (41.0_f64, 73.0_f64);
        let rotate = |point: (f64, f64)| {
            let (dx, dy) = (point.0 - pivot.0, point.1 - pivot.1);
            (
                pivot.0 + dx * cosine - dy * sine,
                pivot.1 + dx * sine + dy * cosine,
            )
        };
        let rotated_pivot = rotate(pivot);
        assert!((rotated_pivot.0 - pivot.0).abs() < 1e-12);
        assert!((rotated_pivot.1 - pivot.1).abs() < 1e-12);

        // Canvas +Y points downward, so +90 degrees moves a rightward vector
        // downward on screen: a visual clockwise quarter-turn.
        let right = rotate((pivot.0 + 1.0, pivot.1));
        assert!((right.0 - pivot.0).abs() < 1e-12);
        assert!((right.1 - (pivot.1 + 1.0)).abs() < 1e-12);
    }

