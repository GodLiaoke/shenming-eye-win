    async fn get_raw(address: SocketAddr, path: &str) -> Vec<u8> {
        let mut stream = tokio::net::TcpStream::connect(address).await.unwrap();
        stream
            .write_all(
                format!("GET {path} HTTP/1.1\r\nHost: {address}\r\nConnection: close\r\n\r\n")
                    .as_bytes(),
            )
            .await
            .unwrap();
        let mut response = Vec::new();
        stream.read_to_end(&mut response).await.unwrap();
        response
    }

    async fn get_json(address: SocketAddr, path: &str) -> Value {
        let response = get_raw(address, path).await;
        assert!(
            response.starts_with(b"HTTP/1.1 200 OK"),
            "{path} did not answer 200"
        );
        let body_offset = response
            .windows(4)
            .position(|window| window == b"\r\n\r\n")
            .unwrap()
            + 4;
        serde_json::from_slice(&response[body_offset..]).unwrap()
    }

    fn websocket_request(
        address: SocketAddr,
        token: &str,
        with_origin: bool,
    ) -> tokio_tungstenite::tungstenite::http::Request<()> {
        let mut request = format!("ws://{address}/api/v1/ws?token={token}")
            .into_client_request()
            .unwrap();
        if with_origin {
            request.headers_mut().insert(
                header::ORIGIN,
                HeaderValue::from_str(&format!("http://{address}")).unwrap(),
            );
        }
        request
    }

    async fn next_json(socket: &mut TestSocket) -> Value {
        let message = tokio::time::timeout(Duration::from_secs(2), socket.next())
            .await
            .expect("websocket read timed out")
            .expect("websocket closed")
            .expect("websocket read failed");
        let text = message.into_text().expect("expected a text message");
        serde_json::from_str(text.as_ref()).unwrap()
    }

    async fn raw_http(address: SocketAddr, request: String) -> Vec<u8> {
        let mut stream = tokio::net::TcpStream::connect(address).await.unwrap();
        stream.write_all(request.as_bytes()).await.unwrap();
        let mut response = Vec::new();
        stream.read_to_end(&mut response).await.unwrap();
        response
    }

    fn http_body(response: &[u8]) -> &[u8] {
        response
            .windows(4)
            .position(|window| window == b"\r\n\r\n")
            .map_or(&[], |offset| &response[offset + 4..])
    }

    fn assert_response_header(response: &[u8], expected: &str) {
        let headers = response
            .windows(4)
            .position(|window| window == b"\r\n\r\n")
            .map_or(response, |offset| &response[..offset]);
        assert!(
            String::from_utf8_lossy(headers)
                .to_ascii_lowercase()
                .contains(&expected.to_ascii_lowercase()),
            "missing response header: {expected}"
        );
    }

    fn response_cookie(response: &[u8]) -> String {
        String::from_utf8_lossy(response)
            .lines()
            .find_map(|line| {
                let (name, value) = line.split_once(':')?;
                (name.eq_ignore_ascii_case("set-cookie")).then(|| {
                    value
                        .trim()
                        .split(';')
                        .next()
                        .unwrap_or_default()
                        .to_owned()
                })
            })
            .expect("auth exchange returned a cookie")
    }

    fn url_path(url: &str) -> String {
        url.split_once("://")
            .and_then(|(_, rest)| rest.split_once('/'))
            .map_or_else(|| "/".to_owned(), |(_, path)| format!("/{path}"))
    }

    #[test]
    fn public_cookie_security_follows_the_configured_origin_scheme() {
        let mut headers = HeaderMap::new();
        headers.insert(header::HOST, HeaderValue::from_static("203.0.113.10"));
        headers.insert("x-forwarded-proto", HeaderValue::from_static("https"));
        assert!(!auth_cookie_is_secure(
            &headers,
            Some("http://203.0.113.10")
        ));

        headers.insert("x-forwarded-proto", HeaderValue::from_static("http"));
        assert!(auth_cookie_is_secure(
            &headers,
            Some("https://203.0.113.10")
        ));
        assert!(!auth_cookie_is_secure(&headers, None));

        headers.insert("x-forwarded-proto", HeaderValue::from_static("https"));
        assert!(auth_cookie_is_secure(&headers, None));
        headers.remove("x-forwarded-proto");
        assert!(auth_cookie_is_secure(&headers, None));

        headers.insert(header::HOST, HeaderValue::from_static("127.0.0.1:3000"));
        assert!(!auth_cookie_is_secure(&headers, None));
    }

