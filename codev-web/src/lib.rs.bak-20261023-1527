    pub fn set_initial_replay_speed(&self, speed: f64) -> Result<(), WebError> {
        if !matches!(speed, 0.25 | 0.5 | 1.0 | 2.0 | 4.0) {
            return Err(WebError::InvalidEvent("invalid initial replay speed"));
        }
        self.inner
            .initial_replay_speed_bits
            .store(speed.to_bits(), Ordering::Release);
        Ok(())
    }

    fn initial_replay_speed(&self) -> Option<f64> {
        let bits = self.inner.initial_replay_speed_bits.load(Ordering::Acquire);
        (bits != 0).then(|| f64::from_bits(bits))
    }

    /// Return the additive WebSocket v1 capability list for this hub.
    ///
    /// The map selector is available for every embedded catalog (including a
    /// replay-only hub).  Proxy profile and CA download actions are advertised
    /// only when their services were installed, so a client never presents a
    /// button which can only return a permanent 404.  The five original
    /// playback capabilities intentionally retain their order for old clients.
    async fn hello_capabilities(&self) -> Vec<&'static str> {
        let mut capabilities = vec!["live", "pause", "seek", "speed", "snapshot_resync"];
        capabilities.push("map_selection");
        let services = self.inner.services.read().await;
        if services.proxy.is_some() {
            capabilities.push("proxy_profiles");
        }
        if services.ca.is_some() {
            capabilities.push("ca_download");
        }
        capabilities
    }

    pub async fn set_session(&self, mut session: SessionView) -> Result<u64, WebError> {
        if session.build_id.is_empty()
            || session.build_id.len() > MAX_SESSION_ID_BYTES
            || session.status_detail.len() > MAX_STATUS_DETAIL_BYTES
        {
            return Err(WebError::InvalidEvent("invalid session metadata length"));
        }
        let _publish = self.inner.publish_lock.lock().await;
        let current = self.inner.session.read().await.clone();
        let generation_advanced = session.channel_generation > current.channel_generation;
        if !generation_advanced {
            session.map_id = session.map_id.or(current.map_id);
            session.capture_start_ns = session.capture_start_ns.or(current.capture_start_ns);
            session.latest_capture_ns = session.latest_capture_ns.or(current.latest_capture_ns);
        }
        if session.channel_generation < current.channel_generation {
            // Session status updates (notably the terminal update) may omit the
            // current channel generation. A lower value is stale metadata, not
            // a channel reopen, so retain the authoritative generation.
            session.channel_generation = current.channel_generation;
        }
        let seq = self.next_seq_unlocked();
        if generation_advanced {
            let boundary_capture_ns = session
                .latest_capture_ns
                .or(current.latest_capture_ns)
                .unwrap_or_default();
            self.inner.latest.write().await.clear();
            self.inner.timeline.lock().await.start_generation(
                seq,
                boundary_capture_ns,
                session.channel_generation,
            );
        }
        *self.inner.session.write().await = session.clone();
        let payload = SessionStatusPayload {
            session: session.clone(),
            operations: self.inner.operations.read().await.clone(),
            pipeline: self.inner.pipeline.read().await.clone(),
        };
        self.broadcast_with_seq_unlocked(
            seq,
            "session_status",
            session.latest_capture_ns.unwrap_or_default(),
            &payload,
        )?;
        Ok(seq)
    }

    /// 异地观看：把云端房间的会话立成「本局进行中 + 已知地图」。
    ///
    /// 页面闸门要 `status ∈ {live, replay}`、底图要 `map_id`；而云端槽位引擎在
    /// proxy 模式下**看不到手机端那一局**（解码在手机上），这两样只能由镜像上传带上来。
    ///
    /// 镜像上传每秒 20 批 —— **只在需要时才写**（会话还不是 live，或地图换了），
    /// 否则每批都要白白广播一条 `session_status`。
    /// 返回 `Ok(Some(seq))` 表示这次真的写了会话，`Ok(None)` 表示本来就是对的。
    pub async fn ensure_live_map_session(
        &self,
        map_id: u32,
        capture_ns: u64,
    ) -> Result<Option<u64>, WebError> {
        let current = self.inner.session.read().await.clone();
        if current.status == SessionStatus::Live && current.map_id == Some(map_id) {
            return Ok(None);
        }
        let start_ns = current.capture_start_ns.unwrap_or(capture_ns);
        self.set_session(SessionView {
            status: SessionStatus::Live,
            status_detail: format!("异地观看：坐标由手机端解码后上传（地图 {map_id}）"),
            map_id: Some(map_id),
            capture_start_ns: Some(start_ns),
            latest_capture_ns: Some(capture_ns),
            ..current
        })
        .await
        .map(Some)
    }

    pub async fn set_operational_status(
        &self,
        operations: OperationalStatus,
    ) -> Result<u64, WebError> {
        if [
            &operations.proxy,
            &operations.tls_mitm,
            &operations.quic,
            &operations.recording,
        ]
        .iter()
        .any(|component| {
            component.detail.len() > MAX_OPERATIONAL_DETAIL_BYTES
                || contains_private_detail(&component.detail)
        }) {
            return Err(WebError::InvalidEvent(
                "operational status detail exceeds public protocol bounds",
            ));
        }
        let _publish = self.inner.publish_lock.lock().await;
        *self.inner.operations.write().await = operations.clone();
        let session = self.inner.session.read().await.clone();
        let capture_ns = session.latest_capture_ns.unwrap_or_default();
        self.broadcast_unlocked(
            "session_status",
            capture_ns,
            &SessionStatusPayload {
                session,
                operations,
                pipeline: self.inner.pipeline.read().await.clone(),
            },
        )
    }

    /// Publish a bounded, non-sensitive parser stage transition.  Stage
    /// transitions reuse the existing `session_status` wire kind so WebSocket
    /// v1 clients remain compatible; the latest value is also included in the
    /// initial `map_roster`, metrics and REST session payloads.
    pub async fn set_pipeline_stage(
        &self,
        capture_ns: u64,
        stage: impl Into<String>,
        health: PipelineHealth,
        detail: impl Into<String>,
    ) -> Result<u64, WebError> {
        let candidate = PipelineStatus {
            stage: stage.into(),
            health,
            detail: detail.into(),
            capture_ns,
            transition_count: 0,
        };
        validate_pipeline_status(&candidate)?;
        let _publish = self.inner.publish_lock.lock().await;
        let mut pipeline = self.inner.pipeline.write().await;
        pipeline.stage = candidate.stage;
        pipeline.health = candidate.health;
        pipeline.detail = candidate.detail;
        pipeline.capture_ns = candidate.capture_ns;
        pipeline.transition_count = pipeline.transition_count.saturating_add(1);
        let pipeline = pipeline.clone();
        let session = self.inner.session.read().await.clone();
        let operations = self.inner.operations.read().await.clone();
        let seq = self.next_seq_unlocked();
        self.broadcast_with_seq_unlocked(
            seq,
            "session_status",
            capture_ns,
            &SessionStatusPayload {
                session,
                operations,
                pipeline,
            },
        )?;
        Ok(seq)
    }

    /// 把 roster 里的英雄编号按"阵营内位次 ↔ 阵营内槽位"补到位置流上。
    ///
    /// 关键点：位置流每帧只推**变化的**那几个槽，所以要跨帧累积"每个阵营见过的槽位"，
    /// 收齐 5 个（与 roster 里该阵营的人数一致）之后才确定映射 —— 否则每帧人数对不上，
    /// 英雄编号永远接不上（这是上一版没生效的原因）。
    /// 把英雄编号贴到位置上。
    ///
    /// 槽位对应关系现在由引擎算好（`RosterEntry.slot`，见 codev-stream 的
    /// `assign_roster_slots`）：阵营只看 2 bit `state_index`（本机五人恒为 0）和自己
    /// 的出生点锚点，roster 只负责"这个人是什么英雄"。这里**绝不再按 roster 数组
    /// 顺序推槽位** —— 之前那样做会把队友画成敌人、把头像贴错人。
    async fn attach_roster_identity(&self, positions: &mut [PositionView]) {
        let roster = self.inner.roster.read().await.clone();
        if roster.is_empty() {
            return;
        }
        for position in positions.iter_mut() {
            let Some(entry) = roster
                .iter()
                .find(|entry| entry.slot == Some(position.slot) && entry.agent_id > 0)
            else {
                continue;
            };
            // 阵营已经由引擎按 state_index 钉死；roster 的阵营只用来交叉校验，
            // 不一致说明这一格还没对齐，宁可先不贴头像也不要贴错。
            if let (Some(camp), true) = (position.camp_id, entry.camp_id > 0)
                && entry.camp_id != camp
            {
                continue;
            }
            // 敌人那五格在出生点几何判定 commit 之前没有阵营（state_index 非 0 且
            // 分类器还没对上出生点）；贴槽表已经把阵营归一化成 1=我方 / 2=对方，
            // 直接用，红色敌人第一帧就能上色。
            if position.camp_id.is_none() && entry.camp_id > 0 {
                position.camp_id = Some(entry.camp_id);
                position.identity_confidence = IdentityConfidence::Proven;
            }
            position.agent_id = Some(entry.agent_id);
            // 注意：**不要**用 roster 条目的 identity_confidence 覆盖位置上的这个字段。
            // 位上的 confidence 表示"阵营/坐标是否证明过"（state_index / 出生点锚点给出来的），
            // roster 条目的那个曾经表示"英雄是否推定"，两者含义不同；混用会导致
            // 队友/敌人被面板当"未确认"而丢掉阵营颜色（今天出现过的全部灰色就是这个）。
        }
    }

    /// 镜像上传携带的脱敏自机绑定。只接受槽位号，不接受 UID/设备名等身份字段。
    /// 返回 `Some(seq)` 表示向观看端广播了新的绑定，未变化时返回 `None`。
    pub async fn set_mirror_binding(
        &self,
        mut binding: RosterBindingView,
    ) -> Result<Option<u64>, WebError> {
        if binding.local_slots.iter().any(|slot| *slot > 63)
            || binding.self_slot.is_some_and(|slot| slot > 63)
        {
            return Err(WebError::InvalidEvent("invalid mirror binding slot"));
        }
        binding.local_slots.sort_unstable();
        binding.local_slots.dedup();
        if let Some(self_slot) = binding.self_slot
            && !binding.local_slots.is_empty()
            && !binding.local_slots.contains(&self_slot)
        {
            return Err(WebError::InvalidEvent("mirror self slot is not local"));
        }
        let changed = {
            let mut current = self.inner.binding.write().await;
            if *current == binding {
                false
            } else {
                *current = binding;
                true
            }
        };
        if !changed {
            return Ok(None);
        }
        self.publish_roster().await.map(Some)
    }

    /// 引擎判定的"自己"落在哪个槽位（出生点锚点），以及本机五人槽位。
    pub async fn set_self_slot(&self, slot: Option<u8>) -> Result<u64, WebError> {
        let mut binding = self.inner.binding.write().await;
        binding.self_slot = slot.filter(|slot| *slot <= 63);
        drop(binding);
        self.publish_roster().await
    }

    async fn publish_roster(&self) -> Result<u64, WebError> {
        let _publish = self.inner.publish_lock.lock().await;
        let session = self.inner.session.read().await.clone();
        let roster = self.inner.roster.read().await.clone();
        let binding = self.inner.binding.read().await.clone();
        let payload = MapRosterPayload {
            session: session.clone(),
            roster,
            maps: self.inner.map_catalog.manifest().clone(),
            operations: self.inner.operations.read().await.clone(),
            pipeline: self.inner.pipeline.read().await.clone(),
            binding,
        };
        self.broadcast_unlocked(
            "map_roster",
            session.latest_capture_ns.unwrap_or_default(),
            &payload,
        )
    }

    pub async fn set_roster(&self, roster: Vec<RosterEntry>) -> Result<u64, WebError> {
        if roster.len() > MAX_POSITIONS_PER_DELTA
            || roster
                .iter()
                .any(|entry| entry.display_name.len() > MAX_DISPLAY_NAME_BYTES)
        {
            return Err(WebError::InvalidEvent("invalid public roster size"));
        }
        {
            let _publish = self.inner.publish_lock.lock().await;
            *self.inner.roster.write().await = roster;
            let mut binding = self.inner.binding.write().await;
            binding.local_slots = self
                .inner
                .roster
                .read()
                .await
                .iter()
                .filter(|entry| entry.camp_id == codev_stream::LOCAL_CAMP_ID)
                .filter_map(|entry| entry.slot)
                .collect();
            binding.local_slots.sort_unstable();
            binding.local_slots.dedup();
        }
        self.publish_roster().await
    }

    pub async fn publish_positions(
        &self,
        capture_ns: u64,
        positions: Vec<PositionView>,
    ) -> Result<u64, WebError> {
        let mut positions = positions;
        // 用对局 roster 补齐英雄编号：位置流本身不带身份（PositionView::unresolved 只填坐标
        // 与阵营），而 roster（开局玩家列表）里有每个人的英雄编号。以前这里从来没接过，
        // 所以面板永远显示不出英雄头像。
        //
        // 对应关系：roster 每条带 camp_id 与 position_slot（显示名形如 batch_slot_N），
        // 同一阵营内有 5 个人、5 个槽位，按"阵营内位次 1..5 ↔ 阵营内槽位从小到大"对应。
        self.attach_roster_identity(&mut positions).await;
        validate_positions(&positions)?;
        let _publish = self.inner.publish_lock.lock().await;
        let seq = self.next_seq_unlocked();
        let channel_generation = self.inner.session.read().await.channel_generation;
        {
            let mut latest = self.inner.latest.write().await;
            let mut timeline = self.inner.timeline.lock().await;
            for position in &positions {
                latest.insert(position.slot, position.clone());
            }
            timeline.push(seq, capture_ns, channel_generation, positions.clone());
        }
        {
            let mut session = self.inner.session.write().await;
            session.capture_start_ns.get_or_insert(capture_ns);
            session.latest_capture_ns = Some(capture_ns);
        }
        let message = WireMessage {
            schema_version: WS_SCHEMA_VERSION,
            session_id: self.inner.session_id.clone(),
            seq,
            capture_ns,
            kind: "position_delta",
            payload: SnapshotPayload { positions },
        };
        self.send_json(seq, capture_ns, "position_delta", &message)?;
        Ok(seq)
    }

    pub async fn publish_gap(&self, capture_ns: u64, gap: GapPayload) -> Result<u64, WebError> {
        let _publish = self.inner.publish_lock.lock().await;
        let seq = self.next_seq_unlocked();
        let channel_generation = self.inner.session.read().await.channel_generation;
        let degraded = {
            let mut latest = self.inner.latest.write().await;
            for position in latest.values_mut() {
                position.continuity = Continuity::Degraded;
            }
            let mut positions: Vec<_> = latest.values().cloned().collect();
            positions.sort_by_key(|position| position.slot);
            positions
        };
        self.inner
            .timeline
            .lock()
            .await
            .push(seq, capture_ns, channel_generation, degraded);
        {
            let mut session = self.inner.session.write().await;
            session.capture_start_ns.get_or_insert(capture_ns);
            session.latest_capture_ns = Some(
                session
                    .latest_capture_ns
                    .map_or(capture_ns, |latest| latest.max(capture_ns)),
            );
        }
        self.broadcast_with_seq_unlocked(seq, "gap", capture_ns, &gap)?;
        Ok(seq)
    }

    pub async fn mark_positions_stale(
        &self,
        capture_ns: u64,
        stale_after_ns: u64,
    ) -> Result<Option<u64>, WebError> {
        let _publish = self.inner.publish_lock.lock().await;
        let mut stale = Vec::new();
        {
            let mut latest = self.inner.latest.write().await;
            for position in latest.values_mut() {
                if position.continuity == Continuity::Proven
                    && capture_ns.saturating_sub(position.updated_ns) > stale_after_ns
                {
                    position.continuity = Continuity::Stale;
                    stale.push(position.clone());
                }
            }
        }
        if stale.is_empty() {
            return Ok(None);
        }
        stale.sort_by_key(|position| position.slot);
        let seq = self.next_seq_unlocked();
        let channel_generation = self.inner.session.read().await.channel_generation;
        self.inner
            .timeline
            .lock()
            .await
            .push(seq, capture_ns, channel_generation, stale.clone());
        self.inner.session.write().await.latest_capture_ns = Some(capture_ns);
        let message = WireMessage {
            schema_version: WS_SCHEMA_VERSION,
            session_id: self.inner.session_id.clone(),
            seq,
            capture_ns,
            kind: "position_delta",
            payload: SnapshotPayload { positions: stale },
        };
        self.send_json(seq, capture_ns, "position_delta", &message)?;
        Ok(Some(seq))
    }

    pub async fn publish_metrics(
        &self,
        capture_ns: u64,
        metrics: MetricsPayload,
    ) -> Result<u64, WebError> {
        let _publish = self.inner.publish_lock.lock().await;
        *self.inner.latest_metrics.write().await = Some((capture_ns, metrics.clone()));
        let payload = MetricsStatusPayload {
            metrics,
            operations: self.inner.operations.read().await.clone(),
            pipeline: self.inner.pipeline.read().await.clone(),
        };
        self.broadcast_unlocked("metrics", capture_ns, &payload)
    }

    pub async fn publish_end(&self, capture_ns: u64, end: EndPayload) -> Result<u64, WebError> {
        let _publish = self.inner.publish_lock.lock().await;
        self.broadcast_unlocked("end", capture_ns, &end)
    }

    pub async fn snapshot(&self) -> Vec<PositionView> {
        let mut positions: Vec<_> = self.inner.latest.read().await.values().cloned().collect();
        positions.sort_by_key(|position| position.slot);
        positions
    }

    fn broadcast_unlocked<T: Serialize>(
        &self,
        kind: &'static str,
        capture_ns: u64,
        payload: &T,
    ) -> Result<u64, WebError> {
        let seq = self.next_seq_unlocked();
        self.broadcast_with_seq_unlocked(seq, kind, capture_ns, payload)?;
        Ok(seq)
    }

    fn next_seq_unlocked(&self) -> u64 {
        self.inner.seq.fetch_add(1, Ordering::Relaxed) + 1
    }

    fn broadcast_with_seq_unlocked<T: Serialize>(
        &self,
        seq: u64,
        kind: &'static str,
        capture_ns: u64,
        payload: &T,
    ) -> Result<(), WebError> {
        self.send_json(
            seq,
            capture_ns,
            kind,
            &WireMessage {
                schema_version: WS_SCHEMA_VERSION,
                session_id: self.inner.session_id.clone(),
                seq,
                capture_ns,
                kind,
                payload,
            },
        )
    }

    fn send_json<T: Serialize>(
        &self,
        seq: u64,
        capture_ns: u64,
        kind: &'static str,
        message: &T,
    ) -> Result<(), WebError> {
        let json: Arc<str> = serde_json::to_string(message)?.into();
        let _ = self.inner.sender.send(BroadcastEvent {
            seq,
            capture_ns,
            kind,
            json,
        });
        Ok(())
    }
}

fn validate_positions(positions: &[PositionView]) -> Result<(), WebError> {
    if positions.len() > MAX_POSITIONS_PER_DELTA {
        return Err(WebError::InvalidEvent("too many positions in one delta"));
    }
    if positions.iter().any(|position| {
        usize::from(position.slot) >= MAX_POSITIONS_PER_DELTA
            || position.track_id.len() > MAX_TRACK_ID_BYTES
            || position
                .display_name
                .as_ref()
                .is_some_and(|name| name.len() > MAX_DISPLAY_NAME_BYTES)
    }) {
        return Err(WebError::InvalidEvent(
            "position metadata exceeds public protocol bounds",
        ));
    }
    if positions.iter().any(|position| {
        !position.world.x.is_finite()
            || !position.world.y.is_finite()
            || !position.world.z.is_finite()
            || !position.yaw.is_finite()
            || position
                .map
                .is_some_and(|point| !point.u.is_finite() || !point.v.is_finite())
    }) {
        return Err(WebError::InvalidEvent(
            "position contains a non-finite value",
        ));
    }
    Ok(())
}

fn contains_private_detail(detail: &str) -> bool {
    let detail = detail.to_ascii_lowercase();
    [
        "packetkey",
        "packet_key",
        "gameid",
        "g0_id",
        "openid",
        "uid",
    ]
    .iter()
    .any(|needle| detail.contains(needle))
}

fn validate_pipeline_status(status: &PipelineStatus) -> Result<(), WebError> {
    if status.stage.is_empty()
        || status.stage.len() > MAX_PIPELINE_STAGE_BYTES
        || !status
            .stage
            .bytes()
            .all(|byte| byte.is_ascii_lowercase() || byte.is_ascii_digit() || byte == b'_')
    {
        return Err(WebError::InvalidEvent("invalid parser pipeline stage"));
    }
    if status.detail.len() > MAX_OPERATIONAL_DETAIL_BYTES || contains_private_detail(&status.detail)
    {
        return Err(WebError::InvalidEvent(
            "parser pipeline detail exceeds public protocol bounds",
        ));
    }
    Ok(())
}

#[derive(Debug, Error)]
pub enum WebError {
    #[error("web JSON error: {0}")]
    Json(#[from] serde_json::Error),
    #[error("map catalog error: {0}")]
    Map(#[from] codev_assets::MapError),
    #[error("web server I/O error: {0}")]
    Io(#[from] std::io::Error),
    #[error("refusing non-loopback listen address {0}")]
    NonLoopback(SocketAddr),
    #[error("invalid web event: {0}")]
    InvalidEvent(&'static str),
    #[error("profile service error: {0}")]
    Profile(#[from] ProfileError),
