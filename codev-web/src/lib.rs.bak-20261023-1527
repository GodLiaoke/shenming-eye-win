async fn profile_response(
    service: &ProxyPanelService,
    headers: &HeaderMap,
    credential: codev_proxy::ProfileCredential,
) -> Result<Response, WebError> {
    let grant = service.issue_download_grant(&credential).await;
    let profile_id = &credential.metadata.profile_id;
    let bearer = format!("{}.{}", credential.metadata.username, credential.secret);
    let base = service
        .public_base_url
        .clone()
        .or_else(|| request_base_url(headers))
        .ok_or(WebError::InvalidEvent(
            "profile public base URL is not configured",
        ))?;
    let base = base.trim_end_matches('/');
    let subscription_url = format!(
        "{base}/api/v1/proxy/subscriptions/{profile_id}?token={}",
        percent_encode(&bearer)
    );
    let host = service
        .config
        .advertised_host
        .as_deref()
        .ok_or(WebError::InvalidEvent(
            "profile advertised host is not configured",
        ))?;
    let port = service
        .config
        .advertised_port
        .unwrap_or(service.config.listen.port());
    let node_url = render_socks5_node_uri(
        host,
        port,
        &credential.metadata.username,
        &credential.secret,
        "CodeV",
    )?;
    let shadowrocket_node_import_url = shadowrocket_node_import_url(&node_url);
    let payload = ProfileResponse {
        profile_id: profile_id.clone(),
        username: credential.metadata.username,
        secret: credential.secret,
        expires_at: credential.metadata.expires_at,
        subscription_url,
        node_url,
        shadowrocket_import_url: shadowrocket_node_import_url.clone(),
        shadowrocket_node_import_url,
        conf_download: format!(
            "/api/v1/proxy/profiles/{}/conf?grant={grant}",
            percent_encode(profile_id)
        ),
        qr_download: format!(
            "/api/v1/proxy/profiles/{}/qr.svg?grant={grant}",
            percent_encode(profile_id)
        ),
    };
    Ok(no_store(Json(payload).into_response()))
}

