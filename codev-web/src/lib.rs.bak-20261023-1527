    }

    #[test]
    fn player_center_base_transform_keeps_every_self_yaw_up_before_final_correction() {
        for heading_degrees in [-179.0_f64, -90.0, 0.0, 37.0, 90.0, 179.0] {
            let heading = heading_degrees.to_radians();
            let raw_forward = (heading.cos(), heading.sin());
            let view_rotation = -std::f64::consts::FRAC_PI_2 - heading;
            let cosine = view_rotation.cos();
            let sine = view_rotation.sin();
            let screen_x = raw_forward.0 * cosine - raw_forward.1 * sine;
            let screen_y = raw_forward.0 * sine + raw_forward.1 * cosine;
            assert!(
                screen_x.abs() < 1e-12,
                "heading {heading_degrees}: x={screen_x}"
            );
            assert!(
                (screen_y + 1.0).abs() < 1e-12,
                "heading {heading_degrees}: y={screen_y}"
            );

            let arrow_angle = heading + view_rotation;
            assert!(
                arrow_angle.cos().abs() < 1e-12 && (arrow_angle.sin() + 1.0).abs() < 1e-12,
                "heading {heading_degrees}: arrow={arrow_angle}"
            );
        }
    }

    #[test]
    fn global_radar_view_uses_the_game_native_baseline_without_a_quarter_turn() {
        let view_rotation = 0.0_f64;
        let a_side = (-1.0_f64, 0.0_f64);
        let b_side = (1.0_f64, 0.0_f64);
        let rotate = |point: (f64, f64)| {
            (
                point.0 * view_rotation.cos() - point.1 * view_rotation.sin(),
                point.0 * view_rotation.sin() + point.1 * view_rotation.cos(),
            )
        };
        let a_screen = rotate(a_side);
        let b_screen = rotate(b_side);
        assert!((a_screen.0 + 1.0).abs() < 1e-12 && a_screen.1.abs() < 1e-12);
        assert!((b_screen.0 - 1.0).abs() < 1e-12 && b_screen.1.abs() < 1e-12);
    }

