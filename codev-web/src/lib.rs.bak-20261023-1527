#[derive(Deserialize)]
struct AuthExchangeRequest {
    token: String,
}

async fn auth_exchange(
    State(hub): State<EventHub>,
    headers: HeaderMap,
    Json(request): Json<AuthExchangeRequest>,
) -> Response {
    let Some(auth) = hub.inner.public_auth.as_ref() else {
        return StatusCode::NOT_FOUND.into_response();
    };
    let Some(session) = auth.exchange(&request.token) else {
        return StatusCode::UNAUTHORIZED.into_response();
    };
    let mut response = StatusCode::NO_CONTENT.into_response();
    // The configured public origin is authoritative for reverse-proxied
    // deployments. Staging may explicitly use plaintext HTTP; in that mode a
    // Secure cookie would never be returned by browsers. Unknown/direct public
    // origins remain secure-by-default, while loopback development stays usable.
    let public_base_url = {
        let services = hub.inner.services.read().await;
        services
            .proxy
            .as_ref()
            .and_then(|service| service.public_base_url.clone())
    };
    let secure_cookie = auth_cookie_is_secure(&headers, public_base_url.as_deref());
    if let Ok(value) = HeaderValue::from_str(&auth.cookie_header(&session, secure_cookie)) {
        response.headers_mut().insert(header::SET_COOKIE, value);
    }
    response
}

fn auth_cookie_is_secure(headers: &HeaderMap, public_base_url: Option<&str>) -> bool {
    if let Some(scheme) = public_base_url
        .and_then(|value| value.parse::<Uri>().ok())
        .and_then(|uri| uri.scheme_str().map(str::to_owned))
    {
        return scheme.eq_ignore_ascii_case("https");
    }

    match headers
        .get("x-forwarded-proto")
        .and_then(|value| value.to_str().ok())
    {
        Some(value) if value.eq_ignore_ascii_case("http") => false,
        Some(value) if value.eq_ignore_ascii_case("https") => true,
        _ => !headers
            .get(header::HOST)
            .and_then(|value| value.to_str().ok())
            .is_some_and(is_loopback_authority),
    }
}

