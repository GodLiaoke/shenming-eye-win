        let after = get_json(address, "/api/v1/session").await;
        assert_eq!(after["status"], "live");
        assert_eq!(after["map_id"], 1004);
        assert_eq!(after["latest_capture_ns"], 1789994130300050000_u64);

        // 同一局后续上传（每秒 20 批）**不能**每批都重写会话。
        let second = raw_http(
            address,
            mirror_post(address, &format!("?access={token}"), body),
        )
        .await;
        let again: Value = serde_json::from_slice(http_body(&second)).unwrap();
