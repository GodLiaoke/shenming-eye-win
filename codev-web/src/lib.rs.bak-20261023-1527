    binding: RwLock<RosterBindingView>,
    /// 每个阵营「已经见过的槽位集合」：位置流每帧只推变化的槽，需要跨帧累积到
    /// 收齐 5 个之后才能确定「位次 ↔ 槽位」的对应关系。
    camp_slots: Mutex<std::collections::BTreeSet<(u32, u8)>>,
    latest_metrics: RwLock<Option<(u64, MetricsPayload)>>,
    latest: RwLock<HashMap<u8, PositionView>>,
    timeline: Mutex<Timeline>,
    publish_lock: Mutex<()>,
    sender: broadcast::Sender<BroadcastEvent>,
    map_catalog: MapCatalog,
    services: RwLock<PanelServices>,
}

#[derive(Clone)]
pub struct EventHub {
    inner: Arc<Inner>,
}

impl EventHub {
    pub fn new(session_id: impl Into<String>) -> Result<Self, WebError> {
        Self::new_with_public_auth(session_id, None, PanelServices::default())
    }

    pub fn new_public(
        session_id: impl Into<String>,
        bootstrap_token: &str,
        token_ttl_secs: u64,
    ) -> Result<Self, WebError> {
        let auth = PublicAuth::new(bootstrap_token, token_ttl_secs).ok_or(
            WebError::InvalidEvent("invalid public panel token configuration"),
        )?;
        Self::new_with_public_auth(session_id, Some(Arc::new(auth)), PanelServices::default())
    }

    pub fn new_public_with_services(
        session_id: impl Into<String>,
        bootstrap_token: &str,
        token_ttl_secs: u64,
        services: PanelServices,
    ) -> Result<Self, WebError> {
        let auth = PublicAuth::new(bootstrap_token, token_ttl_secs).ok_or(
            WebError::InvalidEvent("invalid public panel token configuration"),
        )?;
        Self::new_with_public_auth(session_id, Some(Arc::new(auth)), services)
    }

    fn new_with_public_auth(
        session_id: impl Into<String>,
        public_auth: Option<Arc<PublicAuth>>,
        services: PanelServices,
    ) -> Result<Self, WebError> {
        let session_id = session_id.into();
        if session_id.is_empty() || session_id.len() > MAX_SESSION_ID_BYTES {
            return Err(WebError::InvalidEvent("invalid public session id length"));
        }
        let (sender, _) = broadcast::channel(WS_BROADCAST_CAPACITY);
        Ok(Self {
            inner: Arc::new(Inner {
                session_id,
                token: format!("{:032x}", rand::random::<u128>()),
                public_auth,
                seq: AtomicU64::new(0),
                initial_replay_speed_bits: AtomicU64::new(0),
                session: RwLock::new(SessionView::default()),
                operations: RwLock::new(OperationalStatus::default()),
                pipeline: RwLock::new(PipelineStatus::default()),
                roster: RwLock::new(Vec::new()),
                binding: RwLock::new(RosterBindingView::default()),
                camp_slots: Mutex::new(std::collections::BTreeSet::new()),
                latest_metrics: RwLock::new(None),
                latest: RwLock::new(HashMap::new()),
                timeline: Mutex::new(Timeline::new(DEFAULT_TIMELINE_BYTES)),
                publish_lock: Mutex::new(()),
                sender,
                map_catalog: MapCatalog::embedded().map_err(WebError::Map)?,
                services: RwLock::new(services),
            }),
        })
    }

    pub async fn set_panel_services(&self, services: PanelServices) {
        *self.inner.services.write().await = services;
    }

    pub fn token(&self) -> &str {
        &self.inner.token
    }

    pub fn is_public(&self) -> bool {
        self.inner.public_auth.is_some()
    }

