async fn profile_artifact(
    hub: EventHub,
    id: String,
    raw_query: Option<&str>,
    _headers: HeaderMap,
    artifact: ProfileArtifact,
) -> Response {
    let service = {
        let services = hub.inner.services.read().await;
        services.proxy.clone()
    };
    let Some(service) = service else {
        return StatusCode::NOT_FOUND.into_response();
    };
    let params = query_pairs(raw_query);
    let secret = if let Some(grant) = params.get("grant") {
        service.resolve_download_grant(&id, grant).await
    } else {
        params.get("token").map(|token| token.to_owned())
    };
    let Some(secret) = secret else {
        return StatusCode::UNAUTHORIZED.into_response();
    };
    let status = match service
        .profiles
        .authenticate_subscription(&service.tokens, &id, &secret)
    {
        Ok(status) => status,
        Err(_) => return StatusCode::UNAUTHORIZED.into_response(),
    };
    let host = match service.config.advertised_host.as_deref() {
        Some(host) => host,
        None => return StatusCode::FAILED_DEPENDENCY.into_response(),
    };
    let port = service
        .config
        .advertised_port
        .unwrap_or(service.config.listen.port());
    let bearer = secret;
    let Some((_username, password)) = bearer.split_once('.') else {
        return StatusCode::UNAUTHORIZED.into_response();
    };
    let username = status.metadata.username;
    if matches!(artifact, ProfileArtifact::Qr) {
        let Ok(node_url) = render_socks5_node_uri(host, port, &username, password, "CodeV") else {
            return StatusCode::UNPROCESSABLE_ENTITY.into_response();
        };
        let Ok(code) = QrCode::new(node_url.as_bytes()) else {
            return StatusCode::UNPROCESSABLE_ENTITY.into_response();
        };
        let svg = code.render::<svg::Color>().min_dimensions(256, 256).build();
        return no_store(
            HttpResponse::builder()
                .status(StatusCode::OK)
                .header(header::CONTENT_TYPE, "image/svg+xml")
                .header(
                    header::CONTENT_DISPOSITION,
                    "inline; filename=codev-shadowrocket.svg",
                )
                .body(Body::from(svg))
                .unwrap()
                .into_response(),
        );
    }
    let body = match artifact {
        ProfileArtifact::Conf => render_shadowrocket_conf_live(
            host,
            port,
            &username,
            password,
            &service.config.allow_hosts,
            &service.config.allow_ports,
        ),
        ProfileArtifact::Subscription => {
            render_shadowrocket_subscription(host, port, &username, password)
        }
        ProfileArtifact::Qr => unreachable!("QR response returned above"),
    };
    let Ok(body) = body else {
        return StatusCode::UNPROCESSABLE_ENTITY.into_response();
    };
    let (content_type, disposition) = match artifact {
        ProfileArtifact::Conf => (
            "text/plain; charset=utf-8",
            "attachment; filename=codev-shadowrocket.conf",
        ),
        ProfileArtifact::Subscription => (
            "text/plain; charset=utf-8",
            "inline; filename=codev-shadowrocket-subscription.txt",
        ),
        ProfileArtifact::Qr => unreachable!("QR response returned above"),
    };
    no_store(
        HttpResponse::builder()
            .status(StatusCode::OK)
            .header(header::CONTENT_TYPE, content_type)
            .header(header::CONTENT_DISPOSITION, disposition)
            .body(Body::from(body))
            .unwrap()
            .into_response(),
    )
}

async fn ca_status(State(hub): State<EventHub>) -> Response {
    let services = hub.inner.services.read().await;
    let Some(ca) = services.ca.as_ref() else {
        return Json(serde_json::json!({
            "enabled": false,
            "fingerprint_sha256": "",
            "generated_at_unix": 0
        }))
        .into_response();
    };
    Json(ca.authority.status()).into_response()
}

async fn ca_download(State(hub): State<EventHub>, Path(format): Path<String>) -> Response {
    let kind = match format.as_str() {
        "pem" => CaArtifactKind::Pem,
        "der" => CaArtifactKind::Der,
        "mobileconfig" => CaArtifactKind::Mobileconfig,
        "readme" => CaArtifactKind::Readme,
        _ => return StatusCode::NOT_FOUND.into_response(),
    };
    let services = hub.inner.services.read().await;
    let Some(ca) = services.ca.as_ref() else {
        return StatusCode::NOT_FOUND.into_response();
    };
    let artifact = ca.authority.public_artifact(kind);
    no_store(
        HttpResponse::builder()
            .status(StatusCode::OK)
            .header(header::CONTENT_TYPE, artifact.content_type)
            .header(
                header::CONTENT_DISPOSITION,
                format!("attachment; filename={}", artifact.filename),
            )
            .body(Body::from(artifact.bytes))
            .unwrap()
            .into_response(),
    )
}

fn no_store(mut response: Response) -> Response {
    response.headers_mut().insert(
        header::CACHE_CONTROL,
        HeaderValue::from_static("no-store, max-age=0"),
    );
    response
}

fn error_response(error: WebError) -> Response {
    let (status, message) = match error {
        WebError::Profile(ProfileError::NotFound(_)) => {
            (StatusCode::NOT_FOUND, "profile not found")
        }
        WebError::Profile(ProfileError::InvalidSubscription) => {
            (StatusCode::UNAUTHORIZED, "invalid subscription")
        }
        WebError::InvalidEvent(message) => (StatusCode::FAILED_DEPENDENCY, message),
        _ => (StatusCode::BAD_REQUEST, "profile request rejected"),
    };
    (status, Json(serde_json::json!({"error": message}))).into_response()
}

fn request_base_url(headers: &HeaderMap) -> Option<String> {
    let host = headers.get(header::HOST)?.to_str().ok()?.trim();
    let scheme = headers
        .get("x-forwarded-proto")
        .and_then(|value| value.to_str().ok())
        .filter(|value| matches!(*value, "http" | "https"))
        .unwrap_or("http");
    Some(format!("{scheme}://{host}"))
}

fn query_pairs(raw: Option<&str>) -> HashMap<String, String> {
    raw.unwrap_or_default()
        .split('&')
        .filter_map(|part| {
            let (key, value) = part.split_once('=')?;
            Some((key.to_owned(), percent_decode(value)))
        })
        .collect()
}

fn percent_encode(value: &str) -> String {
    let mut output = String::with_capacity(value.len());
    for byte in value.bytes() {
        if byte.is_ascii_alphanumeric() || matches!(byte, b'-' | b'_' | b'.' | b'~') {
            output.push(byte as char);
        } else {
            output.push('%');
            output.push_str(&format!("{byte:02X}"));
        }
    }
    output
}

fn shadowrocket_node_import_url(node_url: &str) -> String {
    format!("shadowrocket://add/{}", percent_encode(node_url))
}

fn percent_decode(value: &str) -> String {
    let bytes = value.as_bytes();
    let mut output = Vec::with_capacity(bytes.len());
    let mut index = 0;
    while index < bytes.len() {
        if bytes[index] == b'%'
            && index + 2 < bytes.len()
            && let Ok(decoded) = u8::from_str_radix(&value[index + 1..index + 3], 16)
        {
            output.push(decoded);
            index += 3;
            continue;
        }
        output.push(bytes[index]);
        index += 1;
    }
    String::from_utf8_lossy(&output).into_owned()
}

async fn websocket(
    State(hub): State<EventHub>,
    headers: HeaderMap,
    RawQuery(raw_query): RawQuery,
    upgrade: WebSocketUpgrade,
) -> impl IntoResponse {
    let local_token_ok = raw_query
        .as_deref()
        .and_then(parse_local_token)
        .is_some_and(|token| token == hub.token());
    let auth_ok = hub.is_public()
        && (hub.public_authenticated(&headers) || lan_trusted(&hub, &headers).await);
    let origin_ok = if hub.is_public() {
        same_origin(&headers, false)
    } else {
        same_origin(&headers, true)
    };
    if ((!hub.is_public() && !local_token_ok) || (hub.is_public() && !auth_ok)) || !origin_ok {
        return StatusCode::FORBIDDEN.into_response();
    }
    upgrade
        .max_message_size(MAX_CLIENT_MESSAGE_BYTES)
        .max_frame_size(MAX_CLIENT_MESSAGE_BYTES)
        .on_upgrade(move |socket| websocket_client(socket, hub))
        .into_response()
}

fn parse_local_token(raw_query: &str) -> Option<&str> {
    raw_query.split('&').find_map(|part| {
        let (name, value) = part.split_once('=')?;
        (name == "token" && !value.is_empty()).then_some(value)
    })
}

async fn require_access(State(hub): State<EventHub>, request: Request, next: Next) -> Response {
    let public_path = request.uri().path();
    if hub.is_public() {
        let health_path = matches!(
            public_path,
            "/healthz" | "/api/v1/healthz" | "/api/v1/readiness"
        );
        if !has_any_host(request.headers())
            || (!health_path && !public_host_ok(&hub, request.headers()).await)
        {
            return StatusCode::FORBIDDEN.into_response();
        }
        // A public panel may be reached through a reverse proxy, but a
        // browser-supplied Origin must still name the same authority.  Curl
        // health probes and native clients commonly omit Origin, which is
        // intentionally accepted; an explicit cross-origin value is denied
        // before any panel handler (including auth exchange) runs.
        if !public_origin_ok(request.headers()) {
            return StatusCode::FORBIDDEN.into_response();
        }
        let subscription_path = public_path.starts_with("/api/v1/proxy/subscriptions/");
        // 本机回环（App 内嵌 WebView 走 127.0.0.1）**永远**免令牌，不再依赖
        // allow_lan_hosts 配置：面板会话只存在引擎内存里，引擎一重启会话就没了，
        // 老配置下页面会突然跳「请输入管理员令牌」，客户在 App 里卡死。
        let loopback_ok = request
            .headers()
            .get(header::HOST)
            .and_then(|value| value.to_str().ok())
            .is_some_and(is_loopback_authority);
        let lan_ok = loopback_ok || lan_trusted(&hub, request.headers()).await;
        if !matches!(
            public_path,
            "/" | "/healthz" | "/api/v1/healthz" | "/api/v1/readiness" | "/api/v1/auth/exchange"
        ) && !subscription_path
            && !lan_ok
            && !hub.public_authenticated(request.headers())
        {
            return StatusCode::UNAUTHORIZED.into_response();
        }
    } else if !has_local_host(request.headers()) {
        return StatusCode::FORBIDDEN.into_response();
    }
    let mut response = next.run(request).await;
    let headers = response.headers_mut();
    headers.insert(
        header::X_CONTENT_TYPE_OPTIONS,
        HeaderValue::from_static("nosniff"),
    );
    headers.insert(header::X_FRAME_OPTIONS, HeaderValue::from_static("DENY"));
    headers.insert(
        header::REFERRER_POLICY,
        HeaderValue::from_static("no-referrer"),
    );
    headers.insert(
        header::CONTENT_SECURITY_POLICY,
        HeaderValue::from_static(CONTENT_SECURITY_POLICY),
    );
    response
}

fn has_local_host(headers: &HeaderMap) -> bool {
    headers
        .get(header::HOST)
        .and_then(|value| value.to_str().ok())
        .is_some_and(is_loopback_authority)
}

fn has_any_host(headers: &HeaderMap) -> bool {
    headers
        .get(header::HOST)
        .and_then(|value| value.to_str().ok())
        .is_some_and(|value| {
            !value.trim().is_empty() && value.parse::<axum::http::uri::Authority>().is_ok()
        })
}

async fn public_host_ok(hub: &EventHub, headers: &HeaderMap) -> bool {
    let Some(host) = headers
        .get(header::HOST)
        .and_then(|value| value.to_str().ok())
    else {
        return false;
    };
    let services = hub.inner.services.read().await;
    let Some(expected) = services
        .proxy
        .as_ref()
        .and_then(|service| service.public_base_url.as_deref())
    else {
        return true;
    };
    let Some(expected_authority) = expected.parse::<Uri>().ok().and_then(|uri| {
        uri.authority()
            .map(|authority| authority.as_str().to_owned())
    }) else {
        return false;
    };
    if expected_authority.eq_ignore_ascii_case(host.trim()) {
        return true;
    }
    // 局域网共享：A 设备起引擎，B/C 设备用 A 的**局域网地址**访问雷达页。
    // 只有显式打开 `allow_lan_hosts` 的部署才放行，且只接受私网/回环地址
    // 字面量——公网/网关部署必须继续走严格 Host 匹配，否则等于给 DNS
    // rebinding 留门。
    services
        .proxy
        .as_ref()
        .is_some_and(|service| service.allow_lan_hosts)
        && is_private_lan_authority(host)
}

/// 局域网信任：开启 `allow_lan_hosts` 的本地引擎，允许**私网地址来源**直接
/// 访问面板而不必先换取会话令牌（A 起引擎，B/C 在同一局域网直接看）。
///
/// 边界刻意收得很紧：
/// - 必须是私网/回环地址字面量的 Host（域名、公网 IP 一律不信任）；
/// - 必须由本地引擎配置显式打开 `allow_lan_hosts`（公网/网关部署默认关闭）；
/// - 只影响 HTTP/WS 的会话校验，不改动任何数据面逻辑。
async fn lan_trusted(hub: &EventHub, headers: &HeaderMap) -> bool {
    let Some(host) = headers
        .get(header::HOST)
        .and_then(|value| value.to_str().ok())
    else {
        return false;
    };
    if !is_private_lan_authority(host) {
        return false;
    }
    let services = hub.inner.services.read().await;
    services
        .proxy
        .as_ref()
        .is_some_and(|service| service.allow_lan_hosts)
}

/// 判断 Host 是否为私网地址字面量（可带端口）。仅用于局域网共享面板。
fn is_private_lan_authority(authority: &str) -> bool {
    let trimmed = authority.trim();
    let host_only = if let Some(rest) = trimmed.strip_prefix('[') {
        match rest.split_once(']') {
            Some((address, _)) => address,
            None => return false,
        }
    } else if let Some((address, port)) = trimmed.rsplit_once(':') {
        // 只有冒号后面确实是端口时才当主机名处理，避免误切 IPv6。
        if port.parse::<u16>().is_ok() {
            address
        } else {
            trimmed
        }
    } else {
        trimmed
    };
    match host_only.parse::<std::net::IpAddr>() {
        Ok(std::net::IpAddr::V4(v4)) => v4.is_private() || v4.is_loopback() || v4.is_link_local(),
        Ok(std::net::IpAddr::V6(v6)) => {
            v6.is_loopback()
                || (v6.segments()[0] & 0xffc0) == 0xfe80
                || (v6.segments()[0] & 0xfe00) == 0xfc00
        }
        Err(_) => false,
    }
}

fn public_origin_ok(headers: &HeaderMap) -> bool {
    let Some(origin) = headers
        .get(header::ORIGIN)
        .and_then(|value| value.to_str().ok())
    else {
        return true;
    };
    let Some(host) = headers
        .get(header::HOST)
        .and_then(|value| value.to_str().ok())
    else {
        return false;
    };
    let Ok(origin) = origin.parse::<Uri>() else {
        return false;
    };
    matches!(origin.scheme_str(), Some("http" | "https"))
        && origin
            .authority()
            .is_some_and(|authority| authority.as_str().eq_ignore_ascii_case(host.trim()))
}

fn is_loopback_authority(authority: &str) -> bool {
    let Ok(authority) = authority.parse::<axum::http::uri::Authority>() else {
        return false;
    };
    let host = authority.host().trim_matches(['[', ']']);
    host.eq_ignore_ascii_case("localhost")
        || host
            .parse::<std::net::IpAddr>()
            .is_ok_and(|address| address.is_loopback())
}

fn same_origin(headers: &HeaderMap, local_only: bool) -> bool {
    let Some(host) = headers
        .get(header::HOST)
        .and_then(|value| value.to_str().ok())
    else {
        return false;
    };
    if local_only && !is_loopback_authority(host) {
        return false;
    }
    let Some(origin) = headers
        .get(header::ORIGIN)
        .and_then(|value| value.to_str().ok())
        .and_then(|value| value.parse::<Uri>().ok())
    else {
        return false;
    };
    matches!(origin.scheme_str(), Some("http" | "https"))
        && origin
            .authority()
            .is_some_and(|authority| authority.as_str().eq_ignore_ascii_case(host))
}

#[derive(Clone, Copy, Debug, Serialize)]
#[serde(rename_all = "snake_case")]
enum SnapshotReason {
    Initial,
    Seek,
    Playback,
    Live,
    LagResync,
}

#[derive(Clone, Debug, Serialize)]
struct SnapshotWirePayload {
    positions: Vec<PositionView>,
    reason: SnapshotReason,
    #[serde(skip_serializing_if = "Option::is_none")]
    requested_capture_ns: Option<u64>,
    #[serde(skip_serializing_if = "Option::is_none")]
    earliest_available_ns: Option<u64>,
}

struct SnapshotEnvelope {
    seq: u64,
    capture_ns: u64,
    payload: SnapshotWirePayload,
}

struct SnapshotReceipt {
    seq: u64,
    capture_ns: u64,
}

struct InitialState {
    capture_ns: u64,
    channel_generation: u64,
    replay_speed: Option<f64>,
    positions: Vec<PositionView>,
    earliest_available_ns: Option<u64>,
    map_roster: MapRosterPayload,
    metrics: Option<(u64, MetricsPayload)>,
    operations: OperationalStatus,
    pipeline: PipelineStatus,
}

#[derive(Clone, Copy, Debug)]
enum StateDeliveryKind {
    Initial,
    LagResync,
}

#[derive(Clone, Copy, Debug)]
struct StateDeliverySequences {
    hello: Option<u64>,
    snapshot: u64,
    map_roster: u64,
    metrics: Option<u64>,
    last: u64,
}

struct StateDelivery {
    state: InitialState,
    sequences: StateDeliverySequences,
}

struct ClientPlayback {
    paused: bool,
    live: bool,
    cursor_ns: u64,
    speed: f64,
    channel_generation: u64,
    last_tick: tokio::time::Instant,
}

impl ClientPlayback {
    fn live(cursor_ns: u64, channel_generation: u64) -> Self {
        Self {
            paused: false,
            live: true,
            cursor_ns,
            speed: 1.0,
            channel_generation,
            last_tick: tokio::time::Instant::now(),
        }
    }

    fn replay(cursor_ns: u64, channel_generation: u64, speed: f64) -> Self {
        Self {
            paused: false,
            live: false,
            cursor_ns,
            speed,
            channel_generation,
            last_tick: tokio::time::Instant::now(),
        }
    }

    fn advance(&mut self, now: tokio::time::Instant, latest_capture_ns: u64) -> bool {
        let elapsed = now.saturating_duration_since(self.last_tick);
        self.last_tick = now;
        if self.paused || self.live {
            return false;
        }
        let delta_ns = (elapsed.as_secs_f64() * 1_000_000_000.0 * self.speed)
            .clamp(0.0, u64::MAX as f64) as u64;
        self.cursor_ns = self
            .cursor_ns
            .saturating_add(delta_ns)
            .min(latest_capture_ns);
        true
    }
}

async fn websocket_client(mut socket: WebSocket, hub: EventHub) {
    // Subscribe first, then take an atomic logical snapshot. Events published
    // during the initial writes remain queued and are filtered by sequence.
    let mut receiver = hub.inner.sender.subscribe();
    let capabilities = hub.hello_capabilities().await;
    let delivery = state_delivery(&hub, StateDeliveryKind::Initial).await;
    let initial = delivery.state;
    let sequences = delivery.sequences;
    let replay_speed = initial.replay_speed;
    let hello = WireMessage {
        schema_version: WS_SCHEMA_VERSION,
        session_id: hub.inner.session_id.clone(),
        seq: sequences
            .hello
            .expect("initial delivery has a hello sequence"),
        capture_ns: initial.capture_ns,
        kind: "hello",
        payload: HelloPayload {
            capabilities,
            timeline_limit_bytes: DEFAULT_TIMELINE_BYTES,
            initial_playback_speed: replay_speed.unwrap_or(1.0),
            starts_at_live_edge: replay_speed.is_none(),
        },
    };
    if send(&mut socket, &hello).await.is_err() {
        return;
    }
    let initial_snapshot = WireMessage {
        schema_version: WS_SCHEMA_VERSION,
        session_id: hub.inner.session_id.clone(),
        seq: sequences.snapshot,
        capture_ns: initial.capture_ns,
        kind: "snapshot",
        payload: SnapshotWirePayload {
            positions: initial.positions,
            reason: SnapshotReason::Initial,
            requested_capture_ns: None,
            earliest_available_ns: initial.earliest_available_ns,
        },
    };
    if send(&mut socket, &initial_snapshot).await.is_err() {
        return;
    }
    let initial_map_roster = WireMessage {
        schema_version: WS_SCHEMA_VERSION,
        session_id: hub.inner.session_id.clone(),
        seq: sequences.map_roster,
        capture_ns: initial.capture_ns,
        kind: "map_roster",
        payload: initial.map_roster,
    };
    if send(&mut socket, &initial_map_roster).await.is_err() {
        return;
    }
    if let Some((metrics_capture_ns, metrics)) = initial.metrics
        && send(
            &mut socket,
            &WireMessage {
                schema_version: WS_SCHEMA_VERSION,
                session_id: hub.inner.session_id.clone(),
                seq: sequences
                    .metrics
                    .expect("metrics payload has a reserved sequence"),
                capture_ns: metrics_capture_ns,
                kind: "metrics",
                payload: MetricsStatusPayload {
                    metrics,
                    operations: initial.operations.clone(),
                    pipeline: initial.pipeline.clone(),
                },
            },
        )
        .await
        .is_err()
    {
        return;
    }
    let mut last_broadcast_seq = sequences.last;
    let mut playback = replay_speed.map_or_else(
        || ClientPlayback::live(initial.capture_ns, initial.channel_generation),
        |speed| ClientPlayback::replay(initial.capture_ns, initial.channel_generation, speed),
    );
    let mut playback_tick =
        tokio::time::interval_at(tokio::time::Instant::now() + PLAYBACK_TICK, PLAYBACK_TICK);
    playback_tick.set_missed_tick_behavior(tokio::time::MissedTickBehavior::Skip);
    loop {
        tokio::select! {
            incoming = socket.next() => {
                let Some(Ok(message)) = incoming else { break; };
                match message {
                    Message::Text(text) => {
                        if let Ok(control) = serde_json::from_str::<ClientControl>(&text) {
                            match handle_control(&mut socket, &hub, &mut playback, control).await {
                                Ok(Some(receipt)) => {
                                    last_broadcast_seq = last_broadcast_seq.max(receipt.seq);
                                }
                                Ok(None) => {}
                                Err(_) => break,
                            }
                        }
                    }
                    Message::Close(_) => break,
                    Message::Ping(payload) => {
                        if send_message(&mut socket, Message::Pong(payload)).await.is_err() { break; }
                    }
                    _ => {}
                }
            }
            outgoing = receiver.recv() => {
                match outgoing {
                    Ok(event) => {
                        if event.seq <= last_broadcast_seq {
                            continue;
                        }
                        if event.kind == "position_delta" && (playback.paused || !playback.live) {
                            last_broadcast_seq = event.seq;
                            continue;
                        }
                        if event.kind == "session_status" {
                            let session = hub.inner.session.read().await;
                            if session.channel_generation != playback.channel_generation {
                                playback.channel_generation = session.channel_generation;
                                playback.cursor_ns = session.latest_capture_ns.unwrap_or_default();
                                playback.paused = false;
                                playback.live = true;
                                playback.last_tick = tokio::time::Instant::now();
                            }
                        }
                        if send_raw(&mut socket, &event.json).await.is_err() { break; }
                        last_broadcast_seq = event.seq;
                        if event.kind == "position_delta" && playback.live && !playback.paused {
                            playback.cursor_ns = event.capture_ns;
                        }
                    }
                    Err(broadcast::error::RecvError::Lagged(_)) => {
                        let Ok(seq) = send_lag_resync(&mut socket, &hub).await else { break; };
                        last_broadcast_seq = last_broadcast_seq.max(seq);
                    }
                    Err(broadcast::error::RecvError::Closed) => break,
                }
            }
            now = playback_tick.tick() => {
                let latest_capture_ns = hub
                    .inner
                    .session
                    .read()
                    .await
                    .latest_capture_ns
                    .unwrap_or_default();
                if playback.advance(now, latest_capture_ns) {
                    let reached_live_edge = playback.cursor_ns >= latest_capture_ns;
                    let Ok(receipt) = send_snapshot(
                        &mut socket,
                        &hub,
                        Some(playback.cursor_ns),
                        if reached_live_edge {
                            SnapshotReason::Live
                        } else {
                            SnapshotReason::Playback
                        },
                    ).await else { break; };
                    playback.cursor_ns = receipt.capture_ns;
                    last_broadcast_seq = last_broadcast_seq.max(receipt.seq);
                    if reached_live_edge {
                        playback.live = true;
                    }
                }
            }
        }
    }
}

async fn handle_control(
    socket: &mut WebSocket,
    hub: &EventHub,
    playback: &mut ClientPlayback,
    control: ClientControl,
) -> Result<Option<SnapshotReceipt>, ClientSendError> {
    match control {
        ClientControl::Pause => {
            playback.paused = true;
            playback.last_tick = tokio::time::Instant::now();
            Ok(None)
        }
        ClientControl::Play => {
            playback.paused = false;
            playback.last_tick = tokio::time::Instant::now();
            Ok(None)
        }
        ClientControl::Seek { capture_ns } => {
            playback.live = false;
            playback.last_tick = tokio::time::Instant::now();
            let receipt =
                send_snapshot(socket, hub, Some(capture_ns), SnapshotReason::Seek).await?;
            playback.cursor_ns = receipt.capture_ns;
            Ok(Some(receipt))
        }
        ClientControl::Live => {
            playback.live = true;
            playback.paused = false;
            playback.last_tick = tokio::time::Instant::now();
            let receipt = send_snapshot(socket, hub, None, SnapshotReason::Live).await?;
            playback.cursor_ns = receipt.capture_ns;
            Ok(Some(receipt))
        }
        ClientControl::Speed {
            value: value @ (0.25 | 0.5 | 1.0 | 2.0 | 4.0),
        } => {
            playback.speed = value;
            playback.last_tick = tokio::time::Instant::now();
            Ok(None)
        }
        ClientControl::Speed { .. } => Ok(None),
    }
}

async fn send_snapshot(
    socket: &mut WebSocket,
    hub: &EventHub,
    capture_ns: Option<u64>,
    reason: SnapshotReason,
) -> Result<SnapshotReceipt, ClientSendError> {
    let snapshot = snapshot_envelope(hub, capture_ns, reason).await;
    send(
        socket,
        &WireMessage {
            schema_version: WS_SCHEMA_VERSION,
            session_id: hub.inner.session_id.clone(),
            seq: snapshot.seq,
            capture_ns: snapshot.capture_ns,
            kind: "snapshot",
            payload: snapshot.payload,
        },
    )
    .await?;
    Ok(SnapshotReceipt {
        seq: snapshot.seq,
        capture_ns: snapshot.capture_ns,
    })
}

async fn send_lag_resync(socket: &mut WebSocket, hub: &EventHub) -> Result<u64, ClientSendError> {
    let delivery = state_delivery(hub, StateDeliveryKind::LagResync).await;
    let state = delivery.state;
    let sequences = delivery.sequences;
    send(
        socket,
        &WireMessage {
            schema_version: WS_SCHEMA_VERSION,
            session_id: hub.inner.session_id.clone(),
            seq: sequences.map_roster,
            capture_ns: state.capture_ns,
            kind: "map_roster",
            payload: state.map_roster,
        },
    )
    .await?;
    if let Some((metrics_capture_ns, metrics)) = state.metrics {
        send(
            socket,
            &WireMessage {
                schema_version: WS_SCHEMA_VERSION,
                session_id: hub.inner.session_id.clone(),
                seq: sequences
                    .metrics
                    .expect("metrics payload has a reserved sequence"),
                capture_ns: metrics_capture_ns,
                kind: "metrics",
                payload: MetricsStatusPayload {
                    metrics,
                    operations: state.operations.clone(),
                    pipeline: state.pipeline.clone(),
                },
            },
        )
        .await?;
    }
    send(
        socket,
        &WireMessage {
            schema_version: WS_SCHEMA_VERSION,
            session_id: hub.inner.session_id.clone(),
            seq: sequences.snapshot,
            capture_ns: state.capture_ns,
            kind: "snapshot",
            payload: SnapshotWirePayload {
                positions: state.positions,
                reason: SnapshotReason::LagResync,
                requested_capture_ns: None,
                earliest_available_ns: state.earliest_available_ns,
            },
        },
    )
    .await?;
    Ok(sequences.last)
}

async fn state_delivery(hub: &EventHub, kind: StateDeliveryKind) -> StateDelivery {
    let _publish = hub.inner.publish_lock.lock().await;
    let state = initial_state_unlocked(hub, kind).await;
    let sequences = match kind {
        StateDeliveryKind::Initial => {
            let hello = hub.next_seq_unlocked();
            let snapshot = hub.next_seq_unlocked();
            let map_roster = hub.next_seq_unlocked();
            let metrics = state.metrics.as_ref().map(|_| hub.next_seq_unlocked());
            StateDeliverySequences {
                hello: Some(hello),
                snapshot,
                map_roster,
                metrics,
                last: metrics.unwrap_or(map_roster),
            }
        }
        StateDeliveryKind::LagResync => {
            let map_roster = hub.next_seq_unlocked();
            let metrics = state.metrics.as_ref().map(|_| hub.next_seq_unlocked());
            let snapshot = hub.next_seq_unlocked();
            StateDeliverySequences {
                hello: None,
                snapshot,
                map_roster,
                metrics,
                last: snapshot,
            }
        }
    };
    StateDelivery { state, sequences }
}

async fn initial_state_unlocked(hub: &EventHub, kind: StateDeliveryKind) -> InitialState {
    let session = hub.inner.session.read().await.clone();
    let operations = hub.inner.operations.read().await.clone();
    let pipeline = hub.inner.pipeline.read().await.clone();
    let replay_speed = matches!(kind, StateDeliveryKind::Initial)
        .then(|| hub.initial_replay_speed())
        .flatten();
    let latest_positions: Vec<_> = hub.inner.latest.read().await.values().cloned().collect();
    let timeline = hub.inner.timeline.lock().await;
    let earliest_available_ns = timeline
        .baseline_capture_ns
        .or_else(|| timeline.frames.front().map(|frame| frame.capture_ns));
    let replay_snapshot = replay_speed
        .zip(earliest_available_ns)
        .map(|(_, earliest)| timeline.snapshot_at(earliest));
    drop(timeline);
    let (capture_ns, mut positions) = replay_snapshot.map_or_else(
        || {
            (
                session.latest_capture_ns.unwrap_or_default(),
                latest_positions,
            )
        },
        |snapshot| (snapshot.capture_ns, snapshot.positions),
    );
    positions.sort_by_key(|position| position.slot);
    InitialState {
        capture_ns,
        channel_generation: session.channel_generation,
        replay_speed,
        positions,
        earliest_available_ns,
        map_roster: MapRosterPayload {
            session,
            roster: hub.inner.roster.read().await.clone(),
            maps: hub.inner.map_catalog.manifest().clone(),
            operations: operations.clone(),
            pipeline: pipeline.clone(),
            binding: hub.inner.binding.read().await.clone(),
        },
        metrics: hub.inner.latest_metrics.read().await.clone(),
        operations,
        pipeline,
    }
}

async fn snapshot_envelope(
    hub: &EventHub,
    requested_capture_ns: Option<u64>,
    reason: SnapshotReason,
) -> SnapshotEnvelope {
    let _publish = hub.inner.publish_lock.lock().await;
    if let Some(requested) = requested_capture_ns {
        let snapshot = hub.inner.timeline.lock().await.snapshot_at(requested);
        let delivery_seq = hub.next_seq_unlocked();
        debug_assert!(delivery_seq > snapshot.seq);
        SnapshotEnvelope {
            seq: delivery_seq,
            capture_ns: snapshot.capture_ns,
            payload: SnapshotWirePayload {
                positions: snapshot.positions,
                reason,
                requested_capture_ns: Some(requested),
                earliest_available_ns: snapshot.earliest_available_ns,
            },
        }
    } else {
        let seq = hub.next_seq_unlocked();
        let capture_ns = hub
            .inner
            .session
            .read()
            .await
            .latest_capture_ns
            .unwrap_or_default();
        let mut positions: Vec<_> = hub.inner.latest.read().await.values().cloned().collect();
        positions.sort_by_key(|position| position.slot);
        let timeline = hub.inner.timeline.lock().await;
        SnapshotEnvelope {
            seq,
            capture_ns,
            payload: SnapshotWirePayload {
                positions,
                reason,
                requested_capture_ns: None,
                earliest_available_ns: timeline
                    .baseline_capture_ns
                    .or_else(|| timeline.frames.front().map(|frame| frame.capture_ns)),
            },
        }
    }
}

#[derive(Debug, Error)]
enum ClientSendError {
    #[error("websocket JSON serialization failed: {0}")]
    Json(#[from] serde_json::Error),
    #[error("websocket send failed: {0}")]
    WebSocket(#[from] axum::Error),
    #[error("websocket client write timed out")]
    Timeout,
}

async fn send<T: Serialize>(socket: &mut WebSocket, value: &T) -> Result<(), ClientSendError> {
    let json = serde_json::to_string(value)?;
    send_raw(socket, &json).await
}

async fn send_raw(socket: &mut WebSocket, json: &str) -> Result<(), ClientSendError> {
    send_message(socket, Message::Text(json.to_owned().into())).await
}

async fn send_message(socket: &mut WebSocket, message: Message) -> Result<(), ClientSendError> {
    tokio::time::timeout(WS_WRITE_TIMEOUT, socket.send(message))
        .await
        .map_err(|_| ClientSendError::Timeout)??;
    Ok(())
}

