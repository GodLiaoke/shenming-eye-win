            .await
            .unwrap();
        socket
            .send(ClientMessage::Text(r#"{"action":"play"}"#.into()))
            .await
            .unwrap();

        let playback = next_json(&mut socket).await;
        assert!(matches!(
            playback["payload"]["reason"].as_str(),
            Some("playback" | "live")
        ));
        assert!(playback["capture_ns"].as_u64().unwrap() > 0);

        socket.close(None).await.unwrap();
        server.abort();
    }

    #[tokio::test]
    async fn lagging_subscriber_never_backpressures_publishers_and_can_resync() {
        let hub = EventHub::new("lag-test").unwrap();
        let mut lagging = hub.inner.sender.subscribe();
        tokio::time::timeout(Duration::from_secs(3), async {
            for seq in 1..=(WS_BROADCAST_CAPACITY * 4) {
                hub.publish_positions(seq as u64, vec![position(5, seq as u64, seq as f64)])
                    .await
                    .unwrap();
            }
        })
        .await
        .expect("a stalled subscriber backpressured the producer");
        assert!(matches!(
            lagging.recv().await,
            Err(broadcast::error::RecvError::Lagged(_))
        ));
        let snapshot = snapshot_envelope(&hub, None, SnapshotReason::LagResync).await;
        assert_eq!(snapshot.positions_len(), 1);
        assert_eq!(
            snapshot.payload.positions[0].world.x,
            (WS_BROADCAST_CAPACITY * 4) as f64
        );
    }

    #[tokio::test]
    async fn lag_resync_reserves_distinct_monotonic_sequences_and_a_fresh_snapshot() {
        let hub = EventHub::new("lag-sequence-test").unwrap();
        hub.publish_positions(10, vec![position(5, 10, 1.0)])
            .await
            .unwrap();
        hub.publish_metrics(
            10,
            MetricsPayload {
                packets: 1,
                actor_messages: 1,
                coordinate_updates: 1,
                parse_failures: 0,
                pcap_drops: 0,
                proxy_pipeline: None,
                parse_to_ws_p99_ms: None,
                capture_to_ws_p99_ms: None,
            },
        )
        .await
        .unwrap();
        let before = hub.inner.seq.load(Ordering::Relaxed);
        let delivery = state_delivery(&hub, StateDeliveryKind::LagResync).await;
        let sequences = delivery.sequences;
        let metrics = sequences
            .metrics
            .expect("lag resync with metrics reserves a metrics sequence");
        assert!(sequences.hello.is_none());
        assert!(before < sequences.map_roster);
        assert!(sequences.map_roster < metrics);
        assert!(metrics < sequences.snapshot);
        assert_eq!(sequences.last, sequences.snapshot);

        let next = hub
            .publish_positions(20, vec![position(5, 20, 2.0)])
            .await
            .unwrap();
        assert!(sequences.snapshot < next);
    }

    #[test]
    fn wire_models_have_no_private_identity_or_session_keys() {
        let mut view = position(5, 10, 1.0);
        view.display_name = Some("internal tester".into());
        view.identity_confidence = IdentityConfidence::Proven;
        let snapshot = WireMessage {
            schema_version: WS_SCHEMA_VERSION,
            session_id: "redacted-session".into(),
            seq: 1,
            capture_ns: 10,
            kind: "snapshot",
            payload: SnapshotPayload {
                positions: vec![view],
            },
        };
        let roster = MapRosterPayload {
            session: SessionView::default(),
            roster: vec![RosterEntry {
                slot: Some(5),
                display_name: "internal tester".into(),
                agent_id: 7,
                camp_id: 1,
                position_slot: None,
                device_tag: false,
                identity_confidence: IdentityConfidence::Proven,
            }],
            binding: RosterBindingView::default(),
            maps: MapManifest {
                schema_version: 1,
                maps: Vec::new(),
            },
            operations: OperationalStatus::default(),
            pipeline: PipelineStatus::default(),
        };
        let value = serde_json::to_value((snapshot, roster)).unwrap();
        let mut keys = Vec::new();
        collect_keys(&value, &mut keys);
        for forbidden in ["uid", "openid", "packetkey", "gameid"] {
            assert!(
                !keys.iter().any(|key| key.replace('_', "") == forbidden),
                "private field {forbidden} was serialized"
            );
        }
    }

    fn collect_keys(value: &Value, keys: &mut Vec<String>) {
        match value {
            Value::Object(object) => {
                for (key, value) in object {
                    keys.push(key.to_ascii_lowercase());
                    collect_keys(value, keys);
                }
            }
            Value::Array(values) => {
                for value in values {
                    collect_keys(value, keys);
                }
            }
            _ => {}
        }
    }

    impl SnapshotEnvelope {
        fn positions_len(&self) -> usize {
            self.payload.positions.len()
        }
    }
