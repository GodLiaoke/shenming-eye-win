pub async fn serve(listener: TcpListener, hub: EventHub) -> Result<(), WebError> {
    let address = listener.local_addr()?;
    if !hub.is_public() && !address.ip().is_loopback() {
        return Err(WebError::NonLoopback(address));
    }
    // 房间令牌自校验（异地观看写入端）：配置了才把镜像路由从统一会话中间件里摘出来。
    let mirror_access = hub.mirror_access().await;
    axum::serve(listener, app(hub, mirror_access))
        .await
        .map_err(WebError::Io)
}


/// 异地观看：手机端把**已在本机解码好**的坐标推上来，灌进与本地解码**完全相同**的广播管道。
///
/// 设计要点（均已与用户确认）：
///  · **只做实时** —— 不落盘、不做回放；
///  · 复用 [`EventHub::publish_positions`]，因此**观看端（页面 + /api/v1/ws）零改动**；
///  · 身份由**手机端解析好**再上传：roster 是在手机本地解码出来的，云端没有，
///    所以这里不能依赖云端 roster（否则异地面板永远出不了英雄头像）；
///  · 鉴权：默认交给 `require_access` 中间件；配置了房间令牌自校验
///    （[`MirrorAccess`]）时改由 `?access=` 房间令牌自行校验，转发器因此
///    **不再需要 Cookie / Origin**（见 `app()` 里的挂载分支）。
#[derive(Debug, Deserialize)]
struct MirrorPositionsRequest {
    capture_ns: u64,
    positions: Vec<PositionView>,
    /// 手机端解码得到的脱敏自机绑定，用于异地网页正确区分我方/敌方。
    #[serde(default)]
    binding: Option<RosterBindingView>,
    /// 手机端本机引擎当前这一局的**地图号**（不是猜测：手机端从本机 WS 的
    /// `session_status` / `map_roster` 里读出来再带上来）。
    ///
    /// 有它，云端房间才知道该加载哪张底图；没有它（旧版转发器）行为与以前完全一致。
    #[serde(default)]
    map_id: Option<u32>,
}

/// 镜像写入路由的状态：hub + 房间令牌校验器。
#[derive(Clone)]
struct MirrorState {
    hub: EventHub,
    access: Arc<MirrorAccess>,
}

async fn publish_mirror(hub: &EventHub, body: MirrorPositionsRequest) -> Response {
    let binding_seq = match body.binding {
        Some(binding) => match hub.set_mirror_binding(binding).await {
            Ok(seq) => seq,
            Err(error) => {
                return (
                    StatusCode::BAD_REQUEST,
                    Json(serde_json::json!({"ok": false, "error": error.to_string()})),
                )
                    .into_response();
            }
        },
        None => None,
    };
    if body.positions.is_empty() {
        return Json(serde_json::json!({"ok": true, "published": 0, "binding_seq": binding_seq})).into_response();
    }
    // 先把会话立起来，再发坐标：页面的闸门是 `status ∈ {live, replay}`，底图还要
    // `map_id`。云端槽位引擎是 proxy 模式、**永远看不到这一局**（解码在手机上），
    // 所以会话一直是 `awaiting_session`、`map_id=null` —— 页面就会一直停在
    // 「等待对局数据」。会话立不起来就没必要假装成功，直接报错（宁可让手机端
    // 界面显示"异常"，也不要给异地端一块永远空白的雷达）。
    let mut session_seq = None;
    if let Some(map_id) = body.map_id {
        match hub.ensure_live_map_session(map_id, body.capture_ns).await {
            Ok(seq) => session_seq = seq,
            Err(error) => {
                return (
                    StatusCode::BAD_REQUEST,
                    Json(serde_json::json!({"ok": false, "error": error.to_string()})),
                )
                    .into_response();
            }
        }
    }
    match hub.publish_positions(body.capture_ns, body.positions).await {
        Ok(seq) => Json(serde_json::json!({
            "ok": true,
            "seq": seq,
            "published": 1,
            "session_seq": session_seq,
            "binding_seq": binding_seq,
        }))
        .into_response(),
        Err(error) => (
            StatusCode::BAD_REQUEST,
            Json(serde_json::json!({"ok": false, "error": error.to_string()})),
        )
            .into_response(),
    }
}

async fn mirror_positions(
    State(hub): State<EventHub>,
    Json(body): Json<MirrorPositionsRequest>,
) -> Response {
    publish_mirror(&hub, body).await
}

/// 房间令牌自校验版本：`?access=hex(HMAC(cookie_key, "viewer:"+room_id))`。
///
/// 刻意**不检查 Origin**：原生客户端（iOS `URLSessionWebSocketTask` / 转发器）
/// 默认不发 Origin，检查它正是异地观看卡住的根因之一。凭据就是房间令牌本身。
async fn mirror_positions_with_room_token(
    State(state): State<MirrorState>,
    Query(query): Query<HashMap<String, String>>,
    Json(body): Json<MirrorPositionsRequest>,
) -> Response {
    let Some(access) = query.get("access") else {
        return (
            StatusCode::UNAUTHORIZED,
            Json(serde_json::json!({"ok": false, "error": "missing room access token"})),
        )
            .into_response();
    };
    let Some(room_id) = state.access.verify(access) else {
        return (
            StatusCode::UNAUTHORIZED,
            Json(serde_json::json!({"ok": false, "error": "invalid room access token"})),
        )
            .into_response();
    };
    let mut response = publish_mirror(&state.hub, body).await;
    // 房间号只用于诊断（令牌本身不落任何日志）。
    if let Ok(value) = axum::http::HeaderValue::from_str(&room_id) {
        response.headers_mut().insert("x-codev-room", value);
    }
    response
}

fn app(hub: EventHub, mirror_access: Option<Arc<MirrorAccess>>) -> Router {
    let mut protected = Router::new()
        .route("/", get(index))
        .route("/healthz", get(health))
        .route("/api/v1/healthz", get(health))
        .route("/api/v1/readiness", get(readiness))
        .route("/api/v1/auth/exchange", post(auth_exchange))
        .route("/api/v1/session", get(session))
        .route("/api/v1/session/key", post(session_key_issue))
        .route("/api/v1/maps/manifest", get(map_manifest))
        .route("/api/v1/maps/{*path}", get(map_file))
        .route("/api/v1/abilities/{*path}", get(ability_file))
        .route("/api/v1/proxy/status", get(proxy_status))
        .route(
            "/api/v1/proxy/profiles",
            get(list_profiles).post(create_profile),
        )
        .route("/api/v1/proxy/profiles/{id}/conf", get(profile_conf))
        .route("/api/v1/proxy/profiles/{id}/qr.svg", get(profile_qr))
        .route("/api/v1/proxy/profiles/{id}/rotate", post(rotate_profile))
        .route("/api/v1/proxy/profiles/{id}/revoke", post(revoke_profile))
        .route(
            "/api/v1/proxy/subscriptions/{id}",
            get(subscription_profile),
        )
        .route("/api/v1/ca/status", get(ca_status))
        .route("/api/v1/ca/download/{format}", get(ca_download))
        .route("/api/v1/ws", get(websocket));
    if mirror_access.is_none() {
        // 未配置房间令牌自校验 → 保持原样：镜像路由仍在统一会话中间件后面。
        protected = protected.route("/api/v1/mirror/positions", post(mirror_positions));
    }
    let protected = protected
        .layer(middleware::from_fn_with_state(hub.clone(), require_access))
        .with_state(hub.clone());
    match mirror_access {
        // 摘出来：`merge` 进来的路由**不会**被上面那层 `layer` 包住。
        Some(access) => protected.merge(
            Router::new()
                .route(
                    "/api/v1/mirror/positions",
                    post(mirror_positions_with_room_token),
                )
                .with_state(MirrorState { hub, access }),
        ),
        None => protected,
    }
}


/// S2：下发 35 分钟会话密钥 + 按会话加密的字段字典。
///
/// 鉴权由全局 `require_access` 中间件承担，所以这里不重复验证卡密；
/// 会话身份取本槽位的会话令牌 —— 换一次授权就换一把钥匙。
/// 字典未注入时返回 503（**绝不下发空字典**，否则客户端会拿到"能解但内容为空"的假成功）。
async fn session_key_issue(
    State(hub): State<EventHub>,
    body: Option<Json<SessionKeyRequest>>,
) -> Response {
    let device_id = body
        .and_then(|Json(request)| request.device_id)
        .filter(|value| !value.is_empty() && value.len() <= 128)
        .unwrap_or_else(|| "unnamed-device".to_string());

    let Some(dictionary) = session_key::dictionary() else {
        return (
            StatusCode::SERVICE_UNAVAILABLE,
            Json(serde_json::json!({ "ok": false, "error": "字段字典未初始化" })),
        )
            .into_response();
    };

    match session_key::issue(hub.token(), &device_id, dictionary) {
        Ok(grant) => Json(serde_json::json!({
            "ok": true,
            "session_key": grant.session_key_b64,
            "nonce": grant.nonce_b64,
            "dictionary_blob": grant.dictionary_blob_b64,
            "dictionary_tag": grant.dictionary_tag_b64,
            "expires_unix": grant.expires_unix,
            "ttl_secs": session_key::SESSION_TTL_SECS,
            "alg": "chacha20+hmac-sha256",
        }))
        .into_response(),
        Err(error) => (
            StatusCode::INTERNAL_SERVER_ERROR,
            Json(serde_json::json!({ "ok": false, "error": error })),
        )
            .into_response(),
    }
}

