}

struct Timeline {
    frames: VecDeque<TimelineFrame>,
    frame_bytes: usize,
    baseline: HashMap<u8, PositionView>,
    baseline_bytes: usize,
    baseline_seq: u64,
    baseline_capture_ns: Option<u64>,
    baseline_generation: u64,
    limit_bytes: usize,
}

#[derive(Debug)]
struct TimelineSnapshot {
    seq: u64,
    capture_ns: u64,
    earliest_available_ns: Option<u64>,
    positions: Vec<PositionView>,
}

impl Timeline {
    fn new(limit_bytes: usize) -> Self {
        Self {
            frames: VecDeque::new(),
            frame_bytes: 0,
            baseline: HashMap::new(),
            baseline_bytes: 0,
            baseline_seq: 0,
            baseline_capture_ns: None,
            baseline_generation: 0,
            limit_bytes,
        }
    }

    fn start_generation(&mut self, seq: u64, capture_ns: u64, channel_generation: u64) {
        self.push_frame(seq, capture_ns, channel_generation, true, Vec::new());
    }

    fn push(
        &mut self,
        seq: u64,
        capture_ns: u64,
        channel_generation: u64,
        positions: Vec<PositionView>,
    ) {
        self.push_frame(seq, capture_ns, channel_generation, false, positions);
    }

    fn push_frame(
        &mut self,
        seq: u64,
        capture_ns: u64,
        channel_generation: u64,
        starts_generation: bool,
        positions: Vec<PositionView>,
    ) {
        let estimated_bytes = size_of::<TimelineFrame>()
            + positions
                .iter()
                .map(estimated_position_bytes)
                .sum::<usize>();
        self.frames.push_back(TimelineFrame {
            seq,
            capture_ns,
            channel_generation,
            starts_generation,
            positions,
            estimated_bytes,
        });
        self.frame_bytes = self.frame_bytes.saturating_add(estimated_bytes);
        while self.frame_bytes.saturating_add(self.baseline_bytes) > self.limit_bytes {
            if let Some(frame) = self.frames.pop_front() {
                self.frame_bytes = self.frame_bytes.saturating_sub(frame.estimated_bytes);
                self.baseline_seq = self.baseline_seq.max(frame.seq);
                self.baseline_capture_ns = Some(
                    self.baseline_capture_ns
                        .map_or(frame.capture_ns, |timestamp| {
                            timestamp.max(frame.capture_ns)
                        }),
                );
                if frame.starts_generation {
                    self.baseline.clear();
                    self.baseline_bytes = 0;
                    self.baseline_generation = frame.channel_generation;
                }
                if frame.channel_generation != self.baseline_generation {
                    continue;
                }
                for position in frame.positions {
                    if let Some(previous) = self.baseline.insert(position.slot, position.clone()) {
                        self.baseline_bytes = self
                            .baseline_bytes
                            .saturating_sub(estimated_position_bytes(&previous));
                    }
                    self.baseline_bytes = self
                        .baseline_bytes
                        .saturating_add(estimated_position_bytes(&position));
                }
            } else {
                break;
            }
        }
    }

    fn snapshot_at(&self, requested_capture_ns: u64) -> TimelineSnapshot {
        let capture_ns = self
            .baseline_capture_ns
            .map_or(requested_capture_ns, |baseline| {
                requested_capture_ns.max(baseline)
            });
        let mut positions = self.baseline.clone();
        let mut seq = self.baseline_seq;
        let mut channel_generation = self.baseline_generation;
        for frame in &self.frames {
            if frame.capture_ns <= capture_ns {
                seq = seq.max(frame.seq);
                if frame.starts_generation {
                    positions.clear();
                    channel_generation = frame.channel_generation;
                }
                if frame.channel_generation != channel_generation {
                    continue;
                }
                for position in &frame.positions {
                    positions.insert(position.slot, position.clone());
                }
            }
        }
        let mut positions: Vec<_> = positions.into_values().collect();
        positions.sort_by_key(|position| position.slot);
        TimelineSnapshot {
            seq,
            capture_ns,
            earliest_available_ns: self
                .baseline_capture_ns
                .or_else(|| self.frames.front().map(|frame| frame.capture_ns)),
            positions,
        }
    }
}

fn estimated_position_bytes(position: &PositionView) -> usize {
    size_of::<PositionView>()
        .saturating_add(position.track_id.len())
        .saturating_add(position.display_name.as_ref().map_or(0, String::len))
}

