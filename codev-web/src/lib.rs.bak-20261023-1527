    /// 异地观看写入端的房间令牌校验器（来自面板服务）。`None` = 未配置，
    /// 镜像路由继续挂在统一会话中间件后面。
    pub async fn mirror_access(&self) -> Option<Arc<MirrorAccess>> {
        self.inner
            .services
            .read()
            .await
            .proxy
            .as_ref()
            .and_then(|service| service.mirror_access.clone())
