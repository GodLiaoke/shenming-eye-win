        let (key_file, state_file, token) = room_access_fixture(&directory, "FCEACCBFCFBF");
        let access = Arc::new(MirrorAccess::load(&key_file, &state_file).unwrap());
        let (address, server) = mirror_public_hub(Some(access), &directory).await;

        // 前提前提：云端会话一开始确实是"没有对局"（否则这个测试什么都证明不了）。
        let before = get_json(address, "/api/v1/session").await;
        assert_eq!(before["status"], "awaiting_session");
        assert!(before["map_id"].is_null());

        let body = r#"{"capture_ns":1789994130300050000,"map_id":1004,"positions":[{"slot":9,"track_id":"batch_slot_9","actor_guid":null,"player_state_guid":null,"display_name":null,"agent_id":3026,"camp_id":1,"world":{"x":2960.0,"y":-13430.0,"z":400.3},"map":null,"yaw":90.0,"fresh":true,"continuity":"stale","identity_confidence":"proven","updated_ns":1789994130300050000}]}"#;
