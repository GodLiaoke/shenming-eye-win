            ..SessionView::default()
        })
        .await
        .unwrap();
        assert!(hub.snapshot().await.is_empty());
        hub.publish_positions(30, vec![position(5, 30, 2.0)])
            .await
            .unwrap();

        let timeline = hub.inner.timeline.lock().await;
        assert_eq!(timeline.snapshot_at(10).positions[0].world.x, 1.0);
        assert!(timeline.snapshot_at(20).positions.is_empty());
        assert_eq!(timeline.snapshot_at(30).positions[0].world.x, 2.0);
        drop(timeline);

        hub.set_session(SessionView {
            status: SessionStatus::Ended,
            status_detail: "capture ended".into(),
            latest_capture_ns: Some(40),
            ..SessionView::default()
        })
        .await
        .unwrap();
        let session = hub.inner.session.read().await.clone();
        assert_eq!(session.channel_generation, 1);
        assert_eq!(session.status, SessionStatus::Ended);
